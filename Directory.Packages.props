<Project>
    <!-- Every package version lives here. Arc is built against one exact Avalonia version: keep all Avalonia
         packages on it, and all TKCode.Arc packages on the same Arc version. -->
    <PropertyGroup>
        <AvaloniaVersion>12.2.0</AvaloniaVersion>
        <ArcVersion>1.3.1</ArcVersion>
    </PropertyGroup>
    <ItemGroup>
        <PackageVersion Include="Avalonia" Version="$(AvaloniaVersion)" />
        <PackageVersion Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
        <!-- The phone app's platform heads (src/Octopus.Mobile.Android, .iOS): only in Octopus.Mobile.slnx, they need the workloads. -->
        <PackageVersion Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
        <PackageVersion Include="Avalonia.iOS" Version="$(AvaloniaVersion)" />
        <PackageVersion Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
        <PackageVersion Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
        <PackageVersion Include="Avalonia.Headless.XUnit" Version="$(AvaloniaVersion)" />
        <!-- Real drawing in the phone app's headless tests (the desktop app's tests get it through Avalonia.Desktop). -->
        <PackageVersion Include="Avalonia.Skia" Version="$(AvaloniaVersion)" />
        <PackageVersion Include="TKCode.Arc" Version="$(ArcVersion)" />
        <PackageVersion Include="TKCode.Arc.Blocks" Version="$(ArcVersion)" />
        <PackageVersion Include="TKCode.Arc.Dock" Version="$(ArcVersion)" />
        <PackageVersion Include="TKCode.Arc.Fonts" Version="$(ArcVersion)" />
        <PackageVersion Include="TKCode.Arc.Highlighting" Version="$(ArcVersion)" />
        <PackageVersion Include="TKCode.Arc.Icons.Lucide" Version="$(ArcVersion)" />
        <PackageVersion Include="TKCode.Arc.Themes.Corners" Version="$(ArcVersion)" />
        <PackageVersion Include="TKCode.Arc.Terminal" Version="$(ArcVersion)" />
        <!-- Touch-first controls for the phone app (src/Octopus.Mobile). -->
        <PackageVersion Include="TKCode.Arc.Mobile" Version="$(ArcVersion)" />
        <PackageVersion Include="MiniPty" Version="1.7.1" />
        <!-- JavaScript engine for plugins (design/plugins/02). Referenced only by the plugin runtime adapter. -->
        <PackageVersion Include="Jaunt" Version="1.0.3" />
        <!-- SVG files in the image viewer. 5.1.x is the last line built on SkiaSharp 3.119, the version Avalonia's Skia backend uses. -->
        <PackageVersion Include="Svg.Skia" Version="5.1.1" />
        <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageVersion Include="Microsoft.Data.Sqlite" Version="11.0.0" />
        <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="11.0.0" />
        <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
        <!-- Avalonia.Headless.XUnit 12.2.x is built against xunit.v3 3.2.2; xunit.v3 4.x breaks IXunitTestAssembly at run time. -->
        <PackageVersion Include="xunit.v3" Version="3.2.2" />
        <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    </ItemGroup>
</Project>
