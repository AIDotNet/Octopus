<arcm:Page xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
           xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
           xmlns:voice="using:Octopus.Mobile.Voice"
           xmlns:l="using:Octopus.Mobile.Localization"
           xmlns:bots="using:Octopus.Mobile.Bots"
           xmlns:common="using:Octopus.Mobile.Common"
           xmlns:vm="using:Octopus.Mobile.Hosts"
           x:Class="Octopus.Mobile.Hosts.HostsPage"
           x:DataType="vm:HostsViewModel"
           IsScrollable="True">
    <arcm:Page.Resources>
        <StreamGeometry x:Key="GroupUsersGlyph">M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M22 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75</StreamGeometry>
        <!-- One computer row: how it is reached, and a pill with what needs the person there (a lock: its access
             password gets in). Offline it is faded and does nothing. -->
        <DataTemplate x:Key="HostRow" x:DataType="vm:HostRowViewModel">
            <arcm:ListItem Icon="{x:Static arc:ArcIcons.Monitor}"
                           Classes.dimmed="{Binding IsDimmed}"
                           Content="{Binding Name}"
                           Subtitle="{Binding Summary}"
                           ShowChevron="{Binding ShowChevron}"
                           Command="{Binding OpenCommand}">
                <arcm:ListItem.Trailing>
                    <Panel>
                        <Border Classes="pill"
                                Classes.waiting="{Binding IsWaiting}"
                                Classes.error="{Binding IsError}"
                                Classes.working="{Binding IsWorking}"
                                Classes.action="{Binding IsPairAction}"
                                IsVisible="{Binding HasPill}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <arc:ArcSpinner IsVisible="{Binding IsWorking}" />
                                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Lock}" Size="11" IsVisible="{Binding IsPasswordAction}" />
                                <TextBlock Text="{Binding PillText}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Classes="muted" Text="{l:MobileLangResource Idle}" IsVisible="{Binding IsIdle}" VerticalAlignment="Center" />
                    </Panel>
                </arcm:ListItem.Trailing>
            </arcm:ListItem>
        </DataTemplate>

        <!-- A phone of the account under "Other devices": only named ("This phone" for itself), never opened. -->
        <DataTemplate x:Key="DeviceRow" x:DataType="vm:AccountDeviceRowViewModel">
            <arcm:ListItem Icon="{x:Static arc:ArcIcons.Smartphone}"
                           Content="{Binding Name}"
                           Subtitle="{Binding Summary}">
                <arcm:ListItem.Trailing>
                    <Border Classes="pill" IsVisible="{Binding IsCurrent}">
                        <TextBlock Text="{l:MobileLangResource ThisPhone}" />
                    </Border>
                </arcm:ListItem.Trailing>
            </arcm:ListItem>
        </DataTemplate>

        <!-- Cross-host session row in the Activity inbox: full-width title + project-first context with compact status pill. -->
        <DataTemplate x:Key="ActivitySessionRow" x:DataType="vm:ActivitySessionRowViewModel">
            <arcm:ListItem ShowChevron="True" Command="{Binding OpenCommand}">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11" Margin="0,5">
                    <Panel Grid.Column="0" VerticalAlignment="Top" Margin="0,2,0,0">
                        <Border Classes="badge" Background="{Binding Tint}" IsVisible="{Binding IsAgent}">
                            <TextBlock Text="{Binding Initial}" />
                        </Border>
                        <Border Classes="badge" IsVisible="{Binding IsTerminal}">
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Terminal}" Size="16"
                                          Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Panel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0"
                                       Classes="sessionTitle"
                                       Text="{Binding Title}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1" Classes="wsPill" IsVisible="{Binding HasWorkspaceTask}">
                                <TextBlock Text="{Binding WorkspaceTaskKey}" MaxWidth="82" TextTrimming="CharacterEllipsis" />
                            </Border>
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0"
                                       Classes="secondary"
                                       Text="{Binding ContextLine}"
                                       VerticalAlignment="Center" />
                            <Border Grid.Column="1"
                                    Classes="pill compact"
                                    Classes.waiting="{Binding IsWaiting}"
                                    Classes.working="{Binding IsWorking}"
                                    Classes.error="{Binding IsError}"
                                    IsVisible="{Binding HasStatus}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <arc:ArcSpinner IsVisible="{Binding IsWorking}" />
                                    <TextBlock Text="{Binding StatusText}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <TextBlock Classes="preview" Text="{Binding Preview}" IsVisible="{Binding HasPreview}" />
                    </StackPanel>
                </Grid>
            </arcm:ListItem>
        </DataTemplate>
    </arcm:Page.Resources>

    <arcm:Page.Header>
        <!-- One compact row under the status bar: the tab's title on the left (no large-title row, no empty bar above
             it) and the tab's actions on the right. The account lives in the "Me" tab, so no avatar button here. -->
        <arcm:Navbar Name="TabNavbar">
            <arcm:Navbar.Leading>
                <TextBlock Name="TabTitle"
                           Text="{Binding CurrentTabTitle}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{arc:ArcDesignTokenResource TypeXL}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
            </arcm:Navbar.Leading>
            <arcm:Navbar.Trailing>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Quick new group + import link + create Bot on Bots tab -->
                    <arcm:IconButton Name="NavNewGroupButton"
                                     Icon="{StaticResource GroupUsersGlyph}"
                                     Command="{Binding Bots.OpenNewGroupCommand}"
                                     AutomationProperties.Name="{l:MobileLangResource BotGroupsNewButton}"
                                     IsVisible="{Binding IsBotsTab}" />
                    <arcm:IconButton Name="NavImportBotButton"
                                     Icon="{x:Static arc:ArcIcons.ExternalLink}"
                                     Command="{Binding Bots.OpenImportBotCommand}"
                                     AutomationProperties.Name="{l:MobileLangResource BotsImportButton}"
                                     IsVisible="{Binding IsBotsTab}" />
                    <arcm:IconButton Name="NavNewBotButton"
                                     Icon="{x:Static arc:ArcIcons.Plus}"
                                     Command="{Binding Bots.OpenNewBotCommand}"
                                     AutomationProperties.Name="{l:MobileLangResource BotsNewButton}"
                                     IsVisible="{Binding IsBotsTab}" />
                    <!-- Quick add computer on Computers tab -->
                    <arcm:IconButton Name="NavAddHostButton"
                                     Icon="{x:Static arc:ArcIcons.Plus}"
                                     Command="{Binding AddHostCommand}"
                                     AutomationProperties.Name="{l:MobileLangResource AddHost}"
                                     IsVisible="{Binding IsHostsTab}" />
                    <!-- Without an account: a reminder on Activity & Computers that leads to the Me tab -->
                    <Panel IsVisible="{Binding !IsAccountTab}">
                        <arcm:Button Name="SignedOutButton"
                                     Variant="Plain"
                                     Content="{l:MobileLangResource NotSignedIn}"
                                     Command="{Binding SelectAccountTabCommand}"
                                     IsVisible="{Binding IsSignedOut}" />
                    </Panel>
                    <!-- Connection badge on Me tab -->
                    <Border Classes="pill"
                            Classes.success="{Binding IsSignedIn}"
                            IsVisible="{Binding IsAccountTab}"
                            Margin="0,0,4,0">
                        <TextBlock Text="{Binding AccountStatusBadge}" />
                    </Border>
                </StackPanel>
            </arcm:Navbar.Trailing>
        </arcm:Navbar>
    </arcm:Page.Header>

    <StackPanel Margin="0,4,0,24" Spacing="14">
        <!-- Update reminder banner shown on Activity & Computers tabs when an update is available, downloading, ready or failed. -->
        <Border Name="UpdateReminderBanner"
                Classes="updateBanner"
                Classes.ready="{Binding Updater.IsReady}"
                Classes.error="{Binding Updater.IsFailed}"
                Margin="16,4,16,0"
                IsVisible="{Binding ShowUpdateBanner}">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                    <Border Grid.Column="0"
                            Classes="updateIconBadge"
                            Classes.ready="{Binding Updater.IsReady}"
                            Classes.error="{Binding Updater.IsFailed}">
                        <Panel>
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ArrowUp}" Size="16"
                                          Foreground="{arc:ArcDesignTokenResource Accent}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsVisible="{Binding Updater.IsAvailable}" />
                            <arc:ArcSpinner Width="15" Height="15"
                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsVisible="{Binding Updater.IsDownloading}" />
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Check}" Size="16"
                                          Foreground="{arc:ArcDesignTokenResource Success}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsVisible="{Binding Updater.IsReady}" />
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.RefreshCw}" Size="15"
                                          Foreground="{arc:ArcDesignTokenResource Danger}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                          IsVisible="{Binding Updater.IsFailed}" />
                        </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Name="UpdateBannerTitle"
                                   Text="{Binding Updater.BannerTitle}"
                                   FontSize="{arc:ArcDesignTokenResource TypeBase}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Name="UpdateBannerSubtitle"
                                   Classes="secondary"
                                   Text="{Binding Updater.BannerSubtitle}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Name="UpdateBannerDismissButton"
                            Grid.Column="2"
                            Classes="bannerCloseBtn"
                            Command="{Binding Updater.DismissBannerCommand}"
                            IsVisible="{Binding Updater.CanDismissBanner}"
                            AutomationProperties.Name="{l:MobileLangResource UpdateDismiss}">
                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.X}" Size="15"
                                      Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                    </Button>
                </Grid>

                <!-- Visual progress bar while downloading -->
                <ProgressBar Name="UpdateBannerProgress"
                             Classes="updateProgress"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding Updater.ProgressPercent}"
                             IsVisible="{Binding Updater.IsDownloading}" />

                <!-- Actions: What's new (Markdown sheet) + Update / Install / Cancel -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <arcm:Button Name="UpdateBannerNotesButton"
                                 Grid.Column="0"
                                 Variant="Tinted"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Center"
                                 Content="{l:MobileLangResource UpdateNotes}"
                                 Command="{Binding Updater.OpenNotesCommand}"
                                 IsVisible="{Binding Updater.HasOffer}" />
                    <Panel Grid.Column="1">
                        <arcm:Button Name="UpdateBannerPrimaryButton"
                                     Variant="Filled"
                                     HorizontalAlignment="Stretch"
                                     HorizontalContentAlignment="Center"
                                     Content="{Binding Updater.PrimaryModalActionText}"
                                     Command="{Binding Updater.ActCommand}"
                                     IsVisible="{Binding Updater.HasPrimaryModalAction}" />
                        <arcm:Button Name="UpdateBannerCancelButton"
                                     Variant="Tinted"
                                     HorizontalAlignment="Stretch"
                                     HorizontalContentAlignment="Center"
                                     Foreground="{arc:ArcDesignTokenResource Danger}"
                                     Content="{l:MobileLangResource Cancel}"
                                     Command="{Binding Updater.CancelDownloadCommand}"
                                     IsVisible="{Binding Updater.IsDownloading}" />
                    </Panel>
                </Grid>
            </StackPanel>
        </Border>

        <Panel>
        <!-- ==================== Tab 0: Activity (动态收件箱) ==================== -->
        <StackPanel Name="ActivityTabContent" Spacing="18" IsVisible="{Binding IsActivityTab}">
            <!-- Cloud relay upgrade banner when in local-only mode -->
            <Border Name="LocalUpgradeBanner"
                    Classes="alertCard"
                    Margin="16,4,16,0"
                    IsVisible="{Binding IsSignedOut}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{l:MobileLangResource UpgradeBannerTitle}"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   FontWeight="SemiBold"
                                   Foreground="{arc:ArcDesignTokenResource Accent}" />
                        <TextBlock Classes="secondary"
                                   Text="{Binding UpgradeBannerHint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <arcm:Button Name="UpgradeSignInButton"
                                 Grid.Column="1"
                                 Variant="Filled"
                                 VerticalAlignment="Center"
                                 Content="{l:MobileLangResource SignInStart}"
                                 Command="{Binding SignInCommand}" />
                </Grid>
            </Border>

            <!-- Cross-host sessions waiting for approval or failed -->
            <arcm:ListGroup Name="AttentionGroup"
                            Header="{l:MobileLangResource ActivityWaitingHeader}"
                            ItemsSource="{Binding AttentionSessions}"
                            ItemTemplate="{StaticResource ActivitySessionRow}"
                            IsVisible="{Binding HasAttention}" />

            <!-- Cross-host actively working sessions -->
            <arcm:ListGroup Name="WorkingGroup"
                            Header="{l:MobileLangResource ActivityWorkingHeader}"
                            ItemsSource="{Binding WorkingSessions}"
                            ItemTemplate="{StaticResource ActivitySessionRow}"
                            IsVisible="{Binding HasWorking}" />

            <!-- Calm all-clear card when hosts exist but nothing needs attention -->
            <Border Name="AllClearCard"
                    Classes="surfaceCard"
                    Margin="16,0"
                    IsVisible="{Binding IsActivityAllClear}">
                <StackPanel Spacing="4">
                    <TextBlock Text="{l:MobileLangResource ActivityAllClearTitle}"
                               FontSize="{arc:ArcDesignTokenResource TypeLG}"
                               FontWeight="SemiBold" />
                    <TextBlock Classes="secondary"
                               Text="{l:MobileLangResource ActivityAllClearHint}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Quick access to online computers right below the inbox -->
            <arcm:ListGroup Name="QuickHostsGroup"
                            Header="{l:MobileLangResource ActivityQuickHostsHeader}"
                            ItemsSource="{Binding Online}"
                            ItemTemplate="{StaticResource HostRow}"
                            IsVisible="{Binding HasOnline}" />

            <!-- Empty state when no hosts exist yet -->
            <StackPanel Name="ActivityEmpty" Margin="32,32,32,0" Spacing="16" IsVisible="{Binding IsEmpty}">
                <TextBlock Classes="muted"
                           Text="{Binding EmptyText}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <arcm:Button Name="ActivityAddHostButton"
                             Variant="Tinted"
                             HorizontalAlignment="Center"
                             Content="{l:MobileLangResource AddHost}"
                             Command="{Binding AddHostCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- ==================== Tab 1: Bots (Scheme A: 跨电脑折叠会话卡) ==================== -->
        <Panel IsVisible="{Binding IsBotsTab}">
        <StackPanel Name="BotsTabContent" Spacing="12" DataContext="{Binding Bots}" x:DataType="bots:BotsTabViewModel">
            <!-- Inline error banner -->
            <Border Margin="16,0" Padding="12,8" CornerRadius="10"
                    Background="{arc:ArcDesignTokenResource DangerSubtle}"
                    IsVisible="{Binding HasError}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{arc:ArcDesignTokenResource Danger}"
                           TextWrapping="Wrap"
                           FontSize="{arc:ArcDesignTokenResource TypeSM}" />
            </Border>

            <!-- Search + filter chips when bots or groups exist -->
            <StackPanel Spacing="8" IsVisible="{Binding HasAnyBotsOrGroups}">
                <arcm:TextField Name="BotsSearchField"
                                Classes="hostSearch"
                                Margin="16,0"
                                Text="{Binding SearchQuery, Mode=TwoWay}"
                                PlaceholderText="{l:MobileLangResource BotsSearchPlaceholder}" />

                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="16,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Name="BotsFilterAllChip" Classes="chipBtn" Classes.active="{Binding IsFilterAll}"
                                Command="{Binding SelectFilterAllCommand}">
                            <TextBlock Text="{Binding FilterAllText}" />
                        </Button>
                        <Button Name="BotsFilterNeedsChip" Classes="chipBtn attention" Classes.active="{Binding IsFilterNeeds}"
                                Command="{Binding SelectFilterNeedsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border Classes="statusDot warning" />
                                <TextBlock Text="{Binding FilterNeedsText}" />
                            </StackPanel>
                        </Button>
                        <Button Name="BotsFilterWorkingChip" Classes="chipBtn" Classes.active="{Binding IsFilterWorking}"
                                Command="{Binding SelectFilterWorkingCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Border Classes="statusDot accent" />
                                <TextBlock Text="{Binding FilterWorkingText}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>

            <!-- Bot Groups section above single Bots -->
            <StackPanel Name="BotGroupsSection" Spacing="8" IsVisible="{Binding HasAnyBotsOrGroups}">
                <Grid ColumnDefinitions="*,Auto" Margin="18,0">
                    <TextBlock Classes="sectionHeader"
                               Text="{l:MobileLangResource BotGroupsSectionHeader}"
                               VerticalAlignment="Center" />
                    <Button Name="BotsNewGroupInlineButton"
                            Grid.Column="1"
                            Classes="inlineLinkBtn"
                            Command="{Binding OpenNewGroupCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Plus}" Size="12"
                                          Foreground="{arc:ArcDesignTokenResource Accent}"
                                          VerticalAlignment="Center" />
                            <TextBlock Text="{l:MobileLangResource BotGroupsNewButton}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <ItemsControl Name="BotGroupsList" ItemsSource="{Binding VisibleGroups}" IsVisible="{Binding HasVisibleGroups}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="bots:BotGroupCardViewModel">
                            <Border Classes="projectCard"
                                    Classes.attention="{Binding HasAttention}"
                                    Margin="16,0">
                                <Button Classes="cardHeaderBtn" Command="{Binding OpenCommand}" Padding="12,11">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="11">
                                        <!-- Avatar cluster -->
                                        <ItemsControl Grid.Column="0" ItemsSource="{Binding MemberAvatars}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="-6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="bots:BotGroupAvatarViewModel">
                                                    <Border Classes="groupAvatarPip" Background="{Binding Background}">
                                                        <TextBlock Text="{Binding Initial}" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Classes="projectCardTitle" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <Border Classes="branchTag" IsVisible="{Binding HasOverflow}">
                                                        <TextBlock Text="{Binding OverflowText}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1"
                                                           Classes="muted"
                                                           Text="{Binding LatestTimeText}"
                                                           IsVisible="{Binding HasLatestTime}"
                                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Classes="projectCardPath" Text="{Binding MemberCountText}" />
                                            <TextBlock Classes="secondary"
                                                       Text="{Binding LatestPreview}"
                                                       IsVisible="{Binding HasLatestPreview}"
                                                       MaxLines="1"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Classes="pill compact waiting" IsVisible="{Binding HasPendingApprovals}">
                                                <TextBlock Text="{Binding ApprovalBadgeText}" />
                                            </Border>
                                            <Border Classes="pill compact working" IsVisible="{Binding StatusIsWorking}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <arc:ArcSpinner />
                                                    <TextBlock Text="{l:MobileLangResource BotsStatusWorking}" />
                                                </StackPanel>
                                            </Border>
                                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronRight}" Size="15"
                                                          Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                          VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Single Bots section header when groups are also shown -->
            <TextBlock Classes="sectionHeader"
                       Margin="18,4,18,-4"
                       Text="{l:MobileLangResource BotGroupsSingleBotsHeader}"
                       IsVisible="{Binding ShowSingleBotsHeader}" />

            <!-- Expandable Bot cards with inline 1-tap approvals & embedded active sessions -->
            <ItemsControl Name="BotAccordionList" ItemsSource="{Binding VisibleBots}" IsVisible="{Binding HasVisibleBots}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="bots:BotAccordionCardViewModel">
                        <Border Classes="projectCard"
                                Classes.attention="{Binding HasAttention}"
                                Margin="16,0">
                            <StackPanel>
                                <!-- Card header: avatar + name/host/active count + status pill + quick "+" + chevron -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                    <Button Grid.Column="0" Classes="cardHeaderBtn" Command="{Binding ToggleExpandedCommand}">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                                            <Panel Grid.Column="0" Width="38" Height="38" VerticalAlignment="Center">
                                                <Border Width="38" Height="38" CornerRadius="10" Background="{Binding AvatarBrush}">
                                                    <TextBlock Text="{Binding Initial}" Foreground="White" FontSize="15" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border Classes="cornerBadge waiting" IsVisible="{Binding HasCornerBadge}">
                                                    <TextBlock Text="{Binding CornerBadgeText}" />
                                                </Border>
                                            </Panel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Classes="projectCardTitle" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Classes="projectCardPath" Text="{Binding SubtitleText}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <Border Classes="pill compact"
                                                Classes.waiting="{Binding StatusIsWaiting}"
                                                Classes.working="{Binding StatusIsWorking}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <arc:ArcSpinner IsVisible="{Binding StatusIsWorking}" />
                                                <TextBlock Text="{Binding StatusPillText}" />
                                            </StackPanel>
                                        </Border>
                                        <Button Classes="projectPlusBtn" Command="{Binding NewChatCommand}"
                                                AutomationProperties.Name="{l:MobileLangResource BotsNewChatShort}">
                                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Plus}" Size="14"
                                                          Foreground="{arc:ArcDesignTokenResource Accent}"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        <Button Classes="projectChevronBtn" Command="{Binding ToggleExpandedCommand}">
                                            <Panel>
                                                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronRight}" Size="15"
                                                              Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                              IsVisible="{Binding !IsExpanded}" />
                                                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronDown}" Size="15"
                                                              Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                              IsVisible="{Binding IsExpanded}" />
                                            </Panel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Collapsible body: inline 1-tap approval items + active chats + card footer -->
                                <StackPanel IsVisible="{Binding IsExpanded}">
                                    <ItemsControl ItemsSource="{Binding PendingWorkItems}" IsVisible="{Binding HasPendingWorkItems}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="bots:BotWorkItemRowViewModel">
                                                <Border Classes="botTodoStrip">
                                                    <StackPanel Spacing="7">
                                                        <TextBlock Classes="sessionTitle" Text="{Binding Question}" TextWrapping="Wrap" />
                                                        <ItemsControl ItemsSource="{Binding Options}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="bots:BotWorkItemOptionViewModel">
                                                                    <Button Classes="botOptionBtn" Command="{Binding ChooseCommand}">
                                                                        <TextBlock Text="{Binding Label}" />
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Embedded active chats (Home Chat + parallel sub-chats) -->
                                    <Border Classes="projectSessionList" IsVisible="{Binding HasActiveChats}">
                                        <ItemsControl ItemsSource="{Binding ActiveChats}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="bots:BotChatItemViewModel">
                                                    <arcm:ListItem Classes="cardSessionRow" ShowChevron="True" Command="{Binding OpenCommand}">
                                                        <arcm:ListItem.Trailing>
                                                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                <Border Classes="pill compact"
                                                                        Classes.waiting="{Binding IsWaiting}"
                                                                        Classes.working="{Binding IsWorking}"
                                                                        IsVisible="{Binding HasStatus}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                                        <arc:ArcSpinner IsVisible="{Binding IsWorking}" />
                                                                        <TextBlock Text="{Binding StatusText}" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <TextBlock Classes="muted" Text="{Binding TimeText}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </arcm:ListItem.Trailing>
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,3">
                                                            <Border Grid.Column="0" Classes="badge" Background="{Binding AgentTint}">
                                                                <TextBlock Text="{Binding AgentInitial}" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <TextBlock Classes="sessionTitle" Text="{Binding Title}" VerticalAlignment="Center" />
                                                                    <Border Classes="guiTag" IsVisible="{Binding IsHome}">
                                                                        <TextBlock Text="{l:MobileLangResource BotsHomeChatTag}" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Classes="secondary" Text="{Binding Subtitle}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </arcm:ListItem>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>

                                    <!-- Footer quick actions: All Sessions / Connectors / Settings / + New chat -->
                                    <Border Classes="projectCardFooter">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6">
                                                <Button Classes="projectFooterBtn" Command="{Binding OpenSessionsCommand}">
                                                    <TextBlock Text="{Binding AllSessionsButtonText}" />
                                                </Button>
                                                <Button Classes="projectFooterBtn" Command="{Binding OpenConnectorsCommand}">
                                                    <TextBlock Text="{Binding ConnectorsButtonText}" />
                                                </Button>
                                                <Button Classes="projectFooterBtn" Command="{Binding OpenSettingsCommand}">
                                                    <TextBlock Text="{l:MobileLangResource BotsSettingsShort}" />
                                                </Button>
                                            </StackPanel>
                                            <Button Grid.Column="1" Classes="projectFooterBtn primary" Command="{Binding NewChatCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Plus}" Size="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="{l:MobileLangResource BotsNewChatShort}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Empty state when 0 Bots exist -->
            <Border Name="BotsEmptyCard" Classes="surfaceCard" Margin="16,12" IsVisible="{Binding IsEmpty}">
                <StackPanel Spacing="12" HorizontalAlignment="Stretch">
                    <TextBlock Classes="detailTitle" Text="{l:MobileLangResource BotsEmptyTitle}" HorizontalAlignment="Center" />
                    <TextBlock Classes="secondary" Text="{l:MobileLangResource BotsEmptyHint}" TextWrapping="Wrap" TextAlignment="Center" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <arcm:Button Grid.Column="0" Variant="Filled" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                     Content="{l:MobileLangResource BotsNewButton}" Command="{Binding OpenNewBotCommand}" />
                        <arcm:Button Grid.Column="1" Variant="Tinted" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                     Content="{l:MobileLangResource BotsImportButton}" Command="{Binding OpenImportBotCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Filtered empty -->
            <Border Classes="emptyCard" Margin="16,0" IsVisible="{Binding IsFilteredEmpty}">
                <TextBlock Classes="muted" Text="{l:MobileLangResource BotsSessionsEmpty}" TextAlignment="Center" />
            </Border>
        </StackPanel>
        </Panel>

        <!-- ==================== Tab 2: Computers (电脑分组) ==================== -->
        <StackPanel Name="HostsTabContent" Spacing="18" IsVisible="{Binding IsHostsTab}">
            <arcm:ListGroup Name="OnlineGroup"
                            Header="{l:MobileLangResource HostsOnline}"
                            ItemsSource="{Binding Online}"
                            ItemTemplate="{StaticResource HostRow}"
                            IsVisible="{Binding HasOnline}" />
            <arcm:ListGroup Name="UnpairedGroup"
                            Header="{l:MobileLangResource HostsNotPaired}"
                            ItemsSource="{Binding Unpaired}"
                            ItemTemplate="{StaticResource HostRow}"
                            IsVisible="{Binding HasUnpaired}" />
            <arcm:ListGroup Name="OfflineGroup"
                            Header="{l:MobileLangResource HostsOffline}"
                            ItemsSource="{Binding Offline}"
                            ItemTemplate="{StaticResource HostRow}"
                            IsVisible="{Binding HasOffline}" />
            <!-- The account's phones (this one too): folded, for information only. -->
            <StackPanel Name="OtherDevicesSection" Spacing="0" IsVisible="{Binding HasOtherDevices}">
                <arcm:ListGroup Name="OtherDevicesGroup">
                    <arcm:ListItem Name="OtherDevicesToggle"
                                   Icon="{x:Static arc:ArcIcons.Smartphone}"
                                   Content="{Binding OtherDevicesTitle}"
                                   Command="{Binding ToggleOtherDevicesCommand}">
                        <arcm:ListItem.Trailing>
                            <Panel VerticalAlignment="Center">
                                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronRight}" Size="16"
                                              Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                              IsVisible="{Binding !IsOtherDevicesOpen}" />
                                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronDown}" Size="16"
                                              Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                              IsVisible="{Binding IsOtherDevicesOpen}" />
                            </Panel>
                        </arcm:ListItem.Trailing>
                    </arcm:ListItem>
                </arcm:ListGroup>
                <arcm:ListGroup Name="OtherDevicesList"
                                Margin="0,8,0,0"
                                Footer="{l:MobileLangResource OtherDevicesHint}"
                                ItemsSource="{Binding OtherDevices}"
                                ItemTemplate="{StaticResource DeviceRow}"
                                IsVisible="{Binding IsOtherDevicesOpen}" />
            </StackPanel>
            <arcm:ListGroup Name="AddGroup" IsVisible="{Binding HasHosts}">
                <arcm:ListItem Name="AddHostRow"
                               Icon="{x:Static arc:ArcIcons.Plus}"
                               Content="{l:MobileLangResource AddHost}"
                               ShowChevron="True"
                               Command="{Binding AddHostCommand}" />
            </arcm:ListGroup>
            <StackPanel Name="Empty" Margin="32,32,32,0" Spacing="18" IsVisible="{Binding IsEmpty}">
                <TextBlock Name="EmptyText"
                           Classes="muted"
                           Text="{Binding EmptyText}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <arcm:Button Name="AddHostButton"
                             Variant="Tinted"
                             HorizontalAlignment="Center"
                             Content="{l:MobileLangResource AddHost}"
                             Command="{Binding AddHostCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- ==================== Tab 2: Me (我的 / 账号中心) ==================== -->
        <StackPanel Name="AccountTabContent" Spacing="18" IsVisible="{Binding IsAccountTab}">
            <!-- Signed-in identity card -->
            <Border Name="ProfileCard"
                    Classes="surfaceCard"
                    Margin="16,4,16,0"
                    IsVisible="{Binding IsSignedIn}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Classes="avatarCircle">
                        <TextBlock Text="{Binding AccountInitial}" FontSize="18" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Name="ProfileAccountName"
                                   Text="{Binding AccountName}"
                                   FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="secondary"
                                   Text="{Binding AccountHostSummary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="pill success">
                        <TextBlock Text="{l:MobileLangResource MeStatusOnline}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Signed-out / local-only sign-in invitation card -->
            <Border Name="MeSignInCard"
                    Classes="surfaceCard"
                    Margin="16,4,16,0"
                    IsVisible="{Binding IsSignedOut}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{l:MobileLangResource MeSignInCardTitle}"
                                   FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                   FontWeight="SemiBold" />
                        <TextBlock Classes="secondary"
                                   Text="{l:MobileLangResource MeSignInCardHint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <arcm:Button Name="MeSignInButton"
                                 Variant="Filled"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Center"
                                 Content="{Binding SignInButtonText}"
                                 Command="{Binding SignInCommand}" />
                </StackPanel>
            </Border>

            <!-- Account & connection actions -->
            <arcm:ListGroup Name="MeConnectionGroup" Header="{l:MobileLangResource MeSectionAccount}">
                <arcm:ListItem Name="MeManageWebRow"
                               Icon="{x:Static arc:ArcIcons.ExternalLink}"
                               Content="{l:MobileLangResource MeManageWeb}"
                               Subtitle="{Binding ServerHostDisplay}"
                               ShowChevron="True"
                               Command="{Binding OpenAccountWebCommand}"
                               IsVisible="{Binding HasAccountWeb}" />
                <arcm:ListItem Name="MeCustomServerRow"
                               Icon="{x:Static arc:ArcIcons.Server}"
                               Content="{l:MobileLangResource MeSwitchCustom}"
                               Subtitle="{l:MobileLangResource MeSwitchCustomHint}"
                               ShowChevron="True"
                               Command="{Binding OpenCustomServerCommand}" />
                <arcm:ListItem Name="MeAddHostRow"
                               Icon="{x:Static arc:ArcIcons.Plus}"
                               Content="{l:MobileLangResource AddHost}"
                               Subtitle="{l:MobileLangResource UseLocalHint}"
                               ShowChevron="True"
                               Command="{Binding AddHostCommand}" />
            </arcm:ListGroup>

            <!-- Input: voice input, where the phone can recognize or record speech -->
            <arcm:ListGroup Name="MeInputGroup" Header="{l:MobileLangResource MeSectionInput}" IsVisible="{Binding IsVoiceSupported}">
                <arcm:ListItem Name="MeVoiceRow"
                               Icon="{x:Static voice:VoiceGlyphs.Microphone}"
                               Content="{l:MobileLangResource MeVoiceInput}"
                               Subtitle="{Binding VoiceEngineName}"
                               ShowChevron="True"
                               Command="{Binding OpenVoiceSettingsCommand}" />
            </arcm:ListGroup>

            <!-- App version and updates (Android only: a platform without an updater shows no group) -->
            <StackPanel Spacing="10" IsVisible="{Binding Updater.IsSupported}">
                <arcm:ListGroup Name="MeAboutGroup"
                                Header="{l:MobileLangResource MeSectionAbout}"
                                IsVisible="{Binding Updater.IsSupported}">
                    <arcm:ListItem Name="MeUpdateRow"
                                   Icon="{x:Static arc:ArcIcons.RefreshCw}"
                                   Content="{l:MobileLangResource UpdateRowTitle}"
                                   Subtitle="{Binding Updater.StatusText}"
                                   ShowChevron="{Binding !Updater.IsBusy}"
                                   Command="{Binding Updater.ActCommand}">
                        <arcm:ListItem.Trailing>
                            <Panel>
                                <arc:ArcSpinner IsVisible="{Binding Updater.IsBusy}" VerticalAlignment="Center" />
                                <Border Classes="pill action" IsVisible="{Binding !!Updater.ActionText}">
                                    <TextBlock Text="{Binding Updater.ActionText}" />
                                </Border>
                            </Panel>
                        </arcm:ListItem.Trailing>
                    </arcm:ListItem>
                    <arcm:ListItem Name="MeUpdateNotesRow"
                                   Icon="{x:Static arc:ArcIcons.FileText}"
                                   Content="{l:MobileLangResource UpdateNotes}"
                                   Subtitle="{Binding Updater.OfferedMetaText}"
                                   ShowChevron="True"
                                   Command="{Binding Updater.OpenNotesCommand}"
                                   IsVisible="{Binding Updater.HasNews}" />
                </arcm:ListGroup>

                <!-- Live download progress & cancel card inside Me tab while downloading -->
                <Border Name="MeUpdateProgressCard"
                        Classes="surfaceCard"
                        Padding="14,12"
                        Margin="16,0"
                        IsVisible="{Binding Updater.IsDownloading}">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Classes="secondary"
                                       Text="{Binding Updater.ProgressDetailText}"
                                       VerticalAlignment="Center" />
                            <Button Name="MeCancelDownloadButton"
                                    Classes="inlineLinkBtn"
                                    Foreground="{arc:ArcDesignTokenResource Danger}"
                                    Content="{l:MobileLangResource Cancel}"
                                    Command="{Binding Updater.CancelDownloadCommand}" />
                        </Grid>
                        <ProgressBar Classes="updateProgress"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="{Binding Updater.ProgressPercent}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Sign out / Leave local-only mode -->
            <Panel Margin="16,0">
                <arcm:Button Name="MeSignOutButton"
                             Variant="Tinted"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Center"
                             Foreground="{arc:ArcDesignTokenResource Danger}"
                             Content="{l:MobileLangResource SignOut}"
                             Command="{Binding SignOutCommand}"
                             IsVisible="{Binding IsSignedIn}" />
                <arcm:Button Name="MeLeaveLocalButton"
                             Variant="Tinted"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Center"
                             Foreground="{arc:ArcDesignTokenResource Danger}"
                             Content="{l:MobileLangResource LeaveLocal}"
                             Command="{Binding LeaveLocalCommand}"
                             IsVisible="{Binding IsSignedOut}" />
            </Panel>
        </StackPanel>
        </Panel>
    </StackPanel>

    <!-- Scheme A bottom 4-tab navigation bar (Activity | Bots | Computers | Me) -->
    <arcm:Page.Footer>
        <arcm:Tabbar Name="MainTabbar" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
            <arcm:TabbarItem Name="ActivityTab"
                             Icon="{x:Static arc:ArcIcons.Sparkles}"
                             Content="{Binding ActivityTabLabel}" />
            <arcm:TabbarItem Name="BotsTab"
                             Icon="{x:Static arc:ArcIcons.MessageSquare}"
                             Content="{Binding BotsTabLabel}" />
            <arcm:TabbarItem Name="HostsTab"
                             Icon="{x:Static arc:ArcIcons.Monitor}"
                             Content="{l:MobileLangResource TabHosts}" />
            <arcm:TabbarItem Name="AccountTab"
                             Icon="{x:Static arc:ArcIcons.User}"
                             Content="{Binding MeTabLabel}" />
        </arcm:Tabbar>
    </arcm:Page.Footer>

    <arcm:Page.Overlay>
        <Panel>
            <arcm:ActionSheet Name="AccountSheet"
                              IsOpen="{Binding IsAccountOpen, Mode=TwoWay}"
                              Title="{Binding AccountName}"
                              CancelText="{l:MobileLangResource Cancel}">
                <arcm:ActionSheetItem Content="{l:MobileLangResource SignOut}"
                                      IsDestructive="True"
                                      Command="{Binding SignOutCommand}" />
            </arcm:ActionSheet>
            <arcm:ActionSheet Name="LocalSheet"
                              IsOpen="{Binding IsLocalOpen, Mode=TwoWay}"
                              Title="{Binding AccountName}"
                              CancelText="{l:MobileLangResource Cancel}">
                <arcm:ActionSheetItem Content="{l:MobileLangResource SignInStart}"
                                      Command="{Binding SignInCommand}" />
                <arcm:ActionSheetItem Content="{l:MobileLangResource LeaveLocal}"
                                      IsDestructive="True"
                                      Command="{Binding LeaveLocalCommand}" />
            </arcm:ActionSheet>

            <!-- New Bot Group Sheet -->
            <arcm:Sheet Name="NewBotGroupSheet"
                        DataContext="{Binding Bots}"
                        x:DataType="bots:BotsTabViewModel"
                        IsOpen="{Binding IsNewGroupOpen, Mode=TwoWay}"
                        MaxHeightFraction="0.88"
                        Title="{l:MobileLangResource BotGroupsNewTitle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,4,16,24" Spacing="12">
                        <TextBlock Classes="secondary" IsVisible="{Binding HasNoOnlineHosts}"
                                   Text="{l:MobileLangResource BotsNoOnlineHostHint}" TextWrapping="Wrap" />

                        <StackPanel Spacing="6" IsVisible="{Binding HasOnlineHosts}">
                            <TextBlock Classes="fieldLabel" Text="{l:MobileLangResource BotsNewBotHostLabel}" />
                            <arcm:Segmented ItemsSource="{Binding OnlineHostNames}"
                                            SelectedIndex="{Binding SelectedGroupHostIndex, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBlock Classes="fieldLabel" Text="{l:MobileLangResource BotGroupsNewNameLabel}" />
                        <arcm:TextField Text="{Binding NewGroupName, Mode=TwoWay}"
                                        PlaceholderText="{l:MobileLangResource BotGroupsNewNamePlaceholder}" />

                        <TextBlock Classes="fieldLabel" Text="{l:MobileLangResource BotGroupsNewMembersLabel}" />
                        <arcm:ListGroup ItemsSource="{Binding NewGroupMemberChoices}"
                                        IsVisible="{Binding HasNewGroupMemberChoices}">
                            <arcm:ListGroup.ItemTemplate>
                                <DataTemplate x:DataType="bots:BotGroupMemberToggleViewModel">
                                    <arcm:ListItem>
                                        <arcm:ListItem.Trailing>
                                            <arcm:Switch IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                        </arcm:ListItem.Trailing>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,3">
                                            <Border Grid.Column="0" Classes="badge" Background="{Binding AvatarBrush}">
                                                <TextBlock Text="{Binding Initial}" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Classes="sessionTitle" Text="{Binding BotName}" />
                                                <TextBlock Classes="secondary" Text="{Binding AgentLabel}" />
                                            </StackPanel>
                                        </Grid>
                                    </arcm:ListItem>
                                </DataTemplate>
                            </arcm:ListGroup.ItemTemplate>
                        </arcm:ListGroup>
                        <Border Classes="emptyCard" IsVisible="{Binding HasNoNewGroupMemberChoices}">
                            <TextBlock Classes="muted" Text="{l:MobileLangResource BotGroupsNewMembersEmpty}" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Classes="fieldLabel" Text="{l:MobileLangResource BotGroupsNewReplyModeLabel}" />
                        <arcm:Segmented ItemsSource="{Binding GroupReplyModeLabels}"
                                        SelectedIndex="{Binding SelectedGroupReplyModeIndex, Mode=TwoWay}" />

                        <TextBlock Text="{Binding ErrorMessage}"
                                   Foreground="{arc:ArcDesignTokenResource Danger}"
                                   IsVisible="{Binding HasError}"
                                   TextWrapping="Wrap"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}" />

                        <arcm:Button Variant="Filled"
                                     HorizontalAlignment="Stretch"
                                     HorizontalContentAlignment="Center"
                                     Content="{l:MobileLangResource BotGroupsNewCreate}"
                                     Command="{Binding ConfirmCreateGroupCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </arcm:Sheet>

            <!-- New Bot Sheet -->
            <arcm:Sheet Name="NewBotSheet"
                        DataContext="{Binding Bots}"
                        x:DataType="bots:BotsTabViewModel"
                        IsOpen="{Binding IsNewBotOpen, Mode=TwoWay}"
                        MaxHeightFraction="0.88"
                        Title="{l:MobileLangResource BotsNewBotTitle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16,4,16,24" Spacing="12">
                        <TextBlock Classes="secondary" IsVisible="{Binding HasNoOnlineHosts}"
                                   Text="{l:MobileLangResource BotsNoOnlineHostHint}" TextWrapping="Wrap" />

                        <TextBlock Classes="fieldLabel" Text="{l:MobileLangResource BotsNewBotNameLabel}" />
                        <arcm:TextField Text="{Binding NewBotName, Mode=TwoWay}"
                                        PlaceholderText="{l:MobileLangResource BotsNewBotNamePlaceholder}" />

                        <StackPanel Spacing="6" IsVisible="{Binding HasOnlineHosts}">
                            <TextBlock Classes="fieldLabel" Text="{l:MobileLangResource BotsNewBotHostLabel}" />
                            <arcm:Segmented ItemsSource="{Binding OnlineHostNames}"
                                            SelectedIndex="{Binding SelectedHostIndex, Mode=TwoWay}" />
                        </StackPanel>

                        <TextBlock Classes="fieldLabel" Text="{l:MobileLangResource BotsNewBotAgentLabel}" />
                        <arcm:Segmented ItemsSource="{Binding AvailableAgentNames}"
                                        SelectedIndex="{Binding SelectedAgentIndex, Mode=TwoWay}" />

                        <TextBlock Classes="fieldLabel" Text="{l:MobileLangResource BotsNewBotTemplateLabel}" />
                        <arcm:Segmented ItemsSource="{Binding TemplateLabels}"
                                        SelectedIndex="{Binding SelectedTemplateIndex, Mode=TwoWay}" />

                        <TextBlock Classes="fieldLabel" Text="{l:MobileLangResource BotsNewBotSoulLabel}" />
                        <arcm:TextField Text="{Binding NewBotSoul, Mode=TwoWay}"
                                        PlaceholderText="{l:MobileLangResource BotsNewBotSoulPlaceholder}" />

                        <arcm:Button Variant="Filled"
                                     HorizontalAlignment="Stretch"
                                     HorizontalContentAlignment="Center"
                                     Content="{l:MobileLangResource BotsNewBotCreate}"
                                     Command="{Binding ConfirmCreateBotCommand}" />
                    </StackPanel>
                </ScrollViewer>
            </arcm:Sheet>

            <!-- Import Bot from octopus://bot/import Link Sheet -->
            <arcm:Sheet Name="ImportBotSheet"
                        DataContext="{Binding Bots}"
                        x:DataType="bots:BotsTabViewModel"
                        IsOpen="{Binding IsImportOpen, Mode=TwoWay}"
                        Title="{l:MobileLangResource BotsImportTitle}">
                <StackPanel Margin="16,4,16,24" Spacing="12">
                    <StackPanel Spacing="6" IsVisible="{Binding HasOnlineHosts}">
                        <TextBlock Classes="fieldLabel" Text="{l:MobileLangResource BotsNewBotHostLabel}" />
                        <arcm:Segmented ItemsSource="{Binding OnlineHostNames}"
                                        SelectedIndex="{Binding SelectedHostIndex, Mode=TwoWay}" />
                    </StackPanel>

                    <TextBlock Classes="fieldLabel" Text="{l:MobileLangResource BotsImportLinkLabel}" />
                    <arcm:TextField Text="{Binding ImportLink, Mode=TwoWay}"
                                    PlaceholderText="{l:MobileLangResource BotsImportLinkPlaceholder}" />

                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{arc:ArcDesignTokenResource Danger}"
                               IsVisible="{Binding HasError}"
                               TextWrapping="Wrap"
                               FontSize="{arc:ArcDesignTokenResource TypeSM}" />

                    <arcm:Button Variant="Filled"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Center"
                                 Content="{l:MobileLangResource BotsImportConfirm}"
                                 Command="{Binding ConfirmImportBotCommand}" />
                </StackPanel>
            </arcm:Sheet>

            <!-- Quick New Bot Chat Sheet -->
            <arcm:Sheet Name="QuickNewBotChatSheet"
                        DataContext="{Binding Bots}"
                        x:DataType="bots:BotsTabViewModel"
                        IsOpen="{Binding IsNewChatOpen, Mode=TwoWay}"
                        Title="{Binding QuickChatSheetTitle}">
                <StackPanel Margin="16,4,16,24" Spacing="12">
                    <TextBlock Classes="fieldLabel" Text="{l:MobileLangResource BotsNewChatAgentLabel}" />
                    <arcm:Segmented ItemsSource="{Binding QuickChatAgentNames}"
                                    SelectedIndex="{Binding SelectedQuickChatAgentIndex, Mode=TwoWay}" />

                    <TextBlock Classes="fieldLabel" Text="{l:MobileLangResource BotsNewChatTitleLabel}" />
                    <arcm:TextField Text="{Binding QuickChatTitle, Mode=TwoWay}"
                                    PlaceholderText="{l:MobileLangResource BotsNewChatTitlePlaceholder}" />

                    <arcm:Button Variant="Filled"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Center"
                                 Content="{l:MobileLangResource BotsNewChatStart}"
                                 Command="{Binding ConfirmQuickNewChatCommand}" />
                </StackPanel>
            </arcm:Sheet>

            <!-- In-app Markdown release-notes modal sheet -->
            <arcm:Sheet Name="UpdateNotesSheet"
                        IsOpen="{Binding Updater.IsNotesOpen, Mode=TwoWay}"
                        MaxHeightFraction="0.86"
                        Title="{Binding Updater.NotesModalTitle}">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Version transition + release metadata + browser fallback link -->
                    <Border Grid.Row="0"
                            Margin="16,2,16,10"
                            Padding="12,10"
                            CornerRadius="12"
                            Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Name="NotesVersionTransition"
                                           Text="{Binding Updater.VersionTransitionText}"
                                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                           FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Name="NotesMetaText"
                                           Classes="secondary"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Text="{Binding Updater.OfferedMetaText}"
                                           IsVisible="{Binding !!Updater.OfferedMetaText}" />
                            </StackPanel>
                            <Button Name="NotesOpenBrowserButton"
                                    Grid.Column="1"
                                    Classes="inlineLinkBtn"
                                    Command="{Binding Updater.OpenNotesInBrowserCommand}"
                                    IsVisible="{Binding Updater.HasNotesUrl}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="{l:MobileLangResource UpdateOpenInBrowser}" />
                                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ExternalLink}" Size="12"
                                                  Foreground="{arc:ArcDesignTokenResource Accent}"
                                                  VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Scrollable Markdown content -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,2,16,16" Spacing="10">
                            <common:MobileMarkdownView Name="UpdateNotesMarkdown"
                                                       Markdown="{Binding Updater.OfferedNotes}"
                                                       LinkCommand="{Binding Updater.OpenLinkCommand}"
                                                       IsVisible="{Binding Updater.HasOfferedNotes}" />
                            <Border Name="UpdateNotesEmptyCard"
                                    Classes="emptyCard"
                                    IsVisible="{Binding !Updater.HasOfferedNotes}">
                                <TextBlock Classes="secondary"
                                           Text="{l:MobileLangResource UpdateNotesEmpty}"
                                           TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Sticky footer with live progress or primary update/install action -->
                    <Border Grid.Row="2" Classes="sheetFooter">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="6" IsVisible="{Binding Updater.IsDownloading}">
                                <TextBlock Classes="secondary"
                                           Text="{Binding Updater.ProgressDetailText}" />
                                <ProgressBar Classes="updateProgress"
                                             Minimum="0"
                                             Maximum="100"
                                             Value="{Binding Updater.ProgressPercent}" />
                            </StackPanel>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding Updater.IsDownloading}">
                                <arcm:Button Name="NotesLaterWhileDownloadingButton"
                                             Grid.Column="0"
                                             Variant="Tinted"
                                             HorizontalAlignment="Stretch"
                                             HorizontalContentAlignment="Center"
                                             Content="{l:MobileLangResource UpdateLater}"
                                             Command="{Binding Updater.CloseNotesCommand}" />
                                <arcm:Button Name="NotesCancelDownloadButton"
                                             Grid.Column="1"
                                             Variant="Tinted"
                                             HorizontalAlignment="Stretch"
                                             HorizontalContentAlignment="Center"
                                             Foreground="{arc:ArcDesignTokenResource Danger}"
                                             Content="{l:MobileLangResource Cancel}"
                                             Command="{Binding Updater.CancelDownloadCommand}" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" IsVisible="{Binding Updater.HasPrimaryModalAction}">
                                <arcm:Button Name="NotesLaterButton"
                                             Grid.Column="0"
                                             Variant="Tinted"
                                             HorizontalAlignment="Stretch"
                                             HorizontalContentAlignment="Center"
                                             Content="{l:MobileLangResource UpdateLater}"
                                             Command="{Binding Updater.CloseNotesCommand}" />
                                <arcm:Button Name="NotesPrimaryActionButton"
                                             Grid.Column="1"
                                             Variant="Filled"
                                             HorizontalAlignment="Stretch"
                                             HorizontalContentAlignment="Center"
                                             Content="{Binding Updater.PrimaryModalActionText}"
                                             Command="{Binding Updater.ActCommand}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </arcm:Sheet>
        </Panel>
    </arcm:Page.Overlay>
</arcm:Page>
