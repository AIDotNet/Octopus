<arcm:Page xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
           xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
           xmlns:l="using:Octopus.Mobile.Localization"
           xmlns:vm="using:Octopus.Mobile.Hosts"
           x:Class="Octopus.Mobile.Hosts.HostsPage"
           x:DataType="vm:HostsViewModel"
           IsScrollable="True">
    <arcm:Page.Resources>
        <!-- One computer row: how it is reached, and a pill with what needs the person there (a lock: its access
             password gets in). Offline it is faded and does nothing. -->
        <DataTemplate x:Key="HostRow" x:DataType="vm:HostRowViewModel">
            <arcm:ListItem Icon="{x:Static arc:ArcIcons.Monitor}"
                           Classes.dimmed="{Binding IsDimmed}"
                           Content="{Binding Name}"
                           Subtitle="{Binding Summary}"
                           ShowChevron="{Binding ShowChevron}"
                           Command="{Binding OpenCommand}">
                <arcm:ListItem.Trailing>
                    <Panel>
                        <Border Classes="pill"
                                Classes.waiting="{Binding IsWaiting}"
                                Classes.error="{Binding IsError}"
                                Classes.working="{Binding IsWorking}"
                                Classes.action="{Binding IsPairAction}"
                                IsVisible="{Binding HasPill}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <arc:ArcSpinner IsVisible="{Binding IsWorking}" />
                                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Lock}" Size="11" IsVisible="{Binding IsPasswordAction}" />
                                <TextBlock Text="{Binding PillText}" />
                            </StackPanel>
                        </Border>
                        <TextBlock Classes="muted" Text="{l:MobileLangResource Idle}" IsVisible="{Binding IsIdle}" VerticalAlignment="Center" />
                    </Panel>
                </arcm:ListItem.Trailing>
            </arcm:ListItem>
        </DataTemplate>

        <!-- A phone of the account under "Other devices": only named ("This phone" for itself), never opened. -->
        <DataTemplate x:Key="DeviceRow" x:DataType="vm:AccountDeviceRowViewModel">
            <arcm:ListItem Icon="{x:Static arc:ArcIcons.Smartphone}"
                           Content="{Binding Name}"
                           Subtitle="{Binding Summary}">
                <arcm:ListItem.Trailing>
                    <Border Classes="pill" IsVisible="{Binding IsCurrent}">
                        <TextBlock Text="{l:MobileLangResource ThisPhone}" />
                    </Border>
                </arcm:ListItem.Trailing>
            </arcm:ListItem>
        </DataTemplate>

        <!-- Cross-host session row in the Activity inbox: direct jump to TerminalPage. -->
        <DataTemplate x:Key="ActivitySessionRow" x:DataType="vm:ActivitySessionRowViewModel">
            <arcm:ListItem ShowChevron="True" Command="{Binding OpenCommand}">
                <arcm:ListItem.Trailing>
                    <Border Classes="pill"
                            Classes.waiting="{Binding IsWaiting}"
                            Classes.working="{Binding IsWorking}"
                            Classes.error="{Binding IsError}"
                            IsVisible="{Binding HasStatus}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <arc:ArcSpinner IsVisible="{Binding IsWorking}" />
                            <TextBlock Text="{Binding StatusText}" />
                        </StackPanel>
                    </Border>
                </arcm:ListItem.Trailing>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,4">
                    <Panel Grid.Column="0">
                        <Border Classes="badge" Background="{Binding Tint}" IsVisible="{Binding IsAgent}">
                            <TextBlock Text="{Binding Initial}" />
                        </Border>
                        <Border Classes="badge" IsVisible="{Binding IsTerminal}">
                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Terminal}" Size="16"
                                          Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Panel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                            <Border Classes="wsPill" IsVisible="{Binding HasWorkspaceTask}">
                                <TextBlock Text="{Binding WorkspaceTaskKey}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Classes="secondary" Text="{Binding ContextLine}" />
                        <TextBlock Classes="preview" Text="{Binding Preview}" IsVisible="{Binding HasPreview}" />
                    </StackPanel>
                </Grid>
            </arcm:ListItem>
        </DataTemplate>
    </arcm:Page.Resources>

    <arcm:Page.Header>
        <!-- One compact row under the status bar: the tab's title on the left (no large-title row, no empty bar above
             it) and the tab's actions on the right. The account lives in the "Me" tab, so no avatar button here. -->
        <arcm:Navbar Name="TabNavbar">
            <arcm:Navbar.Leading>
                <TextBlock Name="TabTitle"
                           Text="{Binding CurrentTabTitle}"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="{arc:ArcDesignTokenResource TypeXL}"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" />
            </arcm:Navbar.Leading>
            <arcm:Navbar.Trailing>
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Quick add computer on Computers tab -->
                    <arcm:IconButton Name="NavAddHostButton"
                                     Icon="{x:Static arc:ArcIcons.Plus}"
                                     Command="{Binding AddHostCommand}"
                                     AutomationProperties.Name="{l:MobileLangResource AddHost}"
                                     IsVisible="{Binding IsHostsTab}" />
                    <!-- Without an account: a reminder on Activity & Computers that leads to the Me tab -->
                    <Panel IsVisible="{Binding !IsAccountTab}">
                        <arcm:Button Name="SignedOutButton"
                                     Variant="Plain"
                                     Content="{l:MobileLangResource NotSignedIn}"
                                     Command="{Binding SelectAccountTabCommand}"
                                     IsVisible="{Binding IsSignedOut}" />
                    </Panel>
                    <!-- Connection badge on Me tab -->
                    <Border Classes="pill"
                            Classes.success="{Binding IsSignedIn}"
                            IsVisible="{Binding IsAccountTab}"
                            Margin="0,0,4,0">
                        <TextBlock Text="{Binding AccountStatusBadge}" />
                    </Border>
                </StackPanel>
            </arcm:Navbar.Trailing>
        </arcm:Navbar>
    </arcm:Page.Header>

    <Panel Margin="0,4,0,24">
        <!-- ==================== Tab 0: Activity (动态收件箱) ==================== -->
        <StackPanel Name="ActivityTabContent" Spacing="18" IsVisible="{Binding IsActivityTab}">
            <!-- Cloud relay upgrade banner when in local-only mode -->
            <Border Name="LocalUpgradeBanner"
                    Classes="alertCard"
                    Margin="16,4,16,0"
                    IsVisible="{Binding IsSignedOut}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="{l:MobileLangResource UpgradeBannerTitle}"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   FontWeight="SemiBold"
                                   Foreground="{arc:ArcDesignTokenResource Accent}" />
                        <TextBlock Classes="secondary"
                                   Text="{Binding UpgradeBannerHint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <arcm:Button Name="UpgradeSignInButton"
                                 Grid.Column="1"
                                 Variant="Filled"
                                 VerticalAlignment="Center"
                                 Content="{l:MobileLangResource SignInStart}"
                                 Command="{Binding SignInCommand}" />
                </Grid>
            </Border>

            <!-- Cross-host sessions waiting for approval or failed -->
            <arcm:ListGroup Name="AttentionGroup"
                            Header="{l:MobileLangResource ActivityWaitingHeader}"
                            ItemsSource="{Binding AttentionSessions}"
                            ItemTemplate="{StaticResource ActivitySessionRow}"
                            IsVisible="{Binding HasAttention}" />

            <!-- Cross-host actively working sessions -->
            <arcm:ListGroup Name="WorkingGroup"
                            Header="{l:MobileLangResource ActivityWorkingHeader}"
                            ItemsSource="{Binding WorkingSessions}"
                            ItemTemplate="{StaticResource ActivitySessionRow}"
                            IsVisible="{Binding HasWorking}" />

            <!-- Calm all-clear card when hosts exist but nothing needs attention -->
            <Border Name="AllClearCard"
                    Classes="surfaceCard"
                    Margin="16,0"
                    IsVisible="{Binding IsActivityAllClear}">
                <StackPanel Spacing="4">
                    <TextBlock Text="{l:MobileLangResource ActivityAllClearTitle}"
                               FontSize="{arc:ArcDesignTokenResource TypeLG}"
                               FontWeight="SemiBold" />
                    <TextBlock Classes="secondary"
                               Text="{l:MobileLangResource ActivityAllClearHint}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Quick access to online computers right below the inbox -->
            <arcm:ListGroup Name="QuickHostsGroup"
                            Header="{l:MobileLangResource ActivityQuickHostsHeader}"
                            ItemsSource="{Binding Online}"
                            ItemTemplate="{StaticResource HostRow}"
                            IsVisible="{Binding HasOnline}" />

            <!-- Empty state when no hosts exist yet -->
            <StackPanel Name="ActivityEmpty" Margin="32,32,32,0" Spacing="16" IsVisible="{Binding IsEmpty}">
                <TextBlock Classes="muted"
                           Text="{Binding EmptyText}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <arcm:Button Name="ActivityAddHostButton"
                             Variant="Tinted"
                             HorizontalAlignment="Center"
                             Content="{l:MobileLangResource AddHost}"
                             Command="{Binding AddHostCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- ==================== Tab 1: Computers (电脑分组) ==================== -->
        <StackPanel Name="HostsTabContent" Spacing="18" IsVisible="{Binding IsHostsTab}">
            <arcm:ListGroup Name="OnlineGroup"
                            Header="{l:MobileLangResource HostsOnline}"
                            ItemsSource="{Binding Online}"
                            ItemTemplate="{StaticResource HostRow}"
                            IsVisible="{Binding HasOnline}" />
            <arcm:ListGroup Name="UnpairedGroup"
                            Header="{l:MobileLangResource HostsNotPaired}"
                            ItemsSource="{Binding Unpaired}"
                            ItemTemplate="{StaticResource HostRow}"
                            IsVisible="{Binding HasUnpaired}" />
            <arcm:ListGroup Name="OfflineGroup"
                            Header="{l:MobileLangResource HostsOffline}"
                            ItemsSource="{Binding Offline}"
                            ItemTemplate="{StaticResource HostRow}"
                            IsVisible="{Binding HasOffline}" />
            <!-- The account's phones (this one too): folded, for information only. -->
            <StackPanel Name="OtherDevicesSection" Spacing="0" IsVisible="{Binding HasOtherDevices}">
                <arcm:ListGroup Name="OtherDevicesGroup">
                    <arcm:ListItem Name="OtherDevicesToggle"
                                   Icon="{x:Static arc:ArcIcons.Smartphone}"
                                   Content="{Binding OtherDevicesTitle}"
                                   Command="{Binding ToggleOtherDevicesCommand}">
                        <arcm:ListItem.Trailing>
                            <Panel VerticalAlignment="Center">
                                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronRight}" Size="16"
                                              Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                              IsVisible="{Binding !IsOtherDevicesOpen}" />
                                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronDown}" Size="16"
                                              Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                              IsVisible="{Binding IsOtherDevicesOpen}" />
                            </Panel>
                        </arcm:ListItem.Trailing>
                    </arcm:ListItem>
                </arcm:ListGroup>
                <arcm:ListGroup Name="OtherDevicesList"
                                Margin="0,8,0,0"
                                Footer="{l:MobileLangResource OtherDevicesHint}"
                                ItemsSource="{Binding OtherDevices}"
                                ItemTemplate="{StaticResource DeviceRow}"
                                IsVisible="{Binding IsOtherDevicesOpen}" />
            </StackPanel>
            <arcm:ListGroup Name="AddGroup" IsVisible="{Binding HasHosts}">
                <arcm:ListItem Name="AddHostRow"
                               Icon="{x:Static arc:ArcIcons.Plus}"
                               Content="{l:MobileLangResource AddHost}"
                               ShowChevron="True"
                               Command="{Binding AddHostCommand}" />
            </arcm:ListGroup>
            <StackPanel Name="Empty" Margin="32,32,32,0" Spacing="18" IsVisible="{Binding IsEmpty}">
                <TextBlock Name="EmptyText"
                           Classes="muted"
                           Text="{Binding EmptyText}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
                <arcm:Button Name="AddHostButton"
                             Variant="Tinted"
                             HorizontalAlignment="Center"
                             Content="{l:MobileLangResource AddHost}"
                             Command="{Binding AddHostCommand}" />
            </StackPanel>
        </StackPanel>

        <!-- ==================== Tab 2: Me (我的 / 账号中心) ==================== -->
        <StackPanel Name="AccountTabContent" Spacing="18" IsVisible="{Binding IsAccountTab}">
            <!-- Signed-in identity card -->
            <Border Name="ProfileCard"
                    Classes="surfaceCard"
                    Margin="16,4,16,0"
                    IsVisible="{Binding IsSignedIn}">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Classes="avatarCircle">
                        <TextBlock Text="{Binding AccountInitial}" FontSize="18" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Name="ProfileAccountName"
                                   Text="{Binding AccountName}"
                                   FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="secondary"
                                   Text="{Binding AccountHostSummary}"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="pill success">
                        <TextBlock Text="{l:MobileLangResource MeStatusOnline}" />
                    </Border>
                </Grid>
            </Border>

            <!-- Signed-out / local-only sign-in invitation card -->
            <Border Name="MeSignInCard"
                    Classes="surfaceCard"
                    Margin="16,4,16,0"
                    IsVisible="{Binding IsSignedOut}">
                <StackPanel Spacing="12">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{l:MobileLangResource MeSignInCardTitle}"
                                   FontSize="{arc:ArcDesignTokenResource TypeLG}"
                                   FontWeight="SemiBold" />
                        <TextBlock Classes="secondary"
                                   Text="{l:MobileLangResource MeSignInCardHint}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                    <arcm:Button Name="MeSignInButton"
                                 Variant="Filled"
                                 HorizontalAlignment="Stretch"
                                 HorizontalContentAlignment="Center"
                                 Content="{Binding SignInButtonText}"
                                 Command="{Binding SignInCommand}" />
                </StackPanel>
            </Border>

            <!-- Account & connection actions -->
            <arcm:ListGroup Name="MeConnectionGroup" Header="{l:MobileLangResource MeSectionAccount}">
                <arcm:ListItem Name="MeManageWebRow"
                               Icon="{x:Static arc:ArcIcons.ExternalLink}"
                               Content="{l:MobileLangResource MeManageWeb}"
                               Subtitle="{Binding ServerHostDisplay}"
                               ShowChevron="True"
                               Command="{Binding OpenAccountWebCommand}"
                               IsVisible="{Binding HasAccountWeb}" />
                <arcm:ListItem Name="MeCustomServerRow"
                               Icon="{x:Static arc:ArcIcons.Server}"
                               Content="{l:MobileLangResource MeSwitchCustom}"
                               Subtitle="{l:MobileLangResource MeSwitchCustomHint}"
                               ShowChevron="True"
                               Command="{Binding OpenCustomServerCommand}" />
                <arcm:ListItem Name="MeAddHostRow"
                               Icon="{x:Static arc:ArcIcons.Plus}"
                               Content="{l:MobileLangResource AddHost}"
                               Subtitle="{l:MobileLangResource UseLocalHint}"
                               ShowChevron="True"
                               Command="{Binding AddHostCommand}" />
            </arcm:ListGroup>

            <!-- App version and updates (Android only: a platform without an updater shows no group) -->
            <arcm:ListGroup Name="MeAboutGroup"
                            Header="{l:MobileLangResource MeSectionAbout}"
                            IsVisible="{Binding Updater.IsSupported}">
                <arcm:ListItem Name="MeUpdateRow"
                               Icon="{x:Static arc:ArcIcons.RefreshCw}"
                               Content="{l:MobileLangResource UpdateRowTitle}"
                               Subtitle="{Binding Updater.StatusText}"
                               ShowChevron="{Binding !Updater.IsBusy}"
                               Command="{Binding Updater.ActCommand}">
                    <arcm:ListItem.Trailing>
                        <Panel>
                            <arc:ArcSpinner IsVisible="{Binding Updater.IsBusy}" VerticalAlignment="Center" />
                            <Border Classes="pill action" IsVisible="{Binding !!Updater.ActionText}">
                                <TextBlock Text="{Binding Updater.ActionText}" />
                            </Border>
                        </Panel>
                    </arcm:ListItem.Trailing>
                </arcm:ListItem>
                <arcm:ListItem Name="MeUpdateNotesRow"
                               Icon="{x:Static arc:ArcIcons.FileText}"
                               Content="{l:MobileLangResource UpdateNotes}"
                               ShowChevron="True"
                               Command="{Binding Updater.OpenNotesCommand}"
                               IsVisible="{Binding Updater.HasNews}" />
            </arcm:ListGroup>

            <!-- Sign out / Leave local-only mode -->
            <Panel Margin="16,0">
                <arcm:Button Name="MeSignOutButton"
                             Variant="Tinted"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Center"
                             Foreground="{arc:ArcDesignTokenResource Danger}"
                             Content="{l:MobileLangResource SignOut}"
                             Command="{Binding SignOutCommand}"
                             IsVisible="{Binding IsSignedIn}" />
                <arcm:Button Name="MeLeaveLocalButton"
                             Variant="Tinted"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Center"
                             Foreground="{arc:ArcDesignTokenResource Danger}"
                             Content="{l:MobileLangResource LeaveLocal}"
                             Command="{Binding LeaveLocalCommand}"
                             IsVisible="{Binding IsSignedOut}" />
            </Panel>
        </StackPanel>
    </Panel>

    <!-- Scheme A bottom 3-tab navigation bar -->
    <arcm:Page.Footer>
        <arcm:Tabbar Name="MainTabbar" SelectedIndex="{Binding SelectedTab, Mode=TwoWay}">
            <arcm:TabbarItem Name="ActivityTab"
                             Icon="{x:Static arc:ArcIcons.Sparkles}"
                             Content="{Binding ActivityTabLabel}" />
            <arcm:TabbarItem Name="HostsTab"
                             Icon="{x:Static arc:ArcIcons.Monitor}"
                             Content="{l:MobileLangResource TabHosts}" />
            <arcm:TabbarItem Name="AccountTab"
                             Icon="{x:Static arc:ArcIcons.User}"
                             Content="{Binding MeTabLabel}" />
        </arcm:Tabbar>
    </arcm:Page.Footer>

    <arcm:Page.Overlay>
        <Panel>
            <arcm:ActionSheet Name="AccountSheet"
                              IsOpen="{Binding IsAccountOpen, Mode=TwoWay}"
                              Title="{Binding AccountName}"
                              CancelText="{l:MobileLangResource Cancel}">
                <arcm:ActionSheetItem Content="{l:MobileLangResource SignOut}"
                                      IsDestructive="True"
                                      Command="{Binding SignOutCommand}" />
            </arcm:ActionSheet>
            <arcm:ActionSheet Name="LocalSheet"
                              IsOpen="{Binding IsLocalOpen, Mode=TwoWay}"
                              Title="{Binding AccountName}"
                              CancelText="{l:MobileLangResource Cancel}">
                <arcm:ActionSheetItem Content="{l:MobileLangResource SignInStart}"
                                      Command="{Binding SignInCommand}" />
                <arcm:ActionSheetItem Content="{l:MobileLangResource LeaveLocal}"
                                      IsDestructive="True"
                                      Command="{Binding LeaveLocalCommand}" />
            </arcm:ActionSheet>
        </Panel>
    </arcm:Page.Overlay>
</arcm:Page>
