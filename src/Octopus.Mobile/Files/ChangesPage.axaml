<arcm:Page xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
           xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
           xmlns:common="using:Octopus.Mobile.Common"
           xmlns:l="using:Octopus.Mobile.Localization"
           xmlns:vm="using:Octopus.Mobile.Files"
           x:Class="Octopus.Mobile.Files.ChangesPage"
           x:DataType="vm:ChangesViewModel"
           IsScrollable="False">
    <arcm:Page.Header>
        <arcm:Navbar Title="{l:MobileLangResource ChangesTitle}"
                     ShowBack="True"
                     BackCommand="{Binding BackCommand}">
            <arcm:Navbar.Trailing>
                <arcm:IconButton Name="RefreshButton"
                                 Icon="{x:Static arc:ArcIcons.RefreshCw}"
                                 Command="{Binding RefreshCommand}"
                                 AutomationProperties.Name="{l:MobileLangResource Refresh}" />
            </arcm:Navbar.Trailing>
        </arcm:Navbar>
    </arcm:Page.Header>

    <Grid RowDefinitions="Auto,Auto,*">
        <Border Classes="strip" Grid.Row="0" Padding="14,5">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Name="SubtitleText" Classes="secondary" Text="{Binding Subtitle}" VerticalAlignment="Center" />
                <TextBlock Name="CountHeaderText"
                           Grid.Column="1"
                           Classes="muted"
                           FontSize="12"
                           Text="{Binding CountText}"
                           IsVisible="{Binding HasAnyRows}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Client-side instant filter for large change sets (hundreds/thousands of changed files). -->
        <arcm:TextField Name="SearchField"
                        Grid.Row="1"
                        Classes="hostSearch"
                        Margin="16,8,16,4"
                        Text="{Binding SearchQuery, Mode=TwoWay}"
                        PlaceholderText="{l:MobileLangResource ChangesSearchPlaceholder}"
                        IsVisible="{Binding ShowSearch}" />

        <Panel Grid.Row="2">
            <arcm:PullToRefresh IsRefreshing="{Binding IsRefreshing, Mode=TwoWay}"
                                Command="{Binding RefreshCommand}">
                <!-- Virtualized change list: handles hundreds or thousands of modified files smoothly. -->
                <ListBox Name="ChangeList"
                         Classes="virtualList"
                         ItemsSource="{Binding Rows}"
                         IsVisible="{Binding HasRows}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChangeRowViewModel">
                            <Border Classes="virtualRow">
                                <arcm:ListItem Content="{Binding Name}"
                                               Subtitle="{Binding Subtitle}"
                                               ShowChevron="True"
                                               Command="{Binding OpenCommand}">
                                    <arcm:ListItem.Leading>
                                        <Border Classes="changeBadge"
                                                Classes.added="{Binding IsAdded}"
                                                Classes.modified="{Binding IsModified}"
                                                Classes.removed="{Binding IsRemoved}">
                                            <TextBlock Text="{Binding Badge}" />
                                        </Border>
                                    </arcm:ListItem.Leading>
                                    <arcm:ListItem.Trailing>
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding HasCounts}">
                                            <TextBlock Classes="diffStat added" Text="{Binding AddedText}" IsVisible="{Binding HasAdded}" />
                                            <TextBlock Classes="diffStat removed" Text="{Binding RemovedText}" IsVisible="{Binding HasRemoved}" />
                                        </StackPanel>
                                    </arcm:ListItem.Trailing>
                                </arcm:ListItem>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </arcm:PullToRefresh>

            <common:MobileLoadingView Name="LoadingView"
                                      Variant="List"
                                      Label="{l:MobileLangResource LoadingChanges}"
                                      IsVisible="{Binding IsLoading}" />

            <Border Name="ErrorCard" Classes="alertCard danger" Margin="16,12" VerticalAlignment="Top" IsVisible="{Binding HasError}">
                <TextBlock Name="ErrorText" Text="{Binding ErrorText}" TextWrapping="Wrap" />
            </Border>

            <TextBlock Name="EmptyText" Classes="muted" Text="{l:MobileLangResource ChangesEmpty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,36" TextWrapping="Wrap" TextAlignment="Center"
                       IsVisible="{Binding IsEmpty}" />

            <TextBlock Name="NotRepositoryText" Classes="muted" Text="{l:MobileLangResource ChangesNotRepository}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,36" TextWrapping="Wrap" TextAlignment="Center"
                       IsVisible="{Binding IsNotRepository}" />
        </Panel>
    </Grid>
</arcm:Page>
