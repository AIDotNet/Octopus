<arcm:Page xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
           xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
           xmlns:l="using:Octopus.Mobile.Localization"
           xmlns:vm="using:Octopus.Mobile.Files"
           x:Class="Octopus.Mobile.Files.FilesPage"
           x:DataType="vm:FilesViewModel"
           IsScrollable="True">
    <arcm:Page.Header>
        <arcm:Navbar Title="{Binding Title}"
                     ShowBack="True"
                     BackCommand="{Binding BackCommand}" />
    </arcm:Page.Header>

    <StackPanel Margin="0,4,0,24" Spacing="12">
        <!-- The folder started in, then each folder walked into; tapping any goes back there. -->
        <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="16,0">
            <ItemsControl Name="Crumbs" ItemsSource="{Binding Crumbs}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileCrumbViewModel">
                        <arcm:Button Variant="Tinted" Content="{Binding Name}" Command="{Binding OpenCommand}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <arc:ArcSpinner HorizontalAlignment="Center" Margin="0,24" IsVisible="{Binding IsLoading}" />

        <Border Name="ErrorCard" Classes="alertCard danger" Margin="16,0" IsVisible="{Binding HasError}">
            <TextBlock Name="ErrorText" Text="{Binding ErrorText}" TextWrapping="Wrap" />
        </Border>

        <arcm:ListGroup Name="Entries" ItemsSource="{Binding Entries}" IsVisible="{Binding HasEntries}">
            <arcm:ListGroup.ItemTemplate>
                <DataTemplate x:DataType="vm:FileRowViewModel">
                    <arcm:ListItem Content="{Binding Name}"
                                   Icon="{Binding Icon}"
                                   ShowChevron="True"
                                   Command="{Binding OpenCommand}" />
                </DataTemplate>
            </arcm:ListGroup.ItemTemplate>
        </arcm:ListGroup>

        <TextBlock Name="CappedText" Classes="muted" Text="{Binding CappedText}"
                   HorizontalAlignment="Center" Margin="16,0" TextWrapping="Wrap"
                   IsVisible="{Binding IsCapped}" />

        <TextBlock Name="EmptyText" Classes="muted" Text="{l:MobileLangResource FilesEmpty}"
                   HorizontalAlignment="Center" Margin="0,24"
                   IsVisible="{Binding IsEmpty}" />
    </StackPanel>
</arcm:Page>
