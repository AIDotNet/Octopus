<Project Sdk="Microsoft.NET.Sdk">
    <!-- The phone app's shared part: pages, view models and the seam to a remote host (design/12-远程操作.md §9).
         Plain net10.0, so it builds without the iOS / Android workloads; the platform heads only start it. -->
    <PropertyGroup>
        <IsAotCompatible>true</IsAotCompatible>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <!-- AVLN3001: the pages take their view model in the constructor and are never loaded by URI. -->
        <NoWarn>$(NoWarn);AVLN3001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Octopus.Mobile.Tests" />
        <!-- The official service's address (Directory.Build.props), read by MobileBuild. Left out while there is none. -->
        <AssemblyMetadata Include="OctopusServiceUrl" Value="$(OctopusServiceUrl)" Condition="'$(OctopusServiceUrl)' != ''" />
    </ItemGroup>

    <ItemGroup>
        <!-- The logo of the welcome page: the desktop app's transparent in-app logo, not a second copy of it. -->
        <AvaloniaResource Include="../Octopus.App/Assets/Icon/logo.png" Link="Assets/logo.png" />
        <!-- Built-in pixel icons shared with desktop so project squares render identically on mobile. -->
        <AvaloniaResource Include="../Octopus.App/Assets/PixelIcons/pixel-icons.json" Link="Assets/PixelIcons/pixel-icons.json" />
        <Compile Include="../Octopus.App/Common/PixelIcons.cs" Link="Common/PixelIcons.cs" />
        <Compile Include="../Octopus.App/Common/PixelIconView.cs" Link="Common/PixelIconView.cs" />
        <!-- Shared clipped spring-animated 3-line work ticker so desktop and mobile motion stay identical. -->
        <Compile Include="../Octopus.App/AgentGui/WorkTickerViewport.cs" Link="Conversations/WorkTickerViewport.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" />
        <PackageReference Include="Avalonia.Fonts.Inter" />
        <PackageReference Include="TKCode.Arc.Mobile" />
        <PackageReference Include="TKCode.Arc.Fonts" />
        <PackageReference Include="TKCode.Arc.Icons.Lucide" />
        <PackageReference Include="CommunityToolkit.Mvvm" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Octopus.Core/Octopus.Core.csproj" />
        <ProjectReference Include="../Octopus.Remote/Octopus.Remote.csproj" />
        <ProjectReference Include="../Octopus.Remote.Client/Octopus.Remote.Client.csproj" />
        <ProjectReference Include="../Octopus.Terminal/Octopus.Terminal.csproj" />
        <ProjectReference Include="../Octopus.Terminal.Avalonia/Octopus.Terminal.Avalonia.csproj" />
        <!-- The signed manifest, its check and the verified download (design/10-自动更新.md §15). -->
        <ProjectReference Include="../Octopus.Updates/Octopus.Updates.csproj" />
    </ItemGroup>
</Project>
