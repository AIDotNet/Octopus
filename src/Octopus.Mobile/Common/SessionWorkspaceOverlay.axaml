<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
             xmlns:l="using:Octopus.Mobile.Localization"
             xmlns:common="using:Octopus.Mobile.Common"
             x:Class="Octopus.Mobile.Common.SessionWorkspaceOverlay"
             x:DataType="common:SessionWorkspaceViewModel">
    <UserControl.Resources>
        <StreamGeometry x:Key="SessionsGlyph">M3 6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M8 20h8 M10 16v4 M14 16v4</StreamGeometry>
        <StreamGeometry x:Key="EditGlyph">M12 20h9 M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z</StreamGeometry>
        <StreamGeometry x:Key="InfoGlyph">M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18z M12 16v-4 M12 8h.01</StreamGeometry>
        <StreamGeometry x:Key="TrashGlyph">M3 6h18 M8 6V4h8v2 M19 6l-1 14H6L5 6</StreamGeometry>
    </UserControl.Resources>

    <Panel>
        <!-- Scheme C top-right anchored popover menu: workspace navigation (Files / Changes / Branches / Sessions) + current session actions. -->
        <Panel Name="PopoverOverlay" IsVisible="{Binding IsPopoverOpen}">
            <Button Name="PopoverBackdrop"
                    Classes="popoverBackdrop"
                    Command="{Binding ClosePopoverCommand}" />

            <Border Name="PopoverHost" Padding="0,56,10,0" IsHitTestVisible="True">
                <Border Name="PopoverMenu"
                        Classes="sessionPopover"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top">
                    <StackPanel Spacing="1">
                        <TextBlock Classes="popoverSection" Text="{Binding WorkspaceHeaderText}" TextTrimming="CharacterEllipsis" />

                        <Button Name="MenuFilesButton"
                                Classes="popoverRow"
                                IsVisible="{Binding CanBrowseFiles}"
                                Command="{Binding BrowseFilesCommand}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                <arc:ArcGlyph Grid.Column="0" Data="{x:Static arc:ArcIcons.Folder}" Size="15"
                                              Foreground="{arc:ArcDesignTokenResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{l:MobileLangResource SessionMenuFiles}" FontSize="13" VerticalAlignment="Center" />
                                <arc:ArcGlyph Grid.Column="2" Data="{x:Static arc:ArcIcons.ChevronRight}" Size="13"
                                              Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button Name="MenuChangesButton"
                                Classes="popoverRow"
                                IsVisible="{Binding CanViewChanges}"
                                Command="{Binding ViewChangesCommand}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                <arc:ArcGlyph Grid.Column="0" Data="{x:Static arc:ArcIcons.FileText}" Size="15"
                                              Foreground="{arc:ArcDesignTokenResource Warning}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{l:MobileLangResource SessionMenuChanges}" FontSize="13" VerticalAlignment="Center" />
                                <arc:ArcGlyph Grid.Column="2" Data="{x:Static arc:ArcIcons.ChevronRight}" Size="13"
                                              Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button Name="MenuBranchesButton"
                                Classes="popoverRow"
                                Command="{Binding OpenBranchesCommand}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                <arc:ArcGlyph Grid.Column="0" Data="{x:Static arc:ArcIcons.GitBranch}" Size="15"
                                              Foreground="{arc:ArcDesignTokenResource Success}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{l:MobileLangResource SessionMenuBranches}" FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding BranchesBadgeText}"
                                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                           FontSize="10.5"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                           MaxWidth="78"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" />
                                <arc:ArcGlyph Grid.Column="3" Data="{x:Static arc:ArcIcons.ChevronRight}" Size="13"
                                              Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button Name="MenuSessionsButton"
                                Classes="popoverRow"
                                Command="{Binding OpenSessionsCommand}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                                <arc:ArcGlyph Grid.Column="0" Data="{StaticResource SessionsGlyph}" Size="15"
                                              Foreground="{arc:ArcDesignTokenResource Accent}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{l:MobileLangResource SessionMenuSessions}" FontSize="13" VerticalAlignment="Center" />
                                <Border Grid.Column="2" Classes="statusDot warning" IsVisible="{Binding HasOtherAttention}" />
                                <TextBlock Grid.Column="3"
                                           Text="{Binding SessionsBadgeText}"
                                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                           FontSize="11"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                           VerticalAlignment="Center" />
                                <arc:ArcGlyph Grid.Column="4" Data="{x:Static arc:ArcIcons.ChevronRight}" Size="13"
                                              Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Border Classes="popoverDivider" />
                        <TextBlock Classes="popoverSection" Text="{l:MobileLangResource SessionMenuCurrentSection}" />

                        <!-- Inline terminal text size control (TerminalPage only) -->
                        <Grid Name="FontSizeRow"
                              ColumnDefinitions="*,Auto,Auto,Auto"
                              ColumnSpacing="5"
                              Margin="9,4,7,4"
                              IsVisible="{Binding ShowFontSizeControls}">
                            <TextBlock Grid.Column="0"
                                       Text="{l:MobileLangResource SessionMenuFontSize}"
                                       FontSize="12.5"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                       VerticalAlignment="Center" />
                            <Button Name="FontSmallerButton"
                                    Grid.Column="1"
                                    Classes="popoverMiniBtn"
                                    Content="A−"
                                    IsEnabled="{Binding CanSmallerText}"
                                    Command="{Binding SmallerTextCommand}" />
                            <TextBlock Grid.Column="2"
                                       Text="{Binding FontSizeLabel}"
                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                       FontSize="11"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                       VerticalAlignment="Center"
                                       Margin="2,0" />
                            <Button Name="FontLargerButton"
                                    Grid.Column="3"
                                    Classes="popoverMiniBtn"
                                    Content="A+"
                                    IsEnabled="{Binding CanLargerText}"
                                    Command="{Binding LargerTextCommand}" />
                        </Grid>

                        <Button Name="MenuPrimaryActionButton"
                                Classes="popoverRow"
                                IsVisible="{Binding HasPrimaryAction}"
                                Command="{Binding RunPrimaryActionCommand}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                <arc:ArcGlyph Grid.Column="0" Data="{x:Static arc:ArcIcons.RefreshCw}" Size="14"
                                              Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding PrimaryActionLabel}" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button Name="MenuRenameButton"
                                Classes="popoverRow"
                                Command="{Binding RenameCommand}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                <arc:ArcGlyph Grid.Column="0" Data="{StaticResource EditGlyph}" Size="14"
                                              Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{l:MobileLangResource SessionRename}" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button Name="MenuRestartButton"
                                Classes="popoverRow"
                                IsVisible="{Binding CanRestart}"
                                Command="{Binding RestartCommand}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                <arc:ArcGlyph Grid.Column="0" Data="{x:Static arc:ArcIcons.Terminal}" Size="14"
                                              Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{l:MobileLangResource SessionRestart}" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button Name="MenuDuplicateButton"
                                Classes="popoverRow"
                                Command="{Binding DuplicateCommand}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                <arc:ArcGlyph Grid.Column="0" Data="{x:Static arc:ArcIcons.Copy}" Size="14"
                                              Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{l:MobileLangResource SessionDuplicate}" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Button Name="MenuDetailsButton"
                                Classes="popoverRow"
                                Command="{Binding ShowDetailsCommand}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                <arc:ArcGlyph Grid.Column="0" Data="{StaticResource InfoGlyph}" Size="14"
                                              Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{l:MobileLangResource SessionDetails}" FontSize="13" VerticalAlignment="Center" />
                            </Grid>
                        </Button>

                        <Border Classes="popoverDivider" />

                        <Button Name="MenuCloseButton"
                                Classes="popoverRow danger"
                                Command="{Binding CloseSessionCommand}">
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="9">
                                <arc:ArcGlyph Grid.Column="0" Data="{StaticResource TrashGlyph}" Size="14"
                                              Foreground="{arc:ArcDesignTokenResource Danger}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{l:MobileLangResource SessionClose}" FontSize="13"
                                           Foreground="{arc:ArcDesignTokenResource Danger}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Border>
        </Panel>

        <!-- Branches & Workspaces viewer sheet -->
        <arcm:Sheet Name="BranchesSheet"
                    IsOpen="{Binding IsBranchesSheetOpen, Mode=TwoWay}"
                    MaxHeightFraction="0.82"
                    Title="{l:MobileLangResource SessionBranchesTitle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,4,16,20" Spacing="12">
                    <TextBlock Classes="sectionHeader" Text="{l:MobileLangResource SessionBranchesWorkspacesHeader}" />

                    <ItemsControl Name="WorkspaceBranchesList" ItemsSource="{Binding WorkspaceBranches}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="common:SessionBranchItemViewModel">
                                <Border Classes="sessionSheetCard" Classes.current="{Binding IsCurrent}">
                                    <StackPanel Spacing="8">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                            <Panel Grid.Column="0" VerticalAlignment="Center">
                                                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Folder}" Size="16"
                                                              Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                              IsVisible="{Binding IsDefault}" />
                                                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.GitBranch}" Size="16"
                                                              Foreground="{arc:ArcDesignTokenResource Accent}"
                                                              IsVisible="{Binding IsWorktree}" />
                                            </Panel>
                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                               FontSize="13"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <Border Classes="pill success" IsVisible="{Binding IsCurrent}">
                                                        <TextBlock Text="{l:MobileLangResource SessionBranchesCurrent}" />
                                                    </Border>
                                                    <Border Classes="wsPill" IsVisible="{Binding HasTaskKey}">
                                                        <TextBlock Text="{Binding TaskKey}" />
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Classes="projectCardPath" Text="{Binding Subtitle}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="2"
                                                       Classes="muted monoCount"
                                                       Text="{Binding SessionCountText}"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Button Classes="projectFooterBtn"
                                                    IsVisible="{Binding CanBrowseFiles}"
                                                    Command="{Binding BrowseFilesCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Folder}" Size="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="{l:MobileLangResource ProjectActionFiles}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Classes="projectFooterBtn"
                                                    IsVisible="{Binding CanViewChanges}"
                                                    Command="{Binding ViewChangesCommand}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.FileText}" Size="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="{l:MobileLangResource ProjectActionChanges}" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Spacing="8" IsVisible="{Binding IsGitRepository}">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="sectionHeader" Text="{l:MobileLangResource SessionBranchesGitHeader}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsLoadingBranches}">
                                <arc:ArcSpinner Width="11" Height="11" VerticalAlignment="Center" />
                                <TextBlock Classes="muted" FontSize="11" Text="{l:MobileLangResource SessionBranchesLoading}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                        <ItemsControl Name="GitBranchesList" ItemsSource="{Binding GitBranches}" IsVisible="{Binding HasGitBranches}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="common:SessionGitBranchItemViewModel">
                                    <Border Classes="sessionSheetCard" Padding="10,7">
                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                            <arc:ArcGlyph Grid.Column="0" Data="{x:Static arc:ArcIcons.GitBranch}" Size="14"
                                                          Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                       FontSize="12.5"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="2" Classes="pill" IsVisible="{Binding HasOccupiedBy}">
                                                <TextBlock Text="{Binding OccupiedBy}" />
                                            </Border>
                                            <Border Grid.Column="3" Classes="pill" Classes.success="{Binding IsCurrent}">
                                                <TextBlock Text="{Binding KindLabel}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Classes="muted"
                               Text="{l:MobileLangResource SessionBranchesNotRepo}"
                               IsVisible="{Binding ShowNotGitRepo}" />
                </StackPanel>
            </ScrollViewer>
        </arcm:Sheet>

        <!-- Current project Sessions switcher sheet -->
        <arcm:Sheet Name="SessionsSheet"
                    IsOpen="{Binding IsSessionsSheetOpen, Mode=TwoWay}"
                    MaxHeightFraction="0.82"
                    Title="{l:MobileLangResource SessionSessionsTitle}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="16,4,16,20" Spacing="8">
                    <ItemsControl Name="ProjectSessionsList" ItemsSource="{Binding ProjectSessions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="common:SessionSwitchItemViewModel">
                                <Button Classes="cardHeaderBtn" Padding="0" Command="{Binding SelectCommand}">
                                    <Border Classes="sessionSheetCard" Classes.current="{Binding IsCurrent}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Panel Grid.Column="0" VerticalAlignment="Center">
                                                <Border Classes="badge" Background="{Binding Tint}" IsVisible="{Binding IsAgent}">
                                                    <TextBlock Text="{Binding Initial}" />
                                                </Border>
                                                <Border Classes="badge" IsVisible="{Binding IsTerminal}">
                                                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Terminal}" Size="15"
                                                                  Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Panel>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5" HorizontalAlignment="Left">
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Title}"
                                                               FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <Border Grid.Column="1" Classes="guiTag" IsVisible="{Binding IsGui}">
                                                        <TextBlock Text="{l:MobileLangResource GuiBadge}" />
                                                    </Border>
                                                    <Border Grid.Column="2" Classes="branchTag" IsVisible="{Binding HasBranch}">
                                                        <TextBlock Text="{Binding BranchText}" MaxWidth="86" TextTrimming="CharacterEllipsis" />
                                                    </Border>
                                                </Grid>
                                                <TextBlock Classes="preview"
                                                           Text="{Binding Preview}"
                                                           IsVisible="{Binding HasPreview}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Border Classes="pill"
                                                        Classes.waiting="{Binding IsWaiting}"
                                                        Classes.working="{Binding IsWorking}"
                                                        Classes.error="{Binding IsError}"
                                                        IsVisible="{Binding HasStatus}">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <arc:ArcSpinner IsVisible="{Binding IsWorking}" />
                                                        <TextBlock Text="{Binding StatusText}" />
                                                    </StackPanel>
                                                </Border>
                                                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Check}" Size="16"
                                                              Foreground="{arc:ArcDesignTokenResource Accent}"
                                                              IsVisible="{Binding IsCurrent}"
                                                              VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </arcm:Sheet>

        <!-- Rename sheet, Close dialog, and Toast notices -->
        <common:SessionActionOverlays Name="Overlays" DataContext="{Binding Actions}" />
    </Panel>
</UserControl>
