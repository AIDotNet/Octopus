<arcm:Page xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
           xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
           xmlns:l="using:Octopus.Mobile.Localization"
           xmlns:vm="using:Octopus.Mobile.Account"
           x:Class="Octopus.Mobile.Account.AccessPasswordPage"
           x:DataType="vm:AccessPasswordViewModel"
           IsScrollable="True"
           AvoidKeyboard="True">
    <arcm:Page.Header>
        <arcm:Navbar Title="{Binding HostName}"
                     ShowBack="True"
                     BackText="{l:MobileLangResource Hosts}"
                     BackCommand="{Binding BackCommand}" />
    </arcm:Page.Header>

    <!-- The content shrinks above the keyboard and scrolls: the field and the button stay in sight while typing. -->
    <StackPanel Margin="32,24,32,24" Spacing="18">
        <Panel HorizontalAlignment="Center">
            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Monitor}" Size="34"
                          Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
            <Border Classes="lockBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-8,-4">
                <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Lock}" Size="12"
                              Foreground="{arc:ArcDesignTokenResource Accent}"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Panel>
        <TextBlock Name="HostName"
                   Text="{Binding HostName}"
                   FontSize="{arc:ArcDesignTokenResource TypeXL}"
                   FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                   TextTrimming="CharacterEllipsis"
                   HorizontalAlignment="Center" />
        <TextBlock Classes="secondary"
                   Text="{l:MobileLangResource AccessPasswordIntro}"
                   TextWrapping="Wrap"
                   TextTrimming="None"
                   TextAlignment="Center" />

        <StackPanel Spacing="8">
            <TextBlock Classes="fieldLabel" Text="{l:MobileLangResource AccessPasswordLabel}" />
            <!-- Text is kept in step by the code-behind, which also puts the caret back after the dash is added. -->
            <arcm:TextField Name="PasswordInput"
                            Classes="accessPassword"
                            PlaceholderText="XXXX-XXXX"
                            MaxLength="32"
                            IsEnabled="{Binding !IsVerifying}"
                            TextInputOptions.AutoCapitalization="True"
                            TextInputOptions.IsSensitive="True"
                            AutomationProperties.Name="{l:MobileLangResource AccessPasswordLabel}" />
        </StackPanel>

        <arcm:Button Name="VerifyButton"
                     Variant="Filled"
                     HorizontalAlignment="Stretch"
                     HorizontalContentAlignment="Center"
                     Command="{Binding VerifyCommand}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <arc:ArcSpinner Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding IsVerifying}" />
                <TextBlock Text="{Binding VerifyText}" />
            </StackPanel>
        </arcm:Button>

        <TextBlock Name="Error"
                   Text="{Binding ErrorText}"
                   Foreground="{arc:ArcDesignTokenResource Danger}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   IsVisible="{Binding HasError}" />

        <arcm:Button Name="PairInsteadButton"
                     Variant="Tinted"
                     HorizontalAlignment="Center"
                     Content="{l:MobileLangResource AccessPasswordUsePairing}"
                     Command="{Binding PairInsteadCommand}"
                     IsVisible="{Binding CanPairInstead}" />

        <TextBlock Name="Hint"
                   Classes="muted"
                   Text="{l:MobileLangResource AccessPasswordHint}"
                   TextWrapping="Wrap"
                   TextAlignment="Center" />
    </StackPanel>
</arcm:Page>
