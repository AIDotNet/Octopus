<arcm:Page xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
           xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
           xmlns:l="using:Octopus.Mobile.Localization"
           xmlns:vm="using:Octopus.Mobile.Account"
           x:Class="Octopus.Mobile.Account.WelcomePage"
           x:DataType="vm:WelcomeViewModel"
           IsScrollable="True">
    <StackPanel VerticalAlignment="Center" Margin="0,24,0,28" Spacing="20">
        <!-- Hero brand header -->
        <StackPanel Margin="24,0" Spacing="10">
            <Image Source="avares://Octopus.Mobile/Assets/logo.png"
                   Width="72" Height="72"
                   HorizontalAlignment="Center"
                   RenderOptions.BitmapInterpolationMode="HighQuality" />
            <TextBlock Text="Octopus"
                       FontSize="{arc:ArcDesignTokenResource Type2XL}"
                       FontWeight="Bold"
                       HorizontalAlignment="Center" />
            <TextBlock Classes="secondary"
                       Text="{l:MobileLangResource WelcomeTagline}"
                       TextWrapping="Wrap"
                       TextTrimming="None"
                       TextAlignment="Center" />
        </StackPanel>

        <!-- Error / session-ended banner -->
        <Border Name="ErrorCard"
                Classes="alertCard danger"
                Margin="16,0"
                IsVisible="{Binding SignIn.HasError}">
            <TextBlock Name="Error"
                       Text="{Binding SignIn.ErrorText}"
                       Foreground="{arc:ArcDesignTokenResource Danger}"
                       FontSize="{arc:ArcDesignTokenResource TypeSM}"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </Border>

        <!-- Value highlights card on initial onboarding -->
        <Border Name="HighlightsCard"
                Classes="surfaceCard"
                Margin="16,0"
                IsVisible="{Binding ShowsHighlights}">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Classes="featureIcon">
                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Sparkles}" Size="15"
                                      Foreground="{arc:ArcDesignTokenResource Accent}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Classes="secondary"
                               Text="{l:MobileLangResource WelcomeFeatureAttention}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Classes="featureIcon success">
                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Cloud}" Size="15"
                                      Foreground="{arc:ArcDesignTokenResource Success}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Classes="secondary"
                               Text="{Binding RelayFeatureText}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Border Classes="featureIcon muted">
                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Monitor}" Size="15"
                                      Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Grid.Column="1" Classes="secondary"
                               Text="{l:MobileLangResource WelcomeFeatureLocal}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- Primary sign-in action + other ways to connect -->
        <StackPanel Spacing="18">
            <StackPanel Margin="16,0" Spacing="10">
                <arcm:Button Name="SignInButton"
                             Variant="Filled"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Center"
                             Content="{Binding SignInButtonText}"
                             Command="{Binding SignInCommand}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" IsVisible="{Binding SignIn.IsStarting}">
                    <arc:ArcSpinner Width="12" Height="12" VerticalAlignment="Center" />
                    <TextBlock Classes="muted" Text="{l:MobileLangResource SignInStarting}" />
                </StackPanel>
            </StackPanel>

            <arcm:ListGroup Name="OtherWays"
                            Header="{l:MobileLangResource OtherWays}"
                            IsVisible="{Binding ShowsOtherWays}">
                <arcm:ListItem Name="LocalRow"
                               Icon="{x:Static arc:ArcIcons.Monitor}"
                               Content="{l:MobileLangResource UseLocal}"
                               Subtitle="{l:MobileLangResource UseLocalHint}"
                               ShowChevron="True"
                               Command="{Binding UseLocalCommand}"
                               IsVisible="{Binding ShowsLocal}" />
                <arcm:ListItem Name="CustomRow"
                               Icon="{x:Static arc:ArcIcons.Server}"
                               Content="{l:MobileLangResource UseCustom}"
                               Subtitle="{l:MobileLangResource UseCustomHint}"
                               ShowChevron="True"
                               Command="{Binding UseCustomCommand}"
                               IsVisible="{Binding ShowsCustom}" />
            </arcm:ListGroup>
        </StackPanel>
    </StackPanel>

    <!-- Scheme A bottom sheet for the 8-character device verification code -->
    <arcm:Page.Overlay>
        <arcm:Sheet Name="SignInSheet"
                    IsOpen="{Binding IsCodeSheetOpen, Mode=TwoWay}"
                    Title="{l:MobileLangResource SignInSheetTitle}"
                    MaxHeightFraction="0.68">
            <Panel Margin="16,4,16,20">
                <vm:SignInCodeView Name="CodeView" DataContext="{Binding SignIn}" />
            </Panel>
        </arcm:Sheet>
    </arcm:Page.Overlay>
</arcm:Page>
