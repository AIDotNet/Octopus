<arcm:Page xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
           xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
           xmlns:l="using:Octopus.Mobile.Localization"
           xmlns:vm="using:Octopus.Mobile.Account"
           x:Class="Octopus.Mobile.Account.CustomServerPage"
           x:DataType="vm:CustomServerViewModel">
    <arcm:Page.Header>
        <arcm:Navbar Title="{l:MobileLangResource UseCustom}"
                     ShowBack="True"
                     BackText="{l:MobileLangResource Back}"
                     BackCommand="{Binding BackCommand}" />
    </arcm:Page.Header>

    <StackPanel VerticalAlignment="Center" Margin="32,0" Spacing="18">
        <TextBlock Text="{l:MobileLangResource SignInTitle}"
                   FontSize="{arc:ArcDesignTokenResource TypeXL}"
                   FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                   HorizontalAlignment="Center" />

        <!-- First: which service, and "Sign in". -->
        <StackPanel Spacing="18" IsVisible="{Binding IsEntering}">
            <TextBlock Classes="secondary"
                       Text="{l:MobileLangResource SignInServerHint}"
                       TextWrapping="Wrap"
                       TextTrimming="None"
                       TextAlignment="Center" />
            <arcm:TextField Name="ServerInput"
                            Text="{Binding Server, Mode=TwoWay}"
                            PlaceholderText="octopus.example.com"
                            AutomationProperties.Name="{l:MobileLangResource SignInServer}" />
            <arcm:TextField Name="AccessKeyInput"
                            Text="{Binding AccessKey, Mode=TwoWay}"
                            PlaceholderText="{l:MobileLangResource SignInAccessKeyPlaceholder}"
                            AutomationProperties.Name="{l:MobileLangResource SignInAccessKey}" />
            <arcm:Button Name="StartButton"
                         Variant="Filled"
                         HorizontalAlignment="Stretch"
                         HorizontalContentAlignment="Center"
                         Content="{l:MobileLangResource SignInStart}"
                         Command="{Binding StartCommand}" />
            <arcm:Button Name="ScanQrButton"
                         Variant="Tinted"
                         HorizontalAlignment="Stretch"
                         HorizontalContentAlignment="Center"
                         Content="{l:MobileLangResource ScanRelayQrCode}"
                         Command="{Binding ScanQrCommand}"
                         IsVisible="{Binding CanScanQr}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" IsVisible="{Binding SignIn.IsStarting}">
                <arc:ArcSpinner Width="12" Height="12" VerticalAlignment="Center" />
                <TextBlock Classes="muted" Text="{l:MobileLangResource SignInStarting}" />
            </StackPanel>
        </StackPanel>

        <!-- Then: the code, to be confirmed in the browser. -->
        <Panel IsVisible="{Binding SignIn.HasCode}">
            <vm:SignInCodeView Name="CodeView" DataContext="{Binding SignIn}" />
        </Panel>

        <TextBlock Name="Error"
                   Text="{Binding SignIn.ErrorText}"
                   Foreground="{arc:ArcDesignTokenResource Danger}"
                   TextWrapping="Wrap"
                   TextAlignment="Center"
                   IsVisible="{Binding SignIn.HasError}" />
    </StackPanel>
</arcm:Page>
