<arcm:Page xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
           xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
           xmlns:l="using:Octopus.Mobile.Localization"
           xmlns:vm="using:Octopus.Mobile.Conversations"
           xmlns:ws="using:Octopus.Mobile.Workspace"
           xmlns:common="using:Octopus.Mobile.Common"
           xmlns:ticker="using:Octopus.Ticker"
           xmlns:mentions="using:Octopus.App.Common.Mentions"
           xmlns:voice="using:Octopus.Mobile.Voice"
           x:Class="Octopus.Mobile.Conversations.ConversationPage"
           x:DataType="vm:ConversationViewModel"
           AvoidKeyboard="True">
    <arcm:Page.Resources>
        <StreamGeometry x:Key="MoreGlyph">M12 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2z M19 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2z M5 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2z</StreamGeometry>
        <StreamGeometry x:Key="ClipGlyph">M21 11l-8.5 8.5a5 5 0 0 1-7-7L14 4a3.5 3.5 0 0 1 5 5l-8.5 8.5a2 2 0 0 1-3-3L15 7</StreamGeometry>
        <StreamGeometry x:Key="ChevronDownGlyph">M6 9l6 6 6-6</StreamGeometry>
        <StreamGeometry x:Key="ChevronUpGlyph">M18 15l-6-6-6 6</StreamGeometry>
        <StreamGeometry x:Key="ChevronRightGlyph">M9 6l6 6-6 6</StreamGeometry>
        <StreamGeometry x:Key="CircleCheckGlyph">M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M9 12l2 2 4-4</StreamGeometry>
        <StreamGeometry x:Key="CircleAlertGlyph">M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 8v4 M12 16h.01</StreamGeometry>
        <StreamGeometry x:Key="CircleGlyph">M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z</StreamGeometry>
        <StreamGeometry x:Key="AtGlyph">M12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-4 8</StreamGeometry>
        <StreamGeometry x:Key="StopGlyph">M6 8a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2z</StreamGeometry>
        <StreamGeometry x:Key="MicGlyph">M12 3a3 3 0 0 1 3 3v5a3 3 0 0 1-6 0V6a3 3 0 0 1 3-3z M5 11a7 7 0 0 0 14 0 M12 18v3</StreamGeometry>
        <StreamGeometry x:Key="KeyboardGlyph">M4 6h16a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z M6 10h.01 M10 10h.01 M14 10h.01 M18 10h.01 M7 14h10</StreamGeometry>
        <StreamGeometry x:Key="CloseGlyph">M18 6L6 18 M6 6l12 12</StreamGeometry>
        <StreamGeometry x:Key="SendUpGlyph">M12 19V5 M5 12l7-7 7 7</StreamGeometry>
        <StreamGeometry x:Key="ZapGlyph">M13 2L3 14h9l-1 8 10-12h-9l1-8z</StreamGeometry>
    </arcm:Page.Resources>

    <arcm:Page.Styles>
        <!-- Right-aligned user message bubble and its attachment chips. -->
        <Style Selector="Border.userBubble">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}" />
            <Setter Property="CornerRadius" Value="16,16,4,16" />
            <Setter Property="Padding" Value="12,8" />
        </Style>
        <Style Selector="Border.attachChip">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
            <Setter Property="Padding" Value="8,3" />
        </Style>

        <!-- Zero-card pure-text tappable rows for Scheme C unified work area & steps. -->
        <Style Selector="Button.plainHit">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.plainHit:pressed">
            <Setter Property="Opacity" Value="0.65" />
        </Style>

        <!-- Scheme C 5-line sliding ticker typography (zero card). -->
        <Style Selector="TextBlock.tickerVerb">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.tickerVerb.failed">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
        <Style Selector="ticker|TickerTargetText.tickerTarget">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="ticker|TickerTargetText.tickerTarget:not(.thought)">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="ticker|TickerTargetText.tickerTarget.failed">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>

        <!-- Expanded pure-text step rows (zero card). -->
        <Style Selector="TextBlock.stepMark">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.stepMark.failed">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
        <Style Selector="TextBlock.stepVerb">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="TextBlock.stepVerb.failed">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
        <Style Selector="TextBlock.stepTarget">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.stepTarget:not(.thought)">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.stepTarget.failed">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>

        <!-- Pure-text diff counts & detail lines. -->
        <Style Selector="TextBlock.diffAddedCount">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Success}" />
        </Style>
        <Style Selector="TextBlock.diffRemovedCount">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
        <Style Selector="Border.diffLine">
            <Setter Property="Padding" Value="6,1" />
        </Style>
        <Style Selector="Border.diffLine.added">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SuccessSubtle}" />
        </Style>
        <Style Selector="Border.diffLine.removed">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource DangerSubtle}" />
        </Style>
        <Style Selector="TextBlock.diffText">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.diffText.added">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Success}" />
        </Style>
        <Style Selector="TextBlock.diffText.removed">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
        <Style Selector="TextBlock.monoOutput">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="LineHeight" Value="17" />
        </Style>

        <!-- Markdown fenced code block. -->
        <Style Selector="Border.codeBlock">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="TextBlock.codeText">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="LineHeight" Value="18" />
        </Style>

        <!-- Lightweight left-accent strips for interactive permission & question prompts (no heavy card). -->
        <Style Selector="Border.permStrip">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Warning}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="Padding" Value="10,4,0,4" />
        </Style>
        <Style Selector="Border.permStrip.resolved">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        </Style>
        <Style Selector="TextBlock.permTitle">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Warning}" />
        </Style>
        <Style Selector="Border.permStrip.resolved TextBlock.permTitle">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="arcm|Button.permOption">
            <Setter Property="Variant" Value="Tinted" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="arcm|Button.permOption.allow">
            <Setter Property="Variant" Value="Filled" />
        </Style>
        <Style Selector="arcm|Button.permOption.reject">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>

        <Style Selector="Border.questionStrip">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="Padding" Value="10,4,0,4" />
        </Style>
        <Style Selector="Border.questionStrip.resolved">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        </Style>
        <Style Selector="Button.choiceRow">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.choiceRow.selected">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>
        <Style Selector="Border.choiceMark">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.choiceMark.selected">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>

        <!-- Hold to talk (design/ui/移动端输入框重写与语音输入方案.html, scheme B): the bar, the overlay and its targets. -->
        <Style Selector="Border.holdToTalk">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="Border.holdToTalk.pressed">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Border}" />
        </Style>
        <Style Selector="Border.holdToTalk TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        </Style>
        <Style Selector="Border.voiceProblem">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource WarningSubtle}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12,6,6,6" />
        </Style>
        <Style Selector="Border.voiceBackdrop">
            <Setter Property="Background" Value="#A6000000" />
        </Style>
        <Style Selector="Border.voiceBubble">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style Selector="Grid.cancel Border.voiceBubble">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
        <Style Selector="voice|VoiceWaveform">
            <Setter Property="BarBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>
        <Style Selector="Grid.cancel voice|VoiceWaveform">
            <Setter Property="BarBrush" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
        <Style Selector="TextBlock.voiceMeta">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="TextBlock.voiceMeta.warn">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Warning}" />
        </Style>
        <Style Selector="TextBlock.voiceText">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="LineHeight" Value="24" />
        </Style>
        <Style Selector="Run.voiceFaint">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="Border.voiceTarget">
            <Setter Property="Width" Value="68" />
            <Setter Property="Height" Value="68" />
            <Setter Property="CornerRadius" Value="34" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.voiceTarget TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="Border.voiceTarget arc|ArcGlyph">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="Grid.cancel Border.cancelTarget">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Danger}" />
            <Setter Property="RenderTransform" Value="scale(1.2)" />
        </Style>
        <Style Selector="Grid.send Border.sendTarget">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}" />
            <Setter Property="RenderTransform" Value="scale(1.2)" />
        </Style>
        <Style Selector="Grid.cancel Border.cancelTarget TextBlock, Grid.send Border.sendTarget TextBlock">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentForeground}" />
        </Style>
        <Style Selector="Grid.cancel Border.cancelTarget arc|ArcGlyph, Grid.send Border.sendTarget arc|ArcGlyph">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentForeground}" />
        </Style>
        <Style Selector="Border.voiceArc">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="CornerRadius" Value="220,220,0,0" />
            <Setter Property="Margin" Value="-80,0,-80,0" />
            <Setter Property="Height" Value="140" />
        </Style>
        <Style Selector="TextBlock#VoiceReleaseHint">
            <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="Grid.cancel TextBlock#VoiceReleaseHint">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
        <Style Selector="Grid.send TextBlock#VoiceReleaseHint">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>

        <!-- Composer option chips above the prompt field. -->
        <Style Selector="Button.optionChip">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
            <Setter Property="Padding" Value="10,4" />
        </Style>

        <!-- Staged composer attachment chips (images & files) and Send Now pill. -->
        <Style Selector="Border.pendingAttachChip">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="Button.sendNowBtn">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.sendNowBtn:pressed">
            <Setter Property="Opacity" Value="0.72" />
        </Style>

        <!-- Docked collapsible workflow task list tray above the composer (Scheme A). -->
        <Style Selector="Border.taskTray">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style Selector="ProgressBar.taskHairline">
            <Setter Property="Height" Value="2" />
            <Setter Property="MinHeight" Value="2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>
        <Style Selector="ProgressBar.taskHairline.done">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Success}" />
        </Style>
        <Style Selector="Border.taskRatioBadge">
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="Border.taskRatioBadge TextBlock">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="Border.taskRatioBadge.done">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SuccessSubtle}" />
        </Style>
        <Style Selector="Border.taskRatioBadge.done TextBlock">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Success}" />
        </Style>
        <Style Selector="Border.taskRow">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.taskRow.active">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>
        <Style Selector="Border.taskRow.failed">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource DangerSubtle}" />
        </Style>
        <Style Selector="Border.taskRail">
            <Setter Property="Width" Value="2.5" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.taskRail.active">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>
        <Style Selector="Border.taskRail.done">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Success}" />
        </Style>
        <Style Selector="Border.taskRail.failed">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
        <Style Selector="TextBlock.taskIndex">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.taskIndex.active">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.taskTitle">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="TextBlock.taskTitle.active">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.taskTitle.done">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="TextBlock.taskTitle.failed">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
        </Style>
    </arcm:Page.Styles>

    <arcm:Page.DataTemplates>
        <!-- Scheme C: Single slot in the fixed 5-line sliding live ticker (pure text, zero card). -->
        <DataTemplate DataType="ws:ConversationTickerLine">
            <Grid IsVisible="{Binding IsVisible}"
                  ColumnDefinitions="14,Auto,*,Auto"
                  ColumnSpacing="6"
                  Margin="0,1">
                <Panel Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center">
                    <arc:ArcSpinner Width="10" Height="10" IsVisible="{Binding IsRunning}" VerticalAlignment="Center" />
                    <TextBlock Text="✓" FontSize="11" Foreground="{arc:ArcDesignTokenResource TextMuted}"
                               IsVisible="{Binding IsCompleted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="✕" FontSize="11" Foreground="{arc:ArcDesignTokenResource Danger}"
                               IsVisible="{Binding IsFailed}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
                <TextBlock Grid.Column="1"
                           Classes="tickerVerb"
                           Classes.failed="{Binding IsFailed}"
                           Text="{Binding Verb}"
                           VerticalAlignment="Center" />
                <ticker:TickerTargetText Grid.Column="2"
                                         Classes="tickerTarget"
                                         Classes.thought="{Binding IsThought}"
                                         Classes.failed="{Binding IsFailed}"
                                         Text="{Binding Target}"
                                         StepKey="{Binding StepKey}"
                                         AnimateUpdates="{Binding IsActiveThought}"
                                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="3"
                           IsVisible="{Binding HasStat}"
                           Text="{Binding StatText}"
                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                           FontSize="11"
                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- Scheme C: Fixed 5-slot sliding live ticker container (mounted ONLY while streaming & collapsed). -->
        <DataTemplate DataType="ws:ConversationWorkTicker">
            <ticker:WorkTickerViewport Margin="14,2,0,0" Spacing="1" />
        </DataTemplate>

        <!-- One pure-text step inside the expanded unified work area (zero card; lazy-mounts details on tap). -->
        <DataTemplate DataType="ws:ConversationWorkStep">
            <StackPanel Spacing="0">
                <Button Classes="plainHit"
                        Padding="0,4"
                        IsHitTestVisible="{Binding CanExpand}"
                        Command="{Binding $parent[arcm:Page].((vm:ConversationViewModel)DataContext).ToggleWorkStepCommand}"
                        CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="14,*,Auto,Auto" ColumnSpacing="6">
                        <Panel Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center">
                            <arc:ArcSpinner Width="10" Height="10" IsVisible="{Binding IsRunning}" VerticalAlignment="Center" />
                            <TextBlock Classes="stepMark"
                                       Classes.failed="{Binding IsFailed}"
                                       IsVisible="{Binding !IsRunning}"
                                       Text="{Binding StatusMark}" />
                        </Panel>
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0"
                                       Classes="stepVerb"
                                       Classes.failed="{Binding IsFailed}"
                                       IsVisible="{Binding HasVerb}"
                                       Margin="0,0,6,0"
                                       Text="{Binding Verb}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Classes="stepTarget"
                                       Classes.thought="{Binding IsProse}"
                                       Classes.failed="{Binding IsFailed}"
                                       Text="{Binding Target}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Classes="diffAddedCount" Text="{Binding AddedText}" IsVisible="{Binding HasAdded}" />
                            <TextBlock Classes="diffRemovedCount" Text="{Binding RemovedText}" IsVisible="{Binding HasRemoved}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3"
                                   IsVisible="{Binding HasMeta}"
                                   Text="{Binding MetaText}"
                                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                   FontSize="11"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <!-- Lazy pure-text detail pane: null when collapsed so zero detail controls exist until tapped. -->
                <ContentControl Content="{Binding ExpandedDetail}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="ws:ConversationWorkStep">
                            <Border BorderBrush="{arc:ArcDesignTokenResource Border}"
                                    BorderThickness="1,0,0,0"
                                    Margin="14,1,0,6"
                                    Padding="10,2,0,2">
                                <StackPanel Spacing="4">
                                    <!-- Thought pure-text prose -->
                                    <TextBlock IsVisible="{Binding IsThought}"
                                               Text="{Binding ThoughtText}"
                                               Classes="secondary"
                                               FontSize="12.5"
                                               LineHeight="18"
                                               TextWrapping="Wrap" />

                                    <!-- Intermediate text step prose (folded into work area) -->
                                    <TextBlock IsVisible="{Binding IsText}"
                                               Text="{Binding NoteText}"
                                               Classes="secondary"
                                               FontSize="12.5"
                                               LineHeight="18"
                                               TextWrapping="Wrap" />

                                    <!-- Plan pure-text checklist -->
                                    <ItemsControl IsVisible="{Binding IsPlan}" ItemsSource="{Binding PlanItems}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="ws:ConversationPlanItem">
                                                <Grid ColumnDefinitions="14,*" ColumnSpacing="6">
                                                    <TextBlock Text="{Binding StatusMark}" FontSize="11.5"
                                                               Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Content}" FontSize="12.5"
                                                               Classes="secondary" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Tool pure-text command, file link, diff & output -->
                                    <StackPanel IsVisible="{Binding IsTool}" Spacing="4">
                                        <Button Classes="plainHit"
                                                Padding="0,2"
                                                IsVisible="{Binding HasPath}"
                                                Command="{Binding $parent[arcm:Page].((vm:ConversationViewModel)DataContext).OpenFileCommand}"
                                                CommandParameter="{Binding FilePath}">
                                            <Border Classes="attachChip" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal" Spacing="5">
                                                    <arc:ArcGlyph Data="{x:Static arc:ArcIcons.FileText}" Size="12"
                                                                  Foreground="{arc:ArcDesignTokenResource Accent}"
                                                                  VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding FilePath}"
                                                               FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                               FontSize="11.5"
                                                               Foreground="{arc:ArcDesignTokenResource Accent}"
                                                               TextTrimming="CharacterEllipsis"
                                                               MaxWidth="240"
                                                               VerticalAlignment="Center" />
                                                    <arc:ArcGlyph Data="{StaticResource ChevronRightGlyph}" Size="10"
                                                                  Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                  VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                        <TextBlock IsVisible="{Binding HasCommand}"
                                                   Classes="monoOutput"
                                                   Text="{Binding CommandText}"
                                                   TextWrapping="Wrap" />
                                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                                      VerticalScrollBarVisibility="Disabled"
                                                      IsVisible="{Binding Tool.HasDiff, FallbackValue=False}">
                                            <ItemsControl ItemsSource="{Binding Tool.Diff}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="ws:ConversationDiffLine">
                                                        <Border Classes="diffLine"
                                                                Classes.added="{Binding IsAdded}"
                                                                Classes.removed="{Binding IsRemoved}">
                                                            <TextBlock Classes="diffText"
                                                                       Classes.added="{Binding IsAdded}"
                                                                       Classes.removed="{Binding IsRemoved}"
                                                                       Text="{Binding Text}" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock Classes="monoOutput"
                                                   Text="{Binding Tool.Output}"
                                                   TextWrapping="Wrap"
                                                   IsVisible="{Binding Tool.HasOutput, FallbackValue=False}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </StackPanel>
        </DataTemplate>
    </arcm:Page.DataTemplates>

    <arcm:Page.Header>
        <common:SessionTopBar Name="TopBar" DataContext="{Binding WorkspaceMenu}" />
    </arcm:Page.Header>

    <!--
        The composer sits inside the page content (not Page.Footer) so AvoidKeyboard shrinks the timeline and keeps the
        composer directly above the keyboard, matching TerminalPage.axaml (K-A).
    -->
    <Grid RowDefinitions="*,Auto,Auto">
        <!-- Timeline: pinned to the bottom until the person scrolls up. -->
        <ScrollViewer Name="TimelineScroll"
                      Grid.Row="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      BringIntoViewOnFocusChange="False">
            <StackPanel Margin="12,10,12,14" Spacing="12">
                <!-- Non-blocking foreground resume sync indicator when returning directly into an open conversation -->
                <Border Name="ConversationResumeSyncPill"
                        Classes="resumeSyncPill"
                        IsVisible="{Binding IsResuming}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <arc:ArcSpinner Width="12" Height="12" VerticalAlignment="Center" />
                        <TextBlock Text="{l:MobileLangResource ResumeSyncing}"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   FontWeight="SemiBold"
                                   Foreground="{arc:ArcDesignTokenResource Accent}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <TextBlock Name="EarlierNotice"
                           Classes="muted"
                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                           Text="{l:MobileLangResource ConversationEarlier}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           IsVisible="{Binding HasEarlier}" />

                <Border Name="ErrorBanner" Classes="alertCard danger" IsVisible="{Binding HasError}">
                    <StackPanel Spacing="8">
                        <TextBlock Name="ErrorBannerText"
                                   Text="{Binding ErrorText}"
                                   Foreground="{arc:ArcDesignTokenResource Danger}"
                                   TextWrapping="Wrap" />
                        <arcm:Button Name="ReloadButton"
                                     Variant="Tinted"
                                     HorizontalAlignment="Left"
                                     Content="{l:MobileLangResource ConversationReconnect}"
                                     Command="{Binding ReloadCommand}" />
                    </StackPanel>
                </Border>

                <common:MobileLoadingView Name="LoadingView"
                                          Variant="Conversation"
                                          Label="{Binding StatusText}"
                                          IsVisible="{Binding ShowInitialLoading}" />

                <TextBlock Name="EmptyNotice"
                           Classes="muted"
                           Text="{l:MobileLangResource ConversationEmpty}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           Margin="0,32"
                           IsVisible="{Binding IsEmpty}" />

                <ItemsControl Name="Timeline" ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="14" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.DataTemplates>
                        <!-- User message bubble (right-aligned) + optional attachment chips. -->
                        <DataTemplate DataType="ws:ConversationUserEntry">
                            <StackPanel HorizontalAlignment="Right" MaxWidth="310" Spacing="5">
                                <Border Classes="userBubble" IsVisible="{Binding IsPersonMessage}">
                                    <TextBlock Text="{Binding Text}"
                                               Foreground="{arc:ArcDesignTokenResource AccentForeground}"
                                               FontSize="14"
                                               LineHeight="20"
                                               TextWrapping="Wrap" />
                                </Border>
                                <!-- Injected by the collaboration bus (a delegated task, a peer's reply): a card naming the sender and its computer. -->
                                <Border IsVisible="{Binding IsCollabMessage}"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10,8">
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="{Binding CollabHeader}"
                                                   Foreground="{arc:ArcDesignTokenResource Accent}"
                                                   FontSize="11.5"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding CollabFromDeviceText}"
                                                   IsVisible="{Binding HasCollabFromDevice}"
                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                   FontSize="11" />
                                        <TextBlock Text="{Binding DisplayText}"
                                                   FontSize="14"
                                                   LineHeight="20"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Attachments}"
                                              HorizontalAlignment="Right"
                                              IsVisible="{Binding HasAttachments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Button Classes="plainHit"
                                                    HorizontalAlignment="Left"
                                                    Command="{Binding $parent[arcm:Page].((vm:ConversationViewModel)DataContext).OpenFileCommand}"
                                                    CommandParameter="{Binding}">
                                                <Border Classes="attachChip">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <arc:ArcGlyph Data="{StaticResource ClipGlyph}" Size="12"
                                                                      Foreground="{arc:ArcDesignTokenResource Accent}"
                                                                      VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding}"
                                                                   Foreground="{arc:ArcDesignTokenResource Accent}"
                                                                   FontSize="11.5"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>

                        <!-- Assistant turn (Scheme C): One unified zero-card pure-text Work Area + clean Markdown body. -->
                        <DataTemplate DataType="ws:ConversationAssistantEntry">
                            <StackPanel Spacing="8">
                                <!-- Single Unified Pure-Text Work Area (collapsed to 1 line on finish; fixed 5-line ticker while running) -->
                                <StackPanel IsVisible="{Binding HasWorkArea}" Spacing="2">
                                    <Button Classes="plainHit"
                                            Padding="0,4"
                                            IsHitTestVisible="{Binding CanExpandWork}"
                                            Command="{Binding $parent[arcm:Page].((vm:ConversationViewModel)DataContext).ToggleWorkCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                                            <Panel Grid.Column="0" VerticalAlignment="Center" IsVisible="{Binding CanExpandWork}">
                                                <arc:ArcGlyph Data="{StaticResource ChevronRightGlyph}" Size="11"
                                                              Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                              IsVisible="{Binding !IsWorkExpanded}" />
                                                <arc:ArcGlyph Data="{StaticResource ChevronDownGlyph}" Size="11"
                                                              Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                              IsVisible="{Binding IsWorkExpanded}" />
                                            </Panel>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding WorkHeaderTitle}"
                                                       FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2"
                                                       IsVisible="{Binding HasWorkHeaderCounts}"
                                                       Text="{Binding WorkHeaderCounts}"
                                                       Classes="muted"
                                                       FontSize="12"
                                                       MaxLines="1"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3"
                                                       IsVisible="{Binding HasWorkFailures}"
                                                       Text="{Binding WorkHeaderFailedText}"
                                                       FontSize="12"
                                                       FontWeight="Medium"
                                                       Foreground="{arc:ArcDesignTokenResource Danger}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="4"
                                                       IsVisible="{Binding HasDuration}"
                                                       Text="{Binding Duration}"
                                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                       FontSize="11.5"
                                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>

                                    <!-- Scheme C fixed 5-line sliding pure-text ticker (null & unmounted on finish or expand) -->
                                    <ContentControl Content="{Binding LiveTicker}" />

                                    <!-- Lazy-mounted pure-text step log (null & unmounted when collapsed) -->
                                    <Border IsVisible="{Binding IsWorkExpanded}"
                                            BorderBrush="{arc:ArcDesignTokenResource Border}"
                                            BorderThickness="1.5,0,0,0"
                                            Margin="5,2,0,2"
                                            Padding="10,1,0,1">
                                        <ItemsControl ItemsSource="{Binding ExpandedWorkSteps}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </Border>
                                </StackPanel>

                                <!-- Rich NativeAOT-safe Markdown body (tables, inline code/links, images, code blocks) below the unified work area. -->
                                <common:MobileMarkdownView Name="AssistantMarkdown"
                                                           Markdown="{Binding Text}"
                                                           IsStreaming="{Binding IsStreaming}"
                                                           LinkTargetCommand="{Binding $parent[arcm:Page].((vm:ConversationViewModel)DataContext).OpenLinkCommand}"
                                                           IsVisible="{Binding HasText}" />

                                <!-- Reassuring live loading status & rotating i18n whimsical phrases at the bottom while working. -->
                                <Border IsVisible="{Binding ShowLiveStatus}"
                                        HorizontalAlignment="Left"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        CornerRadius="6"
                                        Padding="8,4"
                                        Margin="0,2,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <arc:ArcSpinner Width="11" Height="11" VerticalAlignment="Center" />
                                        <TextBlock FontSize="12"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                   Text="{Binding LiveStatusText}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- Lightweight pure-text error line (zero card). -->
                                <Border BorderThickness="2,0,0,0"
                                        BorderBrush="{arc:ArcDesignTokenResource Danger}"
                                        Padding="10,2,0,2"
                                        IsVisible="{Binding HasError}">
                                    <TextBlock Text="{Binding ErrorText}"
                                               Foreground="{arc:ArcDesignTokenResource Danger}"
                                               FontSize="13"
                                               TextWrapping="Wrap" />
                                </Border>

                                <!-- Duration shown standalone only for pure-text turns with zero work steps. -->
                                <TextBlock Text="{Binding Duration}"
                                           Classes="muted"
                                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                           FontSize="11.5"
                                           IsVisible="{Binding ShowStandaloneDuration}" />
                            </StackPanel>
                        </DataTemplate>

                        <!-- Permission prompt: lightweight left-accent strip, collapses to resolved text once answered. -->
                        <DataTemplate DataType="ws:ConversationPermissionEntry">
                            <Border Classes="permStrip" Classes.resolved="{Binding IsResolved}">
                                <StackPanel Spacing="6">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0"
                                                   Classes="permTitle"
                                                   Text="{Binding Title}"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   FontSize="12"
                                                   Foreground="{arc:ArcDesignTokenResource Success}"
                                                   Text="{Binding ResolvedText}"
                                                   IsVisible="{Binding IsResolved}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <TextBlock Classes="monoOutput"
                                               Text="{Binding Detail}"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasDetail}" />

                                    <TextBlock Text="{Binding Warning}"
                                               Foreground="{arc:ArcDesignTokenResource Danger}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasWarning}" />

                                    <ItemsControl ItemsSource="{Binding Options}"
                                                  IsVisible="{Binding !IsResolved}"
                                                  IsEnabled="{Binding IsOpen}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="ws:ConversationPermissionOption">
                                                <arcm:Button Classes="permOption"
                                                             Classes.allow="{Binding IsAllow}"
                                                             Classes.reject="{Binding IsReject}"
                                                             Content="{Binding Label}"
                                                             Command="{Binding $parent[arcm:Page].((vm:ConversationViewModel)DataContext).RespondCommand}"
                                                             CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>

                        <!-- Question prompt: lightweight left-accent strip, single/multi-select choices, submit. -->
                        <DataTemplate DataType="ws:ConversationQuestionEntry">
                            <Border Classes="questionStrip" Classes.resolved="{Binding IsResolved}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   FontSize="12"
                                                   Foreground="{arc:ArcDesignTokenResource Success}"
                                                   Text="{Binding ResolvedText}"
                                                   IsVisible="{Binding IsResolved}"
                                                   VerticalAlignment="Center" />
                                    </Grid>

                                    <ItemsControl ItemsSource="{Binding Fields}"
                                                  IsVisible="{Binding !IsResolved}"
                                                  IsEnabled="{Binding IsOpen}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="10" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="ws:ConversationQuestionField">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="{Binding Prompt}"
                                                               Classes="fieldLabel"
                                                               Margin="0"
                                                               TextWrapping="Wrap"
                                                               IsVisible="{Binding HasPrompt}" />
                                                    <ItemsControl ItemsSource="{Binding Choices}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Spacing="6" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="ws:ConversationChoice">
                                                                <Button Classes="choiceRow"
                                                                        Classes.selected="{Binding IsSelected}"
                                                                        Command="{Binding $parent[arcm:Page].((vm:ConversationViewModel)DataContext).ToggleChoiceCommand}"
                                                                        CommandParameter="{Binding}">
                                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                                        <Border Classes="choiceMark" Classes.selected="{Binding IsSelected}">
                                                                            <arc:ArcGlyph Data="{x:Static arc:ArcIcons.Check}" Size="11"
                                                                                          Foreground="{arc:ArcDesignTokenResource AccentForeground}"
                                                                                          HorizontalAlignment="Center"
                                                                                          VerticalAlignment="Center"
                                                                                          IsVisible="{Binding IsSelected}" />
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Label}"
                                                                                       FontSize="13.5"
                                                                                       FontWeight="SemiBold"
                                                                                       TextWrapping="Wrap" />
                                                                            <TextBlock Text="{Binding Detail}"
                                                                                       Classes="secondary"
                                                                                       FontSize="12"
                                                                                       TextWrapping="Wrap"
                                                                                       IsVisible="{Binding HasDetail}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <arcm:TextField Text="{Binding FreeText, Mode=TwoWay}"
                                                                    PlaceholderText="{l:MobileLangResource ConversationFreeText}"
                                                                    IsVisible="{Binding AllowFreeText}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <arcm:Button Variant="Filled"
                                                 HorizontalAlignment="Stretch"
                                                 HorizontalContentAlignment="Center"
                                                 Content="{l:MobileLangResource ConversationSubmit}"
                                                 Command="{Binding $parent[arcm:Page].((vm:ConversationViewModel)DataContext).SubmitQuestionCommand}"
                                                 CommandParameter="{Binding}"
                                                 IsVisible="{Binding !IsResolved}"
                                                 IsEnabled="{Binding IsOpen}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- Docked workflow task list tray above the composer (collapsed to 1-line progress bar by default on mobile). -->
        <Border Name="TaskListTray" Grid.Row="1" Classes="taskTray" IsVisible="{Binding HasTasks}">
            <StackPanel Spacing="0">
                <Button Name="TaskListToggle"
                        Classes="plainHit"
                        Padding="12,8"
                        Command="{Binding ToggleTaskListCommand}"
                        AutomationProperties.Name="{l:MobileLangResource ConversationTaskToggle}">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                        <Panel Grid.Column="0" Width="14" Height="14" VerticalAlignment="Center">
                            <arc:ArcSpinner Width="12" Height="12"
                                            Foreground="{arc:ArcDesignTokenResource Accent}"
                                            IsVisible="{Binding HasRunningTasks}" />
                            <arc:ArcGlyph Data="{StaticResource CircleCheckGlyph}" Size="13"
                                          Foreground="{arc:ArcDesignTokenResource Success}"
                                          IsVisible="{Binding IsAllTasksCompleted}" />
                            <arc:ArcGlyph Data="{StaticResource CircleAlertGlyph}" Size="13"
                                          Foreground="{arc:ArcDesignTokenResource Danger}"
                                          IsVisible="{Binding HasFailedTasks}" />
                            <arc:ArcGlyph Data="{StaticResource CircleGlyph}" Size="12"
                                          Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                          Opacity="0.65"
                                          IsVisible="{Binding IsTasksIdlePending}" />
                        </Panel>
                        <TextBlock Name="TaskListHeadline"
                                   Grid.Column="1"
                                   Text="{Binding TaskTrayHeadline}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   MaxLines="1"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="2"
                                Classes="taskRatioBadge"
                                Classes.done="{Binding IsAllTasksCompleted}">
                            <TextBlock Name="TaskListRatio" Text="{Binding TaskRatioText}" />
                        </Border>
                        <Panel Grid.Column="3" Width="14" Height="14" VerticalAlignment="Center">
                            <arc:ArcGlyph Data="{StaticResource ChevronUpGlyph}" Size="12"
                                          Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                          IsVisible="{Binding !IsTaskListExpanded}" />
                            <arc:ArcGlyph Data="{StaticResource ChevronDownGlyph}" Size="12"
                                          Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                          IsVisible="{Binding IsTaskListExpanded}" />
                        </Panel>
                    </Grid>
                </Button>

                <ProgressBar Classes="taskHairline"
                             Classes.done="{Binding IsAllTasksCompleted}"
                             Minimum="0"
                             Maximum="100"
                             Value="{Binding TaskProgressPercent}" />

                <Border Name="TaskListBody"
                        IsVisible="{Binding IsTaskListExpanded}"
                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                        BorderThickness="0,1,0,0">
                    <ScrollViewer MaxHeight="220"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl Name="TaskListItems" ItemsSource="{Binding Tasks}" Margin="8,6">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="3" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="ws:ConversationWorkflowTask">
                                    <Border Classes="taskRow"
                                            Classes.active="{Binding IsInProgress}"
                                            Classes.done="{Binding IsCompleted}"
                                            Classes.failed="{Binding IsFailed}">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="7">
                                            <Border Grid.Column="0" Classes="taskRail"
                                                    Classes.active="{Binding IsInProgress}"
                                                    Classes.done="{Binding IsCompleted}"
                                                    Classes.failed="{Binding IsFailed}" />
                                            <Panel Grid.Column="1" Width="14" Height="14" VerticalAlignment="Center">
                                                <arc:ArcSpinner Width="12" Height="12"
                                                                Foreground="{arc:ArcDesignTokenResource Accent}"
                                                                IsVisible="{Binding IsInProgress}" />
                                                <arc:ArcGlyph Data="{StaticResource CircleCheckGlyph}" Size="13"
                                                              Foreground="{arc:ArcDesignTokenResource Success}"
                                                              IsVisible="{Binding IsCompleted}" />
                                                <arc:ArcGlyph Data="{StaticResource CircleAlertGlyph}" Size="13"
                                                              Foreground="{arc:ArcDesignTokenResource Danger}"
                                                              IsVisible="{Binding IsFailed}" />
                                                <arc:ArcGlyph Data="{StaticResource CircleGlyph}" Size="12"
                                                              Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                              Opacity="0.55"
                                                              IsVisible="{Binding IsPending}" />
                                            </Panel>
                                            <TextBlock Grid.Column="2" Classes="taskIndex"
                                                       Classes.active="{Binding IsInProgress}"
                                                       Text="{Binding DisplayId}" />
                                            <StackPanel Grid.Column="3" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Classes="taskTitle"
                                                           Classes.active="{Binding IsInProgress}"
                                                           Classes.done="{Binding IsCompleted}"
                                                           Classes.failed="{Binding IsFailed}"
                                                           Text="{Binding Title}"
                                                           MaxLines="2"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Classes="muted"
                                                           FontSize="11"
                                                           IsVisible="{Binding HasActiveForm}"
                                                           Text="{Binding ActiveForm}"
                                                           MaxLines="1"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Border IsVisible="{Binding IsInProgress}"
                                                        Padding="6,2"
                                                        CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                                        Background="{arc:ArcDesignTokenResource AccentSubtle}">
                                                    <TextBlock FontSize="10.5" FontWeight="SemiBold"
                                                               Foreground="{arc:ArcDesignTokenResource Accent}"
                                                               Text="{l:MobileLangResource ConversationTaskInProgress}" />
                                                </Border>
                                                <Border IsVisible="{Binding HasOwner}"
                                                        Padding="5,1"
                                                        CornerRadius="4"
                                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                                                    <TextBlock FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                               FontSize="10"
                                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                               Text="{Binding Owner}" />
                                                </Border>
                                                <Border IsVisible="{Binding HasBlockedBy}"
                                                        Padding="5,1"
                                                        CornerRadius="4"
                                                        Background="{arc:ArcDesignTokenResource WarningSubtle}">
                                                    <TextBlock FontSize="10"
                                                               Foreground="{arc:ArcDesignTokenResource Warning}"
                                                               Text="{Binding BlockedByText}" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </Border>

        <!-- Bottom composer: option chips + queued badge, prompt field, stop & send buttons. -->
        <Border Name="ComposerBar" Grid.Row="2" Classes="bar" Padding="10,8">
            <StackPanel Spacing="8">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              IsVisible="{Binding ShowComposerTopRow}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Name="ModelChip"
                                Classes="optionChip"
                                IsVisible="{Binding Composer.HasModels}"
                                Command="{Binding OpenModelPickerCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding Composer.ModelLabel}"
                                           Classes="secondary"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <arc:ArcGlyph Data="{StaticResource ChevronDownGlyph}" Size="11"
                                              Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                              VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Name="ModeChip"
                                Classes="optionChip"
                                IsVisible="{Binding Composer.HasModes}"
                                Command="{Binding OpenModePickerCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding Composer.ModeLabel}"
                                           Classes="secondary"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <arc:ArcGlyph Data="{StaticResource ChevronDownGlyph}" Size="11"
                                              Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                              VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Name="EffortChip"
                                Classes="optionChip"
                                IsVisible="{Binding Composer.HasEfforts}"
                                Command="{Binding OpenEffortPickerCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding Composer.EffortLabel}"
                                           Classes="secondary"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <arc:ArcGlyph Data="{StaticResource ChevronDownGlyph}" Size="11"
                                              Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                              VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border Name="QueuedBadge" Classes="pill working" IsVisible="{Binding HasQueued}">
                            <TextBlock Name="QueuedText" Text="{Binding QueuedText}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- @ suggestions for the query before the caret, just above the keyboard; a tap writes the token. -->
                <ScrollViewer Name="MentionStrip"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              IsVisible="{Binding IsMentionStripOpen}">
                    <ItemsControl ItemsSource="{Binding MentionSuggestions}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="ws:ConversationMentionTarget">
                                <Button Classes="optionChip"
                                        Command="{Binding $parent[arcm:Page].((vm:ConversationViewModel)DataContext).InsertMentionCommand}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Spacing="1">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="Medium" />
                                        <TextBlock Text="{Binding Subtitle}" Classes="secondary" FontSize="11"
                                                   IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Why the microphone cannot be used right now, with the way to the voice settings. -->
                <Border Name="VoiceProblemBanner" Classes="voiceProblem" IsVisible="{Binding Voice.HasProblem}">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4">
                        <TextBlock Name="VoiceProblemText"
                                   Text="{Binding Voice.ProblemText}"
                                   TextWrapping="Wrap"
                                   FontSize="12.5"
                                   VerticalAlignment="Center" />
                        <Button Name="VoiceProblemSettings"
                                Grid.Column="1"
                                Classes="inlineLinkBtn"
                                Content="{l:MobileLangResource VoiceOpenSettings}"
                                Command="{Binding Voice.OpenSettingsCommand}" />
                        <Button Grid.Column="2"
                                Classes="inlineLinkBtn"
                                Content="✕"
                                Command="{Binding Voice.DismissProblemCommand}"
                                AutomationProperties.Name="{l:MobileLangResource Cancel}" />
                    </Grid>
                </Border>

                <!-- Upload progress indicator while sending an image or file to the host. -->
                <StackPanel Name="UploadStatusRow"
                            Orientation="Horizontal"
                            Spacing="6"
                            IsVisible="{Binding IsUploading}">
                    <arc:ArcSpinner Width="12" Height="12" VerticalAlignment="Center" />
                    <TextBlock Name="UploadStatusText"
                               Classes="secondary"
                               FontSize="12"
                               Text="{Binding UploadText}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Staged image & file attachment chips waiting to go out with the next prompt. -->
                <ScrollViewer Name="PendingAttachmentsStrip"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled"
                              IsVisible="{Binding HasPendingAttachments}">
                    <ItemsControl ItemsSource="{Binding PendingAttachments}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ConversationAttachmentItem">
                                <Border Classes="pendingAttachChip">
                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                        <arc:ArcGlyph Data="{Binding Icon}" Size="13"
                                                      Foreground="{arc:ArcDesignTokenResource Accent}"
                                                      VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12"
                                                   MaxWidth="160"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                        <Button Classes="inlineLinkBtn"
                                                Padding="2,0"
                                                Command="{Binding $parent[arcm:Page].((vm:ConversationViewModel)DataContext).RemoveAttachmentCommand}"
                                                CommandParameter="{Binding}"
                                                AutomationProperties.Name="{l:MobileLangResource ConversationRemoveAttachment}">
                                            <arc:ArcGlyph Data="{StaticResource CloseGlyph}" Size="12"
                                                          Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                          VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                    <!-- Microphone / keyboard: switches the field for the "hold to talk" bar and back. -->
                    <Panel Grid.Column="0" VerticalAlignment="Bottom" IsVisible="{Binding Voice.IsSupported}">
                        <arcm:IconButton Name="VoiceModeButton"
                                         Variant="Plain"
                                         Icon="{StaticResource MicGlyph}"
                                         Command="{Binding Voice.ToggleVoiceModeCommand}"
                                         IsVisible="{Binding !Voice.IsVoiceMode}"
                                         AutomationProperties.Name="{l:MobileLangResource VoiceSwitchToVoice}" />
                        <arcm:IconButton Name="KeyboardModeButton"
                                         Variant="Plain"
                                         Icon="{StaticResource KeyboardGlyph}"
                                         Command="{Binding Voice.ToggleVoiceModeCommand}"
                                         IsVisible="{Binding Voice.IsVoiceMode}"
                                         AutomationProperties.Name="{l:MobileLangResource VoiceSwitchToKeyboard}" />
                    </Panel>
                    <!-- Attach image or file (typing '@' in the field triggers inline @mentions directly). -->
                    <Panel Grid.Column="1" VerticalAlignment="Bottom" IsVisible="{Binding !Voice.IsVoiceMode}">
                        <arcm:IconButton Name="AttachButton"
                                         Variant="Plain"
                                         Icon="{StaticResource ClipGlyph}"
                                         Command="{Binding OpenAttachPickerCommand}"
                                         IsVisible="{Binding CanAttach}"
                                         IsEnabled="{Binding !IsUploading}"
                                         AutomationProperties.Name="{l:MobileLangResource ConversationAttach}" />
                    </Panel>
                    <!-- Multi-line composer: grows up to ~5 lines and scrolls internally; '@' triggers inline mention strip. -->
                    <arcm:TextField Name="PromptField"
                                    Grid.Column="2"
                                    Text="{Binding PromptText, Mode=TwoWay}"
                                    CaretIndex="{Binding PromptCaretIndex, Mode=TwoWay}"
                                    mentions:MentionEditing.Tokens="{Binding MentionTokens}"
                                    mentions:MentionEditing.HighlightBrush="{arc:ArcDesignTokenResource AccentSubtle}"
                                    AcceptsReturn="True"
                                    TextWrapping="Wrap"
                                    Height="NaN"
                                    MinHeight="44"
                                    MaxHeight="132"
                                    PlaceholderText="{l:MobileLangResource ConversationPlaceholder}"
                                    IsVisible="{Binding !Voice.IsVoiceMode}"
                                    VerticalAlignment="Center" />
                    <!-- Pressed, held, dragged and released: ConversationPage.axaml.cs reports the finger to Voice. -->
                    <Border Name="HoldToTalkBar"
                            Grid.Column="2"
                            Classes="holdToTalk"
                            Classes.pressed="{Binding Voice.IsRecording}"
                            IsVisible="{Binding Voice.IsVoiceMode}"
                            AutomationProperties.Name="{l:MobileLangResource VoiceHoldToTalk}">
                        <TextBlock Text="{Binding Voice.HoldText}" />
                    </Border>
                    <!-- Shown while active + input has content: interrupts the active turn and sends immediately instead of queueing. -->
                    <Panel Grid.Column="3" VerticalAlignment="Bottom" IsVisible="{Binding !Voice.IsVoiceMode}">
                        <Button Name="SendNowButton"
                                Classes="sendNowBtn"
                                Command="{Binding SendNowCommand}"
                                IsVisible="{Binding CanSendNow}"
                                AutomationProperties.Name="{l:MobileLangResource ConversationSendNow}">
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <arc:ArcGlyph Data="{StaticResource ZapGlyph}" Size="12"
                                              Foreground="{arc:ArcDesignTokenResource Accent}"
                                              VerticalAlignment="Center" />
                                <TextBlock Text="{l:MobileLangResource ConversationSendNow}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{arc:ArcDesignTokenResource Accent}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Panel>
                    <!-- Merged right-side primary action: Stop when active & empty; Send (queue when active) when input has text/attachments or idle. -->
                    <Panel Grid.Column="4" VerticalAlignment="Bottom">
                        <arcm:IconButton Name="StopButton"
                                         Variant="Tinted"
                                         Icon="{StaticResource StopGlyph}"
                                         Command="{Binding CancelCommand}"
                                         IsVisible="{Binding ShowComposerStop}"
                                         AutomationProperties.Name="{l:MobileLangResource ConversationStop}" />
                        <Panel IsVisible="{Binding !Voice.IsVoiceMode}">
                            <arcm:IconButton Name="SendButton"
                                             Variant="Filled"
                                             Icon="{x:Static arc:ArcIcons.ArrowUp}"
                                             Command="{Binding SendCommand}"
                                             IsVisible="{Binding ShowComposerSend}"
                                             IsEnabled="{Binding CanSend}"
                                             AutomationProperties.Name="{l:MobileLangResource Send}" />
                        </Panel>
                    </Panel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

    <arcm:Page.Overlay>
        <Panel>
            <!-- Hold to talk: the live text above the finger, "cancel" / "send" to drag onto, what releasing does.
                 Not hit-testable: the bar keeps the pointer captured while the finger moves over all of this. -->
            <Grid Name="VoiceOverlay"
                  IsVisible="{Binding Voice.IsRecording}"
                  IsHitTestVisible="False"
                  Classes.cancel="{Binding Voice.IsCancelZone}"
                  Classes.send="{Binding Voice.IsSendZone}"
                  RowDefinitions="*,Auto,Auto,Auto">
                <Border Grid.RowSpan="4" Classes="voiceBackdrop" />
                <Border Name="VoiceBubble" Grid.Row="1" Classes="voiceBubble" Margin="32,0,32,28">
                    <StackPanel Spacing="8">
                        <TextBlock Name="VoiceMeta"
                                   Classes="voiceMeta"
                                   Classes.warn="{Binding Voice.IsNearLimit}"
                                   Text="{Binding Voice.MetaText}" />
                        <TextBlock Name="VoiceText" Classes="voiceText" TextWrapping="Wrap" MaxHeight="168">
                            <Run Text="{Binding Voice.SettledText}" /><Run Classes="voiceFaint" Text="{Binding Voice.TailText}" /><Run Classes="voiceFaint" Text="{Binding Voice.Placeholder}" />
                        </TextBlock>
                        <voice:VoiceWaveform Name="VoiceWave"
                                             Height="28"
                                             Level="{Binding Voice.Level}"
                                             IsVisible="{Binding !Voice.IsFinishing}" />
                        <arc:ArcSpinner Width="16"
                                        Height="16"
                                        HorizontalAlignment="Center"
                                        IsVisible="{Binding Voice.IsFinishing}" />
                    </StackPanel>
                </Border>
                <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="40,0,40,22">
                    <Border Name="VoiceCancelTarget" Classes="voiceTarget cancelTarget">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <arc:ArcGlyph Data="{StaticResource CloseGlyph}" Size="20" HorizontalAlignment="Center" />
                            <TextBlock Text="{l:MobileLangResource Cancel}" />
                        </StackPanel>
                    </Border>
                    <Border Name="VoiceSendTarget" Grid.Column="2" Classes="voiceTarget sendTarget">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <arc:ArcGlyph Data="{StaticResource SendUpGlyph}" Size="20" HorizontalAlignment="Center" />
                            <TextBlock Text="{l:MobileLangResource VoiceSendDirect}" />
                        </StackPanel>
                    </Border>
                </Grid>
                <Border Name="VoiceReleaseArc" Grid.Row="3" Classes="voiceArc">
                    <TextBlock Name="VoiceReleaseHint"
                               Text="{Binding Voice.ReleaseText}"
                               HorizontalAlignment="Center"
                               Margin="0,36,0,0" />
                </Border>
            </Grid>
            <arcm:ActionSheet Name="OptionSheet" CancelText="{l:MobileLangResource Cancel}" />
            <common:SessionWorkspaceOverlay Name="WorkspaceOverlay" DataContext="{Binding WorkspaceMenu}" />
        </Panel>
    </arcm:Page.Overlay>
</arcm:Page>
