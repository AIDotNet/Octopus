<Styles xmlns="https://github.com/avaloniaui"
        x:Class="Octopus.Mobile.Shell.MobileStyles"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
        xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
        xmlns:shell="using:Octopus.Mobile.Shell">
    <!-- A state pill at the end of a row: waiting (the person is needed), working, failed, or an action ("Pair"). -->
    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="Padding" Value="9,3" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
    </Style>
    <Style Selector="Border.pill arc|ArcSpinner">
        <Setter Property="Width" Value="9" />
        <Setter Property="Height" Value="9" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pill TextBlock">
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
    </Style>
    <Style Selector="Border.pill.waiting">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource WarningSubtle}" />
    </Style>
    <Style Selector="Border.pill.waiting TextBlock">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Warning}" />
    </Style>
    <Style Selector="Border.pill.working, Border.pill.action">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
    </Style>
    <Style Selector="Border.pill.working TextBlock, Border.pill.action TextBlock">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
    </Style>
    <Style Selector="Border.pill.error">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource DangerSubtle}" />
    </Style>
    <Style Selector="Border.pill.error TextBlock">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
    </Style>

    <!-- The square before a session's title: the agent's letter on its color, or a terminal glyph. -->
    <Style Selector="Border.badge">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
    </Style>
    <Style Selector="Border.badge TextBlock">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Border.badge.large">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Border.badge.large TextBlock">
        <Setter Property="FontSize" Value="18" />
    </Style>
    <!-- "GUI" after the title of a session that runs as a GUI conversation on the computer. -->
    <Style Selector="Border.guiTag">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="5,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
    </Style>
    <Style Selector="Border.guiTag TextBlock">
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
    </Style>
    <Style Selector="TextBlock.detailTitle">
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeLG}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.secondary">
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
    </Style>
    <!-- What a session is doing or asking: one line in the terminal's own face. -->
    <Style Selector="TextBlock.preview">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>

    <!-- The strip under the terminal's title: where the session is and who decides its size. -->
    <Style Selector="Border.strip">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="Padding" Value="12,2,4,2" />
    </Style>
    <!-- The bars under the terminal: replies, the composer, the key row. -->
    <Style Selector="Border.bar">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="8,6" />
    </Style>
    <!-- A key of the row above the keyboard; the sticky Ctrl is filled while it waits for its key. -->
    <Style Selector="arcm|Button.keycap">
        <Setter Property="Variant" Value="Tinted" />
    </Style>
    <Style Selector="arcm|Button.keycap.armed">
        <Setter Property="Variant" Value="Filled" />
    </Style>

    <!-- The number both sides show while pairing, and the sign-in code: large, evenly spaced digits. -->
    <Style Selector="TextBlock.code">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource Type3XL}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- Workspace grouping on the host page and path preview inside the New sheet. -->
    <Style Selector="TextBlock.sectionHeader">
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.wsTitle">
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
    </Style>
    <Style Selector="Border.wsPill">
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
    </Style>
    <Style Selector="Border.wsPill TextBlock">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
    </Style>
    <Style Selector="Border.pathPreview">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
    </Style>
    <Style Selector="Border.emptyCard">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
    </Style>

    <!-- Scheme A smart accordion project cards (HostPage) -->
    <Style Selector="arcm|TextField.hostSearch">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="CornerRadius" Value="11" />
    </Style>
    <Style Selector="Border.statusDot">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="CornerRadius" Value="3.5" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource TextMuted}" />
    </Style>
    <Style Selector="Border.statusDot.warning">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Warning}" />
    </Style>
    <Style Selector="Border.statusDot.accent">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}" />
    </Style>
    <Style Selector="Border.statusDot.danger">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Danger}" />
    </Style>

    <Style Selector="Border.hostSummaryBar">
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="TextBlock.summaryStat">
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.summaryStat.warning">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Warning}" />
    </Style>
    <Style Selector="TextBlock.summaryStat.accent">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
    </Style>
    <Style Selector="TextBlock.summaryStat.danger">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
    </Style>
    <Style Selector="TextBlock.monoCount">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
    </Style>

    <!-- Custom flat/pill touch buttons inside HostPage so Arc's default Button chrome never bloats chips or card headers. -->
    <Style Selector="Button.chipBtn">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.chipBtn:pressed">
        <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="Button.chipBtn.active">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.chipBtn.attention.active">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource WarningSubtle}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Warning}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Warning}" />
    </Style>

    <Style Selector="Button.inlineLinkBtn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.inlineLinkBtn:pressed">
        <Setter Property="Opacity" Value="0.65" />
    </Style>

    <Style Selector="Border.projectCard">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.projectCard.attention">
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Warning}" />
    </Style>
    <Style Selector="Border.projectCard.error">
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Danger}" />
    </Style>

    <Style Selector="Button.cardHeaderBtn">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="12,11,4,11" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.cardHeaderBtn:pressed">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
    </Style>

    <Style Selector="Border.projectBadge">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.projectBadge TextBlock">
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.cornerBadge">
        <Setter Property="MinWidth" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}" />
    </Style>
    <Style Selector="Border.cornerBadge TextBlock">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.cornerBadge.waiting">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Warning}" />
    </Style>
    <Style Selector="Border.cornerBadge.error">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Danger}" />
    </Style>
    <Style Selector="Border.cornerBadge.working">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}" />
    </Style>
    <Style Selector="Border.cornerBadge.working TextBlock">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentForeground}" />
    </Style>

    <Style Selector="TextBlock.projectCardTitle">
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeBase}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
    </Style>
    <Style Selector="TextBlock.projectCardPath">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.branchTag">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="5,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
    </Style>
    <Style Selector="Border.branchTag TextBlock">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.projectPlusBtn">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.projectPlusBtn:pressed">
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <Style Selector="Button.projectChevronBtn">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.projectChevronBtn:pressed">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
    </Style>

    <Style Selector="Border.projectWsBar">
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="Button.wsTabBtn">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.wsTabBtn arc|ArcGlyph">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
    </Style>
    <Style Selector="Button.wsTabBtn.active">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.wsTabBtn.active arc|ArcGlyph">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
    </Style>
    <Style Selector="Button.wsTabBtn.newBranch">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
    </Style>
    <Style Selector="Button.wsTabBtn.newBranch arc|ArcGlyph">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
    </Style>
    <Style Selector="Button.wsTabBtn:pressed">
        <Setter Property="Opacity" Value="0.7" />
    </Style>

    <Style Selector="Border.projectSessionList">
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <Style Selector="Border.projectCardFooter">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="CornerRadius" Value="0,0,15,15" />
        <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="Button.projectFooterBtn">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="9,5" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.projectFooterBtn arc|ArcGlyph">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
    </Style>
    <Style Selector="Button.projectFooterBtn.primary">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.projectFooterBtn.primary arc|ArcGlyph">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
    </Style>
    <Style Selector="Button.projectFooterBtn:pressed">
        <Setter Property="Opacity" Value="0.72" />
    </Style>

    <!-- Scheme A dashboard cards, welcome highlights, account profile & code verification card. -->
    <Style Selector="Border.surfaceCard">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.featureIcon">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
    </Style>
    <Style Selector="Border.featureIcon.success">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SuccessSubtle}" />
    </Style>
    <Style Selector="Border.featureIcon.muted">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
    </Style>
    <Style Selector="Border.alertCard">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.alertCard.danger">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource DangerSubtle}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Danger}" />
    </Style>
    <Style Selector="Border.codeCard">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.avatarCircle">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="46" />
        <Setter Property="CornerRadius" Value="23" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.avatarCircle.sm">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Border.avatarCircle TextBlock">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.pill.success">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SuccessSubtle}" />
    </Style>
    <Style Selector="Border.pill.success TextBlock">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Success}" />
    </Style>
    <Style Selector="Border.onlineDot">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Success}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Files, changes and diffs (Files/). -->
    <Style Selector="arcm|IconButton.toggled">
        <Setter Property="Variant" Value="Plain" />
    </Style>
    <Style Selector="arcm|IconButton.toggled.active">
        <Setter Property="Variant" Value="Tinted" />
    </Style>

    <!-- Status letter before a changed file (A, M, D, R, !). -->
    <Style Selector="Border.changeBadge">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
    </Style>
    <Style Selector="Border.changeBadge TextBlock">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.changeBadge.added">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SuccessSubtle}" />
    </Style>
    <Style Selector="Border.changeBadge.added TextBlock">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Success}" />
    </Style>
    <Style Selector="Border.changeBadge.modified">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource WarningSubtle}" />
    </Style>
    <Style Selector="Border.changeBadge.modified TextBlock">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Warning}" />
    </Style>
    <Style Selector="Border.changeBadge.removed">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource DangerSubtle}" />
    </Style>
    <Style Selector="Border.changeBadge.removed TextBlock">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
    </Style>

    <Style Selector="TextBlock.diffStat">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.diffStat.added">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Success}" />
    </Style>
    <Style Selector="TextBlock.diffStat.removed">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
    </Style>

    <!-- Virtualized read-only code and diff lists: ArcTheme has no ListBox template, so list and rows are templated here. -->
    <Style Selector="ListBox.codeList">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,6" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                    <ScrollViewer Name="PART_ScrollViewer"
                                  HorizontalScrollBarVisibility="{TemplateBinding (ScrollViewer.HorizontalScrollBarVisibility)}"
                                  VerticalScrollBarVisibility="{TemplateBinding (ScrollViewer.VerticalScrollBarVisibility)}">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        Margin="{TemplateBinding Padding}"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ListBox.codeList ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                  Content="{TemplateBinding Content}"
                                  ContentTemplate="{TemplateBinding ContentTemplate}" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="TextBlock.codeNum">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>
    <Style Selector="TextBlock.codeText">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
    </Style>
    <Style Selector="TextBlock.diffMarker">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="19" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
    </Style>
    <Style Selector="Border.diffLine">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Border.diffLine.added">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SuccessSubtle}" />
    </Style>
    <Style Selector="Border.diffLine.added TextBlock.diffMarker">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Success}" />
    </Style>
    <Style Selector="Border.diffLine.removed">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource DangerSubtle}" />
    </Style>
    <Style Selector="Border.diffLine.removed TextBlock.diffMarker">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
    </Style>
    <Style Selector="Border.diffLine.hunk">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        <Setter Property="Padding" Value="0,3" />
    </Style>
    <Style Selector="Border.diffLine.hunk TextBlock.codeText">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.diffLine.note TextBlock.codeText">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <!-- Access passwords (Account/AccessPasswordPage) and the account's devices on the host list. -->
    <Style Selector="Border.lockBadge">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
    </Style>
    <Style Selector="arcm|TextField.accessPassword">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXL}" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="LetterSpacing" Value="2" />
    </Style>
    <Style Selector="Border.pill.action arc|ArcGlyph">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- An offline computer is only named: its row is faded, and nothing happens on a tap. -->
    <Style Selector="arcm|ListItem.dimmed">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!--
        The navbar with a row that keeps a long title (a session's name) off the back button and the actions: Arc's own
        template lays the row out as a *,Auto,* grid, so a title wider than the bar takes all of it and the side buttons
        end up under it, unseen and untappable. Same parts and geometry as Arc's NavbarTheme (bar 43 high, 44 wide slots,
        22 chevron, 30 large title with 8 at the sides); only the row panel differs, and an empty leading slot takes no room.
    -->
    <Style Selector="arcm|Navbar">
        <Setter Property="Template">
            <ControlTemplate TargetType="arcm:Navbar">
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}">
                    <StackPanel>
                        <shell:NavbarBarPanel Height="43">
                            <StackPanel Name="PART_LeadingHost"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <arcm:Button Name="PART_Back"
                                             Variant="Plain"
                                             Command="{TemplateBinding BackCommand}"
                                             IsVisible="{TemplateBinding ShowBack}">
                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                        <arc:ArcGlyph Data="{x:Static arc:ArcIcons.ChevronLeft}"
                                                      Foreground="{Binding $parent[arcm:Button].Foreground}"
                                                      Size="22"
                                                      VerticalAlignment="Center" />
                                        <TextBlock Text="{TemplateBinding BackText}"
                                                   IsVisible="{Binding !!BackText, RelativeSource={RelativeSource TemplatedParent}}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </arcm:Button>
                                <ContentPresenter Name="PART_Leading"
                                                  MinWidth="44"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Leading}"
                                                  IsVisible="{Binding Leading, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                            <arc:ArcContentSwap Name="PART_Title"
                                                Mode="BlurSwap"
                                                Content="{TemplateBinding Title}"
                                                HorizontalContentAlignment="Center"
                                                VerticalAlignment="Center"
                                                Opacity="{TemplateBinding BarTitleOpacity}">
                                <arc:ArcContentSwap.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="{arc:ArcDesignTokenResource TypeBase}"
                                                   FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </arc:ArcContentSwap.ContentTemplate>
                            </arc:ArcContentSwap>
                            <ContentPresenter Name="PART_Trailing"
                                              MinWidth="44"
                                              HorizontalContentAlignment="Right"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Trailing}" />
                        </shell:NavbarBarPanel>
                        <Border Name="PART_LargeTitleHost"
                                Height="{TemplateBinding LargeTitleHeight}"
                                ClipToBounds="True"
                                IsHitTestVisible="False">
                            <arc:ArcContentSwap Name="PART_LargeTitle"
                                                Mode="BlurSwap"
                                                Content="{TemplateBinding Title}"
                                                Margin="8,0"
                                                HorizontalContentAlignment="Left"
                                                VerticalAlignment="Center">
                                <arc:ArcContentSwap.ContentTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}"
                                                   FontSize="30"
                                                   FontWeight="{arc:ArcDesignTokenResource WeightMedium}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </arc:ArcContentSwap.ContentTemplate>
                            </arc:ArcContentSwap>
                        </Border>
                    </StackPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Scheme B floating capsule session top bar + Scheme C anchored top-right popover menu -->
    <Style Selector="Border.sessionTopBar">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Background}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="10,6,10,8" />
    </Style>
    <Style Selector="Button.sessionCircleBtn">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.sessionCircleBtn:pressed">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
    </Style>
    <Style Selector="Button.sessionCircleBtn.active">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
    </Style>
    <Style Selector="Button.sessionPillBtn">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="11,4" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}"
                        ClipToBounds="True">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.sessionPillBtn:pressed">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
    </Style>
    <Style Selector="Button.popoverBackdrop">
        <Setter Property="Background" Value="#28000000" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Border.sessionPopover">
        <Setter Property="Width" Value="248" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="0 12 32 0 #48000000" />
    </Style>
    <Style Selector="TextBlock.popoverSection">
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="Margin" Value="9,5,9,2" />
    </Style>
    <Style Selector="Border.popoverDivider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="Margin" Value="6,4" />
    </Style>
    <Style Selector="Button.popoverRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="9,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.popoverRow:pressed">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
    </Style>
    <Style Selector="Button.popoverRow.danger">
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Danger}" />
    </Style>
    <Style Selector="Button.popoverMiniBtn">
        <Setter Property="MinWidth" Value="34" />
        <Setter Property="Height" Value="26" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.popoverMiniBtn:pressed">
        <Setter Property="Opacity" Value="0.7" />
    </Style>
    <Style Selector="Button.popoverMiniBtn:disabled">
        <Setter Property="Opacity" Value="0.38" />
    </Style>
    <Style Selector="Border.sessionSheetCard">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="11,9" />
    </Style>
    <Style Selector="Border.sessionSheetCard.current">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
    </Style>

    <!-- Crisp session row title and compact status pill so long titles never collide or overflow. -->
    <Style Selector="TextBlock.sessionTitle">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="{arc:ArcDesignTokenResource WeightMedium}" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="Border.pill.compact">
        <Setter Property="Padding" Value="7,2" />
    </Style>
    <Style Selector="Border.pill.compact TextBlock">
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Mobile update reminder banner & progress bar (HostsPage dashboard & Me tab). -->
    <Style Selector="Border.updateBanner">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BoxShadow" Value="0 2 10 0 #0F000000" />
    </Style>
    <Style Selector="Border.updateBanner.ready">
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Success}" />
    </Style>
    <Style Selector="Border.updateBanner.error">
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Danger}" />
    </Style>
    <Style Selector="Border.updateIconBadge">
        <Setter Property="Width" Value="34" />
        <Setter Property="Height" Value="34" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
    </Style>
    <Style Selector="Border.updateIconBadge.ready">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SuccessSubtle}" />
    </Style>
    <Style Selector="Border.updateIconBadge.error">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource DangerSubtle}" />
    </Style>
    <Style Selector="Button.bannerCloseBtn">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.bannerCloseBtn:pressed">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
    </Style>
    <Style Selector="ProgressBar.updateProgress">
        <Setter Property="Height" Value="6" />
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Panel>
                        <Border Name="PART_Indicator"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                HorizontalAlignment="Left" />
                    </Panel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Border.sheetFooter">
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Padding" Value="16,12,16,14" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
    </Style>

    <!-- NativeAOT-safe Markdown renderer styles (MobileMarkdownView). -->
    <Style Selector="TextBlock.mdH1">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LineHeight" Value="24" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
    </Style>
    <Style Selector="TextBlock.mdH2">
        <Setter Property="FontSize" Value="15.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
    </Style>
    <Style Selector="Border.mdHeadingRule">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Border}" />
    </Style>
    <Style Selector="TextBlock.mdH3">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
    </Style>
    <Style Selector="TextBlock.mdH4">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.mdBody">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
    </Style>
    <Style Selector="TextBlock.mdMarker">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="21" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Accent}" />
    </Style>
    <Style Selector="Border.mdQuote">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
        <Setter Property="CornerRadius" Value="0,8,8,0" />
        <Setter Property="Padding" Value="10,7" />
    </Style>
    <Style Selector="TextBlock.mdQuoteText">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
    </Style>
    <Style Selector="Border.mdCodeBlock">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="TextBlock.mdCodeLang">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
    </Style>
    <Style Selector="TextBlock.mdCodeText">
        <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
    </Style>
    <Style Selector="Border.mdDivider">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="Margin" Value="0,4" />
    </Style>
    <Style Selector="Border.mdTableCard">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="Border.mdTableHeaderCell">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.mdTableCell">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="Padding" Value="10,8" />
    </Style>
    <Style Selector="Border.mdTableCell.alt">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="Opacity" Value="0.92" />
    </Style>
    <Style Selector="TextBlock.mdTableHeaderText">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
    </Style>
    <Style Selector="TextBlock.mdTableCellText">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="18" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
    </Style>
    <Style Selector="Button.mdImageCard">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.mdImageCard:pressed">
        <Setter Property="Opacity" Value="0.72" />
    </Style>

    <!-- Bots accordion todo strip & inline option buttons -->
    <Style Selector="Border.botTodoStrip">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="10,0,10,8" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource WarningSubtle}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Warning}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Button.botOptionBtn">
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.botOptionBtn:pressed">
        <Setter Property="Opacity" Value="0.72" />
    </Style>
    <Style Selector="Border.botChatRowClosed">
        <Setter Property="Opacity" Value="0.68" />
    </Style>
</Styles>
