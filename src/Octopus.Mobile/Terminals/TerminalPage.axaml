<arcm:Page xmlns="https://github.com/avaloniaui"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
           xmlns:arcm="https://github.com/AIDotNet/TKCode.Arc.Mobile"
           xmlns:l="using:Octopus.Mobile.Localization"
           xmlns:vm="using:Octopus.Mobile.Terminals"
           xmlns:common="using:Octopus.Mobile.Common"
           xmlns:term="using:Octopus.Terminal.Avalonia"
           x:Class="Octopus.Mobile.Terminals.TerminalPage"
           x:DataType="vm:TerminalViewModel"
           AvoidKeyboard="True">
    <arcm:Page.Resources>
        <StreamGeometry x:Key="MoreGlyph">M12 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2z M19 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2z M5 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2z</StreamGeometry>
    </arcm:Page.Resources>

    <arcm:Page.Header>
        <!-- No text beside the back arrow: a session's title is long, and the strip below names the host. -->
        <arcm:Navbar Title="{Binding Title}"
                     ShowBack="True"
                     BackCommand="{Binding BackCommand}">
            <arcm:Navbar.Trailing>
                <arcm:IconButton Name="MenuButton"
                                 Icon="{StaticResource MoreGlyph}"
                                 Command="{Binding OpenMenuCommand}"
                                 AutomationProperties.Name="{l:MobileLangResource More}" />
            </arcm:Navbar.Trailing>
        </arcm:Navbar>
    </arcm:Page.Header>

    <!--
        Everything that is typed with sits in the content, not the footer: with AvoidKeyboard the content shrinks by the
        keyboard's height while the footer goes behind it (TKCode.Arc.Mobile.Page), so the bars stay right above the
        keyboard and the terminal gets what is left. While fitted the smaller grid goes to the host as the new size.
    -->
    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Where the session is and who decides its size, on one line; fitting and giving back are in the menu. -->
        <Border Classes="strip" Grid.Row="0" Padding="12,4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <TextBlock Name="LocationText" Classes="secondary" Text="{Binding Location}" VerticalAlignment="Center" />
                <TextBlock Name="SizeText" Grid.Column="1" Classes="muted" Text="{Binding SizeText}"
                           FontSize="{arc:ArcDesignTokenResource TypeXS}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <term:TerminalControl Name="Terminal" Grid.Row="1" FontSize="{Binding FontSize}" />

        <StackPanel Name="InputBars" Grid.Row="2">
            <!-- A picture on its way to the host: how far it is. -->
            <Border Name="UploadBar" Classes="bar" Padding="12,6" IsVisible="{Binding IsUploading}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <arc:ArcSpinner VerticalAlignment="Center" />
                    <TextBlock Name="UploadText" Classes="secondary" Text="{Binding UploadText}" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Only looking: one button takes the size and opens the input. -->
            <Border Classes="bar" IsVisible="{Binding IsViewing}">
                <arcm:Button Name="FitAndTypeButton"
                             Variant="Filled"
                             HorizontalAlignment="Stretch"
                             HorizontalContentAlignment="Center"
                             Content="{l:MobileLangResource FitAndType}"
                             Command="{Binding FitCommand}" />
            </Border>

            <!-- The choices of the agent's question, each a row to tap, then Esc. -->
            <Border Classes="bar" Padding="0,8,0,2" IsVisible="{Binding HasQuickReplies}">
                <arcm:ListGroup Name="Replies" ItemsSource="{Binding QuickReplies}">
                    <arcm:ListGroup.ItemTemplate>
                        <DataTemplate x:DataType="vm:QuickReply">
                            <arcm:ListItem Content="{Binding Label}"
                                           Command="{Binding $parent[arcm:ListGroup].((vm:TerminalViewModel)DataContext).ReplyCommand}"
                                           CommandParameter="{Binding}" />
                        </DataTemplate>
                    </arcm:ListGroup.ItemTemplate>
                </arcm:ListGroup>
            </Border>

            <!-- The composer: a whole line, sent at once. -->
            <Border Classes="bar" IsVisible="{Binding IsComposing}">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6">
                    <arcm:IconButton Name="KeyboardButton"
                                     Icon="{x:Static arc:ArcIcons.Keyboard}"
                                     Command="{Binding ToggleInputCommand}"
                                     AutomationProperties.Name="{l:MobileLangResource UseKeyboard}" />
                    <arcm:IconButton Name="ImageButton" Grid.Column="1"
                                     Icon="{x:Static arc:ArcIcons.Image}"
                                     IsVisible="{Binding CanSendImage}"
                                     Command="{Binding SendImageCommand}"
                                     AutomationProperties.Name="{l:MobileLangResource SendImage}" />
                    <arcm:TextField Name="Composer" Grid.Column="2"
                                    Text="{Binding ComposeText, Mode=TwoWay}"
                                    PlaceholderText="{l:MobileLangResource ReplyPlaceholder}"
                                    VerticalAlignment="Center" />
                    <arcm:IconButton Name="SendButton" Grid.Column="3"
                                     Variant="Filled"
                                     Icon="{x:Static arc:ArcIcons.ArrowUp}"
                                     Command="{Binding SendCommand}"
                                     AutomationProperties.Name="{l:MobileLangResource Send}" />
                </Grid>
            </Border>

            <!-- Typing straight into the terminal: the keys a phone keyboard lacks. Ctrl is sticky. -->
            <Border Classes="bar" IsVisible="{Binding IsDirect}">
                <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
                    <arcm:IconButton Name="ComposerButton"
                                     Icon="{x:Static arc:ArcIcons.MessageSquare}"
                                     Command="{Binding ToggleInputCommand}"
                                     AutomationProperties.Name="{l:MobileLangResource UseComposer}" />
                    <arcm:IconButton Name="DirectImageButton" Grid.Column="1"
                                     Icon="{x:Static arc:ArcIcons.Image}"
                                     Focusable="False"
                                     IsVisible="{Binding CanSendImage}"
                                     Command="{Binding SendImageCommand}"
                                     AutomationProperties.Name="{l:MobileLangResource SendImage}" />
                    <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl Name="KeyRow" ItemsSource="{Binding Keys}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="6" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:KeyCapViewModel">
                                    <arcm:Button Classes="keycap"
                                                 Classes.armed="{Binding IsArmed}"
                                                 Focusable="False"
                                                 Content="{Binding Label}"
                                                 Command="{Binding PressCommand}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </StackPanel>
    </Grid>

    <arcm:Page.Overlay>
        <common:SessionActionOverlays Name="Overlays" DataContext="{Binding Actions}" />
    </arcm:Page.Overlay>
</arcm:Page>
