<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:explorer="using:Octopus.App.Explorer"
             xmlns:bots="using:Octopus.App.Bots"
             xmlns:launcher="using:Octopus.App.Launcher"
             xmlns:sidebar="using:Octopus.App.Sidebar"
             xmlns:workspace="using:Octopus.App.Workspace"
             xmlns:chrome="using:Octopus.App.Shell.Chrome"
             xmlns:account="using:Octopus.App.Account"
             xmlns:plugins="using:Octopus.App.Plugins"
             xmlns:updates="using:Octopus.App.Updates"
             xmlns:vm="using:Octopus.App.Shell"
             x:Class="Octopus.App.Shell.ShellView"
             x:DataType="vm:ShellViewModel">
    <Grid x:Name="Root" Background="{arc:ArcDesignTokenResource SurfaceMuted}">
        <Grid x:Name="Main">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Left column: the traffic-light row, then the project rail and the project panel. -->
            <!-- The clip is what the slide animation narrows; the area inside keeps its full width meanwhile (ShellView.axaml.cs). -->
            <Border x:Name="LeftClip" ClipToBounds="True">
            <Grid x:Name="LeftArea" RowDefinitions="Auto,*" HorizontalAlignment="Stretch" ClipToBounds="True">
                <Grid x:Name="SidebarLead" Height="{DynamicResource OctopusTopRowHeight}" ColumnDefinitions="Auto,*,Auto" Margin="0,0,6,0">
                    <Border Width="{Binding LeftInset}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="10,0,0,0" VerticalAlignment="Center">
                        <Image Width="{DynamicResource OctopusLogoSize}" Height="{DynamicResource OctopusLogoSize}" Source="avares://Octopus/Assets/Icon/logo.png"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                        <TextBlock Classes="body" FontWeight="SemiBold" VerticalAlignment="Center" Text="Octopus" />
                    </StackPanel>
                    <arc:Button Grid.Column="2" Classes="icon" Variant="Ghost" VerticalAlignment="Center"
                                Command="{Binding ToggleSidebarCommand}"
                                AutomationProperties.Name="{l:AppLangResource ToggleSidebar}"
                                arc:Tooltip.Tip="{l:AppLangResource ToggleSidebar}" arc:Tooltip.Side="Bottom">
                        <lucide:LucideIcon Kind="PanelLeftClose" Size="{DynamicResource OctopusTopIconSize}" />
                    </arc:Button>
                </Grid>
                <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                    <Border BorderThickness="0,0,1,0" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
                        <sidebar:ProjectRailView DataContext="{Binding Rail}" />
                    </Border>
                    <Panel Grid.Column="1" IsVisible="{Binding !IsBotMode}">
                        <sidebar:ProjectPanelView DataContext="{Binding Panel}" />
                    </Panel>
                    <Panel Grid.Column="1" IsVisible="{Binding IsBotMode}">
                        <bots:BotPanelView x:Name="BotPanel" DataContext="{Binding BotPanel}" />
                    </Panel>
                </Grid>
            </Grid>
            </Border>

            <GridSplitter x:Name="LeftSplitter" Grid.Column="1" Width="{DynamicResource OctopusSplitterWidth}"
                          Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                          DragCompleted="OnSplitterDragCompleted" />

            <!-- The workspace reaches the window's top edge: its tab strips are the top row. -->
            <Grid Grid.Column="2" x:Name="WorkspaceArea" ClipToBounds="True">
                <workspace:WorkspaceView x:Name="WorkspaceHost" DataContext="{Binding Workspace}" />

                <!-- Collapsed sidebar: the traffic-light room, the name and the toggle join the first tab strip. -->
                <!-- Always laid out (the workspace needs its width while the sidebar slides); shown by code once collapsed. -->
                <StackPanel x:Name="CollapsedLead" Orientation="Horizontal" Height="{DynamicResource OctopusTopRowHeight}"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            Opacity="0" IsHitTestVisible="False">
                    <Border Width="{Binding LeftInset}" />
                    <Image Width="{DynamicResource OctopusLogoSize}" Height="{DynamicResource OctopusLogoSize}" Margin="10,0,0,0" Source="avares://Octopus/Assets/Icon/logo.png"
                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                    <TextBlock Classes="body" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,4,0" Text="Octopus" />
                    <arc:Button Classes="icon" Variant="Ghost" VerticalAlignment="Center" Margin="0,0,6,0"
                                Command="{Binding ToggleSidebarCommand}"
                                AutomationProperties.Name="{l:AppLangResource ToggleSidebar}"
                                arc:Tooltip.Tip="{l:AppLangResource ToggleSidebar}" arc:Tooltip.Side="Bottom">
                        <lucide:LucideIcon Kind="PanelLeftOpen" Size="{DynamicResource OctopusTopIconSize}" />
                    </arc:Button>
                </StackPanel>

                <!-- Split, over the right end of the top row. The "+" lives in each group's own tab strip (WorkspaceView). -->
                <StackPanel x:Name="Toolbar" Orientation="Horizontal" Height="{DynamicResource OctopusTopRowHeight}" Spacing="2"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,40,0"
                            IsVisible="{Binding Workspace.HasProject}">
                    <!-- Plugin indicators (design/plugins/05-界面能力.md §7), e.g. the agents' usage. -->
                    <plugins:IndicatorStrip Margin="0,0,4,0" />
                    <arc:Button Classes="icon" Variant="Ghost" VerticalAlignment="Center"
                                Command="{Binding SplitRightCommand}"
                                AutomationProperties.Name="{l:AppLangResource SplitRight}"
                                arc:Tooltip.Tip="{l:AppLangResource SplitRight}" arc:Tooltip.Side="Bottom">
                        <lucide:LucideIcon Kind="Columns2" Size="{DynamicResource OctopusTopIconSize}" />
                    </arc:Button>
                </StackPanel>
            </Grid>

            <GridSplitter x:Name="RightSplitter" Grid.Column="3" Width="{DynamicResource OctopusSplitterWidth}" IsVisible="False"
                          Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                          DragCompleted="OnRightSplitterDragCompleted" />
            <!-- The right panel switches between Project Explorer and the dedicated Bot right panel. -->
            <Border x:Name="RightClip" Grid.Column="4" ClipToBounds="True">
                <Grid x:Name="RightPanelHost" IsVisible="False">
                    <Panel IsVisible="{Binding !IsBotMode}">
                        <explorer:ExplorerPanelView x:Name="RightPanel" />
                    </Panel>
                    <Panel IsVisible="{Binding IsBotMode}">
                        <bots:BotRightPanelView x:Name="BotRightPanel" DataContext="{Binding BotRightPanel}" />
                    </Panel>
                </Grid>
            </Border>
        </Grid>

        <!-- Top right corner, always: the account capsule (Scheme B), the right panel switch, and caption buttons. -->
        <StackPanel x:Name="TopRight" Orientation="Horizontal" Height="{DynamicResource OctopusTopRowHeight}" Spacing="4" Margin="0,0,6,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button x:Name="AccountCapsuleButton"
                    Classes="account-capsule"
                    Classes.cta="{Binding Account.ShowSignedOutCapsule}"
                    Classes.signing="{Binding Account.IsSigningIn}"
                    Classes.ended="{Binding Account.ShowEndedCapsule}"
                    VerticalAlignment="Center"
                    Command="{Binding Account.ActivateCapsuleCommand}"
                    AutomationProperties.Name="{Binding Account.CapsuleLabel}"
                    arc:Tooltip.Tip="{Binding Account.CapsuleTooltip}" arc:Tooltip.Side="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Signed out: user icon -->
                    <lucide:LucideIcon Kind="User" Size="12" IsVisible="{Binding Account.ShowSignedOutCapsule}" VerticalAlignment="Center" />
                    <!-- Session ended: alert icon -->
                    <lucide:LucideIcon Kind="TriangleAlert" Size="12" IsVisible="{Binding Account.ShowEndedCapsule}" VerticalAlignment="Center" />
                    <!-- Signing in: spinner -->
                    <arc:ArcSpinner Width="11" Height="11" IsVisible="{Binding Account.IsSigningIn}" VerticalAlignment="Center" />
                    <!-- Signed in: mini initial circle -->
                    <Border Width="17" Height="17" CornerRadius="9"
                            Background="{arc:ArcDesignTokenResource Accent}"
                            IsVisible="{Binding Account.IsSignedIn}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Account.AccountInitial}" Foreground="White" FontSize="9.5" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock x:Name="AccountCapsuleLabel" Text="{Binding Account.CapsuleLabel}"
                               FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="112"
                               VerticalAlignment="Center" />
                    <!-- Signed-in relay live dot -->
                    <Panel Width="7" Height="7" IsVisible="{Binding Account.IsSignedIn}" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" IsVisible="{Binding Account.IsRelayOnline}" Fill="{arc:ArcDesignTokenResource Success}" />
                        <Ellipse Width="7" Height="7" IsVisible="{Binding Account.IsRelayConnecting}" Fill="{arc:ArcDesignTokenResource Warning}" />
                        <Ellipse Width="7" Height="7" IsVisible="{Binding Account.IsRelayOff}" Fill="{arc:ArcDesignTokenResource TextMuted}" Opacity="0.6" />
                    </Panel>
                </StackPanel>
            </Button>
            <arc:Button Classes="icon" Variant="Ghost" VerticalAlignment="Center"
                        Command="{Binding ToggleRightPanelCommand}"
                        AutomationProperties.Name="{l:AppLangResource ToggleRightPanel}"
                        arc:Tooltip.Tip="{l:AppLangResource ToggleRightPanel}" arc:Tooltip.Side="Bottom">
                <lucide:LucideIcon Kind="PanelRight" Size="{DynamicResource OctopusTopIconSize}" />
            </arc:Button>
            <chrome:CaptionButtonsView IsVisible="{Binding ShowsCaptionButtons}" Margin="6,0,0,0" />
        </StackPanel>

        <arc:Popover x:Name="LauncherPopover" Placement="Bottom" Alignment="Start">
            <launcher:LauncherMenu x:Name="LauncherMenuView" DataContext="{Binding Launcher}" />
        </arc:Popover>

        <arc:Popover x:Name="DevicePopover" Placement="Right" Alignment="Start">
            <sidebar:DeviceSwitcherView x:Name="DeviceSwitcherMenuView" DataContext="{Binding DeviceSwitcher}" />
        </arc:Popover>

        <arc:Popover x:Name="AccountPopover" Placement="Bottom" Alignment="End">
            <account:AccountMenuView x:Name="AccountMenuView" DataContext="{Binding Account}" />
        </arc:Popover>

        <!-- Centered account sign-in dialog (Scheme B). -->
        <account:AccountSignInOverlay x:Name="AccountSignInModal"
                                      DataContext="{Binding Account}"
                                      IsVisible="{Binding IsSignInDialogOpen}" />

        <!-- The settings page covers the whole window. -->
        <Grid x:Name="Overlay" />

        <!-- A new version: found, downloading, ready (design/10-自动更新.md §10). Over the settings page too. -->
        <updates:UpdateCardView x:Name="UpdateCard" DataContext="{Binding UpdateCard}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24" />
    </Grid>
</UserControl>
