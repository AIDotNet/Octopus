<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ex="using:Octopus.App.Explorer"
             xmlns:files="using:Octopus.App.Explorer.Files"
             xmlns:git="using:Octopus.App.Explorer.Git"
             xmlns:tunnels="using:Octopus.App.Explorer.Tunnels"
             xmlns:sessions="using:Octopus.App.Explorer.Sessions"
             x:Class="Octopus.App.Explorer.ExplorerPanelView"
             x:DataType="ex:ExplorerPanelViewModel">
    <UserControl.Styles>
        <Style Selector="arc|Button.ex-icon">
            <Setter Property="Width" Value="{DynamicResource OctopusIconButtonSize}" />
            <Setter Property="Height" Value="{DynamicResource OctopusIconButtonSize}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsPressScaleEnabled" Value="False" />
        </Style>

        <!-- A whole-row target (a change, a commit, a search result): tinted on hover and when selected. -->
        <Style Selector="Border.ex-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.ex-row:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        </Style>
        <Style Selector="Border.ex-row.selected">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Border}" />
        </Style>

        <Style Selector="TextBlock.ex-body">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="TextBlock.ex-caption">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.ex-hint">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{arc:ArcDesignTokenResource SurfaceMuted}" RowDefinitions="Auto,Auto,Auto,*">
        <!-- The top row lines up with the window's top row and is where the window is dragged from. Its right end belongs
             to what the window floats there (the account capsule, the panel switch, the caption buttons), see TrailingInset. -->
        <Border x:Name="TopBar" Height="{DynamicResource OctopusTopRowHeight}" Background="Transparent"
                PointerPressed="OnTopBarPointerPressed" />

        <!-- The options are made by the code behind: Files always, Git while the folder is in a repository, Sessions
             for a folder on this computer, Tunnels for a project on an SSH host. The chosen one shows its name.
             They sit in the top row while their widest tab state fits left of the trailing inset, and on a row of their
             own below it otherwise (so switching tabs never makes the tab bar jump between rows). -->
        <ex:ExplorerTabGroup x:Name="Tabs" Size="Small" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                             IsVisible="{Binding HasProject}"
                             SelectedValue="{Binding TabKey, Mode=TwoWay}"
                             Label="{l:AppLangResource ExplorerTabs}" />

        <!-- Shown above Files / Git when following a branch worktree tab so the user never confuses worktree vs main. -->
        <Border Grid.Row="2" IsVisible="{Binding HasWorkspaceBanner}"
                Margin="8,2,8,4" Padding="8,4"
                CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                Background="{arc:ArcDesignTokenResource AccentSubtle}"
                arc:Tooltip.Tip="{Binding ProjectPath}">
            <StackPanel Orientation="Horizontal" Spacing="6">
                <lucide:LucideIcon Kind="GitBranch" Size="12" VerticalAlignment="Center"
                                   Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                <TextBlock FontSize="{arc:ArcDesignTokenResource TypeXS}" FontWeight="SemiBold"
                           Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                           Text="{Binding WorkspaceBannerText}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <!-- No project -->
        <arc:EmptyState Grid.Row="3" IsVisible="{Binding HasNoProject}" VerticalAlignment="Top" Margin="12,24"
                        Title="{l:AppLangResource ExplorerNoProject}" Description="{l:AppLangResource ExplorerNoProjectHint}"
                        Icon="{x:Static arc:ArcIcons.FileText}" />

        <files:FilesTabView Grid.Row="3" IsVisible="{Binding IsFilesTab}" />
        <Panel Grid.Row="3" IsVisible="{Binding IsGitTab}">
            <git:GitTabView DataContext="{Binding Git}" />
        </Panel>
        <Panel Grid.Row="3" IsVisible="{Binding IsTunnelsTab}">
            <tunnels:TunnelsTabView DataContext="{Binding Tunnels}" />
        </Panel>
        <Panel Grid.Row="3" IsVisible="{Binding IsSessionsTab}">
            <sessions:SessionsTabView DataContext="{Binding Sessions}" />
        </Panel>
    </Grid>
</UserControl>
