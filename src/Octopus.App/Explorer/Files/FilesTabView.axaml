<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ex="using:Octopus.App.Explorer"
             xmlns:files="using:Octopus.App.Explorer.Files"
             xmlns:search="using:Octopus.App.Explorer.Search"
             x:Class="Octopus.App.Explorer.Files.FilesTabView"
             x:DataType="ex:ExplorerPanelViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Title row: the project name and the folder actions. -->
        <Grid ColumnDefinitions="*,Auto" Margin="14,0,8,2" Height="32">
            <TextBlock Classes="ex-body" FontWeight="SemiBold" VerticalAlignment="Center"
                       Text="{Binding ProjectName}" TextTrimming="CharacterEllipsis"
                       arc:Tooltip.Tip="{Binding ProjectPath}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
                <arc:Button Classes="ex-icon" Variant="Ghost" Command="{Binding Files.CollapseAllCommand}"
                            AutomationProperties.Name="{l:AppLangResource ExplorerCollapseAll}"
                            arc:Tooltip.Tip="{l:AppLangResource ExplorerCollapseAll}">
                    <lucide:LucideIcon Kind="ListCollapse" Size="14" />
                </arc:Button>
                <arc:Button Classes="ex-icon" Variant="Ghost" Command="{Binding RefreshCommand}"
                            AutomationProperties.Name="{l:AppLangResource ExplorerRefresh}"
                            arc:Tooltip.Tip="{l:AppLangResource ExplorerRefresh}">
                    <lucide:LucideIcon Kind="RefreshCw" Size="14" />
                </arc:Button>
                <arc:Button x:Name="MoreButton" Classes="ex-icon" Variant="Ghost"
                            AutomationProperties.Name="{l:AppLangResource ExplorerMore}"
                            arc:Tooltip.Tip="{l:AppLangResource ExplorerMore}">
                    <lucide:LucideIcon Kind="Ellipsis" Size="14" />
                </arc:Button>
            </StackPanel>
        </Grid>

        <!-- Search mode and box. -->
        <StackPanel Grid.Row="1" Margin="10,2,10,6" Spacing="6" DataContext="{Binding Search}" x:DataType="search:FileSearchViewModel" IsVisible="{Binding HasRoot}">
            <arc:SegmentedControl HorizontalAlignment="Stretch" SelectedValue="{Binding ModeKey, Mode=TwoWay}"
                                  AutomationProperties.Name="{l:AppLangResource ExplorerSearchMode}">
                <arc:SegmentedOption Value="name" Label="{l:AppLangResource ExplorerSearchByName}" />
                <arc:SegmentedOption Value="content" Label="{l:AppLangResource ExplorerSearchByContent}" />
            </arc:SegmentedControl>
            <arc:SearchField Size="Small" IsLabelVisible="False"
                             Label="{Binding Placeholder}" Placeholder="{Binding Placeholder}"
                             Text="{Binding Query, Mode=TwoWay}" />
        </StackPanel>

        <!-- On an SSH host the folders are read through the host: a failed read is said above the tree. -->
        <DockPanel Grid.Row="2" IsVisible="{Binding !Search.IsActive}">
            <TextBlock DockPanel.Dock="Top" Classes="ex-hint" Margin="14,4,14,6" TextWrapping="Wrap"
                       Text="{Binding RemoteStatusText}" IsVisible="{Binding HasRemoteStatus}" />
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="14,2,14,6" IsVisible="{Binding IsRemoteBusy}">
                <arc:ArcSpinner Width="12" Height="12" VerticalAlignment="Center"
                                Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                <TextBlock Classes="ex-hint" Text="{Binding RemoteBusyText}" VerticalAlignment="Center" />
            </StackPanel>
            <files:FileTreeView DataContext="{Binding Files}" />
        </DockPanel>
        <search:SearchResultsView Grid.Row="2" DataContext="{Binding Search}" IsVisible="{Binding IsActive}" />
    </Grid>
</UserControl>
