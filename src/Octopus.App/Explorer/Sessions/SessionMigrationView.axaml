<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:common="using:Octopus.App.Common"
             xmlns:s="using:Octopus.App.Explorer.Sessions"
             x:Class="Octopus.App.Explorer.Sessions.SessionMigrationView"
             x:DataType="s:SessionMigrationFormViewModel"
             Width="420">
    <UserControl.Styles>
        <Style Selector="TextBlock.mig-caption">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="Button.mig-target">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.mig-target:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        </Style>
        <Style Selector="Button.mig-target.selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Border}" />
        </Style>
        <Style Selector="Button.mig-target:disabled">
            <Setter Property="Opacity" Value="0.5" />
            <Setter Property="Cursor" Value="Arrow" />
        </Style>
        <Style Selector="Ellipse.mig-radio">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="14" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="Stroke" Value="{arc:ArcDesignTokenResource BorderStrong}" />
        </Style>
        <Style Selector="Button.selected Ellipse.mig-radio">
            <Setter Property="Stroke" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="8">
        <!-- The session being moved -->
        <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}" BorderBrush="{arc:ArcDesignTokenResource Border}"
                BorderThickness="1" CornerRadius="{arc:ArcDesignTokenResource RadiusControl}" Padding="10,8">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <common:AgentIcon AgentId="{Binding Session.AgentId}" AgentName="{Binding SourceName}" Size="20" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Spacing="1">
                    <TextBlock Text="{Binding Session.Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               FontSize="{arc:ArcDesignTokenResource TypeSM}" />
                    <TextBlock Text="{Binding SourceMeta}" TextTrimming="CharacterEllipsis"
                               FontSize="{arc:ArcDesignTokenResource TypeXS}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Classes="mig-caption" Margin="0,4,0,0" Text="{l:AppLangResource MigrateTarget}" />
        <Border BorderBrush="{arc:ArcDesignTokenResource Border}" BorderThickness="1"
                CornerRadius="{arc:ArcDesignTokenResource RadiusControl}" ClipToBounds="True">
            <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Targets}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="s:MigrationTargetRowViewModel">
                            <Button Classes="mig-target" Classes.selected="{Binding IsSelected}"
                                    IsEnabled="{Binding IsAvailable}" Command="{Binding ChooseCommand}"
                                    AutomationProperties.Name="{Binding Name}">
                                <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="9">
                                    <Panel VerticalAlignment="Center">
                                        <Ellipse Classes="mig-radio" />
                                        <Ellipse Width="6" Height="6" IsVisible="{Binding IsSelected}"
                                                 Fill="{arc:ArcDesignTokenResource Accent}" />
                                    </Panel>
                                    <common:AgentIcon Grid.Column="1" AgentId="{Binding AgentId}" AgentName="{Binding Name}" Size="18"
                                                      VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center"
                                               FontSize="{arc:ArcDesignTokenResource TypeSM}" TextTrimming="CharacterEllipsis" />
                                    <arc:Badge Grid.Column="3" Size="Small" Tone="{Binding KindTone}" Content="{Binding KindText}"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Classes="mig-caption" Margin="0,4,0,0" Text="{l:AppLangResource MigrateKind}" />
        <arc:SegmentedControl HorizontalAlignment="Stretch" SelectedValue="{Binding Mode, Mode=TwoWay}"
                              AutomationProperties.Name="{l:AppLangResource MigrateKind}">
            <arc:SegmentedOption Value="native" Label="{l:AppLangResource MigrateNative}" IsDisabled="{Binding !CanNative}" />
            <arc:SegmentedOption Value="handoff" Label="{l:AppLangResource MigrateHandoff}" IsDisabled="{Binding !CanHandoff}" />
        </arc:SegmentedControl>
        <TextBlock IsVisible="{Binding IsNative}" Text="{Binding NativeHint}" TextWrapping="Wrap"
                   FontSize="{arc:ArcDesignTokenResource TypeXS}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        <TextBlock IsVisible="{Binding IsHandoff}" Text="{Binding HandoffHint}" TextWrapping="Wrap"
                   FontSize="{arc:ArcDesignTokenResource TypeXS}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
        <TextBlock IsVisible="{Binding !CanNative}" Text="{Binding NativeHint}" TextWrapping="Wrap"
                   FontSize="{arc:ArcDesignTokenResource TypeXS}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />

        <StackPanel Spacing="8" IsVisible="{Binding HasAccounts}">
            <TextBlock Classes="mig-caption" Margin="0,4,0,0" Text="{l:AppLangResource MigrateAccount}" />
            <arc:Select AutoScrollToSelectedItem="False" Size="Small" HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{l:AppLangResource MigrateAccount}"
                        ItemsSource="{Binding Accounts}" SelectedValue="{Binding AccountDirectory, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel Spacing="8" Margin="0,4,0,0">
            <arc:Checkbox IsChecked="{Binding IncludeToolOutput, Mode=TwoWay}" Content="{l:AppLangResource MigrateToolOutput}" />
            <arc:Checkbox IsVisible="{Binding IsHandoff}" IsChecked="{Binding RecentOnly, Mode=TwoWay}" Content="{l:AppLangResource MigrateRecentOnly}" />
        </StackPanel>
    </StackPanel>
</UserControl>
