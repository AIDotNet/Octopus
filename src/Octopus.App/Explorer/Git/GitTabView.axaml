<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:git="using:Octopus.App.Explorer.Git"
             x:Class="Octopus.App.Explorer.Git.GitTabView"
             x:DataType="git:GitPanelViewModel">
    <UserControl.Styles>
        <!-- The stage / unstage buttons show on the row or heading under the pointer (and while focused). -->
        <Style Selector="arc|Button.git-action">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsPressScaleEnabled" Value="False" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.ex-row:pointerover arc|Button.git-action, Grid.git-heading:pointerover arc|Button.git-action, arc|Button.git-action:focus-within">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Grid.git-heading">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Branch (a menu: switch, create, delete), sync and refresh -->
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="8,0,8,2" Height="32">
            <arc:Button x:Name="BranchButton" Variant="Ghost" Size="Small" HorizontalAlignment="Left" MinWidth="0" Padding="6,0"
                        AutomationProperties.Name="{l:AppLangResource ExplorerSwitchBranch}"
                        arc:Tooltip.Tip="{l:AppLangResource ExplorerSwitchBranch}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon Kind="GitBranch" Size="15" VerticalAlignment="Center"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    <TextBlock Classes="ex-body" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="150"
                               Text="{Binding BranchName}" TextTrimming="CharacterEllipsis" />
                    <lucide:LucideIcon Kind="ChevronDown" Size="12" VerticalAlignment="Center"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                </StackPanel>
            </arc:Button>
            <TextBlock Grid.Column="1" Classes="ex-hint" Margin="4,0,4,0" VerticalAlignment="Center"
                       IsVisible="{Binding HasAheadBehind}" Text="{Binding AheadBehind}" />
            <arc:Button Grid.Column="2" Classes="ex-icon" Variant="Ghost" Command="{Binding PullCommand}"
                        AutomationProperties.Name="{l:AppLangResource ExplorerPull}"
                        arc:Tooltip.Tip="{l:AppLangResource ExplorerPull}">
                <lucide:LucideIcon Kind="ArrowDownToLine" Size="14" />
            </arc:Button>
            <arc:Button Grid.Column="3" Classes="ex-icon" Variant="Ghost" Command="{Binding PushCommand}"
                        AutomationProperties.Name="{l:AppLangResource ExplorerPush}"
                        arc:Tooltip.Tip="{l:AppLangResource ExplorerPush}">
                <lucide:LucideIcon Kind="ArrowUpFromLine" Size="14" />
            </arc:Button>
            <arc:Button Grid.Column="4" Classes="ex-icon" Variant="Ghost" Command="{Binding RefreshNowCommand}"
                        AutomationProperties.Name="{l:AppLangResource ExplorerRefresh}"
                        arc:Tooltip.Tip="{l:AppLangResource ExplorerRefresh}">
                <lucide:LucideIcon Kind="RefreshCw" Size="14" />
            </arc:Button>
            <arc:Button x:Name="MoreButton" Grid.Column="5" Classes="ex-icon" Variant="Ghost"
                        AutomationProperties.Name="{l:AppLangResource ExplorerMoreGit}"
                        arc:Tooltip.Tip="{l:AppLangResource ExplorerMoreGit}">
                <lucide:LucideIcon Kind="Ellipsis" Size="14" />
            </arc:Button>
        </Grid>

        <!-- Commit box -->
        <StackPanel Grid.Row="1" Margin="10,2,10,6" Spacing="6" IsVisible="{Binding HasRepository}">
            <arc:Textarea x:Name="MessageBox" Text="{Binding CommitMessage, Mode=TwoWay}"
                          IsLabelVisible="False" FrameMinHeight="52" FrameHeight="52" IsResizable="True" />
            <arc:Button x:Name="CommitButton" Variant="Primary" Size="Small" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding CommitCommand}" Content="{Binding CommitButtonText}" />
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowBusy}">
                <arc:ArcSpinner Width="12" Height="12" VerticalAlignment="Center" />
                <TextBlock Classes="ex-hint" VerticalAlignment="Center" Text="{Binding BusyText}" />
            </StackPanel>
            <SelectableTextBlock Classes="ex-hint" IsVisible="{Binding HasGitError}" Text="{Binding GitError}"
                                 TextWrapping="Wrap" MaxHeight="120"
                                 Foreground="{arc:ArcDesignTokenResource Danger}" />
        </StackPanel>

        <Grid Grid.Row="2" RowDefinitions="Auto,*">
            <TextBlock Classes="ex-hint" Margin="14,4" IsVisible="{Binding IsClean}" Text="{l:AppLangResource ExplorerClean}" />
            <!-- One virtualized list: group headings, changes, the commits heading and the commits. -->
            <ItemsControl x:Name="List" Grid.Row="1" ItemsSource="{Binding Items}" Margin="4,0,4,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Template>
                    <ControlTemplate>
                        <arc:ScrollArea Name="PART_ScrollViewer" FadeLength="0" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="0,0,0,10" />
                        </arc:ScrollArea>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="git:GitChangeGroupViewModel">
                        <Grid Classes="git-heading" ColumnDefinitions="*,Auto,Auto,Auto" Height="30" Margin="10,0,8,0">
                            <TextBlock Classes="ex-caption" VerticalAlignment="Bottom" Margin="0,0,0,6" Text="{Binding Title}" />
                            <arc:Button Grid.Column="1" Classes="git-action" Variant="Ghost" VerticalAlignment="Bottom" Margin="0,0,2,2"
                                        IsVisible="{Binding CanDiscard}"
                                        Command="{Binding $parent[ItemsControl].((git:GitPanelViewModel)DataContext).DiscardGroupCommand}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding DiscardText}" arc:Tooltip.Tip="{Binding DiscardText}">
                                <lucide:LucideIcon Kind="{Binding DiscardIcon}" Size="14" />
                            </arc:Button>
                            <arc:Button Grid.Column="2" Classes="git-action" Variant="Ghost" VerticalAlignment="Bottom" Margin="0,0,4,2"
                                        Command="{Binding $parent[ItemsControl].((git:GitPanelViewModel)DataContext).StageGroupCommand}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding ActionText}" arc:Tooltip.Tip="{Binding ActionText}">
                                <lucide:LucideIcon Kind="{Binding ActionIcon}" Size="14" />
                            </arc:Button>
                            <TextBlock Grid.Column="3" Classes="ex-hint" VerticalAlignment="Bottom" Margin="0,0,0,6" MinWidth="18"
                                       TextAlignment="Center" Text="{Binding Count}" />
                        </Grid>
                    </DataTemplate>
                    <DataTemplate DataType="git:GitChangeRowViewModel">
                        <Border Classes="ex-row" Classes.selected="{Binding IsSelected}" Height="28"
                                PointerPressed="OnChangePressed" DoubleTapped="OnChangeDoubleTapped"
                                arc:Tooltip.Tip="{Binding Change.Path}">
                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,18" Margin="10,0,8,0">
                                <TextBlock Classes="ex-body" VerticalAlignment="Center" Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" MinWidth="40" />
                                <TextBlock Grid.Column="1" Classes="ex-hint" Margin="8,0,6,0" VerticalAlignment="Center"
                                           MaxWidth="120" Text="{Binding Directory}" IsVisible="{Binding HasDirectory}"
                                           TextTrimming="PathSegmentEllipsis" />
                                <arc:Button Grid.Column="2" Classes="git-action" Variant="Ghost" Margin="0,0,2,0"
                                            IsVisible="{Binding CanDiscard}"
                                            Command="{Binding $parent[ItemsControl].((git:GitPanelViewModel)DataContext).DiscardCommand}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding DiscardText}" arc:Tooltip.Tip="{Binding DiscardText}">
                                    <lucide:LucideIcon Kind="{Binding DiscardIcon}" Size="14" />
                                </arc:Button>
                                <arc:Button Grid.Column="3" Classes="git-action" Variant="Ghost" Margin="0,0,4,0"
                                            Command="{Binding $parent[ItemsControl].((git:GitPanelViewModel)DataContext).ToggleStageCommand}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding ActionText}" arc:Tooltip.Tip="{Binding ActionText}">
                                    <lucide:LucideIcon Kind="{Binding ActionIcon}" Size="14" />
                                </arc:Button>
                                <git:GitStatusLetter Grid.Column="4" Kind="{Binding Kind}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <DataTemplate DataType="git:GitCommitsHeaderViewModel">
                        <StackPanel Margin="10,14,10,4" Spacing="4">
                            <TextBlock Classes="ex-caption" Text="{l:AppLangResource ExplorerRecentCommits}" />
                            <TextBlock Classes="ex-hint" IsVisible="{Binding HasNoCommits}" Text="{l:AppLangResource ExplorerNoCommits}" />
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="git:GitCommitRowViewModel">
                        <Border Classes="ex-row" Classes.selected="{Binding IsSelected}" PointerPressed="OnCommitPressed"
                                arc:Tooltip.Tip="{Binding Subject}">
                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="4,5,8,5">
                                <lucide:LucideIcon Kind="{Binding ChevronIcon}" Size="12" Margin="0,3,4,0" VerticalAlignment="Top"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Classes="ex-hint" Margin="0,2,10,0" VerticalAlignment="Top"
                                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" Text="{Binding ShortHash}" />
                                <StackPanel Grid.Column="2" Spacing="1">
                                    <TextBlock Classes="ex-body" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="ex-hint" Text="{Binding Meta}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <DataTemplate DataType="git:GitCommitFileRowViewModel">
                        <Border Classes="ex-row" Classes.selected="{Binding IsSelected}" Height="26"
                                PointerPressed="OnCommitFilePressed" arc:Tooltip.Tip="{Binding Tip}">
                            <Grid ColumnDefinitions="*,Auto,18" Margin="30,0,8,0">
                                <TextBlock Classes="ex-body" VerticalAlignment="Center" Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" MinWidth="40" />
                                <TextBlock Grid.Column="1" Classes="ex-hint" Margin="8,0,6,0" VerticalAlignment="Center"
                                           MaxWidth="120" Text="{Binding Directory}" IsVisible="{Binding HasDirectory}"
                                           TextTrimming="PathSegmentEllipsis" />
                                <git:GitStatusLetter Grid.Column="2" Kind="{Binding Kind}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>
        </Grid>
    </Grid>
</UserControl>
