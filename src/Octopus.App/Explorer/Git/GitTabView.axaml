<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:common="using:Octopus.App.Common"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:git="using:Octopus.App.Explorer.Git"
             x:Class="Octopus.App.Explorer.Git.GitTabView"
             x:DataType="git:GitPanelViewModel">
    <UserControl.Styles>
        <!-- The stage / unstage buttons show on the row or heading under the pointer (and while focused). -->
        <Style Selector="arc|Button.git-action">
            <Setter Property="Width" Value="{DynamicResource OctopusGitActionSize}" />
            <Setter Property="Height" Value="{DynamicResource OctopusGitActionSize}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsPressScaleEnabled" Value="False" />
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.ex-row:pointerover arc|Button.git-action, Grid.git-heading:pointerover arc|Button.git-action, arc|Button.git-action:focus-within">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Grid.git-heading">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.git-section">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.git-section:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        </Style>
        <Style Selector="Button.git-section:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Border}" />
        </Style>
        <Style Selector="Button.git-load-more">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.git-load-more:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        </Style>
        <Style Selector="Border.git-section-divider">
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        </Style>
        <Style Selector="Border.git-count-pill">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPill}" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Branch (a menu: switch, create, delete), sync and refresh -->
        <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto" Margin="{DynamicResource OctopusExplorerHeaderMargin}" Height="{DynamicResource OctopusExplorerHeaderHeight}">
            <arc:Button x:Name="BranchButton" Variant="Ghost" Size="Small" HorizontalAlignment="Left" MinWidth="0" Padding="6,0"
                        AutomationProperties.Name="{l:AppLangResource ExplorerSwitchBranch}"
                        arc:Tooltip.Tip="{l:AppLangResource ExplorerSwitchBranch}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon Kind="GitBranch" Size="15" VerticalAlignment="Center"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    <TextBlock Classes="ex-body" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="150"
                               Text="{Binding BranchName}" TextTrimming="CharacterEllipsis" />
                    <lucide:LucideIcon Kind="ChevronDown" Size="12" VerticalAlignment="Center"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                </StackPanel>
            </arc:Button>
            <TextBlock Grid.Column="1" Classes="ex-hint" Margin="4,0,4,0" VerticalAlignment="Center"
                       IsVisible="{Binding HasAheadBehind}" Text="{Binding AheadBehind}" />
            <arc:Button Grid.Column="2" Classes="ex-icon" Variant="Ghost" Command="{Binding PullCommand}"
                        AutomationProperties.Name="{l:AppLangResource ExplorerPull}"
                        arc:Tooltip.Tip="{l:AppLangResource ExplorerPull}">
                <lucide:LucideIcon Kind="ArrowDownToLine" Size="14" />
            </arc:Button>
            <arc:Button Grid.Column="3" Classes="ex-icon" Variant="Ghost" Command="{Binding PushCommand}"
                        AutomationProperties.Name="{l:AppLangResource ExplorerPush}"
                        arc:Tooltip.Tip="{l:AppLangResource ExplorerPush}">
                <lucide:LucideIcon Kind="ArrowUpFromLine" Size="14" />
            </arc:Button>
            <arc:Button Grid.Column="4" Classes="ex-icon" Variant="Ghost" Command="{Binding RefreshNowCommand}"
                        AutomationProperties.Name="{l:AppLangResource ExplorerRefresh}"
                        arc:Tooltip.Tip="{l:AppLangResource ExplorerRefresh}">
                <lucide:LucideIcon Kind="RefreshCw" Size="14" />
            </arc:Button>
            <arc:Button x:Name="MoreButton" Grid.Column="5" Classes="ex-icon" Variant="Ghost"
                        AutomationProperties.Name="{l:AppLangResource ExplorerMoreGit}"
                        arc:Tooltip.Tip="{l:AppLangResource ExplorerMoreGit}">
                <lucide:LucideIcon Kind="Ellipsis" Size="14" />
            </arc:Button>
        </Grid>

        <!-- Commit box -->
        <StackPanel Grid.Row="1" Margin="{DynamicResource OctopusGitCommitMargin}" Spacing="{DynamicResource OctopusGitCommitSpacing}" IsVisible="{Binding HasRepository}">
            <arc:Textarea x:Name="MessageBox" Text="{Binding CommitMessage, Mode=TwoWay}"
                          IsLabelVisible="False" FrameMinHeight="{DynamicResource OctopusGitTextareaHeight}" FrameHeight="{DynamicResource OctopusGitTextareaHeight}" IsResizable="True" />
            <arc:Button x:Name="CommitButton" Variant="Primary" Size="Small" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        Command="{Binding CommitCommand}" Content="{Binding CommitButtonText}" />
            <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowBusy}">
                <arc:ArcSpinner Width="12" Height="12" VerticalAlignment="Center" />
                <TextBlock Classes="ex-hint" VerticalAlignment="Center" Text="{Binding BusyText}" />
            </StackPanel>
            <SelectableTextBlock Classes="ex-hint" IsVisible="{Binding HasGitError}" Text="{Binding GitError}"
                                 TextWrapping="Wrap" MaxHeight="120"
                                 Foreground="{arc:ArcDesignTokenResource Danger}" />
        </StackPanel>

        <Grid x:Name="SectionsGrid" Grid.Row="2" RowDefinitions="*,Auto">
            <!-- Virtualized list: collapsible working changes section and collapsible scroll-loaded commits section. -->
            <ItemsControl x:Name="List" Grid.Row="0" ItemsSource="{Binding Items}" Margin="4,0,4,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Template>
                    <ControlTemplate>
                        <arc:ScrollArea Name="PART_ScrollViewer" FadeLength="0" HorizontalScrollBarVisibility="Disabled">
                            <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="0,0,0,8" />
                        </arc:ScrollArea>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.DataTemplates>
                    <DataTemplate DataType="git:GitChangesSectionHeaderViewModel">
                        <Border Classes="git-section-divider" Padding="0,3,0,2">
                            <Button Classes="git-section"
                                    Command="{Binding $parent[ItemsControl].((git:GitPanelViewModel)DataContext).ToggleChangesSectionCommand}"
                                    AutomationProperties.Name="{l:AppLangResource ExplorerWorkingChanges}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5" Margin="6,4,6,4">
                                    <lucide:LucideIcon Kind="{Binding ChevronIcon}" Size="12" VerticalAlignment="Center"
                                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                    <TextBlock Grid.Column="1" Classes="ex-caption" VerticalAlignment="Center"
                                               Text="{l:AppLangResource ExplorerWorkingChanges}" />
                                    <Border Grid.Column="2" Classes="git-count-pill" IsVisible="{Binding HasCount}">
                                        <TextBlock Classes="ex-hint" HorizontalAlignment="Center" Text="{Binding CountText}" />
                                    </Border>
                                </Grid>
                            </Button>
                        </Border>
                    </DataTemplate>
                    <DataTemplate DataType="git:GitCleanStateRowViewModel">
                        <TextBlock Classes="ex-hint" Margin="22,4,8,6" Text="{l:AppLangResource ExplorerClean}" />
                    </DataTemplate>
                    <DataTemplate DataType="git:GitChangeGroupViewModel">
                        <Grid Classes="git-heading" ColumnDefinitions="*,Auto,Auto,Auto" Height="{DynamicResource OctopusGitGroupHeight}" Margin="12,0,6,0">
                            <TextBlock Classes="ex-caption" VerticalAlignment="Bottom" Margin="0,0,0,4" Text="{Binding Title}" />
                            <arc:Button Grid.Column="1" Classes="git-action" Variant="Ghost" VerticalAlignment="Bottom" Margin="0,0,2,1"
                                        IsVisible="{Binding CanDiscard}"
                                        Command="{Binding $parent[ItemsControl].((git:GitPanelViewModel)DataContext).DiscardGroupCommand}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding DiscardText}" arc:Tooltip.Tip="{Binding DiscardText}">
                                <lucide:LucideIcon Kind="{Binding DiscardIcon}" Size="13" />
                            </arc:Button>
                            <arc:Button Grid.Column="2" Classes="git-action" Variant="Ghost" VerticalAlignment="Bottom" Margin="0,0,4,1"
                                        Command="{Binding $parent[ItemsControl].((git:GitPanelViewModel)DataContext).StageGroupCommand}"
                                        CommandParameter="{Binding}"
                                        AutomationProperties.Name="{Binding ActionText}" arc:Tooltip.Tip="{Binding ActionText}">
                                <lucide:LucideIcon Kind="{Binding ActionIcon}" Size="13" />
                            </arc:Button>
                            <TextBlock Grid.Column="3" Classes="ex-hint" VerticalAlignment="Bottom" Margin="0,0,0,4" MinWidth="18"
                                       TextAlignment="Center" Text="{Binding Count}" />
                        </Grid>
                    </DataTemplate>
                    <DataTemplate DataType="git:GitChangeRowViewModel">
                        <Border Classes="ex-row" Classes.selected="{Binding IsSelected}" Height="{DynamicResource OctopusGitRowHeight}"
                                PointerPressed="OnChangePressed" DoubleTapped="OnChangeDoubleTapped"
                                arc:Tooltip.Tip="{Binding Change.Path}">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,18" Margin="8,0,6,0">
                                <common:FileIconView IconKey="{Binding IconKey}" Size="{DynamicResource OctopusFileTreeIconSize}" Margin="{DynamicResource OctopusFileTreeIconMargin}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="ex-body" VerticalAlignment="Center" Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" MinWidth="40" />
                                <TextBlock Grid.Column="2" Classes="ex-hint" Margin="6,0,4,0" VerticalAlignment="Center"
                                           MaxWidth="120" Text="{Binding Directory}" IsVisible="{Binding HasDirectory}"
                                           TextTrimming="PathSegmentEllipsis" />
                                <arc:Button Grid.Column="3" Classes="git-action" Variant="Ghost" Margin="0,0,2,0"
                                            IsVisible="{Binding CanDiscard}"
                                            Command="{Binding $parent[ItemsControl].((git:GitPanelViewModel)DataContext).DiscardCommand}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding DiscardText}" arc:Tooltip.Tip="{Binding DiscardText}">
                                    <lucide:LucideIcon Kind="{Binding DiscardIcon}" Size="13" />
                                </arc:Button>
                                <arc:Button Grid.Column="4" Classes="git-action" Variant="Ghost" Margin="0,0,4,0"
                                            Command="{Binding $parent[ItemsControl].((git:GitPanelViewModel)DataContext).ToggleStageCommand}"
                                            CommandParameter="{Binding}"
                                            AutomationProperties.Name="{Binding ActionText}" arc:Tooltip.Tip="{Binding ActionText}">
                                    <lucide:LucideIcon Kind="{Binding ActionIcon}" Size="13" />
                                </arc:Button>
                                <git:GitStatusLetter Grid.Column="5" Kind="{Binding Kind}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <DataTemplate DataType="git:GitCommitsHeaderViewModel">
                        <StackPanel Margin="0,4,0,2" Spacing="2">
                            <Border Classes="git-section-divider" Padding="0,3,0,0">
                                <Button Classes="git-section"
                                        Command="{Binding $parent[ItemsControl].((git:GitPanelViewModel)DataContext).ToggleCommitsSectionCommand}"
                                        AutomationProperties.Name="{l:AppLangResource ExplorerRecentCommits}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5" Margin="6,4,6,4">
                                        <lucide:LucideIcon Kind="{Binding ChevronIcon}" Size="12" VerticalAlignment="Center"
                                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                        <TextBlock Grid.Column="1" Classes="ex-caption" VerticalAlignment="Center"
                                                   Text="{l:AppLangResource ExplorerRecentCommits}" />
                                        <Border Grid.Column="2" Classes="git-count-pill" IsVisible="{Binding HasCount}">
                                            <TextBlock Classes="ex-hint" HorizontalAlignment="Center" Text="{Binding CountText}" />
                                        </Border>
                                    </Grid>
                                </Button>
                            </Border>
                            <TextBlock Classes="ex-hint" Margin="22,4,8,4" IsVisible="{Binding ShowNoCommits}"
                                       Text="{l:AppLangResource ExplorerNoCommits}" />
                        </StackPanel>
                    </DataTemplate>
                    <DataTemplate DataType="git:GitCommitRowViewModel">
                        <Border Classes="ex-row" Classes.selected="{Binding IsSelected}" PointerPressed="OnCommitPressed"
                                arc:Tooltip.Tip="{Binding Subject}">
                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="{DynamicResource OctopusGitCommitInnerMargin}">
                                <lucide:LucideIcon Kind="{Binding ChevronIcon}" Size="12" Margin="0,3,4,0" VerticalAlignment="Top"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                <TextBlock Grid.Column="1" Classes="ex-hint" Margin="0,2,8,0" VerticalAlignment="Top"
                                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" Text="{Binding ShortHash}" />
                                <StackPanel Grid.Column="2" Spacing="1">
                                    <TextBlock Classes="ex-body" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Classes="ex-hint" Text="{Binding Meta}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <DataTemplate DataType="git:GitCommitFileRowViewModel">
                        <Border Classes="ex-row" Classes.selected="{Binding IsSelected}" Height="{DynamicResource OctopusGitCommitFileHeight}"
                                PointerPressed="OnCommitFilePressed" arc:Tooltip.Tip="{Binding Tip}">
                            <Grid ColumnDefinitions="Auto,*,Auto,18" Margin="26,0,6,0">
                                <common:FileIconView IconKey="{Binding IconKey}" Size="{DynamicResource OctopusFileTreeIconSize}" Margin="{DynamicResource OctopusFileTreeIconMargin}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="ex-body" VerticalAlignment="Center" Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis" MinWidth="40" />
                                <TextBlock Grid.Column="2" Classes="ex-hint" Margin="8,0,6,0" VerticalAlignment="Center"
                                           MaxWidth="120" Text="{Binding Directory}" IsVisible="{Binding HasDirectory}"
                                           TextTrimming="PathSegmentEllipsis" />
                                <git:GitStatusLetter Grid.Column="3" Kind="{Binding Kind}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                    <DataTemplate DataType="git:GitCommitsFooterViewModel">
                        <Panel Margin="6,4,6,6">
                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" Margin="0,4"
                                        IsVisible="{Binding IsLoading}">
                                <arc:ArcSpinner Width="12" Height="12" VerticalAlignment="Center" />
                                <TextBlock Classes="ex-hint" VerticalAlignment="Center" Text="{l:AppLangResource ExplorerLoadingMoreCommits}" />
                            </StackPanel>
                            <Button Classes="git-load-more" IsVisible="{Binding CanLoadMore}"
                                    Command="{Binding $parent[ItemsControl].((git:GitPanelViewModel)DataContext).LoadMoreCommitsCommand}">
                                <TextBlock Classes="ex-hint" HorizontalAlignment="Center" Text="{l:AppLangResource ExplorerLoadMoreCommits}" />
                            </Button>
                        </Panel>
                    </DataTemplate>
                </ItemsControl.DataTemplates>
            </ItemsControl>

            <!-- Collapsible Branch Graph section (collapsed by default; mounts and loads only when expanded). -->
            <Border Grid.Row="1" Classes="git-section-divider" Padding="4,2,4,4" IsVisible="{Binding HasRepository}">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <Button x:Name="BranchGraphHeaderButton" Classes="git-section" Command="{Binding ToggleBranchGraphCommand}"
                                AutomationProperties.Name="{l:AppLangResource ExplorerBranchGraph}">
                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="5" Margin="6,4,6,4">
                                <lucide:LucideIcon Kind="{Binding BranchGraphChevronIcon}" Size="12" VerticalAlignment="Center"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                <lucide:LucideIcon Grid.Column="1" Kind="GitBranch" Size="12" VerticalAlignment="Center"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                <TextBlock Grid.Column="2" Classes="ex-caption" VerticalAlignment="Center"
                                           Text="{l:AppLangResource ExplorerBranchGraph}" />
                            </Grid>
                        </Button>
                        <arc:Button Grid.Column="1" Classes="ex-icon" Variant="Ghost"
                                    IsVisible="{Binding IsBranchGraphExpanded}"
                                    Command="{Binding RefreshBranchGraphCommand}"
                                    AutomationProperties.Name="{l:AppLangResource ExplorerRefresh}"
                                    arc:Tooltip.Tip="{l:AppLangResource ExplorerRefresh}">
                            <lucide:LucideIcon Kind="RefreshCw" Size="12" />
                        </arc:Button>
                    </Grid>

                    <Border x:Name="BranchGraphHost" Grid.Row="1" MaxHeight="340" IsVisible="{Binding IsBranchGraphExpanded}">
                        <Panel Margin="2,4,2,2">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="16,10"
                                        IsVisible="{Binding IsLoadingBranchGraph}">
                                <arc:ArcSpinner Width="12" Height="12" VerticalAlignment="Center" />
                                <TextBlock Classes="ex-hint" VerticalAlignment="Center" Text="{l:AppLangResource ExplorerLoadingBranchGraph}" />
                            </StackPanel>
                            <TextBlock Classes="ex-hint" Margin="18,8" IsVisible="{Binding ShowBranchGraphEmpty}"
                                       Text="{l:AppLangResource ExplorerNoCommits}" />
                            <arc:ScrollArea FadeLength="0" HorizontalScrollBarVisibility="Disabled"
                                            IsVisible="{Binding ShowBranchGraphControl}">
                                <Border x:Name="BranchGraphSlot" Margin="2,0,2,4" />
                            </arc:ScrollArea>
                        </Panel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
