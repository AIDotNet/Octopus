<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="using:Octopus.App.Account"
             x:Class="Octopus.App.Account.AccountSignInOverlay"
             x:DataType="vm:AccountViewModel">
    <!-- Dimmed modal backdrop; clicking outside the card closes the dialog. -->
    <Grid Background="#78000000" PointerPressed="OnBackdropPressed">
        <Border x:Name="ModalCard"
                Width="416"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{arc:ArcDesignTokenResource Background}"
                BorderBrush="{arc:ArcDesignTokenResource Border}"
                BorderThickness="1"
                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                BoxShadow="0 20 56 0 #55000000"
                Padding="22,20"
                PointerPressed="OnCardPressed">
            <StackPanel Spacing="14">
                <!-- Header + close button -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                            VerticalAlignment="Top">
                        <Image Width="26" Height="26" Source="avares://Octopus/Assets/Icon/logo.png"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                        <TextBlock x:Name="DialogTitleText" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}"
                                   Text="{Binding DialogTitle}" />
                        <TextBlock Classes="hint" Text="{Binding DialogSubtitle}" TextWrapping="Wrap"
                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    </StackPanel>
                    <arc:Button x:Name="CloseDialogButton" Grid.Column="2" Classes="icon" Variant="Ghost" Size="Small"
                                VerticalAlignment="Top" Margin="0,-4,-4,0"
                                Command="{Binding CloseSignInDialogCommand}"
                                AutomationProperties.Name="{l:AppLangResource UpdateClose}">
                        <lucide:LucideIcon Kind="X" Size="14" />
                    </arc:Button>
                </Grid>

                <!-- Session expired banner -->
                <arc:Alert Tone="Danger" Content="{l:AppLangResource SettingsRemoteRelayEnded}" IsVisible="{Binding SignInEnded}" />

                <!-- Step 1: Choose official (octoterm.si) or custom server -->
                <StackPanel x:Name="IdleSignInSection" Spacing="12" IsVisible="{Binding ShowIdleModalContent}">
                    <CheckBox x:Name="AutoRelayCheckBox"
                              IsChecked="{Binding AutoEnableRelayOnSignIn, Mode=TwoWay}">
                        <TextBlock Classes="body" Text="{l:AppLangResource AccountAutoEnableRelay}" TextWrapping="Wrap" />
                    </CheckBox>

                    <!-- Collapsible self-hosted server input -->
                    <Border x:Name="CustomServerPanel"
                            IsVisible="{Binding ShowCustomServer}"
                            Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                            Padding="12,10">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="caption" Text="{l:AppLangResource AccountCustomServerLabel}" />
                            <arc:Input x:Name="CustomServerInput" Size="Small"
                                       Text="{Binding CustomServerUrl, Mode=TwoWay}"
                                       PlaceholderText="https://octoterm.si" />
                            <TextBlock Classes="hint" Text="{Binding CustomServerHintText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <arc:Alert Tone="Warning" Content="{l:AppLangResource SettingsRemoteRelayInsecure}" IsVisible="{Binding IsCustomServerInsecure}" />
                    <arc:Alert Tone="Danger" Content="{Binding ErrorText}" IsVisible="{Binding HasError}" />

                    <arc:Button x:Name="StartSignInButton" Variant="Primary" HorizontalAlignment="Stretch"
                                Content="{Binding PrimaryActionText}"
                                Command="{Binding StartSignInCommand}" />

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <arc:Button x:Name="ToggleCustomServerButton" Variant="Ghost" Size="Small" Padding="4,0"
                                    Content="{Binding CustomServerToggleText}"
                                    Command="{Binding ToggleCustomServerCommand}" />
                        <TextBlock Grid.Column="1" Classes="hint" HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Text="{l:AppLangResource AccountLanNoSignInHint}" />
                    </Grid>
                </StackPanel>

                <!-- Step 2: Waiting for browser confirmation of 8-char device code -->
                <StackPanel x:Name="SigningInSection" Spacing="12" IsVisible="{Binding IsSigningIn}">
                    <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                            Padding="16,14">
                        <StackPanel Spacing="10" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                <arc:ArcSpinner Width="13" Height="13" VerticalAlignment="Center" />
                                <TextBlock Classes="body" FontWeight="Medium" Text="{l:AppLangResource AccountCodeConfirmTitle}" VerticalAlignment="Center" />
                            </StackPanel>
                            <SelectableTextBlock x:Name="DialogUserCodeText"
                                                 Text="{Binding UserCode}"
                                                 HorizontalAlignment="Center"
                                                 FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                 FontSize="28" FontWeight="Bold" LetterSpacing="3" />
                            <TextBlock Classes="hint" Text="{Binding CodeConfirmHintText}"
                                       TextWrapping="Wrap" TextAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <arc:Button x:Name="OpenBrowserAgainButton" Variant="Secondary" Size="Small" HorizontalAlignment="Stretch"
                                    Content="{l:AppLangResource SettingsRemoteRelayOpenBrowser}"
                                    Command="{Binding OpenBrowserAgainCommand}" />
                        <arc:Button x:Name="CopyCodeButton" Grid.Column="1" Variant="Secondary" Size="Small"
                                    Click="OnCopyCode">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <lucide:LucideIcon Kind="Copy" Size="12" IsVisible="{Binding !CodeCopied}" />
                                <lucide:LucideIcon Kind="Check" Size="12" IsVisible="{Binding CodeCopied}" Foreground="{arc:ArcDesignTokenResource Success}" />
                                <TextBlock Text="{l:AppLangResource AccountCodeCopy}" IsVisible="{Binding !CodeCopied}" />
                                <TextBlock Text="{l:AppLangResource AccountCodeCopied}" IsVisible="{Binding CodeCopied}" />
                            </StackPanel>
                        </arc:Button>
                        <arc:Button x:Name="CancelSignInButton" Grid.Column="2" Variant="Ghost" Size="Small"
                                    Content="{l:AppLangResource SettingsRemoteRelayCancel}"
                                    Command="{Binding CancelSignInCommand}" />
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
