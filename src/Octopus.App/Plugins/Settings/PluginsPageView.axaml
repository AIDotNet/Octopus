<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:s="using:Octopus.App.Plugins.Settings"
             x:Class="Octopus.App.Plugins.Settings.PluginsPageView"
             x:DataType="s:PluginsSettingsViewModel">
    <!-- Settings -> Plugins: Installed, Built-in Marketplace, and Multi-Agent Authoring Skill Installer -->
    <StackPanel Spacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
                <TextBlock Classes="title" Text="{x:Static s:PluginStrings.Title}" />
                <TextBlock Classes="subtitle" Text="{x:Static s:PluginStrings.Subtitle}" />
            </StackPanel>
            <arc:SegmentedControl Grid.Column="1"
                                  VerticalAlignment="Center"
                                  AutoScrollToSelectedItem="False"
                                  SelectedValue="{Binding ActiveTab, Mode=TwoWay}">
                <arc:SegmentedOption Value="installed" Label="{x:Static s:PluginStrings.TabInstalled}" />
                <arc:SegmentedOption Value="marketplace" Label="{x:Static s:PluginStrings.TabMarketplace}" />
                <arc:SegmentedOption Value="skills" Label="{x:Static s:PluginStrings.TabSkills}" />
            </arc:SegmentedControl>
        </Grid>

        <arc:Alert Tone="{Binding MessageTone}" Title="{Binding Message}" IsVisible="{Binding HasMessage}">
            <arc:Button Variant="Ghost" Size="Small" HorizontalAlignment="Right" Command="{Binding DismissMessageCommand}">
                <lucide:LucideIcon Kind="X" Size="14" />
            </arc:Button>
        </arc:Alert>

        <!-- ==================== TAB 1: INSTALLED PLUGINS ==================== -->
        <StackPanel Spacing="16" IsVisible="{Binding IsInstalledTab}">
            <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                    Padding="14,10">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Classes="hint" VerticalAlignment="Center" Text="{x:Static s:PluginStrings.InstallHint}" />
                    <arc:Button Grid.Column="1"
                                Variant="Ghost"
                                Size="Small"
                                VerticalAlignment="Center"
                                Command="{Binding OpenFolderCommand}"
                                AutomationProperties.Name="{x:Static s:PluginStrings.OpenFolder}"
                                arc:Tooltip.Tip="{x:Static s:PluginStrings.OpenFolder}">
                        <lucide:LucideIcon Kind="FolderOpen" Size="16" />
                    </arc:Button>
                    <arc:Button Grid.Column="2"
                                Variant="Secondary"
                                Size="Small"
                                VerticalAlignment="Center"
                                Content="{x:Static s:PluginStrings.Rescan}"
                                Command="{Binding RescanCommand}" />
                    <arc:Button Grid.Column="3"
                                Variant="Primary"
                                Size="Small"
                                VerticalAlignment="Center"
                                Command="{Binding InstallCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:LucideIcon Kind="PackagePlus" Size="14" />
                            <TextBlock Text="{x:Static s:PluginStrings.Install}" />
                        </StackPanel>
                    </arc:Button>
                </Grid>
            </Border>

            <StackPanel Spacing="6" IsVisible="{Binding HasBuiltin}">
                <TextBlock Classes="group" Margin="2,4,0,0" Text="{x:Static s:PluginStrings.Builtin}" />
                <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                        ClipToBounds="True">
                    <ItemsControl ItemsSource="{Binding Builtin}" Margin="0,-1,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="s:PluginRowViewModel">
                                <s:PluginRowView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Classes="group" Margin="2,12,0,0" Text="{x:Static s:PluginStrings.Installed}" />
                <TextBlock Classes="hint" Margin="2,0,0,0" Text="{x:Static s:PluginStrings.NoneInstalled}" IsVisible="{Binding !HasInstalled}" />
                <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                        ClipToBounds="True"
                        IsVisible="{Binding HasInstalled}">
                    <ItemsControl ItemsSource="{Binding Installed}" Margin="0,-1,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="s:PluginRowViewModel">
                                <s:PluginRowView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- Color themes from plugins (design/plugins/07-主题.md §5): one per appearance. -->
            <StackPanel Spacing="6">
                <TextBlock Classes="group" Margin="2,12,0,0" Text="{x:Static s:PluginStrings.Themes}" />
                <arc:SettingsGroup Appearance="Card" Description="{x:Static s:PluginStrings.ThemesHint}" IsEnabled="{Binding HasThemes}">
                    <arc:SettingsRow Header="{x:Static s:PluginStrings.LightTheme}">
                        <arc:Select AutoScrollToSelectedItem="False" Size="Small" Width="220"
                                    AutomationProperties.Name="{x:Static s:PluginStrings.LightTheme}"
                                    ItemsSource="{Binding LightThemes}"
                                    SelectedValue="{Binding LightTheme, Mode=TwoWay}" />
                    </arc:SettingsRow>
                    <arc:SettingsRow Header="{x:Static s:PluginStrings.DarkTheme}">
                        <arc:Select AutoScrollToSelectedItem="False" Size="Small" Width="220"
                                    AutomationProperties.Name="{x:Static s:PluginStrings.DarkTheme}"
                                    ItemsSource="{Binding DarkThemes}"
                                    SelectedValue="{Binding DarkTheme, Mode=TwoWay}" />
                    </arc:SettingsRow>
                </arc:SettingsGroup>
                <TextBlock Classes="hint" Margin="2,0,0,0" Text="{x:Static s:PluginStrings.NoThemes}" IsVisible="{Binding !HasThemes}" />
                <arc:Alert Tone="Warning" Title="{x:Static s:PluginStrings.ThemeRefused}" Content="{Binding ThemeProblem}" IsVisible="{Binding HasThemeProblem}" />
            </StackPanel>
        </StackPanel>

        <!-- ==================== TAB 2: BUILT-IN MARKETPLACE ==================== -->
        <StackPanel Spacing="14" IsVisible="{Binding IsMarketplaceTab}">
            <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                    Padding="12">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <arc:Input Text="{Binding MarketQuery, Mode=TwoWay}"
                               Size="Small"
                               Label="{x:Static s:PluginStrings.TabMarketplace}"
                               IsLabelVisible="False"
                               Placeholder="{x:Static s:PluginStrings.MarketSearchPlaceholder}" />
                    <arc:Select Grid.Column="1"
                                AutoScrollToSelectedItem="False"
                                Size="Small"
                                Width="150"
                                ItemsSource="{Binding MarketCategories}"
                                SelectedValue="{Binding MarketCategory, Mode=TwoWay}" />
                    <arc:Button Grid.Column="2"
                                Variant="Secondary"
                                Size="Small"
                                IsLoading="{Binding IsMarketLoading}"
                                Content="{x:Static s:PluginStrings.MarketRefresh}"
                                Command="{Binding RefreshMarketplaceCommand}" />
                    <arc:Button Grid.Column="3"
                                Variant="Ghost"
                                Size="Small"
                                Command="{Binding OpenWebMarketplaceCommand}"
                                arc:Tooltip.Tip="{x:Static s:PluginStrings.MarketOpenWeb}">
                        <lucide:LucideIcon Kind="ExternalLink" Size="15" />
                    </arc:Button>
                </Grid>
            </Border>

            <arc:Alert Tone="Danger" Title="{Binding MarketError}" IsVisible="{Binding HasMarketError}" />

            <TextBlock Classes="hint"
                       Margin="2,4,0,0"
                       Text="{x:Static s:PluginStrings.MarketEmpty}"
                       IsVisible="{Binding !HasMarketItems}" />

            <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                    ClipToBounds="True"
                    IsVisible="{Binding HasMarketItems}">
                <ItemsControl ItemsSource="{Binding MarketItems}" Margin="0,-1,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="s:MarketplacePluginRowViewModel">
                            <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                    BorderThickness="0,1,0,0"
                                    Padding="14,12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="name" Text="{Binding Name}" VerticalAlignment="Center" />
                                            <TextBlock Classes="hint" Text="{Binding VersionLabel}" VerticalAlignment="Center" />
                                            <arc:Badge Size="Small" Tone="{Binding RiskTone}" Content="{Binding RiskLabel}" VerticalAlignment="Center" />
                                            <arc:Badge Size="Small" Tone="Neutral" Content="{Binding PermissionsSummary}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Classes="body" Text="{Binding Description}" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Classes="mono" Text="{Binding Id}" />
                                            <TextBlock Classes="hint" Text="{Binding PublisherLabel}" />
                                            <TextBlock Classes="hint" Text="{Binding DownloadsLabel}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <arc:Badge Size="Small" Tone="Success" Content="{x:Static s:PluginStrings.MarketInstalledBadge}"
                                                   IsVisible="{Binding !ShowActionButton}" VerticalAlignment="Center" />
                                        <arc:Button Variant="Primary" Size="Small"
                                                    IsLoading="{Binding IsBusy}"
                                                    IsVisible="{Binding ShowActionButton}"
                                                    Content="{Binding ActionLabel}"
                                                    Command="{Binding InstallOrUpgradeCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <!-- ==================== TAB 3: MULTI-AGENT AUTHORING SKILL INSTALLER ==================== -->
        <StackPanel Spacing="14" IsVisible="{Binding IsSkillsTab}">
            <StackPanel Spacing="4">
                <TextBlock Classes="group" Text="{x:Static s:PluginStrings.SkillHeading}" />
                <TextBlock Classes="hint" Text="{x:Static s:PluginStrings.SkillSubtitle}" TextWrapping="Wrap" />
            </StackPanel>

            <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                    Padding="12">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <arc:SegmentedControl AutoScrollToSelectedItem="False"
                                          SelectedValue="{Binding SkillScopeKey, Mode=TwoWay}">
                        <arc:SegmentedOption Value="global" Label="{x:Static s:PluginStrings.SkillScopeGlobal}" />
                        <arc:SegmentedOption Value="project" Label="{x:Static s:PluginStrings.SkillScopeProject}" IsEnabled="{Binding HasCurrentProject}" />
                    </arc:SegmentedControl>
                    <arc:Button Grid.Column="1"
                                Variant="Secondary"
                                Size="Small"
                                Content="{x:Static s:PluginStrings.SkillResetDefaults}"
                                Command="{Binding ResetSkillDefaultsCommand}" />
                    <arc:Button Grid.Column="2"
                                Variant="Primary"
                                Size="Small"
                                IsLoading="{Binding IsSkillInstalling}"
                                Content="{x:Static s:PluginStrings.SkillInstallNow}"
                                Command="{Binding InstallSkillCommand}" />
                </Grid>
            </Border>

            <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                    ClipToBounds="True">
                <ItemsControl ItemsSource="{Binding SkillTargets}" Margin="0,-1,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="s:SkillTargetRowViewModel">
                            <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                    BorderThickness="0,1,0,0"
                                    Padding="12,10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <CheckBox Grid.Column="0"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Classes="name" Text="{Binding DisplayName}" />
                                        <TextBlock Classes="mono" Text="{Binding ResolvedPath}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="hint" Text="{Binding ClientsNote}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <arc:Badge Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Size="Small"
                                               Tone="{Binding StatusTone}"
                                               Content="{Binding StatusLabel}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <arc:Input Text="{Binding CustomSkillPath, Mode=TwoWay}"
                           Size="Small"
                           Label="{x:Static s:PluginStrings.SkillAddCustom}"
                           IsLabelVisible="False"
                           Placeholder="{x:Static s:PluginStrings.SkillCustomPlaceholder}" />
                <arc:Button Grid.Column="1"
                            Variant="Secondary"
                            Size="Small"
                            Content="{x:Static s:PluginStrings.SkillAddCustom}"
                            Command="{Binding AddCustomSkillTargetCommand}" />
            </Grid>

            <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                    Padding="12"
                    IsVisible="{Binding HasSkillResult}">
                <SelectableTextBlock Classes="mono" Text="{Binding SkillInstallSummary}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
