<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:settings="using:Octopus.App.Settings"
             xmlns:s="using:Octopus.App.Plugins.Settings"
             x:Name="Root"
             x:Class="Octopus.App.Plugins.Settings.PluginsPageView"
             x:DataType="s:PluginsSettingsViewModel">
    <UserControl.Styles>
        <Style Selector="Border.market-featured-card">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.market-featured-card:pointerover">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
        <Style Selector="Border.market-compact-card">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.market-compact-card:pointerover">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
    </UserControl.Styles>

    <!-- Settings -> Plugins: Installed, Proposal-B Card Marketplace (Featured + 3-Col Grid), and Authoring Skill Modal Button -->
    <StackPanel Spacing="16">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <TextBlock Classes="title" Text="{x:Static s:PluginStrings.Title}" VerticalAlignment="Center" />
                <settings:SettingHelpTip Tip="{x:Static s:PluginStrings.Subtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <arc:SegmentedControl VerticalAlignment="Center"
                                      AutoScrollToSelectedItem="False"
                                      SelectedValue="{Binding ActiveTab, Mode=TwoWay}">
                    <arc:SegmentedOption Value="installed" Label="{x:Static s:PluginStrings.TabInstalled}" />
                    <arc:SegmentedOption Value="marketplace" Label="{x:Static s:PluginStrings.TabMarketplace}" />
                </arc:SegmentedControl>
                <Border Width="1"
                        Height="18"
                        Margin="2,0"
                        VerticalAlignment="Center"
                        Background="{arc:ArcDesignTokenResource BorderSubtle}" />
                <arc:Button Variant="Secondary"
                            Size="Small"
                            VerticalAlignment="Center"
                            Command="{Binding OpenSkillDialogCommand}"
                            arc:Tooltip.Tip="{x:Static s:PluginStrings.SkillButtonTip}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <lucide:LucideIcon Kind="Sparkles" Size="14" Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                        <TextBlock Text="{x:Static s:PluginStrings.TabSkills}" VerticalAlignment="Center" />
                    </StackPanel>
                </arc:Button>
            </StackPanel>
        </Grid>

        <arc:Alert Tone="{Binding MessageTone}" Title="{Binding Message}" IsVisible="{Binding HasMessage}">
            <arc:Button Variant="Ghost" Size="Small" HorizontalAlignment="Right" Command="{Binding DismissMessageCommand}">
                <lucide:LucideIcon Kind="X" Size="14" />
            </arc:Button>
        </arc:Alert>

        <!-- ==================== TAB 1: INSTALLED PLUGINS ==================== -->
        <StackPanel Spacing="16" IsVisible="{Binding IsInstalledTab}">
            <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                    Padding="14,10">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <TextBlock Classes="name" Text="{x:Static s:PluginStrings.Install}" VerticalAlignment="Center" />
                        <settings:SettingHelpTip Tip="{x:Static s:PluginStrings.InstallHint}" />
                    </StackPanel>
                    <arc:Button Grid.Column="1"
                                Variant="Ghost"
                                Size="Small"
                                VerticalAlignment="Center"
                                Command="{Binding OpenFolderCommand}"
                                AutomationProperties.Name="{x:Static s:PluginStrings.OpenFolder}"
                                arc:Tooltip.Tip="{x:Static s:PluginStrings.OpenFolder}">
                        <lucide:LucideIcon Kind="FolderOpen" Size="16" />
                    </arc:Button>
                    <arc:Button Grid.Column="2"
                                Variant="Secondary"
                                Size="Small"
                                VerticalAlignment="Center"
                                Content="{x:Static s:PluginStrings.Rescan}"
                                Command="{Binding RescanCommand}" />
                    <arc:Button Grid.Column="3"
                                Variant="Primary"
                                Size="Small"
                                VerticalAlignment="Center"
                                Command="{Binding InstallCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:LucideIcon Kind="PackagePlus" Size="14" />
                            <TextBlock Text="{x:Static s:PluginStrings.Install}" />
                        </StackPanel>
                    </arc:Button>
                </Grid>
            </Border>

            <StackPanel Spacing="6" IsVisible="{Binding HasBuiltin}">
                <TextBlock Classes="group" Margin="2,4,0,0" Text="{x:Static s:PluginStrings.Builtin}" />
                <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                        ClipToBounds="True">
                    <ItemsControl ItemsSource="{Binding Builtin}" Margin="0,-1,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="s:PluginRowViewModel">
                                <s:PluginRowView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <StackPanel Spacing="6">
                <TextBlock Classes="group" Margin="2,12,0,0" Text="{x:Static s:PluginStrings.Installed}" />
                <TextBlock Classes="hint" Margin="2,0,0,0" Text="{x:Static s:PluginStrings.NoneInstalled}" IsVisible="{Binding !HasInstalled}" />
                <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                        ClipToBounds="True"
                        IsVisible="{Binding HasInstalled}">
                    <ItemsControl ItemsSource="{Binding Installed}" Margin="0,-1,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="s:PluginRowViewModel">
                                <s:PluginRowView />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- Color themes from plugins (design/plugins/07-主题.md §5): one per appearance. -->
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="5" Margin="2,12,0,0">
                    <TextBlock Classes="group" Text="{x:Static s:PluginStrings.Themes}" VerticalAlignment="Center" />
                    <settings:SettingHelpTip Tip="{x:Static s:PluginStrings.ThemesHint}" />
                </StackPanel>
                <arc:SettingsGroup Appearance="Card" IsEnabled="{Binding HasThemes}">
                    <arc:SettingsRow Header="{x:Static s:PluginStrings.LightTheme}">
                        <arc:Select AutoScrollToSelectedItem="False" Size="Small" Width="220"
                                    AutomationProperties.Name="{x:Static s:PluginStrings.LightTheme}"
                                    ItemsSource="{Binding LightThemes}"
                                    SelectedValue="{Binding LightTheme, Mode=TwoWay}" />
                    </arc:SettingsRow>
                    <arc:SettingsRow Header="{x:Static s:PluginStrings.DarkTheme}">
                        <arc:Select AutoScrollToSelectedItem="False" Size="Small" Width="220"
                                    AutomationProperties.Name="{x:Static s:PluginStrings.DarkTheme}"
                                    ItemsSource="{Binding DarkThemes}"
                                    SelectedValue="{Binding DarkTheme, Mode=TwoWay}" />
                    </arc:SettingsRow>
                </arc:SettingsGroup>
                <TextBlock Classes="hint" Margin="2,0,0,0" Text="{x:Static s:PluginStrings.NoThemes}" IsVisible="{Binding !HasThemes}" />
                <arc:Alert Tone="Warning" Title="{x:Static s:PluginStrings.ThemeRefused}" Content="{Binding ThemeProblem}" IsVisible="{Binding HasThemeProblem}" />
            </StackPanel>
        </StackPanel>

        <!-- ==================== TAB 2: BUILT-IN MARKETPLACE (PROPOSAL B) ==================== -->
        <StackPanel Spacing="14" IsVisible="{Binding IsMarketplaceTab}">
            <!-- Search, sort, refresh & web portal controls -->
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                    <arc:SearchField Text="{Binding MarketQuery, Mode=TwoWay}"
                                     Size="Small"
                                     Label="{x:Static s:PluginStrings.TabMarketplace}"
                                     IsLabelVisible="False"
                                     Placeholder="{x:Static s:PluginStrings.MarketSearchPlaceholder}" />
                    <arc:Select Grid.Column="1"
                                AutoScrollToSelectedItem="False"
                                Size="Small"
                                Width="136"
                                ItemsSource="{Binding MarketSortOptions}"
                                SelectedValue="{Binding MarketSort, Mode=TwoWay}" />
                    <arc:Button Grid.Column="2"
                                Variant="Secondary"
                                Size="Small"
                                IsLoading="{Binding IsMarketLoading}"
                                Command="{Binding RefreshMarketplaceCommand}"
                                AutomationProperties.Name="{x:Static s:PluginStrings.MarketRefresh}"
                                arc:Tooltip.Tip="{x:Static s:PluginStrings.MarketRefresh}">
                        <lucide:LucideIcon Kind="RefreshCw" Size="14" />
                    </arc:Button>
                    <arc:Button Grid.Column="3"
                                Variant="Ghost"
                                Size="Small"
                                Command="{Binding OpenWebMarketplaceCommand}"
                                AutomationProperties.Name="{x:Static s:PluginStrings.MarketOpenWeb}"
                                arc:Tooltip.Tip="{x:Static s:PluginStrings.MarketOpenWeb}">
                        <lucide:LucideIcon Kind="ExternalLink" Size="15" />
                    </arc:Button>
                </Grid>

                <!-- Horizontal category pills -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <ItemsControl ItemsSource="{Binding MarketCategoryChips}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="s:MarketplaceCategoryChipViewModel">
                                <arc:Button Variant="{Binding ButtonVariant}"
                                            Size="Small"
                                            Command="{Binding SelectCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Count}"
                                                   Opacity="0.72"
                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                   VerticalAlignment="Center"
                                                   IsVisible="{Binding HasCount}" />
                                    </StackPanel>
                                </arc:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Grid.Column="1"
                               Classes="hint"
                               VerticalAlignment="Center"
                               Text="{Binding MarketCountLabel}"
                               IsVisible="{Binding HasMarketItems}" />
                </Grid>
            </StackPanel>

            <arc:Alert Tone="Danger" Title="{Binding MarketError}" IsVisible="{Binding HasMarketError}" />

            <!-- Empty state -->
            <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="24,28"
                    IsVisible="{Binding !HasMarketItems}">
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <lucide:LucideIcon Kind="Search" Size="24"
                                       HorizontalAlignment="Center"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                       Opacity="0.65" />
                    <TextBlock Classes="name"
                               HorizontalAlignment="Center"
                               Text="{x:Static s:PluginStrings.MarketEmpty}" />
                    <TextBlock Classes="hint"
                               HorizontalAlignment="Center"
                               Text="{x:Static s:PluginStrings.MarketEmptyHint}" />
                    <arc:Button Variant="Secondary"
                                Size="Small"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                Content="{x:Static s:PluginStrings.MarketResetFilters}"
                                Command="{Binding ResetMarketFiltersCommand}"
                                IsVisible="{Binding HasActiveMarketFilters}" />
                </StackPanel>
            </Border>

            <!-- Featured Spotlight Banner (2-column) -->
            <StackPanel Spacing="6" IsVisible="{Binding ShowFeaturedSection}">
                <Grid ColumnDefinitions="*,Auto" Margin="2,0">
                    <TextBlock Classes="group" Text="{x:Static s:PluginStrings.MarketFeaturedHeading}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="hint" Text="{x:Static s:PluginStrings.MarketFeaturedHint}" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding FeaturedMarketItems}" Margin="-5">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding #Root.FeaturedGridColumns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="s:MarketplacePluginRowViewModel">
                            <Border Classes="market-featured-card"
                                    PointerPressed="OnMarketplaceCardPointerPressed">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <Border Width="44" Height="44"
                                            CornerRadius="10"
                                            Background="{arc:ArcDesignTokenResource Surface}"
                                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                            BorderThickness="1"
                                            ClipToBounds="True"
                                            VerticalAlignment="Center">
                                        <Panel>
                                            <Image Source="{Binding IconBitmap}"
                                                   Width="28" Height="28"
                                                   Stretch="Uniform"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding HasIconBitmap}" />
                                            <lucide:LucideIcon Kind="{Binding Icon}" Size="20"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                                               IsVisible="{Binding !HasIconBitmap}" />
                                        </Panel>
                                    </Border>

                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <lucide:LucideIcon Kind="Sparkles" Size="11"
                                                               Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                                               VerticalAlignment="Center" />
                                            <TextBlock FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                                       Text="{Binding FeaturedKicker}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <TextBlock Classes="name"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Name}"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <lucide:LucideIcon Kind="BadgeCheck" Size="13"
                                                               Foreground="{arc:ArcDesignTokenResource Accent}"
                                                               VerticalAlignment="Center"
                                                               IsVisible="{Binding PublisherVerified}" />
                                        </StackPanel>
                                        <TextBlock Classes="hint"
                                                   Text="{Binding Description}"
                                                   TextWrapping="Wrap"
                                                   MaxLines="2"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Panel Grid.Column="2" VerticalAlignment="Center">
                                        <arc:Badge Size="Small"
                                                   Tone="Success"
                                                   Content="{x:Static s:PluginStrings.MarketInstalledBadge}"
                                                   IsVisible="{Binding !ShowActionButton}" />
                                        <arc:Button Variant="Primary"
                                                    Size="Small"
                                                    IsLoading="{Binding IsBusy}"
                                                    IsVisible="{Binding ShowActionButton}"
                                                    Content="{Binding ActionLabel}"
                                                    Command="{Binding InstallOrUpgradeCommand}" />
                                    </Panel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- All Plugins Compact Card Grid (3-column, adapts to 2/1 on narrow windows) -->
            <StackPanel Spacing="6" IsVisible="{Binding HasMarketItems}">
                <Grid ColumnDefinitions="*,Auto" Margin="2,2,2,0">
                    <TextBlock Classes="group" Text="{x:Static s:PluginStrings.MarketAllHeading}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="hint" Text="{Binding MarketCountLabel}" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding MarketItems}" Margin="-5">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding #Root.MarketGridColumns}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="s:MarketplacePluginRowViewModel">
                            <Border Classes="market-compact-card"
                                    PointerPressed="OnMarketplaceCardPointerPressed">
                                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                                    <!-- Top row: icon tile + risk dot -->
                                    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <Border Width="34" Height="34"
                                                CornerRadius="8"
                                                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                BorderThickness="1"
                                                ClipToBounds="True">
                                            <Panel>
                                                <Image Source="{Binding IconBitmap}"
                                                       Width="22" Height="22"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       IsVisible="{Binding HasIconBitmap}" />
                                                <lucide:LucideIcon Kind="{Binding Icon}" Size="17"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                   IsVisible="{Binding !HasIconBitmap}" />
                                            </Panel>
                                        </Border>

                                        <StackPanel Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    Spacing="5"
                                                    VerticalAlignment="Center"
                                                    arc:Tooltip.Tip="{Binding PermissionsSummary}">
                                            <Panel VerticalAlignment="Center">
                                                <Ellipse Width="7" Height="7" Fill="{arc:ArcDesignTokenResource Danger}" IsVisible="{Binding IsHighRisk}" />
                                                <Ellipse Width="7" Height="7" Fill="{arc:ArcDesignTokenResource Warning}" IsVisible="{Binding IsMediumRisk}" />
                                                <Ellipse Width="7" Height="7" Fill="{arc:ArcDesignTokenResource Success}" IsVisible="{Binding IsLowRisk}" />
                                            </Panel>
                                            <TextBlock Classes="hint" Text="{Binding RiskShortLabel}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Plugin name -->
                                    <TextBlock Grid.Row="1"
                                               Margin="0,8,0,0"
                                               Classes="name"
                                               FontWeight="SemiBold"
                                               Text="{Binding Name}"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Publisher + verified tick + category -->
                                    <StackPanel Grid.Row="2" Margin="0,2,0,0" Orientation="Horizontal" Spacing="4">
                                        <TextBlock Classes="hint" Text="{Binding PublisherSlug}" VerticalAlignment="Center" />
                                        <lucide:LucideIcon Kind="BadgeCheck" Size="12"
                                                           Foreground="{arc:ArcDesignTokenResource Accent}"
                                                           VerticalAlignment="Center"
                                                           IsVisible="{Binding PublisherVerified}" />
                                        <TextBlock Classes="hint" Text="·" VerticalAlignment="Center" />
                                        <TextBlock Classes="hint" Text="{Binding CategoryLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- 2-line description -->
                                    <TextBlock Grid.Row="3"
                                               Margin="0,7,0,10"
                                               Classes="hint"
                                               Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               MaxLines="2"
                                               MinHeight="34"
                                               TextTrimming="CharacterEllipsis" />

                                    <!-- Footer: version + downloads + install/installed action -->
                                    <Border Grid.Row="4"
                                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                            BorderThickness="0,1,0,0"
                                            Padding="0,8,0,0">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Classes="mono" Text="{Binding VersionLabel}" VerticalAlignment="Center" />
                                                <TextBlock Classes="hint" Text="{Binding DownloadsLabel}" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                                <arc:Badge Size="Small"
                                                           Tone="Success"
                                                           Content="{x:Static s:PluginStrings.MarketInstalledBadge}"
                                                           IsVisible="{Binding !ShowActionButton}" />
                                                <arc:Button Variant="Primary"
                                                            Size="Small"
                                                            IsLoading="{Binding IsBusy}"
                                                            IsVisible="{Binding ShowActionButton}"
                                                            Content="{Binding ActionLabel}"
                                                            Command="{Binding InstallOrUpgradeCommand}" />
                                            </Panel>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
