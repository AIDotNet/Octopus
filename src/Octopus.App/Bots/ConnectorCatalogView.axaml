<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:common="using:Octopus.App.Common"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="using:Octopus.App.Bots"
             x:Class="Octopus.App.Bots.ConnectorCatalogView"
             x:DataType="vm:ConnectorCatalogViewModel">
    <Grid ColumnDefinitions="196,*" Height="460" HorizontalAlignment="Stretch">
        <!-- Left category sidebar -->
        <Grid RowDefinitions="*,Auto" Margin="0,0,12,0">
            <Border BorderThickness="0,0,1,0" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" Padding="0,0,12,0">
                <Grid RowDefinitions="*,Auto">
                    <ItemsControl x:Name="CategoriesList" ItemsSource="{Binding Categories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <arc:ScrollArea Name="PART_ScrollViewer" OverlayScrollbarMode="Auto" FadeLength="0"
                                                HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </arc:ScrollArea>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ConnectorCategoryItemViewModel">
                                <StackPanel Margin="0,0,0,2">
                                    <Border IsVisible="{Binding SeparatorBefore}" Height="1" Margin="4,8"
                                            Background="{arc:ArcDesignTokenResource BorderSubtle}" />
                                    <Button Classes="row" Classes.selected="{Binding IsSelected}"
                                            Padding="8,6"
                                            Command="{Binding SelectCommand}">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <lucide:LucideIcon Kind="{Binding Icon}" Size="14" VerticalAlignment="Center"
                                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                            <TextBlock Grid.Column="1" Classes="body" Text="{Binding Name}"
                                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Classes="hint" IsVisible="{Binding HasCount}"
                                                       Text="{Binding CountText}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" Padding="0,8,0,0" Margin="0,8,0,0">
                        <Button Classes="row" Padding="8,6" Command="{Binding ToggleAddByUrlCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                <lucide:LucideIcon Kind="Plus" Size="14" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Classes="body" Text="{l:AppLangResource BotConnectorCatalogAddByUrl}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Right search + categorized app list -->
        <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
            <arc:SearchField x:Name="AppSearchField" Size="Small" IsLabelVisible="False"
                             Label="{l:AppLangResource BotConnectorCatalogSearch}"
                             Placeholder="{l:AppLangResource BotConnectorCatalogSearch}"
                             Text="{Binding SearchQuery, Mode=TwoWay}" />

            <!-- Optional inline "+ Add by URL" form (HTTP / SSE + optional Bearer token + Test) -->
            <Border Grid.Row="1" IsVisible="{Binding IsAddingByUrl}" Margin="0,10,0,0" Padding="10"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                    BorderBrush="{arc:ArcDesignTokenResource Border}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Classes="caption" Text="{l:AppLangResource BotConnectorCatalogAddByUrl}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <arc:Input Size="Small" IsLabelVisible="False"
                                   Label="{l:AppLangResource BotConnectorUrlNamePlaceholder}"
                                   Placeholder="{l:AppLangResource BotConnectorUrlNamePlaceholder}"
                                   Text="{Binding CustomUrlName, Mode=TwoWay}" />
                        <arc:SegmentedControl Grid.Column="1" VerticalAlignment="Center"
                                              SelectedValue="{Binding CustomTransport, Mode=TwoWay}"
                                              AutomationProperties.Name="{l:AppLangResource BotConnectorTransportLabel}">
                            <arc:SegmentedOption Value="http" Label="HTTP" />
                            <arc:SegmentedOption Value="sse" Label="SSE" />
                        </arc:SegmentedControl>
                    </Grid>
                    <arc:Input Size="Small" IsLabelVisible="False"
                               FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                               Label="{l:AppLangResource BotConnectorUrlPlaceholder}"
                               Placeholder="{l:AppLangResource BotConnectorUrlPlaceholder}"
                               Text="{Binding CustomUrl, Mode=TwoWay}" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <arc:Input Size="Small" IsLabelVisible="False"
                                   PasswordChar="•"
                                   Label="{l:AppLangResource BotConnectorTokenLabel}"
                                   Placeholder="{l:AppLangResource BotConnectorTokenPlaceholder}"
                                   Text="{Binding CustomBearerToken, Mode=TwoWay}" />
                        <arc:Button Grid.Column="1" Variant="Secondary" Size="Small"
                                    IsLoading="{Binding IsTestingCustomUrl}"
                                    Content="{l:AppLangResource BotConnectorTestButton}"
                                    Command="{Binding TestCustomUrlCommand}" />
                        <arc:Button Grid.Column="2" Variant="Primary" Size="Small"
                                    Content="{l:AppLangResource BotConnectorUrlConfirm}"
                                    Command="{Binding AddByUrlCommand}" />
                    </Grid>
                    <TextBlock Classes="hint" IsVisible="{Binding HasCustomUrlTestStatus}" Text="{Binding CustomUrlTestStatus}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Virtualized flattened list of category headers + app rows -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <ItemsControl x:Name="CatalogList" ItemsSource="{Binding CatalogItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Template>
                        <ControlTemplate>
                            <arc:ScrollArea Name="PART_ScrollViewer" OverlayScrollbarMode="Auto" FadeLength="0"
                                            HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="0,0,0,6" />
                            </arc:ScrollArea>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.DataTemplates>
                        <DataTemplate DataType="vm:ConnectorCatalogHeaderViewModel">
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="{Binding Margin}">
                                <lucide:LucideIcon Kind="{Binding Icon}" Size="12" Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                                <TextBlock Classes="caption" Text="{Binding Header}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                        <DataTemplate DataType="vm:ConnectorAppRowViewModel">
                            <Border Padding="8,7" Margin="0,0,0,4" CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                    Background="{arc:ArcDesignTokenResource Surface}"
                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="1">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                    <common:ConnectorIconView AppId="{Binding AppId}"
                                                              Size="32"
                                                              CornerRadius="8"
                                                              IconPadding="6"
                                                              TileBackground="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                              TileBorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                              FallbackText="{Binding BadgeText}"
                                                              FallbackBrush="{Binding BadgeBrush}"
                                                              VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding Name}" VerticalAlignment="Center" />
                                            <Border IsVisible="{Binding HasEndpoint}" Padding="5,1" CornerRadius="999"
                                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Classes="hint" FontSize="10" Text="{Binding AuthBadgeText}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Classes="hint" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <arc:Button Grid.Column="2" Size="Small" VerticalAlignment="Center"
                                                Variant="Secondary"
                                                Content="{Binding ActionLabel}"
                                                Command="{Binding ToggleCommand}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.DataTemplates>
                </ItemsControl>

                <TextBlock Classes="hint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24"
                           IsVisible="{Binding HasNoResults}"
                           Text="{l:AppLangResource BotChatsEmpty}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
