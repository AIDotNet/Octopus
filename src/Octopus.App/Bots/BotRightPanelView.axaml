<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:common="using:Octopus.App.Common"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ex="using:Octopus.App.Explorer"
             xmlns:files="using:Octopus.App.Explorer.Files"
             xmlns:search="using:Octopus.App.Explorer.Search"
             xmlns:vm="using:Octopus.App.Bots"
             x:Class="Octopus.App.Bots.BotRightPanelView"
             x:DataType="vm:BotRightPanelViewModel">
    <UserControl.Styles>
        <Style Selector="arc|Button.ex-icon">
            <Setter Property="Width" Value="{DynamicResource OctopusIconButtonSize}" />
            <Setter Property="Height" Value="{DynamicResource OctopusIconButtonSize}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsPressScaleEnabled" Value="False" />
        </Style>

        <Style Selector="Border.bot-card">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style Selector="Border.bot-settings-group">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="Border.bot-settings-sep">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="Margin" Value="12,0" />
        </Style>

        <!-- Avatar button with subtle hover pencil overlay (matches Image 5) -->
        <Style Selector="Button.bot-avatar-btn">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.bot-avatar-btn Border.avatar-edit-overlay">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.bot-avatar-btn:pointerover Border.avatar-edit-overlay">
            <Setter Property="Opacity" Value="1" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{arc:ArcDesignTokenResource SurfaceMuted}" RowDefinitions="Auto,Auto,*">
        <!-- Top drag bar aligned with window chrome -->
        <Border x:Name="TopBar" Height="{DynamicResource OctopusTopRowHeight}" Background="Transparent"
                PointerPressed="OnTopBarPointerPressed" />

        <!-- 4 tabs: 主页 | 连接器 | 聊天 | 文件 -->
        <ex:ExplorerTabGroup x:Name="Tabs" Size="Small" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                             IsVisible="{Binding HasBot}"
                             SelectedValue="{Binding TabKey, Mode=TwoWay}"
                             Label="{l:AppLangResource BotsTitle}" />

        <!-- No bot selected -->
        <arc:EmptyState Grid.Row="2" IsVisible="{Binding HasNoBot}" VerticalAlignment="Top" Margin="12,24"
                        Title="{l:AppLangResource BotRightEmptyTitle}"
                        Description="{l:AppLangResource BotRightEmptyDescription}"
                        Icon="{x:Static arc:ArcIcons.Sparkles}" />

        <!-- Tab 1A: 主页 Overview (matches Image 1) -->
        <arc:ScrollArea Grid.Row="2" IsVisible="{Binding IsHomeOverview}" OverlayScrollbarMode="Auto" FadeLength="0">
            <StackPanel Margin="12,8,12,20" Spacing="16">
                <!-- Bot identity header: clickable avatar + name + status + Settings gear + More menu -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Button Classes="bot-avatar-btn" Command="{Binding EditAvatarCommand}"
                            arc:Tooltip.Tip="{l:AppLangResource BotAvatarPickerTitle}">
                        <Grid Width="44" Height="44">
                            <Border Width="44" Height="44" CornerRadius="12" Background="{Binding BotAvatarBrush}" ClipToBounds="True">
                                <Panel>
                                    <Image IsVisible="{Binding HasBotAvatarImage}" Source="{Binding BotAvatarImage}"
                                           Width="44" Height="44" Stretch="UniformToFill"
                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                    <lucide:LucideIcon IsVisible="{Binding HasBotAvatarIcon}" Kind="{Binding BotAvatarIcon}" Size="22" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock IsVisible="{Binding ShowBotInitial}" Text="{Binding BotInitial}" Foreground="White"
                                               FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Classes="avatar-edit-overlay" Background="#77000000">
                                        <lucide:LucideIcon Kind="Pencil" Size="15" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                </Panel>
                            </Border>
                            <!-- Bottom-right status dot -->
                            <Border Width="11" Height="11" CornerRadius="5.5" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,-1,-1" Background="{arc:ArcDesignTokenResource SurfaceMuted}" Padding="2">
                                <Panel>
                                    <Ellipse IsVisible="{Binding IsBotWorking}" Fill="{arc:ArcDesignTokenResource Accent}" />
                                    <Ellipse IsVisible="{Binding !IsBotWorking}" Fill="{arc:ArcDesignTokenResource TextMuted}" Opacity="0.65" />
                                </Panel>
                            </Border>
                        </Grid>
                    </Button>

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="body" FontSize="15" FontWeight="SemiBold" Text="{Binding BotName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="hint" Text="{Binding BotStatusLine}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <arc:Button x:Name="BotSettingsButton" Classes="ex-icon" Variant="Ghost"
                                    Command="{Binding OpenSettingsCommand}"
                                    AutomationProperties.Name="{l:AppLangResource BotSettingsTitle}"
                                    arc:Tooltip.Tip="{l:AppLangResource BotSettingsTitle}">
                            <lucide:LucideIcon Kind="Settings" Size="15" />
                        </arc:Button>
                        <arc:Button Classes="ex-icon" Variant="Ghost"
                                    AutomationProperties.Name="{l:AppLangResource ExplorerMore}"
                                    arc:Tooltip.Tip="{l:AppLangResource ExplorerMore}">
                            <arc:Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuItem Header="{l:AppLangResource BotSettingsShare}" Command="{Binding OpenShareCommand}" />
                                    <MenuItem Header="{l:AppLangResource BotMenuEditSoul}" Command="{Binding EditSoulCommand}" />
                                    <MenuItem Header="{l:AppLangResource BotMenuRevealFolder}" Command="{Binding RevealHomeFolderCommand}" />
                                    <Separator />
                                    <MenuItem Header="{Binding PauseButtonTooltip}" Command="{Binding TogglePauseCommand}" />
                                    <MenuItem Header="{l:AppLangResource BotMenuRename}" Command="{Binding RenameBotCommand}" />
                                    <MenuItem Header="{l:AppLangResource BotSettingsDeleteEllipsis}" Command="{Binding DeleteBotCommand}" />
                                </MenuFlyout>
                            </arc:Button.Flyout>
                            <lucide:LucideIcon Kind="Ellipsis" Size="15" />
                        </arc:Button>
                    </StackPanel>
                </Grid>

                <!-- Items section: centered empty state (matches Image 1) OR active item cards -->
                <StackPanel IsVisible="{Binding HasNoWorkItems}" HorizontalAlignment="Center" Margin="12,26,12,18" Spacing="8" MaxWidth="260">
                    <lucide:LucideIcon Kind="ListChecks" Size="24" Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                       HorizontalAlignment="Center" />
                    <TextBlock Classes="body" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Text="{l:AppLangResource BotHomeEmptyItemsTitle}" />
                    <TextBlock Classes="hint" TextWrapping="Wrap" TextAlignment="Center"
                               Text="{Binding HomeEmptyItemsDescription}" />
                </StackPanel>

                <StackPanel IsVisible="{Binding HasWorkItems}" Spacing="6">
                    <TextBlock Classes="caption" Text="{l:AppLangResource BotHomeItemsHeading}" />
                    <ItemsControl ItemsSource="{Binding WorkItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BotWorkItemCardViewModel">
                                <Border Classes="bot-card">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                            <TextBlock Classes="hint" Text="{Binding NumberText}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Classes="body" FontWeight="SemiBold" Text="{Binding Title}"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" Padding="5,1" CornerRadius="999"
                                                    Background="{arc:ArcDesignTokenResource BorderSubtle}">
                                                <TextBlock Classes="hint" FontSize="10" Text="{Binding StatusLabel}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Classes="hint" TextWrapping="Wrap" IsVisible="{Binding HasQuestion}" Text="{Binding Question}" />
                                        <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding IsNeedsYou}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:BotWorkItemOptionViewModel">
                                                    <arc:Button Variant="Secondary" Size="Small" Content="{Binding Label}" Command="{Binding ChooseCommand}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Schedules the bot (via the octopus-bot MCP tools) or its owner made; Octopus fires them -->
                <StackPanel IsVisible="{Binding HasScheduledTasks}" Spacing="6">
                    <TextBlock Classes="caption" Text="{l:AppLangResource BotScheduledTasksHeading}" />
                    <Border Classes="bot-settings-group">
                        <ItemsControl ItemsSource="{Binding ScheduledTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:BotScheduleRowViewModel">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="4" Margin="0,0,8,0">
                                        <Button Classes="row" Padding="12,8" CornerRadius="0"
                                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                Command="{Binding OpenChatCommand}"
                                                arc:Tooltip.Tip="{Binding Tooltip}">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                                <Panel VerticalAlignment="Top" Margin="0,2,0,0">
                                                    <lucide:LucideIcon IsVisible="{Binding IsRecurring}" Kind="Repeat" Size="15"
                                                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                    <lucide:LucideIcon IsVisible="{Binding !IsRecurring}" Kind="AlarmClock" Size="15"
                                                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                </Panel>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Classes="body" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="hint" Text="{Binding ScheduleText}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Classes="hint" IsVisible="{Binding HasStatus}" Text="{Binding StatusText}"
                                                               Foreground="{arc:ArcDesignTokenResource Warning}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <arc:Switch Grid.Column="1" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <arc:Button Grid.Column="2" Classes="ex-icon" Variant="Ghost" VerticalAlignment="Center"
                                                    AutomationProperties.Name="{l:AppLangResource ExplorerMore}"
                                                    arc:Tooltip.Tip="{l:AppLangResource ExplorerMore}">
                                            <arc:Button.Flyout>
                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                    <MenuItem Header="{l:AppLangResource BotScheduleRunNow}" Command="{Binding RunNowCommand}" />
                                                    <MenuItem Header="{l:AppLangResource BotScheduleDelete}" Command="{Binding DeleteCommand}" />
                                                </MenuFlyout>
                                            </arc:Button.Flyout>
                                            <lucide:LucideIcon Kind="Ellipsis" Size="14" />
                                        </arc:Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                    <TextBlock Classes="hint" TextWrapping="Wrap" Margin="2,2,2,0" Text="{Binding ScheduledTasksHint}" />
                </StackPanel>

                <!-- Automations card (Look around + Memory maintenance) -->
                <StackPanel Spacing="6">
                    <TextBlock Classes="caption" Text="{l:AppLangResource BotHomeAutomationsHeading}" />
                    <Border Classes="bot-settings-group">
                        <StackPanel>
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="12,8">
                                <lucide:LucideIcon Kind="Eye" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="body" Text="{l:AppLangResource BotSettingsLookAround}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="hint" Text="{Binding LookAroundIntervalText}" VerticalAlignment="Center" />
                                <arc:Switch Grid.Column="3" IsChecked="{Binding LookAroundEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                            <Border Classes="bot-settings-sep" />
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="12,8">
                                <lucide:LucideIcon Kind="Moon" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="body" Text="{l:AppLangResource BotSettingsMemoryMaintenance}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Classes="hint" Text="{l:AppLangResource BotSettingsNightly}" VerticalAlignment="Center" />
                                <arc:Switch Grid.Column="3" IsChecked="{Binding TidyUpMemoryEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Classes="hint" TextWrapping="Wrap" Margin="2,2,2,0" Text="{Binding HomeAutomationsHint}" />
                </StackPanel>
            </StackPanel>
        </arc:ScrollArea>

        <!-- Tab 1B: In-panel Bot Settings sub-page (< {BotName} / 设置, matches Images 2 & 3) -->
        <Grid Grid.Row="2" IsVisible="{Binding IsHomeSettings}" RowDefinitions="Auto,*">
            <!-- Back header -->
            <Border BorderThickness="0,0,0,1" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" Padding="6,6,10,8">
                <Button Classes="row" Padding="6,4" HorizontalAlignment="Left" Command="{Binding CloseSettingsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <lucide:LucideIcon Kind="ChevronLeft" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                        <TextBlock Classes="body" Foreground="{arc:ArcDesignTokenResource TextSecondary}" Text="{Binding BotName}" VerticalAlignment="Center" />
                        <TextBlock Classes="hint" Text="/" VerticalAlignment="Center" />
                        <TextBlock Classes="body" FontWeight="SemiBold" Text="{l:AppLangResource BotSettingsTitle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Border>

            <arc:ScrollArea Grid.Row="1" OverlayScrollbarMode="Auto" FadeLength="0">
                <StackPanel Margin="12,12,12,24" Spacing="14">
                    <!-- Identity card with clickable avatar + Share icon -->
                    <Border Classes="bot-settings-group" Padding="10,9">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Button Classes="bot-avatar-btn" Command="{Binding EditAvatarCommand}"
                                    arc:Tooltip.Tip="{l:AppLangResource BotAvatarPickerTitle}">
                                <Border Width="38" Height="38" CornerRadius="10" Background="{Binding BotAvatarBrush}" ClipToBounds="True">
                                    <Panel>
                                        <Image IsVisible="{Binding HasBotAvatarImage}" Source="{Binding BotAvatarImage}"
                                               Width="38" Height="38" Stretch="UniformToFill"
                                               RenderOptions.BitmapInterpolationMode="HighQuality" />
                                        <lucide:LucideIcon IsVisible="{Binding HasBotAvatarIcon}" Kind="{Binding BotAvatarIcon}" Size="19" Foreground="White"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock IsVisible="{Binding ShowBotInitial}" Text="{Binding BotInitial}" Foreground="White"
                                                   FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Classes="avatar-edit-overlay" Background="#77000000">
                                            <lucide:LucideIcon Kind="Pencil" Size="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Panel>
                                </Border>
                            </Button>
                            <TextBlock Grid.Column="1" Classes="body" FontSize="14" FontWeight="SemiBold"
                                       Text="{Binding BotName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <arc:Button Grid.Column="2" Classes="ex-icon" Variant="Ghost" VerticalAlignment="Center"
                                        Command="{Binding OpenShareCommand}"
                                        arc:Tooltip.Tip="{l:AppLangResource BotSettingsShare}">
                                <lucide:LucideIcon Kind="Share2" Size="15" />
                            </arc:Button>
                        </Grid>
                    </Border>

                    <!-- Section: 智能体 -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="caption" Margin="2,0" Text="{l:AppLangResource BotSettingsSectionAgent}" />
                        <Border Classes="bot-settings-group">
                            <StackPanel>
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="12,6">
                                    <lucide:LucideIcon Kind="Bot" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="body" Text="{l:AppLangResource BotDialogAgentLabel}" VerticalAlignment="Center" />
                                    <arc:Select Grid.Column="2" Size="Small" MinWidth="118" MaxWidth="156" AutoScrollToSelectedItem="False"
                                                ItemsSource="{Binding AgentOptions}"
                                                SelectedValue="{Binding SelectedAgentId, Mode=TwoWay}" />
                                </Grid>
                                <Border Classes="bot-settings-sep" />
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="12,6">
                                    <lucide:LucideIcon Kind="Shield" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="body" Text="{l:AppLangResource BotSettingsPermission}" VerticalAlignment="Center" />
                                    <arc:Select Grid.Column="2" Size="Small" MinWidth="118" MaxWidth="156" AutoScrollToSelectedItem="False"
                                                ItemsSource="{Binding PermissionOptions}"
                                                SelectedValue="{Binding SelectedPermissionMode, Mode=TwoWay}" />
                                </Grid>
                                <Border Classes="bot-settings-sep" />
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="12,9">
                                    <lucide:LucideIcon Kind="Laptop" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="body" Text="{l:AppLangResource BotDialogHostLabel}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="hint" Text="{Binding BotHostDisplayName}" VerticalAlignment="Center" />
                                </Grid>
                                <Border Classes="bot-settings-sep" />
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="12,7">
                                    <lucide:LucideIcon Kind="Activity" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="body" Text="{l:AppLangResource BotSettingsEnabled}" VerticalAlignment="Center" />
                                    <arc:Switch Grid.Column="2" IsChecked="{Binding IsBotEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Section: 计划 -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="caption" Margin="2,0" Text="{l:AppLangResource BotSettingsSectionSchedule}" />
                        <Border Classes="bot-settings-group">
                            <StackPanel>
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="12,7">
                                    <lucide:LucideIcon Kind="Eye" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="body" Text="{l:AppLangResource BotSettingsLookAround}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="hint" Text="{Binding LookAroundIntervalText}" VerticalAlignment="Center" />
                                    <arc:Switch Grid.Column="3" IsChecked="{Binding LookAroundEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                                <Border Classes="bot-settings-sep" />
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10" Margin="12,7">
                                    <lucide:LucideIcon Kind="Moon" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="body" Text="{l:AppLangResource BotSettingsMemoryMaintenance}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Classes="hint" Text="{l:AppLangResource BotSettingsNightly}" VerticalAlignment="Center" />
                                    <arc:Switch Grid.Column="3" IsChecked="{Binding TidyUpMemoryEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Section: 事项 -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="caption" Margin="2,0" Text="{l:AppLangResource BotSettingsSectionItems}" />
                        <Border Classes="bot-settings-group" Padding="12,6">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <lucide:LucideIcon Kind="Hourglass" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="body" Text="{l:AppLangResource BotSettingsStaleAfter}" VerticalAlignment="Center" />
                                <arc:Select Grid.Column="2" Size="Small" MinWidth="0" Width="88" AutoScrollToSelectedItem="False"
                                            ItemsSource="{Binding StaleDayOptions}"
                                            SelectedValue="{Binding StaleAfterDaysKey, Mode=TwoWay}" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Section: 灵魂与记忆 -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="caption" Margin="2,0" Text="{l:AppLangResource BotSettingsSectionSoulMemory}" />
                        <Border Classes="bot-settings-group">
                            <StackPanel>
                                <Button Classes="row" Padding="12,9" Command="{Binding EditSoulCommand}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <lucide:LucideIcon Kind="Smile" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="body" Text="{l:AppLangResource BotSettingsSoul}" VerticalAlignment="Center" />
                                        <lucide:LucideIcon Grid.Column="2" Kind="ChevronRight" Size="14" Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Border Classes="bot-settings-sep" />
                                <Button Classes="row" Padding="12,9" Command="{Binding EditMemoryCommand}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                        <lucide:LucideIcon Kind="Brain" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="body" Text="{l:AppLangResource BotSettingsMemory}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="hint" Text="{Binding MemoryFilesSummary}" VerticalAlignment="Center" />
                                        <lucide:LucideIcon Grid.Column="3" Kind="ChevronRight" Size="14" Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Section: 访问权限 -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="caption" Margin="2,0" Text="{l:AppLangResource BotSettingsSectionAccess}" />
                        <Border Classes="bot-settings-group">
                            <StackPanel>
                                <Button Classes="row" Padding="12,9" Command="{Binding OpenConnectorsTabCommand}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                        <lucide:LucideIcon Kind="Plug" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="body" Text="{l:AppLangResource BotRightTabConnectors}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="hint" Text="{Binding ConnectorsCountSummary}" VerticalAlignment="Center" />
                                        <lucide:LucideIcon Grid.Column="3" Kind="ChevronRight" Size="14" Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Border Classes="bot-settings-sep" />
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="12,6">
                                    <lucide:LucideIcon Kind="Users" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="body" Text="{l:AppLangResource BotSettingsWhoCanAsk}" VerticalAlignment="Center" />
                                    <arc:Select Grid.Column="2" Size="Small" MinWidth="118" MaxWidth="156" AutoScrollToSelectedItem="False"
                                                ItemsSource="{Binding WhoCanAskOptions}"
                                                SelectedValue="{Binding SelectedWhoCanAsk, Mode=TwoWay}" />
                                </Grid>
                                <Border Classes="bot-settings-sep" />
                                <Button Classes="row" Padding="12,9" Command="{Binding OpenConnectorCatalogCommand}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                        <lucide:LucideIcon Kind="Wrench" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="body" Text="{l:AppLangResource BotSettingsTools}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="hint" Text="{Binding ToolsCountSummary}" VerticalAlignment="Center" />
                                        <lucide:LucideIcon Grid.Column="3" Kind="ChevronRight" Size="14" Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Border Classes="bot-settings-sep" />
                                <Button Classes="row" Padding="12,9" Command="{Binding RevealSkillsFolderCommand}">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                                        <lucide:LucideIcon Kind="BookOpen" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Classes="body" Text="{l:AppLangResource BotSettingsSkills}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="hint" Text="{Binding SkillsCountSummary}" VerticalAlignment="Center" />
                                        <lucide:LucideIcon Grid.Column="3" Kind="ChevronRight" Size="14" Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Share standalone card -->
                    <Border Classes="bot-settings-group">
                        <Button Classes="row" Padding="12,9" Command="{Binding OpenShareCommand}">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                <lucide:LucideIcon Kind="Share2" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="body" Text="{l:AppLangResource BotSettingsShare}" VerticalAlignment="Center" />
                                <lucide:LucideIcon Grid.Column="2" Kind="ChevronRight" Size="14" Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Border>

                    <!-- Section: 通知 -->
                    <StackPanel Spacing="6">
                        <TextBlock Classes="caption" Margin="2,0" Text="{l:AppLangResource BotSettingsSectionNotifications}" />
                        <Border Classes="bot-settings-group">
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto" Margin="12,7">
                                    <TextBlock Classes="body" Text="{l:AppLangResource BotSettingsNotifyPermission}" VerticalAlignment="Center" />
                                    <arc:Switch Grid.Column="1" IsChecked="{Binding NotifyNeedsPermission, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                                <Border Classes="bot-settings-sep" />
                                <Grid ColumnDefinitions="*,Auto" Margin="12,7">
                                    <TextBlock Classes="body" Text="{l:AppLangResource BotSettingsNotifyDone}" VerticalAlignment="Center" />
                                    <arc:Switch Grid.Column="1" IsChecked="{Binding NotifyTaskCompleted, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                                <Border Classes="bot-settings-sep" />
                                <Grid ColumnDefinitions="*,Auto" Margin="12,7">
                                    <TextBlock Classes="body" Text="{l:AppLangResource BotSettingsNotifyFailed}" VerticalAlignment="Center" />
                                    <arc:Switch Grid.Column="1" IsChecked="{Binding NotifyUnableToComplete, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Destructive delete action -->
                    <Button Classes="row" Padding="8,8" Command="{Binding DeleteBotCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <lucide:LucideIcon Kind="Trash2" Size="15" Foreground="{arc:ArcDesignTokenResource Danger}" VerticalAlignment="Center" />
                            <TextBlock Classes="body" FontWeight="Medium" Foreground="{arc:ArcDesignTokenResource Danger}"
                                       Text="{l:AppLangResource BotSettingsDeleteEllipsis}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </arc:ScrollArea>
        </Grid>

        <!-- Tab 2: Connectors -->
        <Grid Grid.Row="2" IsVisible="{Binding IsConnectorsTab}">
            <StackPanel IsVisible="{Binding HasNoConnectors}" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Margin="20,0" Spacing="16" MaxWidth="280">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
                    <common:ConnectorIconView AppId="slack" Size="38" CornerRadius="10" IconPadding="8"
                                              TileBackground="{arc:ArcDesignTokenResource Surface}"
                                              TileBorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" />
                    <common:ConnectorIconView AppId="google" Size="38" CornerRadius="10" IconPadding="8"
                                              TileBackground="{arc:ArcDesignTokenResource Surface}"
                                              TileBorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" />
                    <common:ConnectorIconView AppId="linear" Size="38" CornerRadius="10" IconPadding="8"
                                              TileBackground="{arc:ArcDesignTokenResource Surface}"
                                              TileBorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" />
                    <common:ConnectorIconView AppId="github" Size="38" CornerRadius="10" IconPadding="8"
                                              TileBackground="{arc:ArcDesignTokenResource Surface}"
                                              TileBorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" />
                </StackPanel>

                <TextBlock Classes="body" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                           Text="{Binding ConnectorsEmptyDescription}" />

                <arc:Button x:Name="EmptyAddConnectorButton" Variant="Primary" Size="Medium" HorizontalAlignment="Center"
                            Command="{Binding OpenConnectorCatalogCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <lucide:LucideIcon Kind="Plus" Size="14" VerticalAlignment="Center" />
                        <TextBlock Text="{l:AppLangResource BotConnectorsAddButton}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                </arc:Button>
            </StackPanel>

            <Grid IsVisible="{Binding HasConnectors}" RowDefinitions="Auto,*,Auto">
                <Border Padding="10,8,10,6">
                    <arc:Button Variant="Secondary" Size="Small" HorizontalAlignment="Stretch"
                                Command="{Binding OpenConnectorCatalogCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <lucide:LucideIcon Kind="Plus" Size="13" VerticalAlignment="Center" />
                            <TextBlock Text="{l:AppLangResource BotConnectorsAddButton}" VerticalAlignment="Center" />
                        </StackPanel>
                    </arc:Button>
                </Border>
                <ItemsControl x:Name="ConnectorsList" Grid.Row="1" ItemsSource="{Binding Connectors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Template>
                        <ControlTemplate>
                            <arc:ScrollArea Name="PART_ScrollViewer" OverlayScrollbarMode="Auto" FadeLength="0"
                                            HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="10,4,10,8" />
                            </arc:ScrollArea>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BotConnectorItemViewModel">
                            <Border Classes="bot-card" Padding="10,9" Margin="0,0,0,6" ClipToBounds="True">
                                        <StackPanel Spacing="9">
                                            <!-- Card header: icon + title/badges/url + actions -->
                                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="9">
                                                <common:ConnectorIconView AppId="{Binding AppId}"
                                                                          Size="32"
                                                                          CornerRadius="8"
                                                                          IconPadding="6"
                                                                          TileBackground="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                                          TileBorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                                          FallbackText="{Binding BadgeText}"
                                                                          FallbackBrush="{Binding BadgeBrush}"
                                                                          VerticalAlignment="Top"
                                                                          Margin="0,1,0,0" />
                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding Name}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                        <!-- Auth status pill -->
                                                        <Border Padding="5,1" CornerRadius="4"
                                                                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="1"
                                                                VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <Ellipse Width="5.5" Height="5.5" IsVisible="{Binding IsAuthenticated}"
                                                                         Fill="{arc:ArcDesignTokenResource Success}" VerticalAlignment="Center" />
                                                                <Ellipse Width="5.5" Height="5.5" IsVisible="{Binding NeedsAttention}"
                                                                         Fill="{arc:ArcDesignTokenResource Warning}" VerticalAlignment="Center" />
                                                                <Ellipse Width="5.5" Height="5.5" IsVisible="{Binding IsNoAuth}"
                                                                         Fill="{arc:ArcDesignTokenResource TextMuted}" Opacity="0.65" VerticalAlignment="Center" />
                                                                <TextBlock Classes="hint" FontSize="10" Text="{Binding AuthBadge}" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Border>
                                                        <!-- Transport pill -->
                                                        <Border IsVisible="{Binding HasEndpoint}" Padding="5,1" CornerRadius="4"
                                                                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Classes="hint" FontSize="9.5"
                                                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                       Text="{Binding TransportBadge}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Classes="hint" FontSize="11"
                                                               Text="{Binding Subtitle}"
                                                               TextTrimming="CharacterEllipsis"
                                                               arc:Tooltip.Tip="{Binding Subtitle}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top">
                                                    <arc:Button Classes="ex-icon" Variant="Ghost" VerticalAlignment="Center"
                                                                Command="{Binding ToggleEditCommand}"
                                                                arc:Tooltip.Tip="{l:AppLangResource BotConnectorConfigureTip}">
                                                        <lucide:LucideIcon Kind="SlidersHorizontal" Size="13" />
                                                    </arc:Button>
                                                    <arc:Switch IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" Margin="2,0" />
                                                    <arc:Button Classes="ex-icon" Variant="Ghost" VerticalAlignment="Center"
                                                                Command="{Binding RemoveCommand}"
                                                                arc:Tooltip.Tip="{l:AppLangResource BotConnectorRemove}">
                                                        <lucide:LucideIcon Kind="Trash2" Size="13" />
                                                    </arc:Button>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Quick 1-click OAuth sign-in bar for unauthorized OAuth connectors -->
                                            <Grid IsVisible="{Binding ShowQuickOAuthBar}" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                <arc:Button Variant="Primary" Size="Small" HorizontalAlignment="Stretch"
                                                            IsLoading="{Binding IsSigningInOAuth}"
                                                            Command="{Binding SignInOAuthCommand}">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <lucide:LucideIcon Kind="LogIn" Size="13" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding OAuthActionLabel}" FontWeight="Medium" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </arc:Button>
                                                <arc:Button Grid.Column="1" Variant="Ghost" Size="Small"
                                                            IsVisible="{Binding IsSigningInOAuth}"
                                                            Content="{l:AppLangResource Cancel}"
                                                            Command="{Binding CancelOAuthCommand}" />
                                            </Grid>

                                            <!-- Collapsed status feedback (e.g. OAuth progress/error from quick sign-in) -->
                                            <Border IsVisible="{Binding ShowCollapsedFeedback}" Padding="8,6"
                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="1">
                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                    <Panel VerticalAlignment="Top" Margin="0,1.5,0,0">
                                                        <lucide:LucideIcon Kind="CheckCircle2" Size="13" IsVisible="{Binding IsProbeSuccess}" Foreground="{arc:ArcDesignTokenResource Success}" />
                                                        <lucide:LucideIcon Kind="AlertCircle" Size="13" IsVisible="{Binding IsProbeWarning}" Foreground="{arc:ArcDesignTokenResource Warning}" />
                                                        <lucide:LucideIcon Kind="XCircle" Size="13" IsVisible="{Binding IsProbeError}" Foreground="{arc:ArcDesignTokenResource Danger}" />
                                                        <lucide:LucideIcon Kind="Info" Size="13" IsVisible="{Binding IsProbeNeutral}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                                    </Panel>
                                                    <TextBlock Grid.Column="1" Classes="hint" Text="{Binding ProbeStatusText}" TextWrapping="Wrap" />
                                                </Grid>
                                            </Border>

                                            <!-- Expanded inline configuration panel -->
                                            <Border IsVisible="{Binding IsEditing}" Padding="10"
                                                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="1"
                                                    ClipToBounds="True">
                                                <StackPanel Spacing="10">
                                                    <!-- OAuth 2.1 browser sign-in section -->
                                                    <Border IsVisible="{Binding CanUseOAuth}" Padding="9,8"
                                                            CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                            Background="{arc:ArcDesignTokenResource Surface}"
                                                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="1">
                                                        <StackPanel Spacing="7">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                    <lucide:LucideIcon Kind="ShieldCheck" Size="13" Foreground="{arc:ArcDesignTokenResource Accent}" VerticalAlignment="Center" />
                                                                    <TextBlock Classes="caption" FontWeight="SemiBold" Text="OAuth 2.1" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Classes="hint" FontSize="11"
                                                                           IsVisible="{Binding IsOAuthSignedIn}"
                                                                           Foreground="{arc:ArcDesignTokenResource Success}"
                                                                           Text="{l:AppLangResource BotConnectorAuthOAuthSignedIn}"
                                                                           VerticalAlignment="Center" />
                                                            </Grid>
                                                            <TextBlock Classes="hint" FontSize="11" TextWrapping="Wrap"
                                                                       Text="{l:AppLangResource BotConnectorOAuthHint}" />
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                                <arc:Button Variant="Primary" Size="Small" HorizontalAlignment="Stretch"
                                                                            IsLoading="{Binding IsSigningInOAuth}"
                                                                            Command="{Binding SignInOAuthCommand}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                        <lucide:LucideIcon Kind="LogIn" Size="13" VerticalAlignment="Center" />
                                                                        <TextBlock Text="{Binding OAuthActionLabel}" FontWeight="Medium" VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </arc:Button>
                                                                <arc:Button Grid.Column="1" Variant="Ghost" Size="Small"
                                                                            IsVisible="{Binding IsSigningInOAuth}"
                                                                            Content="{l:AppLangResource Cancel}"
                                                                            Command="{Binding CancelOAuthCommand}" />
                                                                <arc:Button Grid.Column="1" Variant="Ghost" Size="Small"
                                                                            IsVisible="{Binding ShowOAuthSignOut}"
                                                                            Content="{l:AppLangResource BotConnectorOAuthSignOut}"
                                                                            Command="{Binding ClearTokenCommand}" />
                                                            </Grid>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Endpoint URL / Template Variable + Transport segmented switcher (zero overflow) -->
                                                    <StackPanel IsVisible="{Binding HasUrlVariable}" Spacing="5">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <TextBlock Classes="hint" Text="{Binding UrlVariableLabel}" VerticalAlignment="Center" />
                                                            <arc:SegmentedControl Grid.Column="1" SelectedValue="{Binding EditTransport, Mode=TwoWay}"
                                                                                  AutomationProperties.Name="{l:AppLangResource BotConnectorTransportLabel}">
                                                                <arc:SegmentedOption Value="http" Label="HTTP" />
                                                                <arc:SegmentedOption Value="sse" Label="SSE" />
                                                            </arc:SegmentedControl>
                                                        </Grid>
                                                        <arc:Input Size="Small" IsLabelVisible="False"
                                                                   Label="{Binding UrlVariableLabel}"
                                                                   Placeholder="{Binding UrlVariablePlaceholder}"
                                                                   Text="{Binding EditVariableValue, Mode=TwoWay}" />
                                                        <TextBlock Classes="hint" FontSize="10.5"
                                                                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                   Text="{Binding ResolvedUrlPreview}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <StackPanel IsVisible="{Binding !HasUrlVariable}" Spacing="5">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                            <TextBlock Classes="hint" Text="MCP URL" VerticalAlignment="Center" />
                                                            <arc:SegmentedControl Grid.Column="1" SelectedValue="{Binding EditTransport, Mode=TwoWay}"
                                                                                  AutomationProperties.Name="{l:AppLangResource BotConnectorTransportLabel}">
                                                                <arc:SegmentedOption Value="http" Label="HTTP" />
                                                                <arc:SegmentedOption Value="sse" Label="SSE" />
                                                            </arc:SegmentedControl>
                                                        </Grid>
                                                        <arc:Input Size="Small" IsLabelVisible="False"
                                                                   Label="MCP URL"
                                                                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                   Placeholder="{l:AppLangResource BotConnectorUrlPlaceholder}"
                                                                   Text="{Binding EditUrl, Mode=TwoWay}" />
                                                    </StackPanel>

                                                    <!-- Manual Bearer Token input -->
                                                    <StackPanel IsVisible="{Binding ShowBearerTokenInput}" Spacing="5">
                                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                            <TextBlock Classes="hint" Text="{Binding TokenFieldLabel}" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Classes="hint" FontSize="10.5"
                                                                       IsVisible="{Binding IsBearerSaved}"
                                                                       Foreground="{arc:ArcDesignTokenResource Success}"
                                                                       Text="{l:AppLangResource BotConnectorAuthTokenSet}"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                        <arc:Input Size="Small" IsLabelVisible="False"
                                                                   PasswordChar="•"
                                                                   Label="{Binding TokenFieldLabel}"
                                                                   Placeholder="{l:AppLangResource BotConnectorTokenPlaceholder}"
                                                                   Text="{Binding EditBearerToken, Mode=TwoWay}" />
                                                    </StackPanel>

                                                    <!-- Action buttons -->
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                        <arc:Button Variant="Ghost" Size="Small" HorizontalAlignment="Left"
                                                                    IsVisible="{Binding ShowClearBearerButton}"
                                                                    Content="{l:AppLangResource BotConnectorClearCredentials}"
                                                                    Command="{Binding ClearTokenCommand}" />
                                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                            <arc:Button Variant="Secondary" Size="Small"
                                                                        IsLoading="{Binding IsProbing}"
                                                                        Content="{l:AppLangResource BotConnectorTestButton}"
                                                                        Command="{Binding TestCommand}" />
                                                            <arc:Button Variant="Primary" Size="Small"
                                                                        Content="{l:AppLangResource Save}"
                                                                        Command="{Binding SaveConfigCommand}" />
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- Status feedback banner -->
                                                    <Border IsVisible="{Binding HasProbeStatus}" Padding="8,6"
                                                            CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                                            Background="{arc:ArcDesignTokenResource Surface}"
                                                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="1">
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                            <Panel VerticalAlignment="Top" Margin="0,1.5,0,0">
                                                                <lucide:LucideIcon Kind="CheckCircle2" Size="13" IsVisible="{Binding IsProbeSuccess}" Foreground="{arc:ArcDesignTokenResource Success}" />
                                                                <lucide:LucideIcon Kind="AlertCircle" Size="13" IsVisible="{Binding IsProbeWarning}" Foreground="{arc:ArcDesignTokenResource Warning}" />
                                                                <lucide:LucideIcon Kind="XCircle" Size="13" IsVisible="{Binding IsProbeError}" Foreground="{arc:ArcDesignTokenResource Danger}" />
                                                                <lucide:LucideIcon Kind="Info" Size="13" IsVisible="{Binding IsProbeNeutral}" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                                            </Panel>
                                                            <TextBlock Grid.Column="1" Classes="hint" Text="{Binding ProbeStatusText}" TextWrapping="Wrap" />
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                <TextBlock Grid.Row="2" Classes="hint" Margin="12,4,12,10" TextWrapping="Wrap"
                           Text="{l:AppLangResource BotConnectorMcpHint}" />
            </Grid>
        </Grid>

        <!-- Tab 3: Chats -->
        <Grid Grid.Row="2" IsVisible="{Binding IsChatsTab}" RowDefinitions="Auto,*">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" Margin="10,6,10,6">
                <arc:SearchField Size="Small" IsLabelVisible="False"
                                 Label="{l:AppLangResource BotChatsSearchPlaceholder}"
                                 Placeholder="{l:AppLangResource BotChatsSearchPlaceholder}"
                                 Text="{Binding ChatSearchQuery, Mode=TwoWay}" />
                <arc:Button Grid.Column="1" Variant="Secondary" Size="Small"
                            Command="{Binding NewChatCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                        <lucide:LucideIcon Kind="Plus" Size="13" VerticalAlignment="Center" />
                        <TextBlock Text="{l:AppLangResource BotNewChatButton}" VerticalAlignment="Center" />
                    </StackPanel>
                </arc:Button>
            </Grid>

            <Grid Grid.Row="1">
                <ItemsControl x:Name="ChatsList" ItemsSource="{Binding FilteredChats}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Template>
                        <ControlTemplate>
                            <arc:ScrollArea Name="PART_ScrollViewer" OverlayScrollbarMode="Auto" FadeLength="0"
                                            HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" Margin="6,2,6,12" />
                            </arc:ScrollArea>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BotChatRowViewModel">
                            <Button Classes="row" Classes.selected="{Binding IsSelected}"
                                    Padding="8,7" Margin="0,0,0,2"
                                    Command="{Binding OpenCommand}"
                                    DataContextChanged="OnChatRowDataContextChanged">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <lucide:LucideIcon Kind="{Binding Icon}" Size="15" VerticalAlignment="Top" Margin="0,2,0,0"
                                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Classes="body" FontWeight="Medium" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Classes="hint" IsVisible="{Binding HasSubtitle}" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Panel Grid.Column="2" VerticalAlignment="Top" Margin="4,2,0,0">
                                        <arc:ArcSpinner Width="11" Height="11" IsVisible="{Binding IsWorking}" Foreground="{arc:ArcDesignTokenResource Accent}" />
                                        <Ellipse Width="7" Height="7" IsVisible="{Binding NeedsYou}" Fill="{arc:ArcDesignTokenResource Warning}" />
                                        <TextBlock Classes="hint" IsVisible="{Binding ShowTime}" Text="{Binding TimeText}" />
                                    </Panel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="hint" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20"
                           IsVisible="{Binding HasNoFilteredChats}"
                           Text="{l:AppLangResource BotChatsEmpty}" />
            </Grid>
        </Grid>

        <!-- Tab 4: Files -->
        <Grid Grid.Row="2" IsVisible="{Binding IsFilesTab}" RowDefinitions="Auto,Auto,*">
            <Grid ColumnDefinitions="*,Auto" Margin="{DynamicResource OctopusExplorerHeaderMargin}" Height="{DynamicResource OctopusExplorerHeaderHeight}">
                <TextBlock Classes="body" FontWeight="SemiBold" VerticalAlignment="Center"
                           Text="{Binding BotSlug}" TextTrimming="CharacterEllipsis"
                           arc:Tooltip.Tip="{Binding BotHomePath}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
                    <arc:Button Classes="ex-icon" Variant="Ghost" Command="{Binding Files.CollapseAllCommand}"
                                AutomationProperties.Name="{l:AppLangResource ExplorerCollapseAll}"
                                arc:Tooltip.Tip="{l:AppLangResource ExplorerCollapseAll}">
                        <lucide:LucideIcon Kind="ListCollapse" Size="14" />
                    </arc:Button>
                    <arc:Button Classes="ex-icon" Variant="Ghost" Command="{Binding RefreshFilesCommand}"
                                AutomationProperties.Name="{l:AppLangResource ExplorerRefresh}"
                                arc:Tooltip.Tip="{l:AppLangResource ExplorerRefresh}">
                        <lucide:LucideIcon Kind="RefreshCw" Size="14" />
                    </arc:Button>
                    <arc:Button Classes="ex-icon" Variant="Ghost" Command="{Binding RevealHomeFolderCommand}"
                                AutomationProperties.Name="{l:AppLangResource BotMenuRevealFolder}"
                                arc:Tooltip.Tip="{l:AppLangResource BotMenuRevealFolder}">
                        <lucide:LucideIcon Kind="FolderOpen" Size="14" />
                    </arc:Button>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Margin="{DynamicResource OctopusExplorerSearchMargin}" Spacing="{DynamicResource OctopusExplorerSearchSpacing}"
                        DataContext="{Binding Search}" x:DataType="search:FileSearchViewModel" IsVisible="{Binding HasRoot}">
                <arc:SegmentedControl HorizontalAlignment="Stretch" SelectedValue="{Binding ModeKey, Mode=TwoWay}"
                                      AutomationProperties.Name="{l:AppLangResource ExplorerSearchMode}">
                    <arc:SegmentedOption Value="name" Label="{l:AppLangResource ExplorerSearchByName}" />
                    <arc:SegmentedOption Value="content" Label="{l:AppLangResource ExplorerSearchByContent}" />
                </arc:SegmentedControl>
                <arc:SearchField Size="Small" IsLabelVisible="False"
                                 Label="{Binding Placeholder}" Placeholder="{Binding Placeholder}"
                                 Text="{Binding Query, Mode=TwoWay}" />
            </StackPanel>

            <Panel Grid.Row="2" IsVisible="{Binding !Search.IsActive}">
                <files:FileTreeView DataContext="{Binding Files}" />
            </Panel>
            <search:SearchResultsView Grid.Row="2" DataContext="{Binding Search}" IsVisible="{Binding IsActive}" />
        </Grid>
    </Grid>
</UserControl>
