<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:ex="using:Octopus.App.Explorer"
             xmlns:bots="using:Octopus.App.Bots"
             xmlns:grp="using:Octopus.App.Bots.Groups"
             x:Class="Octopus.App.Bots.Groups.BotGroupRightPanelView"
             x:DataType="grp:BotGroupRightPanelViewModel">
    <UserControl.Styles>
        <Style Selector="arc|Button.ex-icon">
            <Setter Property="Width" Value="{DynamicResource OctopusIconButtonSize}" />
            <Setter Property="Height" Value="{DynamicResource OctopusIconButtonSize}" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsPressScaleEnabled" Value="False" />
        </Style>

        <Style Selector="Border.bot-card">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <Style Selector="Border.bot-settings-group">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="Border.bot-settings-sep">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="Margin" Value="12,0" />
        </Style>
    </UserControl.Styles>

    <Grid Background="{arc:ArcDesignTokenResource SurfaceMuted}" RowDefinitions="Auto,Auto,*">
        <!-- Top drag bar aligned with window chrome -->
        <Border x:Name="TopBar" Height="{DynamicResource OctopusTopRowHeight}" Background="Transparent"
                PointerPressed="OnTopBarPointerPressed" />

        <!-- 2 tabs: Overview | Work Items -->
        <ex:ExplorerTabGroup x:Name="Tabs" Size="Small" Margin="8,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center"
                             IsVisible="{Binding HasGroup}"
                             SelectedValue="{Binding TabKey, Mode=TwoWay}"
                             Label="{l:AppLangResource BotGroupSectionGroups}" />

        <!-- No group selected -->
        <arc:EmptyState Grid.Row="2" IsVisible="{Binding HasNoGroup}" VerticalAlignment="Top" Margin="12,24"
                        Title="{l:AppLangResource BotGroupRightEmptyTitle}"
                        Description="{l:AppLangResource BotGroupRightEmptyDescription}"
                        Icon="{x:Static arc:ArcIcons.Sparkles}" />

        <!-- Tab 1: Overview & Members -->
        <arc:ScrollArea Grid.Row="2" IsVisible="{Binding IsOverviewTab}" OverlayScrollbarMode="Auto" FadeLength="0">
            <StackPanel Margin="12,8,12,20" Spacing="16">
                <!-- Group Identity Header -->
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <Border Width="42" Height="42" CornerRadius="11"
                            Background="{arc:ArcDesignTokenResource Surface}"
                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                            BorderThickness="1" Padding="2" ClipToBounds="True" VerticalAlignment="Center">
                        <Panel>
                            <Border IsVisible="{Binding HasSingleAvatar}" CornerRadius="8"
                                    Background="{Binding SingleAvatar.AvatarBrush}" ClipToBounds="True">
                                <Panel>
                                    <Image IsVisible="{Binding SingleAvatar.HasAvatarImage}" Source="{Binding SingleAvatar.AvatarImage}" Stretch="UniformToFill" />
                                    <TextBlock IsVisible="{Binding SingleAvatar.ShowInitial}" Text="{Binding SingleAvatar.Initial}"
                                               Foreground="White" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <lucide:LucideIcon IsVisible="{Binding SingleAvatar.HasAvatarIcon}" Kind="{Binding SingleAvatar.AvatarIcon}"
                                                       Size="18" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Panel>
                            </Border>
                            <ItemsControl IsVisible="{Binding HasMultiAvatar}" ItemsSource="{Binding GroupAvatars}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" Rows="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="grp:BotGroupAvatarTile">
                                        <Border Margin="1" CornerRadius="4" Background="{Binding AvatarBrush}" ClipToBounds="True">
                                            <Panel>
                                                <Image IsVisible="{Binding HasAvatarImage}" Source="{Binding AvatarImage}" Stretch="UniformToFill" />
                                                <TextBlock IsVisible="{Binding !HasAvatarImage}" Text="{Binding Initial}"
                                                           Foreground="White" FontSize="9" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Panel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Panel>
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Classes="body" FontSize="15" FontWeight="SemiBold" Text="{Binding GroupName}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Classes="hint" Text="{Binding MemberCountText}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <arc:Button Grid.Column="2" Classes="ex-icon" Variant="Ghost" VerticalAlignment="Center"
                                AutomationProperties.Name="{l:AppLangResource ExplorerMore}"
                                arc:Tooltip.Tip="{l:AppLangResource ExplorerMore}">
                        <arc:Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuItem Header="{l:AppLangResource BotGroupMenuNewThread}" Command="{Binding CreateThreadCommand}" />
                                <MenuItem Header="{l:AppLangResource BotGroupMenuManageMembers}" Command="{Binding ManageMembersCommand}" />
                                <MenuItem Header="{l:AppLangResource BotGroupMenuRename}" Command="{Binding RenameGroupCommand}" />
                                <Separator />
                                <MenuItem Header="{l:AppLangResource BotGroupMenuDelete}" Command="{Binding DeleteGroupCommand}" />
                            </MenuFlyout>
                        </arc:Button.Flyout>
                        <lucide:LucideIcon Kind="Ellipsis" Size="15" />
                    </arc:Button>
                </Grid>

                <!-- Room Settings Card -->
                <StackPanel Spacing="6">
                    <TextBlock Classes="caption" Margin="2,0" Text="{l:AppLangResource BotGroupRightSectionSettings}" />
                    <Border Classes="bot-settings-group">
                        <StackPanel>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="12,7">
                                <lucide:LucideIcon Kind="AtSign" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="body" Text="{l:AppLangResource BotGroupDialogReplyModeLabel}" VerticalAlignment="Center" />
                                <arc:Select Grid.Column="2" Size="Small" MinWidth="118" MaxWidth="156" AutoScrollToSelectedItem="False"
                                            ItemsSource="{Binding ReplyModeOptions}"
                                            SelectedValue="{Binding SelectedReplyModeKind, Mode=TwoWay}" />
                            </Grid>
                            <Border Classes="bot-settings-sep" IsVisible="{Binding ShowDefaultBotPicker}" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="12,7" IsVisible="{Binding ShowDefaultBotPicker}">
                                <lucide:LucideIcon Kind="Bot" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="body" Text="{l:AppLangResource BotGroupDialogDefaultBotLabel}" VerticalAlignment="Center" />
                                <arc:Select Grid.Column="2" Size="Small" MinWidth="118" MaxWidth="156" AutoScrollToSelectedItem="False"
                                            ItemsSource="{Binding DefaultBotOptions}"
                                            SelectedValue="{Binding SelectedDefaultBotId, Mode=TwoWay}" />
                            </Grid>
                            <Border Classes="bot-settings-sep" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="12,7">
                                <lucide:LucideIcon Kind="GitFork" Size="15" Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Classes="body" Text="{l:AppLangResource BotGroupDialogMaxHopsLabel}" VerticalAlignment="Center" />
                                <arc:Select Grid.Column="2" Size="Small" MinWidth="84" MaxWidth="112" AutoScrollToSelectedItem="False"
                                            ItemsSource="{Binding MaxHopsOptions}"
                                            SelectedValue="{Binding SelectedMaxHopsKey, Mode=TwoWay}" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Members List -->
                <StackPanel Spacing="6">
                    <TextBlock Classes="caption" Margin="2,0" Text="{l:AppLangResource BotGroupRightSectionMembers}" />
                    <Border Classes="bot-settings-group">
                        <ItemsControl ItemsSource="{Binding Members}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="grp:BotGroupRightMemberViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" Margin="10,7">
                                        <!-- Member avatar -->
                                        <Border Width="26" Height="26" CornerRadius="7" Background="{Binding Avatar.AvatarBrush}"
                                                ClipToBounds="True" VerticalAlignment="Center">
                                            <Panel>
                                                <Image IsVisible="{Binding Avatar.HasAvatarImage}" Source="{Binding Avatar.AvatarImage}"
                                                       Width="26" Height="26" Stretch="UniformToFill" />
                                                <lucide:LucideIcon IsVisible="{Binding Avatar.HasAvatarIcon}" Kind="{Binding Avatar.AvatarIcon}"
                                                                   Size="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <TextBlock IsVisible="{Binding Avatar.ShowInitial}" Text="{Binding Avatar.Initial}"
                                                           Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Panel>
                                        </Border>

                                        <!-- Name + agent + paused tag -->
                                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding Name}"
                                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <Border IsVisible="{Binding IsPaused}" Padding="4,0" CornerRadius="4"
                                                        Background="{arc:ArcDesignTokenResource BorderSubtle}" VerticalAlignment="Center">
                                                    <TextBlock Classes="hint" FontSize="10" Text="{l:AppLangResource BotPausedTag}" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{Binding AgentAccent}" VerticalAlignment="Center" />
                                                <TextBlock Classes="hint" FontSize="11" Text="{Binding AgentName}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Jump to bot -->
                                        <arc:Button Grid.Column="2" Classes="ex-icon" Variant="Ghost" VerticalAlignment="Center"
                                                    Command="{Binding JumpToBotCommand}"
                                                    AutomationProperties.Name="{l:AppLangResource BotGroupRightJumpToBot}"
                                                    arc:Tooltip.Tip="{l:AppLangResource BotGroupRightJumpToBot}">
                                            <lucide:LucideIcon Kind="ArrowUpRight" Size="14" />
                                        </arc:Button>

                                        <!-- Remove member (if > 1) -->
                                        <arc:Button Grid.Column="3" Classes="ex-icon" Variant="Ghost" VerticalAlignment="Center"
                                                    IsVisible="{Binding CanRemove}"
                                                    Command="{Binding RemoveCommand}"
                                                    AutomationProperties.Name="{l:AppLangResource BotGroupRightRemoveMember}"
                                                    arc:Tooltip.Tip="{l:AppLangResource BotGroupRightRemoveMember}">
                                            <lucide:LucideIcon Kind="X" Size="13" />
                                        </arc:Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- Quick action buttons -->
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                    <arc:Button Variant="Secondary" Size="Small" HorizontalAlignment="Stretch"
                                Command="{Binding ManageMembersCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <lucide:LucideIcon Kind="Users" Size="13" VerticalAlignment="Center" />
                            <TextBlock Text="{l:AppLangResource BotGroupRightManageMembers}" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </arc:Button>
                    <arc:Button Grid.Column="1" Variant="Secondary" Size="Small" HorizontalAlignment="Stretch"
                                Command="{Binding CreateThreadCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <lucide:LucideIcon Kind="Plus" Size="13" VerticalAlignment="Center" />
                            <TextBlock Text="{l:AppLangResource BotGroupNewThread}" FontWeight="Medium" VerticalAlignment="Center" />
                        </StackPanel>
                    </arc:Button>
                </Grid>
            </StackPanel>
        </arc:ScrollArea>

        <!-- Tab 2: Aggregated Work Items -->
        <arc:ScrollArea Grid.Row="2" IsVisible="{Binding IsItemsTab}" OverlayScrollbarMode="Auto" FadeLength="0">
            <StackPanel Margin="12,8,12,20" Spacing="10">
                <StackPanel IsVisible="{Binding HasNoWorkItems}" HorizontalAlignment="Center" Margin="12,36,12,18" Spacing="8" MaxWidth="260">
                    <lucide:LucideIcon Kind="ListChecks" Size="24" Foreground="{arc:ArcDesignTokenResource TextMuted}" HorizontalAlignment="Center" />
                    <TextBlock Classes="body" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                               Text="{l:AppLangResource BotGroupRightItemsEmptyTitle}" />
                    <TextBlock Classes="hint" TextWrapping="Wrap" TextAlignment="Center"
                               Text="{l:AppLangResource BotGroupRightItemsEmptyDescription}" />
                </StackPanel>

                <ItemsControl IsVisible="{Binding HasWorkItems}" ItemsSource="{Binding WorkItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="grp:BotGroupWorkItemCardViewModel">
                            <Border Classes="bot-card">
                                <StackPanel Spacing="6">
                                    <!-- Bot tag + item number + status -->
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                        <Border Padding="6,1" CornerRadius="999" Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="1">
                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Ellipse Width="6" Height="6" Fill="{Binding BotBrush}" VerticalAlignment="Center" />
                                                <TextBlock Classes="hint" FontSize="10.5" FontWeight="SemiBold" Text="{Binding BotName}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Grid.Column="1" Classes="hint" Text="{Binding NumberText}" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Padding="5,1" CornerRadius="999"
                                                Background="{arc:ArcDesignTokenResource BorderSubtle}">
                                            <TextBlock Classes="hint" FontSize="10" Text="{Binding StatusLabel}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Classes="body" FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                                    <TextBlock Classes="hint" TextWrapping="Wrap" IsVisible="{Binding HasQuestion}" Text="{Binding Question}" />

                                    <ItemsControl ItemsSource="{Binding Options}" IsVisible="{Binding IsNeedsYou}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="bots:BotWorkItemOptionViewModel">
                                                <arc:Button Variant="Secondary" Size="Small" Content="{Binding Label}" Command="{Binding ChooseCommand}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </arc:ScrollArea>
    </Grid>
</UserControl>
