<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="using:Octopus.App.Bots"
             x:Class="Octopus.App.Bots.NewBotDialogView"
             x:DataType="vm:NewBotDialogViewModel">
    <UserControl.Styles>
        <Style Selector="Button.bot-pill">
            <Setter Property="Height" Value="28" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Pill"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Pill">
                <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
            </Style>
            <Style Selector="^.selected">
                <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
                <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
                <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
            </Style>
        </Style>

        <Style Selector="Button.bot-swatch">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Ring"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="999"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^.selected">
                <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
            </Style>
        </Style>

        <!-- Avatar tile: click to upload an image; a dim overlay with an icon shows on hover -->
        <Style Selector="Button.bot-avatar">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.bot-avatar Border#AvatarHoverOverlay">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button.bot-avatar:pointerover Border#AvatarHoverOverlay">
            <Setter Property="Opacity" Value="1" />
        </Style>

        <Style Selector="Button.bot-avatar-remove">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{arc:ArcDesignTokenResource Foreground}"
                            BorderBrush="{arc:ArcDesignTokenResource Surface}"
                            BorderThickness="1.5"
                            CornerRadius="999">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Clean Arc-styled multiline textarea container (mirrors Orca's large SOUL editor box) -->
        <Style Selector="Border.bot-textarea-shell">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusPanel}" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="Border.bot-textarea-shell:focus-within">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>

        <Style Selector="TextBox.bot-textarea">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="88" />
            <Setter Property="MaxHeight" Value="140" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="CaretBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="SelectionBrush" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
            <Setter Property="PlaceholderForeground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="Template">
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer Name="PART_ScrollViewer"
                                      Theme="{DynamicResource FieldScrollViewerTheme}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <Panel>
                                <TextBlock Name="PART_Placeholder"
                                           Margin="0,1,0,0"
                                           FontSize="{TemplateBinding FontSize}"
                                           LineHeight="{TemplateBinding LineHeight}"
                                           Foreground="{TemplateBinding PlaceholderForeground}"
                                           Text="{TemplateBinding PlaceholderText}"
                                           TextWrapping="Wrap">
                                    <TextBlock.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                        </MultiBinding>
                                    </TextBlock.IsVisible>
                                </TextBlock>
                                <TextPresenter Name="PART_TextPresenter"
                                               Margin="0,1,0,0"
                                               Text="{TemplateBinding Text, Mode=TwoWay}"
                                               CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                               CaretIndex="{TemplateBinding CaretIndex}"
                                               SelectionStart="{TemplateBinding SelectionStart}"
                                               SelectionEnd="{TemplateBinding SelectionEnd}"
                                               TextWrapping="{TemplateBinding TextWrapping}"
                                               LineHeight="{TemplateBinding LineHeight}"
                                               SelectionBrush="{TemplateBinding SelectionBrush}"
                                               SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                               CaretBrush="{TemplateBinding CaretBrush}" />
                            </Panel>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="14" HorizontalAlignment="Stretch">
        <!-- Row 1: Rounded-square Avatar + Arc Name input + compact Color swatches -->
        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
            <Panel Width="54" Height="54" VerticalAlignment="Top" Margin="0,2,0,0">
                <Button Classes="bot-avatar"
                        IsEnabled="{Binding CanPickImage}"
                        Command="{Binding PickImageCommand}"
                        ToolTip.Tip="{l:AppLangResource BotDialogUploadAvatar}">
                    <Border Width="54" Height="54" CornerRadius="14" ClipToBounds="True"
                            Background="{Binding AvatarBrush}">
                        <Panel>
                            <TextBlock IsVisible="{Binding !HasAvatarImage}"
                                       Text="{Binding AvatarInitial}" Foreground="White" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image IsVisible="{Binding HasAvatarImage}" Source="{Binding AvatarImage}"
                                   Width="54" Height="54" Stretch="UniformToFill"
                                   RenderOptions.BitmapInterpolationMode="HighQuality" />
                            <Border Name="AvatarHoverOverlay" Background="#73000000">
                                <lucide:LucideIcon Kind="ImagePlus" Size="20" Foreground="White"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Panel>
                    </Border>
                </Button>
                <Button Classes="bot-avatar-remove"
                        IsVisible="{Binding HasAvatarImage}"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                        Command="{Binding ClearImageCommand}"
                        ToolTip.Tip="{l:AppLangResource BotDialogRemoveAvatar}">
                    <lucide:LucideIcon Kind="X" Size="10" Foreground="{arc:ArcDesignTokenResource Surface}" />
                </Button>
            </Panel>

            <StackPanel Grid.Column="1" Spacing="8">
                <arc:Input x:Name="NameInput" Size="Small"
                           IsLabelVisible="False"
                           Label="{l:AppLangResource BotDialogNameLabel}"
                           Placeholder="{l:AppLangResource BotDialogNamePlaceholder}"
                           Text="{Binding Name, Mode=TwoWay}"
                           MaxLength="32" />
                <ItemsControl ItemsSource="{Binding Colors}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BotColorOptionViewModel">
                            <Button Classes="bot-swatch" Classes.selected="{Binding IsSelected}"
                                    Command="{Binding PickCommand}">
                                <Ellipse Fill="{Binding Brush}" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <!-- Row 2: SOUL.md responsibilities multiline textarea -->
        <StackPanel Spacing="6">
            <TextBlock Classes="caption" Text="{l:AppLangResource BotDialogSoulLabel}" />
            <Border Classes="bot-textarea-shell">
                <TextBox Classes="bot-textarea"
                         Text="{Binding Soul, Mode=TwoWay}"
                         PlaceholderText="{l:AppLangResource BotDialogSoulPlaceholder}" />
            </Border>
        </StackPanel>

        <!-- Row 3: Two-column Computer (Host) + Agent selectors (matches Orca layout) -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
            <arc:Select x:Name="HostSelect" Size="Small" AutoScrollToSelectedItem="False"
                        Label="{l:AppLangResource BotDialogHostLabel}"
                        ItemsSource="{Binding HostOptions}"
                        SelectedValue="{Binding SelectedHostKey, Mode=TwoWay}" />
            <arc:Select x:Name="AgentSelect" Grid.Column="1" Size="Small" AutoScrollToSelectedItem="False"
                        Label="{l:AppLangResource BotDialogAgentLabel}"
                        Placeholder="{l:AppLangResource NoAgentsFound}"
                        IsEnabled="{Binding HasAgents}"
                        ItemsSource="{Binding AgentOptions}"
                        SelectedValue="{Binding SelectedAgentId, Mode=TwoWay}" />
        </Grid>

        <!-- Row 4: Compact starter templates -->
        <StackPanel Spacing="6">
            <TextBlock Classes="caption" Text="{l:AppLangResource BotDialogTemplateLabel}" />
            <ItemsControl ItemsSource="{Binding Templates}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:BotTemplateOptionViewModel">
                        <Button Classes="bot-pill" Classes.selected="{Binding IsSelected}"
                                Command="{Binding PickCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <lucide:LucideIcon Kind="{Binding Icon}" Size="12" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           FontWeight="Medium" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Row 5: Safety hint -->
        <StackPanel Orientation="Horizontal" Spacing="6">
            <lucide:LucideIcon Kind="ShieldCheck" Size="13" Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
            <TextBlock Classes="hint" Text="{l:AppLangResource BotDialogSafetyNote}" VerticalAlignment="Center" />
        </StackPanel>
    </StackPanel>
</UserControl>
