<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:common="using:Octopus.App.Common"
             xmlns:agents="using:Octopus.App.Settings.Agents"
             x:Class="Octopus.App.Settings.Agents.AgentRowView"
             x:DataType="agents:AgentRowViewModel">
    <UserControl.Styles>
        <Style Selector="agents|FieldRow">
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid ColumnDefinitions="132,*" ColumnSpacing="10">
                        <TextBlock x:Name="PART_Label"
                                   Classes="label"
                                   Text="{TemplateBinding Label}"
                                   VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="4">
                            <ContentPresenter Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}" />
                            <TextBlock Classes="hint"
                                       Text="{TemplateBinding Description}"
                                       IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="agents|FieldRow:top /template/ TextBlock#PART_Label">
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="0,9,0,0" />
        </Style>
        <Style Selector="Grid.agentHeader">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Grid.agentHeader.disabled">
            <Setter Property="Opacity" Value="0.52" />
        </Style>
        <Style Selector="lucide|LucideIcon.rowChevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="lucide|LucideIcon.rowChevron.expanded">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
        <Style Selector="arc|Button.defaultStar">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="arc|Button.defaultStar.active">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
    </UserControl.Styles>

    <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="0,1,0,0">
        <StackPanel>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="{DynamicResource OctopusSettingsAgentHeaderMargin}">
                <!-- Left clickable identity + command area: Button.row stretches cleanly and clips overflow without shifting the icon -->
                <Button Grid.Column="0"
                        Classes="row"
                        Padding="8,5"
                        ClipToBounds="True"
                        Command="{Binding ToggleExpandedCommand}"
                        AutomationProperties.Name="{Binding Name}"
                        arc:Tooltip.Tip="{l:AppLangResource SettingsToggleDetails}">
                    <Grid Classes="agentHeader" Classes.disabled="{Binding !IsEnabled}"
                          ColumnDefinitions="28,*" ColumnSpacing="10">
                        <common:AgentIcon Grid.Column="0"
                                          AgentId="{Binding Id}"
                                          AgentName="{Binding Name}"
                                          Size="24"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" ClipToBounds="True">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="name" Text="{Binding Name}" VerticalAlignment="Center" />
                                <TextBlock Classes="hint"
                                           Text="{Binding Version}"
                                           IsVisible="{Binding HasVersion}"
                                           VerticalAlignment="Center" />
                                <Border IsVisible="{Binding SupportsAcp}"
                                        Padding="6,1"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AcpBadgeText}"
                                               FontSize="10.5"
                                               FontWeight="Medium"
                                               Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                                </Border>
                                <Border IsVisible="{Binding !SupportsAcp}"
                                        Padding="6,1"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding AcpBadgeText}"
                                               FontSize="10.5"
                                               Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                </Border>
                                <Border Background="{arc:ArcDesignTokenResource AccentSubtle}"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                        Padding="6,1"
                                        IsVisible="{Binding IsDefault}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{l:AppLangResource SettingsDefaultBadge}"
                                               FontSize="10.5"
                                               FontWeight="Medium"
                                               Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                                </Border>
                                <arc:Badge Size="Small" Tone="Neutral" Content="{Binding OriginBadge}" IsVisible="{Binding HasOriginBadge}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                <TextBlock Classes="mono" Text="{Binding DefaultCommandName}"
                                           IsVisible="{Binding IsCommandOverridden}"
                                           TextDecorations="Strikethrough"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                <TextBlock Grid.Column="1"
                                           Classes="mono"
                                           Text="{Binding CommandPreview}"
                                           TextTrimming="CharacterEllipsis"
                                           arc:Tooltip.Tip="{Binding CommandPreview}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Right compact action strip: Surface mode + Enable switch | Utility icon actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Per-agent open surface: ACP agents choose Follow / GUI / Terminal; non-ACP agents stay locked to Terminal -->
                    <Panel VerticalAlignment="Center">
                        <arc:SegmentedControl AutoScrollToSelectedItem="False"
                                              IsVisible="{Binding SupportsAcp}"
                                              SelectedValue="{Binding SurfaceKey, Mode=TwoWay}"
                                              AutomationProperties.Name="{l:AppLangResource SettingsSurfaceSectionTitle}">
                            <arc:SegmentedOption Value="follow" Label="{l:AppLangResource SettingsSurfaceFollow}" />
                            <arc:SegmentedOption Value="gui" Label="{l:AppLangResource SettingsSurfaceGuiShort}" />
                            <arc:SegmentedOption Value="terminal" Label="{l:AppLangResource SettingsSurfaceTerminalShort}" />
                        </arc:SegmentedControl>
                        <Border IsVisible="{Binding !SupportsAcp}"
                                Padding="8,3"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                BorderThickness="1">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <lucide:LucideIcon Kind="SquareTerminal" Size="12" Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                                <TextBlock Classes="hint" Text="{l:AppLangResource SettingsAcpBadgeTerminalOnly}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Panel>

                    <arc:Switch VerticalAlignment="Center"
                                Margin="2,0"
                                IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                AutomationProperties.Name="{l:AppLangResource SettingsEnabled}"
                                arc:Tooltip.Tip="{l:AppLangResource SettingsEnabled}" />

                    <Border Width="1" Height="16" Background="{arc:ArcDesignTokenResource BorderSubtle}" VerticalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                        <arc:Button Classes="icon defaultStar"
                                    Classes.active="{Binding IsDefault}"
                                    Variant="Ghost"
                                    Command="{Binding ToggleDefaultCommand}"
                                    AutomationProperties.Name="{Binding DefaultButtonText}"
                                    arc:Tooltip.Tip="{Binding DefaultButtonText}">
                            <lucide:LucideIcon Kind="Star" Size="14" />
                        </arc:Button>
                        <arc:Button Classes="icon"
                                    Variant="Ghost"
                                    IsVisible="{Binding CanEdit}"
                                    Command="{Binding $parent[agents:AgentsPageView].((agents:AgentsSettingsViewModel)DataContext).EditAgentCommand}"
                                    CommandParameter="{Binding Definition}"
                                    AutomationProperties.Name="{l:AppLangResource SettingsEditAgent}"
                                    arc:Tooltip.Tip="{l:AppLangResource SettingsEditAgent}">
                            <lucide:LucideIcon Kind="Pencil" Size="14" />
                        </arc:Button>
                        <arc:Button Classes="icon"
                                    Variant="Ghost"
                                    IsVisible="{Binding CanRemove}"
                                    Command="{Binding $parent[agents:AgentsPageView].((agents:AgentsSettingsViewModel)DataContext).RemoveAgentCommand}"
                                    CommandParameter="{Binding Definition}"
                                    AutomationProperties.Name="{Binding RemoveText}"
                                    arc:Tooltip.Tip="{Binding RemoveText}">
                            <lucide:LucideIcon Kind="Trash2" Size="14" />
                        </arc:Button>
                        <arc:Button Classes="icon"
                                    Variant="Ghost"
                                    IsVisible="{Binding HasHomepage}"
                                    Command="{Binding OpenHomepageCommand}"
                                    AutomationProperties.Name="{l:AppLangResource SettingsOpenHomepage}"
                                    arc:Tooltip.Tip="{l:AppLangResource SettingsOpenHomepage}">
                            <lucide:LucideIcon Kind="ExternalLink" Size="14" />
                        </arc:Button>
                        <arc:Button Classes="icon"
                                    Variant="Ghost"
                                    Command="{Binding ToggleExpandedCommand}"
                                    AutomationProperties.Name="{l:AppLangResource SettingsToggleDetails}"
                                    arc:Tooltip.Tip="{l:AppLangResource SettingsToggleDetails}">
                            <lucide:LucideIcon Classes="rowChevron" Classes.expanded="{Binding IsExpanded}" Kind="ChevronRight" Size="14" />
                        </arc:Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <common:SmoothCollapse IsExpanded="{Binding IsExpanded}">
                <StackPanel Margin="{DynamicResource OctopusSettingsAgentDetailMargin}" Spacing="{DynamicResource OctopusSettingsAgentDetailSpacing}">
                    <arc:Alert Tone="Info"
                               Title="{l:AppLangResource SettingsUnverified}"
                               IsVisible="{Binding IsUnverified}" />

                    <agents:FieldRow Label="{l:AppLangResource SettingsAcpCommandLabel}"
                                     IsVisible="{Binding SupportsAcp}">
                        <TextBlock Classes="mono" Text="{Binding AcpCommandPreview}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </agents:FieldRow>

                    <agents:FieldRow Label="{l:AppLangResource AccountSectionLabel}"
                                     TopAligned="True"
                                     IsVisible="{Binding HasAccountsSection}">
                        <StackPanel DataContext="{Binding AccountsSection}"
                                    x:DataType="agents:AgentAccountsSectionViewModel"
                                    Spacing="8">
                            <arc:Alert Tone="Warning"
                                       IsVisible="{Binding IsGlobalKeyring}"
                                       Title="{Binding GlobalWarningTitle}"
                                       Content="{Binding GlobalWarningBody}" />
                            <TextBlock Classes="hint"
                                       IsVisible="{Binding IsEnvDir}"
                                       Text="{Binding SectionHint}"
                                       TextWrapping="Wrap" />

                            <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                    BorderThickness="1"
                                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                    ClipToBounds="True"
                                    IsVisible="{Binding !!Items.Count}">
                                <ItemsControl ItemsSource="{Binding Items}" Margin="0,-1,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="agents:AgentAccountItemViewModel">
                                            <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                    BorderThickness="0,1,0,0"
                                                    Padding="10,6">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Classes="label" FontWeight="Medium" Text="{Binding DisplayLabel}" VerticalAlignment="Center" />
                                                            <arc:Badge Size="Small" Tone="Info"
                                                                       Content="{l:AppLangResource AccountDefaultBadge}"
                                                                       IsVisible="{Binding IsDefault}"
                                                                       VerticalAlignment="Center" />
                                                            <arc:Badge Size="Small" Tone="Success"
                                                                       Content="{l:AppLangResource AccountActiveBadge}"
                                                                       IsVisible="{Binding IsActiveGlobal}"
                                                                       VerticalAlignment="Center" />
                                                            <arc:Badge Size="Small" Tone="Neutral"
                                                                       Content="{l:AppLangResource AccountExternalBadge}"
                                                                       IsVisible="{Binding IsExternal}"
                                                                       VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Classes="mono"
                                                                   Text="{Binding Subtitle}"
                                                                   IsVisible="{Binding HasSubtitle}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <arc:Button Variant="Ghost" Size="Small"
                                                                    IsVisible="{Binding CanLogin}"
                                                                    Content="{l:AppLangResource AccountLogin}"
                                                                    Command="{Binding LoginCommand}" />
                                                        <arc:Button Variant="Ghost" Size="Small"
                                                                    IsVisible="{Binding CanSwitchGlobal}"
                                                                    Content="{l:AppLangResource AccountSwitchTo}"
                                                                    Command="{Binding SwitchGlobalCommand}" />
                                                        <arc:Button Variant="Ghost" Size="Small"
                                                                    IsVisible="{Binding CanSetDefault}"
                                                                    Content="{l:AppLangResource AccountSetDefault}"
                                                                    Command="{Binding SetDefaultCommand}" />
                                                        <arc:Button Variant="Ghost" Size="Small"
                                                                    IsVisible="{Binding CanUpdateSnapshot}"
                                                                    Command="{Binding UpdateSnapshotCommand}"
                                                                    AutomationProperties.Name="{l:AppLangResource AccountUpdateSnapshot}"
                                                                    arc:Tooltip.Tip="{l:AppLangResource AccountUpdateSnapshot}">
                                                            <lucide:LucideIcon Kind="RefreshCw" Size="14" />
                                                        </arc:Button>
                                                        <arc:Button Variant="Ghost" Size="Small"
                                                                    IsVisible="{Binding CanRevealFolder}"
                                                                    Command="{Binding RevealFolderCommand}"
                                                                    AutomationProperties.Name="{l:AppLangResource AccountRevealFolder}"
                                                                    arc:Tooltip.Tip="{l:AppLangResource AccountRevealFolder}">
                                                            <lucide:LucideIcon Kind="FolderOpen" Size="14" />
                                                        </arc:Button>
                                                        <arc:Button Variant="Ghost" Size="Small"
                                                                    Command="{Binding RenameCommand}"
                                                                    AutomationProperties.Name="{l:AppLangResource AccountRename}"
                                                                    arc:Tooltip.Tip="{l:AppLangResource AccountRename}">
                                                            <lucide:LucideIcon Kind="Pencil" Size="14" />
                                                        </arc:Button>
                                                        <arc:Button Variant="Ghost" Size="Small"
                                                                    IsVisible="{Binding CanRemove}"
                                                                    Command="{Binding RemoveCommand}"
                                                                    AutomationProperties.Name="{l:AppLangResource AccountRemove}"
                                                                    arc:Tooltip.Tip="{l:AppLangResource AccountRemove}">
                                                            <lucide:LucideIcon Kind="Trash2" Size="14" />
                                                        </arc:Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Border>

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <arc:Button Variant="Secondary" Size="Small"
                                            IsVisible="{Binding IsEnvDir}"
                                            Command="{Binding AddManagedCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <lucide:LucideIcon Kind="Plus" Size="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{l:AppLangResource AccountAdd}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </arc:Button>
                                <arc:Button Variant="Secondary" Size="Small"
                                            IsVisible="{Binding IsEnvDir}"
                                            Command="{Binding ImportFolderCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <lucide:LucideIcon Kind="FolderInput" Size="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{l:AppLangResource AccountImportFolder}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </arc:Button>
                                <arc:Button Variant="Secondary" Size="Small"
                                            IsVisible="{Binding IsGlobalKeyring}"
                                            Command="{Binding SaveCurrentLoginCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <lucide:LucideIcon Kind="BookmarkPlus" Size="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{l:AppLangResource AccountSaveCurrentLogin}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </arc:Button>
                                <arc:Button Variant="Secondary" Size="Small"
                                            IsVisible="{Binding IsGlobalKeyring}"
                                            Command="{Binding LoginNewGlobalCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <lucide:LucideIcon Kind="Plus" Size="14" VerticalAlignment="Center" />
                                        <TextBlock Text="{l:AppLangResource AccountLoginNew}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </arc:Button>
                            </StackPanel>
                        </StackPanel>
                    </agents:FieldRow>

                    <ItemsControl ItemsSource="{Binding Fields}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="{DynamicResource OctopusSettingsFieldSpacing}" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </common:SmoothCollapse>
        </StackPanel>
    </Border>
</UserControl>
