<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:common="using:Octopus.App.Common"
             xmlns:agents="using:Octopus.App.Settings.Agents"
             x:Class="Octopus.App.Settings.Agents.AgentsPageView"
             x:DataType="agents:AgentsSettingsViewModel">
    <UserControl.Styles>
        <Style Selector="Button.surfaceCard">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="{DynamicResource OctopusSettingsSurfaceCardPadding}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Card"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Card">
                <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            </Style>
            <Style Selector="^.selected /template/ Border#PART_Card">
                <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource AccentStrong}" />
                <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
            </Style>
        </Style>
        <Style Selector="lucide|LucideIcon.sectionChevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="lucide|LucideIcon.sectionChevron.expanded">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>
    </UserControl.Styles>
    <UserControl.DataTemplates>
        <DataTemplate DataType="agents:CommandFieldViewModel">
            <agents:FieldRow Label="{Binding Label}">
                <arc:Input Text="{Binding Text, Mode=TwoWay}"
                           Placeholder="{Binding Placeholder}"
                           Label="{Binding Label}"
                           IsLabelVisible="False"
                           Size="Small"
                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}">
                    <arc:Input.Suffix>
                        <arc:Button Variant="Ghost"
                                    Size="Small"
                                    Content="{l:AppLangResource SettingsReset}"
                                    IsVisible="{Binding HasValue}"
                                    Command="{Binding ResetCommand}" />
                    </arc:Input.Suffix>
                </arc:Input>
            </agents:FieldRow>
        </DataTemplate>

        <DataTemplate DataType="agents:ChoiceFieldViewModel">
            <agents:FieldRow Label="{Binding Label}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" HorizontalAlignment="Stretch">
                    <arc:Input Grid.Column="0"
                               Text="{Binding CustomText, Mode=TwoWay}"
                               Placeholder="{Binding CustomPlaceholder}"
                               Label="{Binding Label}"
                               IsLabelVisible="False"
                               Size="Small"
                               IsVisible="{Binding IsCustom}"
                               FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" />
                    <lucide:LucideIcon Grid.Column="1"
                                       Kind="ShieldAlert"
                                       Size="16"
                                       VerticalAlignment="Center"
                                       Foreground="{arc:ArcDesignTokenResource Warning}"
                                       IsVisible="{Binding IsDangerSelected}" />
                    <arc:Select AutoScrollToSelectedItem="False" Grid.Column="2"
                                Size="Small"
                                MinWidth="240"
                                HorizontalAlignment="Right"
                                AutomationProperties.Name="{Binding Label}"
                                ItemsSource="{Binding Options}"
                                SelectedValue="{Binding SelectedId, Mode=TwoWay}" />
                </Grid>
            </agents:FieldRow>
        </DataTemplate>

        <DataTemplate DataType="agents:ToggleFieldViewModel">
            <agents:FieldRow Label="{Binding Label}" Description="{Binding Description}">
                <arc:Switch IsChecked="{Binding IsOn, Mode=TwoWay}" HorizontalAlignment="Right" />
            </agents:FieldRow>
        </DataTemplate>

        <DataTemplate DataType="agents:TextFieldViewModel">
            <agents:FieldRow Label="{Binding Label}" Description="{Binding Description}" TopAligned="{Binding IsMultiLine}">
                <Grid ColumnDefinitions="*,Auto">
                    <Panel>
                        <arc:Textarea Text="{Binding Text, Mode=TwoWay}"
                                      Placeholder="{Binding Placeholder}"
                                      Label="{Binding Label}"
                                      IsLabelVisible="False"
                                      FrameMinHeight="72"
                                      IsVisible="{Binding IsMultiLine}" />
                        <arc:Input Text="{Binding Text, Mode=TwoWay}"
                                   Placeholder="{Binding Placeholder}"
                                   Label="{Binding Label}"
                                   IsLabelVisible="False"
                                   Size="Small"
                                   IsVisible="{Binding !IsMultiLine}"
                                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" />
                    </Panel>
                    <arc:Button Grid.Column="1"
                                Variant="Secondary"
                                Size="Small"
                                Margin="8,0,0,0"
                                Content="{l:AppLangResource SettingsBrowse}"
                                IsVisible="{Binding CanBrowse}"
                                Command="{Binding BrowseCommand}" />
                </Grid>
            </agents:FieldRow>
        </DataTemplate>

        <DataTemplate DataType="agents:ArgsFieldViewModel">
            <agents:FieldRow Label="{Binding Label}" Description="{Binding Description}" TopAligned="True">
                <arc:TagInput Value="{Binding Value, Mode=TwoWay}"
                              Placeholder="{Binding Placeholder}"
                              Label="{Binding Label}"
                              IsLabelVisible="False" />
            </agents:FieldRow>
        </DataTemplate>

        <DataTemplate DataType="agents:EnvFieldViewModel">
            <agents:FieldRow Label="{Binding Label}" TopAligned="True">
                <StackPanel Spacing="8">
                    <TextBlock Classes="hint"
                               Text="{l:AppLangResource SettingsEnvEmpty}"
                               IsVisible="{Binding IsEmpty}"
                               VerticalAlignment="Center" />
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="agents:EnvEntryViewModel">
                                <StackPanel Spacing="4">
                                    <Grid ColumnDefinitions="200,*,Auto" ColumnSpacing="8">
                                        <arc:Input Text="{Binding Name, Mode=TwoWay}"
                                                   Placeholder="{l:AppLangResource SettingsEnvNamePlaceholder}"
                                                   Label="{l:AppLangResource SettingsEnvNamePlaceholder}"
                                                   IsLabelVisible="False"
                                                   Size="Small"
                                                   arc:Tooltip.Tip="{Binding Hint}"
                                                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" />
                                        <Panel Grid.Column="1">
                                            <arc:PasswordField Text="{Binding Value, Mode=TwoWay}"
                                                               Placeholder="{l:AppLangResource SettingsEnvValuePlaceholder}"
                                                               Label="{l:AppLangResource SettingsEnvValuePlaceholder}"
                                                               IsLabelVisible="False"
                                                               Size="Small"
                                                               IsVisible="{Binding IsSecret}" />
                                            <arc:Input Text="{Binding Value, Mode=TwoWay}"
                                                       Placeholder="{l:AppLangResource SettingsEnvValuePlaceholder}"
                                                       Label="{l:AppLangResource SettingsEnvValuePlaceholder}"
                                                       IsLabelVisible="False"
                                                       Size="Small"
                                                       IsVisible="{Binding !IsSecret}"
                                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" />
                                        </Panel>
                                        <arc:Button Grid.Column="2"
                                                    Variant="Ghost"
                                                    Size="Small"
                                                    Command="{Binding RemoveCommand}"
                                                    AutomationProperties.Name="{l:AppLangResource SettingsEnvRemove}"
                                                    arc:Tooltip.Tip="{l:AppLangResource SettingsEnvRemove}">
                                            <lucide:LucideIcon Kind="X" Size="16" />
                                        </arc:Button>
                                    </Grid>
                                    <TextBlock Classes="hint"
                                               Margin="2,0,0,0"
                                               Text="{l:AppLangResource SettingsEnvSecretNote}"
                                               IsVisible="{Binding IsSecret}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <arc:DropdownMenu Label="{l:AppLangResource SettingsEnvAddKnown}"
                                          Alignment="Start"
                                          ItemsSource="{Binding AvailableKnown}"
                                          IsVisible="{Binding HasKnown}">
                            <arc:DropdownMenu.ItemTemplate>
                                <DataTemplate x:DataType="agents:KnownEnvChoice">
                                    <arc:MenuEntry Header="{Binding Detail}" Icon="{x:Static arc:ArcIcons.Plus}" Command="{Binding AddCommand}" />
                                </DataTemplate>
                            </arc:DropdownMenu.ItemTemplate>
                        </arc:DropdownMenu>
                        <arc:Button Variant="Secondary"
                                    Size="Small"
                                    IsVisible="{Binding AllowCustom}"
                                    Command="{Binding AddCustomCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <lucide:LucideIcon Kind="Plus" Size="14" />
                                <TextBlock Text="{l:AppLangResource SettingsEnvAddCustom}" />
                            </StackPanel>
                        </arc:Button>
                    </StackPanel>
                </StackPanel>
            </agents:FieldRow>
        </DataTemplate>
    </UserControl.DataTemplates>

    <StackPanel Spacing="16">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Classes="title" Text="{l:AppLangResource SettingsAgentsTitle}" />
                <TextBlock Classes="subtitle" Text="{Binding Subtitle}" />
            </StackPanel>
            <arc:Button Grid.Column="1" Variant="Secondary" Size="Small" VerticalAlignment="Center"
                        IsVisible="{Binding CanEditAgents}" Command="{Binding AddAgentCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <lucide:LucideIcon Kind="Plus" Size="14" VerticalAlignment="Center" />
                    <TextBlock Text="{l:AppLangResource SettingsAddAgent}" VerticalAlignment="Center" />
                </StackPanel>
            </arc:Button>
        </Grid>

        <!-- Default open mode: two compact preview cards (GUI via ACP vs Terminal CLI) directly at top of Agents settings -->
        <StackPanel Spacing="6">
            <StackPanel Spacing="1">
                <TextBlock Classes="group" Margin="2,0,0,0" Text="{l:AppLangResource SettingsSurfaceSectionTitle}" />
                <TextBlock Classes="hint" Margin="2,0,0,0" Text="{l:AppLangResource SettingsSurfaceSectionHint}" TextWrapping="Wrap" />
            </StackPanel>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <!-- Card 1: GUI (ACP) -->
                <Button x:Name="GuiSurfaceCard"
                        Grid.Column="0"
                        Classes="surfaceCard"
                        Classes.selected="{Binding IsGuiDefault}"
                        Command="{Binding SelectGuiSurfaceCommand}"
                        AutomationProperties.Name="{l:AppLangResource SettingsSurfaceGuiTitle}">
                    <StackPanel Spacing="8">
                        <!-- Miniature GUI (ACP) visual preview -->
                        <Border Height="{DynamicResource OctopusSettingsSurfacePreviewHeight}"
                                Background="{arc:ArcDesignTokenResource Background}"
                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="4">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
                                    <Border Width="6" Height="6" CornerRadius="3" Background="#22C55E" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Width="56" Height="5" CornerRadius="2.5" Background="{arc:ArcDesignTokenResource Border}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Padding="4,0" CornerRadius="3" Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                                        <TextBlock Text="ACP" FontSize="8.5" FontWeight="SemiBold" Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                                    </Border>
                                </Grid>
                                <StackPanel Grid.Row="1" Spacing="4" VerticalAlignment="Center">
                                    <Border HorizontalAlignment="Right" Padding="6,2" CornerRadius="6" Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                                        <Border Width="64" Height="4" CornerRadius="2" Background="{arc:ArcDesignTokenResource TextSecondary}" Opacity="0.55" />
                                    </Border>
                                    <Border Padding="6,3" CornerRadius="5"
                                            Background="{arc:ArcDesignTokenResource Surface}"
                                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="5">
                                            <lucide:LucideIcon Kind="FileDiff" Size="9" Foreground="{arc:ArcDesignTokenResource AccentStrong}" VerticalAlignment="Center" />
                                            <TextBlock Text="Edit Program.cs" FontSize="8.5" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                            <TextBlock Text="+14" FontSize="8.5" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" Foreground="#16A34A" />
                                            <TextBlock Text="-3" FontSize="8.5" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" Foreground="#DC2626" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <Border Grid.Row="2" Padding="6,2.5" CornerRadius="5"
                                        Background="{arc:ArcDesignTokenResource Surface}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="1">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
                                        <TextBlock Text="/ @" FontSize="8.5" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Height="3.5" Width="48" HorizontalAlignment="Left" CornerRadius="2" Background="{arc:ArcDesignTokenResource Border}" VerticalAlignment="Center" />
                                        <Border Grid.Column="2" Width="12" Height="12" CornerRadius="3" Background="{arc:ArcDesignTokenResource AccentStrong}">
                                            <lucide:LucideIcon Kind="ArrowUp" Size="8" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <!-- Card Footer -->
                        <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <lucide:LucideIcon Kind="MessageSquareCode" Size="14" VerticalAlignment="Center" Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Classes="name" Text="{l:AppLangResource SettingsSurfaceGuiTitle}" VerticalAlignment="Center" />
                                    <arc:Badge Size="Small" Tone="Info" Content="{l:AppLangResource SettingsSurfaceGuiBadge}" VerticalAlignment="Center" />
                                </StackPanel>
                                <arc:Badge Grid.Column="2" Size="Small" Tone="Success"
                                           Content="{l:AppLangResource SettingsSurfaceSelectedBadge}"
                                           IsVisible="{Binding IsGuiDefault}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Classes="hint" Text="{l:AppLangResource SettingsSurfaceGuiDesc}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Button>

                <!-- Card 2: Terminal (CLI) -->
                <Button x:Name="TerminalSurfaceCard"
                        Grid.Column="1"
                        Classes="surfaceCard"
                        Classes.selected="{Binding IsTerminalDefault}"
                        Command="{Binding SelectTerminalSurfaceCommand}"
                        AutomationProperties.Name="{l:AppLangResource SettingsSurfaceTerminalTitle}">
                    <StackPanel Spacing="8">
                        <!-- Miniature Terminal (CLI) dark preview -->
                        <Border Height="{DynamicResource OctopusSettingsSurfacePreviewHeight}"
                                Background="#13151A"
                                BorderBrush="#262A34"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                ClipToBounds="True">
                            <StackPanel Spacing="3">
                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,0,0,2">
                                    <Border Width="6" Height="6" CornerRadius="3" Background="#EF4444" Opacity="0.8" />
                                    <Border Width="6" Height="6" CornerRadius="3" Background="#F59E0B" Opacity="0.8" />
                                    <Border Width="6" Height="6" CornerRadius="3" Background="#22C55E" Opacity="0.8" />
                                    <TextBlock Text="zsh — 80×24" Margin="4,0,0,0" FontSize="8.5" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" Foreground="#6B7280" />
                                </StackPanel>
                                <TextBlock Text="$ claude --model sonnet" FontSize="9.5" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" Foreground="#E5E7EB" />
                                <TextBlock Text="❯ Refactoring auth middleware..." FontSize="9.5" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" Foreground="#60A5FA" />
                                <StackPanel Orientation="Horizontal" Spacing="3">
                                    <TextBlock Text="  ✓ Updated src/Auth.cs (+14 -3)" FontSize="9.5" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" Foreground="#4ADE80" />
                                    <Border Width="5" Height="10" Background="#E5E7EB" Opacity="0.75" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- Card Footer -->
                        <StackPanel Spacing="2">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <lucide:LucideIcon Kind="SquareTerminal" Size="14" VerticalAlignment="Center" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <TextBlock Classes="name" Text="{l:AppLangResource SettingsSurfaceTerminalTitle}" VerticalAlignment="Center" />
                                    <arc:Badge Size="Small" Tone="Neutral" Content="{l:AppLangResource SettingsSurfaceTerminalBadge}" VerticalAlignment="Center" />
                                </StackPanel>
                                <arc:Badge Grid.Column="2" Size="Small" Tone="Success"
                                           Content="{l:AppLangResource SettingsSurfaceSelectedBadge}"
                                           IsVisible="{Binding IsTerminalDefault}"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Classes="hint" Text="{l:AppLangResource SettingsSurfaceTerminalDesc}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                Padding="14,10">
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="12">
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <TextBlock Classes="name" Text="{l:AppLangResource SettingsDefaultPermission}" />
                    <TextBlock Classes="hint" Text="{l:AppLangResource SettingsDefaultPermissionHint}" />
                </StackPanel>
                <arc:Select AutoScrollToSelectedItem="False" Grid.Column="1"
                            Size="Small"
                            MinWidth="200"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="{l:AppLangResource SettingsDefaultPermission}"
                            ItemsSource="{Binding PermissionOptions}"
                            SelectedValue="{Binding GlobalPermission, Mode=TwoWay}" />
                <TextBlock Grid.Column="2"
                           Classes="hint"
                           VerticalAlignment="Center"
                           Text="{Binding LastScanText}" />
                <arc:Button Grid.Column="3"
                            Variant="Secondary"
                            Size="Small"
                            VerticalAlignment="Center"
                            IsLoading="{Binding IsScanning}"
                            Content="{Binding RescanText}"
                            Command="{Binding RescanCommand}" />
            </Grid>
        </Border>

        <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                Padding="14,10">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="name" Text="{l:AppLangResource SettingsAcpAdapterPolicy}" />
                        <TextBlock Classes="hint" Text="{l:AppLangResource SettingsAcpAdapterPolicyHint}" TextWrapping="Wrap" />
                    </StackPanel>
                    <arc:Select AutoScrollToSelectedItem="False" Grid.Column="1"
                                Size="Small"
                                MinWidth="240"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{l:AppLangResource SettingsAcpAdapterPolicy}"
                                ItemsSource="{Binding AcpAdapterPolicyOptions}"
                                SelectedValue="{Binding AcpAdapterPolicyKey, Mode=TwoWay}" />
                </Grid>
                <Border Height="1" Background="{arc:ArcDesignTokenResource BorderSubtle}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="name" Text="{l:AppLangResource SettingsAcpFormElicitation}" />
                        <TextBlock Classes="hint" Text="{l:AppLangResource SettingsAcpFormElicitationHint}" TextWrapping="Wrap" />
                    </StackPanel>
                    <arc:Switch Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{l:AppLangResource SettingsAcpFormElicitation}"
                                IsChecked="{Binding AcpEnableFormElicitation, Mode=TwoWay}" />
                </Grid>
                <Border Height="1" Background="{arc:ArcDesignTokenResource BorderSubtle}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="name" Text="{l:AppLangResource SettingsAcpUrlElicitation}" />
                        <TextBlock Classes="hint" Text="{l:AppLangResource SettingsAcpUrlElicitationHint}" TextWrapping="Wrap" />
                    </StackPanel>
                    <arc:Switch Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{l:AppLangResource SettingsAcpUrlElicitation}"
                                IsChecked="{Binding AcpEnableUrlElicitation, Mode=TwoWay}" />
                </Grid>
                <Border Height="1" Background="{arc:ArcDesignTokenResource BorderSubtle}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="name" Text="{l:AppLangResource SettingsAcpClientFileSystem}" />
                        <TextBlock Classes="hint" Text="{l:AppLangResource SettingsAcpClientFileSystemHint}" TextWrapping="Wrap" />
                    </StackPanel>
                    <arc:Switch Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{l:AppLangResource SettingsAcpClientFileSystem}"
                                IsChecked="{Binding AcpEnableClientFileSystem, Mode=TwoWay}" />
                </Grid>
                <Border Height="1" Background="{arc:ArcDesignTokenResource BorderSubtle}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="name" Text="{l:AppLangResource SettingsAcpClientTerminal}" />
                        <TextBlock Classes="hint" Text="{l:AppLangResource SettingsAcpClientTerminalHint}" TextWrapping="Wrap" />
                    </StackPanel>
                    <arc:Switch Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{l:AppLangResource SettingsAcpClientTerminal}"
                                IsChecked="{Binding AcpEnableClientTerminal, Mode=TwoWay}" />
                </Grid>
                <Border Height="1" Background="{arc:ArcDesignTokenResource BorderSubtle}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock Classes="name" Text="{l:AppLangResource SettingsUseSystemProxy}" />
                        <TextBlock Classes="hint" Text="{l:AppLangResource SettingsUseSystemProxyHint}" />
                    </StackPanel>
                    <arc:Switch Grid.Column="1"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{l:AppLangResource SettingsUseSystemProxy}"
                                IsChecked="{Binding UseSystemProxy, Mode=TwoWay}" />
                </Grid>
            </StackPanel>
        </Border>

        <arc:Alert Tone="Warning"
                   Title="{l:AppLangResource SettingsFullAccessWarningTitle}"
                   Content="{l:AppLangResource SettingsFullAccessWarning}"
                   IsVisible="{Binding ShowFullWarning}" />

        <StackPanel Spacing="6">
            <TextBlock Classes="group" Margin="2,4,0,0" Text="{l:AppLangResource SettingsInstalled}" />
            <TextBlock Classes="hint"
                       Margin="2,0,0,0"
                       Text="{l:AppLangResource SettingsNoneInstalled}"
                       IsVisible="{Binding !HasInstalled}" />
            <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                    ClipToBounds="True"
                    IsVisible="{Binding HasInstalled}">
                <ItemsControl ItemsSource="{Binding Installed}" Margin="0,-1,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="agents:AgentRowViewModel">
                            <agents:AgentRowView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>

        <StackPanel Spacing="6" IsVisible="{Binding HasNotInstalled}">
            <Button x:Name="NotInstalledToggleButton"
                    Classes="row"
                    Margin="0,8,0,0"
                    Padding="4,6"
                    Command="{Binding ToggleNotInstalledCommand}"
                    AutomationProperties.Name="{Binding NotInstalledTitle}">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <lucide:LucideIcon Classes="sectionChevron"
                                       Classes.expanded="{Binding IsNotInstalledExpanded}"
                                       Kind="ChevronRight"
                                       Size="14"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                       VerticalAlignment="Center" />
                    <TextBlock Classes="group" Text="{Binding NotInstalledTitle}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <Border x:Name="NotInstalledListBorder"
                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                    ClipToBounds="True"
                    IsVisible="{Binding IsNotInstalledExpanded}">
                <ItemsControl ItemsSource="{Binding NotInstalled}" Margin="0,-1,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="agents:UninstalledAgentViewModel">
                            <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="14,8">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" ColumnSpacing="12">
                                    <common:AgentIcon AgentId="{Binding Id}" AgentName="{Binding Name}" Size="28" VerticalAlignment="Center" Opacity="0.6" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="label" Text="{Binding Name}" FontWeight="Medium" VerticalAlignment="Center" />
                                            <arc:Badge Size="Small" Tone="Info" Content="{Binding AcpBadgeText}" IsVisible="{Binding SupportsAcp}"
                                                       VerticalAlignment="Center" />
                                            <arc:Badge Size="Small" Tone="Neutral" Content="{Binding AcpBadgeText}" IsVisible="{Binding !SupportsAcp}"
                                                       VerticalAlignment="Center" />
                                            <arc:Badge Size="Small" Tone="Neutral" Content="{Binding OriginBadge}" IsVisible="{Binding HasOriginBadge}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Classes="mono"
                                                   Text="{Binding InstallCommand}"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding HasInstallCommand}" />
                                    </StackPanel>
                                    <arc:CopyButton Grid.Column="2"
                                                    IsIconOnly="True"
                                                    Value="{Binding InstallCommand}"
                                                    IsVisible="{Binding HasInstallCommand}"
                                                    VerticalAlignment="Center"
                                                    AutomationProperties.Name="{l:AppLangResource SettingsCopyInstallCommand}"
                                                    arc:Tooltip.Tip="{l:AppLangResource SettingsCopyInstallCommand}" />
                                    <arc:Button Grid.Column="4"
                                                Variant="Ghost"
                                                Size="Small"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding CanEdit}"
                                                Command="{Binding $parent[agents:AgentsPageView].((agents:AgentsSettingsViewModel)DataContext).EditAgentCommand}"
                                                CommandParameter="{Binding Definition}"
                                                AutomationProperties.Name="{l:AppLangResource SettingsEditAgent}"
                                                arc:Tooltip.Tip="{l:AppLangResource SettingsEditAgent}">
                                        <lucide:LucideIcon Kind="Pencil" Size="15" />
                                    </arc:Button>
                                    <arc:Button Grid.Column="5"
                                                Variant="Ghost"
                                                Size="Small"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding CanRemove}"
                                                Command="{Binding $parent[agents:AgentsPageView].((agents:AgentsSettingsViewModel)DataContext).RemoveAgentCommand}"
                                                CommandParameter="{Binding Definition}"
                                                AutomationProperties.Name="{Binding RemoveText}"
                                                arc:Tooltip.Tip="{Binding RemoveText}">
                                        <lucide:LucideIcon Kind="Trash2" Size="15" />
                                    </arc:Button>
                                    <arc:Button Grid.Column="3"
                                                Variant="Ghost"
                                                Size="Small"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasHomepage}"
                                                Command="{Binding OpenHomepageCommand}"
                                                AutomationProperties.Name="{l:AppLangResource SettingsOpenHomepage}"
                                                arc:Tooltip.Tip="{l:AppLangResource SettingsOpenHomepage}">
                                        <lucide:LucideIcon Kind="ExternalLink" Size="16" />
                                    </arc:Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
