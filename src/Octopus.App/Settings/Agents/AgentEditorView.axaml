<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:agents="using:Octopus.App.Settings.Agents"
             x:Class="Octopus.App.Settings.Agents.AgentEditorView"
             x:DataType="agents:AgentEditorModel"
             Width="560">
    <UserControl.Styles>
        <Style Selector="TextBlock.field">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="arc|Input.mono, arc|Textarea.mono">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="10">
        <TextBlock Classes="hint" IsVisible="{Binding IsBuiltIn}" Text="{l:AppLangResource AgentEditorBuiltInNote}" />
        <arc:SegmentedControl HorizontalAlignment="Left" Height="28" SelectedValue="{Binding Mode, Mode=TwoWay}">
            <arc:SegmentedOption Value="form" Label="{l:AppLangResource AgentEditorForm}" />
            <arc:SegmentedOption Value="json" Label="{l:AppLangResource AgentEditorJson}" />
        </arc:SegmentedControl>

        <arc:ScrollArea MaxHeight="460" FadeLength="0" IsVisible="{Binding IsForm}">
            <StackPanel Spacing="12" Margin="0,0,10,0">
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="field" Text="{l:AppLangResource AgentEditorName}" />
                        <arc:Input x:Name="NameInput" Size="Small" Text="{Binding Name, Mode=TwoWay}" Placeholder="My Agent"
                                   Label="{l:AppLangResource AgentEditorName}" IsLabelVisible="False" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="field" Text="{l:AppLangResource AgentEditorId}" />
                        <arc:Input Classes="mono" Size="Small" Text="{Binding Id, Mode=TwoWay}" IsEnabled="{Binding CanEditId}"
                                   Placeholder="my-agent" Label="{l:AppLangResource AgentEditorId}" IsLabelVisible="False" />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="field" Text="{l:AppLangResource AgentEditorExecutables}" />
                        <arc:Input Classes="mono" Size="Small" Text="{Binding Executables, Mode=TwoWay}" Placeholder="my-agent"
                                   Label="{l:AppLangResource AgentEditorExecutables}" IsLabelVisible="False" />
                        <TextBlock Classes="hint" Text="{l:AppLangResource AgentEditorExecutablesHint}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="field" Text="{l:AppLangResource AgentEditorVersionArgs}" />
                        <arc:Input Classes="mono" Size="Small" Text="{Binding VersionArgs, Mode=TwoWay}" Placeholder="--version"
                                   Label="{l:AppLangResource AgentEditorVersionArgs}" IsLabelVisible="False" />
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="4">
                    <TextBlock Classes="field" Text="{l:AppLangResource AgentEditorBaseArgs}" />
                    <arc:Input Classes="mono" Size="Small" Text="{Binding BaseArgs, Mode=TwoWay}"
                               Label="{l:AppLangResource AgentEditorBaseArgs}" IsLabelVisible="False" />
                </StackPanel>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="field" Text="{l:AppLangResource AgentEditorModelArgs}" />
                        <arc:Input Classes="mono" Size="Small" Text="{Binding ModelArgs, Mode=TwoWay}" Placeholder="--model {value}"
                                   Label="{l:AppLangResource AgentEditorModelArgs}" IsLabelVisible="False" />
                        <TextBlock Classes="hint" Text="{l:AppLangResource AgentEditorModelArgsHint}" />
                        <arc:Checkbox IsChecked="{Binding AllowCustomModel, Mode=TwoWay}" Content="{l:AppLangResource AgentEditorAllowCustomModel}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4">
                        <TextBlock Classes="field" Text="{l:AppLangResource AgentEditorModelOptions}" />
                        <arc:Textarea Classes="mono" Text="{Binding ModelOptions, Mode=TwoWay}" FrameMinHeight="72" FrameHeight="72"
                                      Label="{l:AppLangResource AgentEditorModelOptions}" IsLabelVisible="False" />
                        <TextBlock Classes="hint" Text="{l:AppLangResource AgentEditorModelOptionsHint}" />
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="4">
                    <TextBlock Classes="field" Text="{l:AppLangResource AgentEditorPrompt}" />
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <arc:SegmentedControl HorizontalAlignment="Left" Height="28" SelectedValue="{Binding PromptMode, Mode=TwoWay}">
                            <arc:SegmentedOption Value="positional" Label="{l:AppLangResource AgentEditorPromptPositional}" />
                            <arc:SegmentedOption Value="flag" Label="{l:AppLangResource AgentEditorPromptFlag}" />
                            <arc:SegmentedOption Value="none" Label="{l:AppLangResource AgentEditorPromptNone}" />
                        </arc:SegmentedControl>
                        <arc:Input Grid.Column="1" Classes="mono" Size="Small" Text="{Binding PromptArgs, Mode=TwoWay}" Placeholder="--prompt {value}"
                                   IsVisible="{Binding ShowPromptArgs}"
                                   Label="{l:AppLangResource AgentEditorPromptArgs}" IsLabelVisible="False" />
                    </Grid>
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Classes="field" Text="{l:AppLangResource AgentEditorResumeArgs}" />
                    <arc:Input Classes="mono" Size="Small" Text="{Binding ResumeArgs, Mode=TwoWay}" Placeholder="--continue"
                               Label="{l:AppLangResource AgentEditorResumeArgs}" IsLabelVisible="False" />
                </StackPanel>
                <StackPanel Spacing="4">
                    <TextBlock Classes="field" Text="{l:AppLangResource AgentEditorEnvironment}" />
                    <arc:Textarea Classes="mono" Text="{Binding Environment, Mode=TwoWay}" FrameMinHeight="56" FrameHeight="56"
                                  Label="{l:AppLangResource AgentEditorEnvironment}" IsLabelVisible="False" />
                    <TextBlock Classes="hint" Text="{l:AppLangResource AgentEditorEnvironmentHint}" />
                </StackPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Classes="field" Text="{l:AppLangResource AgentEditorHomepage}" />
                        <arc:Input Size="Small" Text="{Binding Homepage, Mode=TwoWay}" Placeholder="https://"
                                   Label="{l:AppLangResource AgentEditorHomepage}" IsLabelVisible="False" />
                    </StackPanel>
                    <arc:Checkbox Grid.Column="1" VerticalAlignment="Bottom" IsChecked="{Binding ExtraArgs, Mode=TwoWay}"
                              Content="{l:AppLangResource AgentEditorExtraArgs}" />
                </Grid>
            </StackPanel>
        </arc:ScrollArea>

        <StackPanel Spacing="4" IsVisible="{Binding IsJson}">
            <TextBlock Classes="hint" Text="{l:AppLangResource AgentEditorJsonHint}" />
            <arc:Textarea Classes="mono" Text="{Binding Json, Mode=TwoWay}" FrameMinHeight="380" FrameHeight="380"
                          Label="{l:AppLangResource AgentEditorJson}" IsLabelVisible="False" />
        </StackPanel>

        <TextBlock Classes="hint" IsVisible="{Binding HasError}" Text="{Binding Error}"
                   Foreground="{arc:ArcDesignTokenResource Danger}" />
    </StackPanel>
</UserControl>
