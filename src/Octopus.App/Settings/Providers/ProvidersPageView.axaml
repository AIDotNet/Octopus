<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:vm="using:Octopus.App.Settings.Providers"
             x:Class="Octopus.App.Settings.Providers.ProvidersPageView"
             x:DataType="vm:ProvidersSettingsViewModel">
    <Panel>
        <!-- Main Scheme B Layout: Header + Quick Preset Bar + 2-column Provider Card Grid -->
        <StackPanel Spacing="16" IsVisible="{Binding !IsEditing}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Classes="title" Text="{l:AppLangResource ProvidersTitle}" />
                    <TextBlock Classes="subtitle" Text="{l:AppLangResource ProvidersSubtitle}" />
                </StackPanel>
                <arc:Button Grid.Column="1"
                            Variant="Primary"
                            Size="Small"
                            VerticalAlignment="Center"
                            Command="{Binding AddCustomCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:LucideIcon Kind="Plus" Size="14" />
                        <TextBlock Text="{l:AppLangResource ProvidersAddButton}" VerticalAlignment="Center" />
                    </StackPanel>
                </arc:Button>
            </Grid>

            <!-- CoWork Bound Model Quota Card -->
            <Border IsVisible="{Binding ShowCoWorkCard}"
                    Background="{arc:ArcDesignTokenResource Surface}"
                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="14">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                        <StackPanel Spacing="3">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <lucide:LucideIcon Kind="Link2" Size="15" Foreground="{arc:ArcDesignTokenResource AccentStrong}" VerticalAlignment="Center" />
                                <TextBlock Classes="name" Text="{Binding CoWorkTitleText}" VerticalAlignment="Center" />
                                <arc:Badge Size="Small" Tone="Info" Content="{Binding CoWorkBadgeText}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Classes="hint" Text="{Binding CoWorkSummaryText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <arc:Button Variant="Secondary" Size="Small"
                                        IsEnabled="{Binding !IsCoWorkBusy}"
                                        Command="{Binding RefreshCoWorkCommand}">
                                <lucide:LucideIcon Kind="RefreshCw" Size="13" />
                            </arc:Button>
                            <arc:Button Variant="Secondary" Size="Small"
                                        IsVisible="{Binding IsCoWorkBound}"
                                        IsEnabled="{Binding !IsCoWorkBusy}"
                                        Command="{Binding SyncCoWorkModelsCommand}"
                                        Content="Sync Models" />
                            <arc:Button Variant="Primary" Size="Small"
                                        Command="{Binding OpenCoWorkBindPageCommand}"
                                        Content="CoWork" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" IsVisible="{Binding HasCoWorkTeams}">
                        <TextBlock Classes="hint" Text="Team:" VerticalAlignment="Center" />
                        <arc:Select Grid.Column="1"
                                    Size="Small"
                                    ItemsSource="{Binding CoWorkTeamOptions}"
                                    SelectedValue="{Binding SelectedCoWorkTeamId, Mode=TwoWay}"
                                    IsEnabled="{Binding !IsCoWorkBusy}"
                                    MaxWidth="280"
                                    HorizontalAlignment="Left" />
                    </Grid>
                    <arc:Alert Tone="Info"
                               IsVisible="{Binding HasCoWorkMessage}"
                               Content="{Binding CoWorkMessage}" />
                </StackPanel>
            </Border>

            <!-- Quick Preset Bar -->
            <Border Background="{arc:ArcDesignTokenResource Surface}"
                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,10">
                <StackPanel Spacing="8">
                    <TextBlock Classes="hint" FontWeight="SemiBold" Text="{l:AppLangResource ProvidersQuickPresets}" />
                    <ItemsControl ItemsSource="{Binding Presets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProviderPresetChipViewModel">
                                <arc:Button Variant="Secondary"
                                            Size="Small"
                                            Margin="0,0,6,6"
                                            Command="{Binding PickCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <lucide:LucideIcon Kind="Plus" Size="12" />
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </arc:Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Empty Hint -->
            <arc:Alert Tone="Info"
                       IsVisible="{Binding IsEmpty}"
                       Content="{l:AppLangResource ProvidersEmptyHint}" />

            <!-- 2-Column Provider Card Grid -->
            <ItemsControl ItemsSource="{Binding Cards}" IsVisible="{Binding !IsEmpty}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ProviderCardViewModel">
                        <Border Background="{arc:ArcDesignTokenResource Surface}"
                                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14"
                                Margin="0,0,10,10">
                            <StackPanel Spacing="10">
                                <!-- Top: Name + Protocol + Enable Switch -->
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <lucide:LucideIcon Kind="Plug" Size="15" Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                                        <TextBlock Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <arc:Badge Grid.Column="1" Size="Small" Tone="Info" Content="{Binding ProtocolLabel}" VerticalAlignment="Center" />
                                    <arc:Switch Grid.Column="2" IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                </Grid>

                                <!-- Base URL -->
                                <TextBlock Classes="mono" Text="{Binding BaseUrlDisplay}" TextTrimming="CharacterEllipsis" />

                                <!-- Enabled Model Chips -->
                                <ItemsControl ItemsSource="{Binding EnabledModelChips}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                    CornerRadius="6"
                                                    Padding="6,2"
                                                    Margin="0,0,5,5">
                                                <TextBlock Classes="mono" Text="{Binding}" />
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- Footer: Compatible Agents + Badges + Actions -->
                                <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,8,0,0">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Classes="hint" Text="{l:AppLangResource ProvidersCompatibleAgents}" />
                                                <TextBlock Classes="hint" Text="{Binding CompatibleAgentsSummary}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <arc:Badge Size="Small" Tone="Success"
                                                           Content="{Binding TestBadgeText}"
                                                           IsVisible="{Binding HasTestBadge}" />
                                                <arc:Badge Size="Small" Tone="Neutral"
                                                           Content="⚡ Tunnel"
                                                           IsVisible="{Binding AllowRemoteTunnel}" />
                                            </StackPanel>
                                        </StackPanel>
                                        <arc:Button Grid.Column="1" Variant="Secondary" Size="Small"
                                                    Content="{l:AppLangResource ProvidersTestConnection}"
                                                    IsEnabled="{Binding !IsTesting}"
                                                    Command="{Binding TestCommand}" />
                                        <arc:Button Grid.Column="2" Variant="Primary" Size="Small"
                                                    Content="{l:AppLangResource ProvidersConfigure}"
                                                    Command="{Binding ConfigureCommand}" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Inline Provider Editor Panel (when editing/adding a provider) -->
        <StackPanel DataContext="{Binding Editor}"
                    x:DataType="vm:ProviderEditorViewModel"
                    IsVisible="{Binding $parent[UserControl].((vm:ProvidersSettingsViewModel)DataContext).IsEditing}"
                    Spacing="14">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                <arc:Button Variant="Ghost" Size="Small" Command="{Binding CancelCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <lucide:LucideIcon Kind="ArrowLeft" Size="14" />
                        <TextBlock Text="{l:AppLangResource Cancel}" VerticalAlignment="Center" />
                    </StackPanel>
                </arc:Button>
                <TextBlock Grid.Column="1" Classes="title" Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <arc:Button Grid.Column="2" Variant="Secondary" Size="Small"
                            IsVisible="{Binding CanDelete}"
                            Command="{Binding DeleteCommand}"
                            Content="{l:AppLangResource AccountRemove}" />
                <arc:Button Grid.Column="3" Variant="Primary" Size="Small"
                            IsEnabled="{Binding !IsBusy}"
                            Command="{Binding SaveCommand}"
                            Content="{l:AppLangResource Save}" />
            </Grid>

            <arc:Alert Tone="Info"
                       IsVisible="{Binding HasStatus}"
                       Content="{Binding StatusMessage}" />

            <!-- Connection & Auth Card -->
            <Border Background="{arc:ArcDesignTokenResource Surface}"
                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="{l:AppLangResource AgentEditorName}" />
                            <arc:Input Text="{Binding Name, Mode=TwoWay}" Size="Small" IsLabelVisible="False" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock Classes="label" Text="{l:AppLangResource ProvidersProtocolLabel}" />
                            <arc:Select Size="Small"
                                        ItemsSource="{Binding ProtocolOptions}"
                                        SelectedValue="{Binding SelectedProtocol, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                        <TextBlock Classes="label" Text="{l:AppLangResource ProvidersBaseUrlLabel}" />
                        <arc:Input Text="{Binding BaseUrl, Mode=TwoWay}"
                                   Size="Small"
                                   IsEnabled="{Binding IsBaseUrlEditable}"
                                   IsLabelVisible="False"
                                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsAnthropicProtocol}">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="label" Text="Anthropic Auth Variable" />
                            <arc:Select Size="Small"
                                        ItemsSource="{Binding AuthEnvOptions}"
                                        SelectedValue="{Binding AuthEnvPreference, Mode=TwoWay}" />
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="label" Text="{l:AppLangResource ProvidersApiKeyLabel}" VerticalAlignment="Center" />
                            <arc:Badge Size="Small" Tone="Success"
                                       IsVisible="{Binding HasSavedSecret}"
                                       Content="{l:AppLangResource ProvidersApiKeySavedHint}" />
                        </StackPanel>
                        <arc:Input Text="{Binding ApiKeyInput, Mode=TwoWay}"
                                   Placeholder="sk-..."
                                   PasswordChar="•"
                                   Size="Small"
                                   IsLabelVisible="False"
                                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Classes="label" Text="{l:AppLangResource ProvidersIsolateDirLabel}" VerticalAlignment="Center" />
                        <arc:Switch Grid.Column="1" IsChecked="{Binding IsolateConfigDir, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <TextBlock Classes="label" Text="{l:AppLangResource ProvidersAllowRemoteTunnelLabel}" VerticalAlignment="Center" />
                        <arc:Switch Grid.Column="1" IsChecked="{Binding AllowRemoteTunnel, Mode=TwoWay}" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <arc:Button Variant="Secondary" Size="Small"
                                    IsEnabled="{Binding !IsBusy}"
                                    Content="{l:AppLangResource ProvidersTestConnection}"
                                    Command="{Binding TestConnectionCommand}" />
                        <arc:Button Variant="Secondary" Size="Small"
                                    Content="{l:AppLangResource ProvidersPreviewMaterialize}"
                                    Command="{Binding TogglePreviewCommand}" />
                        <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding CompatibleSummary}" />
                    </StackPanel>

                    <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10"
                            IsVisible="{Binding ShowPreview}">
                        <TextBlock Classes="mono" Text="{Binding PreviewText}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- Managed Models Card -->
            <Border Background="{arc:ArcDesignTokenResource Surface}"
                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="16">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Classes="name" Text="{l:AppLangResource ProvidersModelsHeading}" VerticalAlignment="Center" />
                        <arc:Button Grid.Column="1" Variant="Secondary" Size="Small"
                                    IsEnabled="{Binding !IsBusy}"
                                    Content="{l:AppLangResource ProvidersFetchModels}"
                                    Command="{Binding FetchModelsCommand}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <arc:Input Text="{Binding NewModelId, Mode=TwoWay}"
                                   Placeholder="e.g. claude-sonnet-5-5, deepseek-reasoner, gpt-6.2-astra"
                                   Size="Small"
                                   IsLabelVisible="False"
                                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" />
                        <arc:Button Grid.Column="1" Variant="Secondary" Size="Small"
                                    Content="{l:AppLangResource ProvidersAddModel}"
                                    Command="{Binding AddModelCommand}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Models}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ManagedModelRowViewModel">
                                <Border Background="{arc:ArcDesignTokenResource Background}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10,7"
                                        Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Classes="mono" FontWeight="SemiBold" Text="{Binding Id}" TextTrimming="CharacterEllipsis" />
                                            <arc:Input Text="{Binding DisplayName, Mode=TwoWay}"
                                                       Placeholder="Display name (optional)"
                                                       Size="Small"
                                                       IsLabelVisible="False" />
                                        </StackPanel>
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding Efforts}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ModelEffortChipViewModel">
                                                    <arc:Button Size="Small"
                                                                Variant="Ghost"
                                                                Content="{Binding Id}"
                                                                Command="{Binding ToggleCommand}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <arc:Select Grid.Column="3"
                                                    Size="Small"
                                                    MinWidth="136"
                                                    IsVisible="{Binding ShowTier}"
                                                    ItemsSource="{Binding TierOptions}"
                                                    SelectedValue="{Binding SelectedTier, Mode=TwoWay}" />
                                        <arc:Button Grid.Column="4" Variant="Ghost" Size="Small" Command="{Binding RemoveCommand}">
                                            <lucide:LucideIcon Kind="X" Size="13" />
                                        </arc:Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </Panel>
</UserControl>
