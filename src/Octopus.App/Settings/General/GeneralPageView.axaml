<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:settings="using:Octopus.App.Settings"
             xmlns:general="using:Octopus.App.Settings.General"
             x:Class="Octopus.App.Settings.General.GeneralPageView"
             x:DataType="general:GeneralSettingsViewModel">
    <StackPanel Spacing="{DynamicResource OctopusSettingsPageSpacing}">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="title" Text="{l:AppLangResource SettingsGeneralTitle}" VerticalAlignment="Center" />
            <settings:SettingHelpTip Tip="{l:AppLangResource SettingsGeneralSubtitle}" />
        </StackPanel>
        <arc:SettingsGroup Appearance="Plain">
            <arc:SettingsRow Header="{l:AppLangResource Language}"
                             settings:SettingHelp.Tip="{l:AppLangResource SettingsLanguageHint}">
                <arc:Select AutoScrollToSelectedItem="False" Size="Small"
                            Width="200"
                            AutomationProperties.Name="{l:AppLangResource Language}"
                            ItemsSource="{Binding Languages}"
                            SelectedValue="{Binding Language, Mode=TwoWay}" />
            </arc:SettingsRow>
            <arc:SettingsRow Header="{l:AppLangResource SettingsLaunchAtLogin}"
                             settings:SettingHelp.Tip="{l:AppLangResource SettingsLaunchAtLoginHint}">
                <arc:Switch x:Name="LaunchAtLoginSwitch" IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}" />
            </arc:SettingsRow>
            <arc:SettingsRow Header="{l:AppLangResource SettingsRestoreAgents}"
                             settings:SettingHelp.Tip="{l:AppLangResource SettingsRestoreAgentsHint}">
                <arc:Switch x:Name="RestoreAgentsSwitch" IsChecked="{Binding RestoreItemsOnStartup, Mode=TwoWay}" />
            </arc:SettingsRow>
            <arc:SettingsRow Header="{l:AppLangResource SettingsResumeAgents}"
                             settings:SettingHelp.Tip="{l:AppLangResource SettingsResumeAgentsHint}">
                <arc:Switch x:Name="ResumeAgentsSwitch" IsChecked="{Binding ResumeAgentsOnRestart, Mode=TwoWay}" IsEnabled="{Binding RestoreItemsOnStartup}" />
            </arc:SettingsRow>
            <arc:SettingsRow Header="{l:AppLangResource SettingsTrayShow}"
                             settings:SettingHelp.Tip="{l:AppLangResource SettingsTrayShowHint}">
                <arc:Switch x:Name="TrayEnabledSwitch" IsChecked="{Binding TrayEnabled, Mode=TwoWay}" />
            </arc:SettingsRow>
            <arc:SettingsRow Header="{l:AppLangResource SettingsTrayCloseAction}"
                             settings:SettingHelp.Tip="{l:AppLangResource SettingsTrayCloseActionHint}">
                <arc:Select x:Name="CloseActionSelect" AutoScrollToSelectedItem="False" Size="Small"
                            Width="200"
                            AutomationProperties.Name="{l:AppLangResource SettingsTrayCloseAction}"
                            ItemsSource="{Binding CloseActions}"
                            SelectedValue="{Binding CloseAction, Mode=TwoWay}"
                            IsEnabled="{Binding TrayEnabled}" />
            </arc:SettingsRow>
        </arc:SettingsGroup>
    </StackPanel>
</UserControl>
