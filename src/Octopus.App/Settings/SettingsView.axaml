<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:local="using:Octopus.App.Settings"
             xmlns:agents="using:Octopus.App.Settings.Agents"
             xmlns:general="using:Octopus.App.Settings.General"
             xmlns:terminal="using:Octopus.App.Settings.Terminal"
             xmlns:ssh="using:Octopus.App.Settings.Ssh"
             xmlns:appearance="using:Octopus.App.Settings.Appearance"
             xmlns:shortcuts="using:Octopus.App.Settings.Shortcuts"
             xmlns:pluginSettings="using:Octopus.App.Plugins.Settings"
             x:Class="Octopus.App.Settings.SettingsView"
             x:DataType="local:SettingsViewModel"
             Focusable="True">
    <UserControl.Styles>
        <Style Selector="TextBlock.title">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXL}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="TextBlock.subtitle">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.group">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.name">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <DataTemplate DataType="agents:AgentsSettingsViewModel">
            <agents:AgentsPageView />
        </DataTemplate>
        <DataTemplate DataType="general:GeneralSettingsViewModel">
            <general:GeneralPageView />
        </DataTemplate>
        <DataTemplate DataType="terminal:TerminalSettingsViewModel">
            <terminal:TerminalPageView />
        </DataTemplate>
        <DataTemplate DataType="ssh:SshSettingsViewModel">
            <ssh:SshPageView />
        </DataTemplate>
        <DataTemplate DataType="appearance:AppearanceSettingsViewModel">
            <appearance:AppearancePageView />
        </DataTemplate>
        <DataTemplate DataType="pluginSettings:PluginsSettingsViewModel">
            <pluginSettings:PluginsPageView />
        </DataTemplate>
        <DataTemplate DataType="shortcuts:ShortcutsViewModel">
            <shortcuts:ShortcutsPageView />
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid ColumnDefinitions="Auto,*" Background="{arc:ArcDesignTokenResource Background}">
        <!-- Arc's sidebar: one section per group, filled from the view model's groups in SettingsView.axaml.cs. -->
        <arc:Sidebar x:Name="Nav"
                     Grid.Column="0"
                     ExpandedWidth="230"
                     IsCollapseButtonVisible="False"
                     IsFilterVisible="False"
                     SelectedKey="{Binding SelectedKey, Mode=TwoWay}">
            <arc:Sidebar.Header>
                <arc:Button x:Name="BackButton"
                            Variant="Ghost"
                            Size="Small"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="OnBackClick">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <lucide:LucideIcon Kind="ArrowLeft" Size="16" />
                        <TextBlock Text="{l:AppLangResource SettingsBackToApp}" VerticalAlignment="Center" />
                    </StackPanel>
                </arc:Button>
            </arc:Sidebar.Header>
        </arc:Sidebar>

        <arc:ScrollArea x:Name="ContentScroll" Grid.Column="1">
            <Border MaxWidth="820" Margin="34,26,34,60">
                <ContentControl Content="{Binding Page}" />
            </Border>
        </arc:ScrollArea>
    </Grid>
</UserControl>
