<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:settings="using:Octopus.App.Settings"
             xmlns:about="using:Octopus.App.Settings.About"
             xmlns:updates="using:Octopus.App.Updates"
             x:Class="Octopus.App.Settings.About.AboutPageView"
             x:DataType="about:AboutSettingsViewModel">
    <StackPanel Spacing="{DynamicResource OctopusSettingsPageSpacing}">
        <!-- Page header -->
        <StackPanel Spacing="4">
            <TextBlock Classes="title" Text="{l:AppLangResource SettingsAboutTitle}" />
            <TextBlock Classes="subtitle" Text="{l:AppLangResource SettingsAboutSlogan}" />
        </StackPanel>

        <!-- Brand hero & update status card -->
        <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                Padding="18,16">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                    <Border Grid.Column="0"
                            Width="64"
                            Height="64"
                            VerticalAlignment="Top"
                            Background="{arc:ArcDesignTokenResource Background}"
                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}"
                            Padding="7">
                        <Image RenderOptions.BitmapInterpolationMode="HighQuality"
                               Source="avares://Octopus/Assets/Icon/logo.png" />
                    </Border>

                    <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Octopus"
                                       FontSize="{arc:ArcDesignTokenResource TypeXL}"
                                       FontWeight="SemiBold"
                                       Foreground="{arc:ArcDesignTokenResource Foreground}"
                                       VerticalAlignment="Center" />
                            <arc:Badge x:Name="AboutVersionBadge"
                                       Size="Small"
                                       Tone="Info"
                                       Content="{Binding Updates.VersionBadgeText}"
                                       VerticalAlignment="Center" />
                            <arc:Badge x:Name="AboutChannelBadge"
                                       Size="Small"
                                       Tone="Neutral"
                                       Content="{Binding Updates.ChannelBadgeText}"
                                       IsVisible="{Binding Updates.ShowStableBadge}"
                                       VerticalAlignment="Center" />
                            <arc:Badge Size="Small"
                                       Tone="Warning"
                                       Content="{Binding Updates.ChannelBadgeText}"
                                       IsVisible="{Binding Updates.ShowPreviewBadge}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Classes="subtitle"
                                   Text="{l:AppLangResource SettingsAboutIntro}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Top"
                                DataContext="{Binding Updates}"
                                x:DataType="updates:UpdateSettingsViewModel">
                        <arc:Button x:Name="UpdateRestartButton"
                                    Variant="Primary"
                                    Size="Small"
                                    IsVisible="{Binding IsReady}"
                                    Command="{Binding RestartCommand}"
                                    Content="{l:AppLangResource UpdateRestart}" />
                        <arc:Button x:Name="UpdateDownloadButton"
                                    Variant="Primary"
                                    Size="Small"
                                    IsVisible="{Binding IsAvailable}"
                                    Command="{Binding DownloadCommand}"
                                    Content="{l:AppLangResource UpdateDownload}" />
                        <arc:Button x:Name="UpdateCheckButton"
                                    Variant="Secondary"
                                    Size="Small"
                                    IsVisible="{Binding ShowCheckButton}"
                                    IsEnabled="{Binding IsEnabled}"
                                    IsLoading="{Binding IsChecking}"
                                    Command="{Binding CheckCommand}"
                                    Content="{l:AppLangResource SettingsUpdateCheck}" />
                    </StackPanel>
                </Grid>

                <!-- Update status strip -->
                <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                        BorderThickness="0,1,0,0"
                        Padding="0,10,0,0"
                        DataContext="{Binding Updates}"
                        x:DataType="updates:UpdateSettingsViewModel">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <Panel Grid.Column="0" VerticalAlignment="Center" Width="8" Height="8">
                            <Ellipse Width="7" Height="7" Fill="{arc:ArcDesignTokenResource Success}" IsVisible="{Binding IsStatusSuccess}" />
                            <Ellipse Width="7" Height="7" Fill="{arc:ArcDesignTokenResource Warning}" IsVisible="{Binding IsStatusWarning}" />
                            <Ellipse Width="7" Height="7" Fill="{arc:ArcDesignTokenResource Accent}" IsVisible="{Binding IsStatusInfo}" />
                        </Panel>
                        <TextBlock Grid.Column="1"
                                   x:Name="UpdateStatusText"
                                   Classes="hint"
                                   VerticalAlignment="Center"
                                   Text="{Binding StatusText}" />
                        <arc:Button Grid.Column="2"
                                    x:Name="UpdateNotesButton"
                                    Variant="Ghost"
                                    Size="Small"
                                    Command="{Binding OpenNotesCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <lucide:LucideIcon Kind="FileText" Size="13" VerticalAlignment="Center" />
                                <TextBlock Text="{l:AppLangResource UpdateNotes}" VerticalAlignment="Center" />
                            </StackPanel>
                        </arc:Button>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Core capabilities overview (2x2) -->
        <TextBlock Classes="group" Text="{l:AppLangResource SettingsAboutOverview}" Margin="0,6,0,0" />
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
            <Border Grid.Row="0" Grid.Column="0"
                    Background="{arc:ArcDesignTokenResource Background}"
                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                    Padding="13,12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                    <Border Grid.Column="0"
                            Width="30" Height="30"
                            VerticalAlignment="Top"
                            Background="{arc:ArcDesignTokenResource AccentSubtle}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusControl}">
                        <lucide:LucideIcon Kind="SquareTerminal" Size="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Classes="name" Text="{l:AppLangResource SettingsAboutFeatureWorkspaceTitle}" TextWrapping="Wrap" />
                        <TextBlock Classes="hint" Text="{l:AppLangResource SettingsAboutFeatureWorkspaceDesc}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="0" Grid.Column="1"
                    Background="{arc:ArcDesignTokenResource Background}"
                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                    Padding="13,12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                    <Border Grid.Column="0"
                            Width="30" Height="30"
                            VerticalAlignment="Top"
                            Background="{arc:ArcDesignTokenResource AccentSubtle}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusControl}">
                        <lucide:LucideIcon Kind="Bot" Size="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Classes="name" Text="{l:AppLangResource SettingsAboutFeatureAgentsTitle}" TextWrapping="Wrap" />
                        <TextBlock Classes="hint" Text="{l:AppLangResource SettingsAboutFeatureAgentsDesc}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="0"
                    Background="{arc:ArcDesignTokenResource Background}"
                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                    Padding="13,12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                    <Border Grid.Column="0"
                            Width="30" Height="30"
                            VerticalAlignment="Top"
                            Background="{arc:ArcDesignTokenResource AccentSubtle}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusControl}">
                        <lucide:LucideIcon Kind="MonitorSmartphone" Size="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Classes="name" Text="{l:AppLangResource SettingsAboutFeatureRemoteTitle}" TextWrapping="Wrap" />
                        <TextBlock Classes="hint" Text="{l:AppLangResource SettingsAboutFeatureRemoteDesc}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1" Grid.Column="1"
                    Background="{arc:ArcDesignTokenResource Background}"
                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="1"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                    Padding="13,12">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                    <Border Grid.Column="0"
                            Width="30" Height="30"
                            VerticalAlignment="Top"
                            Background="{arc:ArcDesignTokenResource AccentSubtle}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusControl}">
                        <lucide:LucideIcon Kind="Puzzle" Size="15"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                    </Border>
                    <StackPanel Grid.Column="1" Spacing="3">
                        <TextBlock Classes="name" Text="{l:AppLangResource SettingsAboutFeaturePluginsTitle}" TextWrapping="Wrap" />
                        <TextBlock Classes="hint" Text="{l:AppLangResource SettingsAboutFeaturePluginsDesc}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Software updates (design/10-自动更新.md §9) -->
        <TextBlock Classes="group" Text="{l:AppLangResource SettingsUpdates}" Margin="0,6,0,0" />
        <arc:SettingsGroup Appearance="Plain" DataContext="{Binding Updates}" x:DataType="updates:UpdateSettingsViewModel">
            <arc:SettingsRow Header="{l:AppLangResource SettingsUpdateMode}"
                             settings:SettingHelp.Tip="{l:AppLangResource SettingsUpdateModeHint}">
                <arc:Select x:Name="UpdateModeSelect" AutoScrollToSelectedItem="False" Size="Small" Width="240"
                            AutomationProperties.Name="{l:AppLangResource SettingsUpdateMode}"
                            IsEnabled="{Binding IsEnabled}"
                            ItemsSource="{Binding Modes}"
                            SelectedValue="{Binding Mode, Mode=TwoWay}" />
            </arc:SettingsRow>
            <arc:SettingsRow Header="{l:AppLangResource SettingsUpdateChannel}"
                             settings:SettingHelp.Tip="{l:AppLangResource SettingsUpdateChannelHint}">
                <arc:Select x:Name="UpdateChannelSelect" AutoScrollToSelectedItem="False" Size="Small" Width="240"
                            AutomationProperties.Name="{l:AppLangResource SettingsUpdateChannel}"
                            IsEnabled="{Binding IsEnabled}"
                            ItemsSource="{Binding Channels}"
                            SelectedValue="{Binding Channel, Mode=TwoWay}" />
            </arc:SettingsRow>
        </arc:SettingsGroup>
        <TextBlock Classes="hint" Text="{Binding Updates.InstallNote}" IsVisible="{Binding Updates.HasInstallNote}" TextWrapping="Wrap" />

        <!-- Official links & local directories -->
        <TextBlock Classes="group" Text="{l:AppLangResource SettingsAboutLinksAndData}" Margin="0,6,0,0" />
        <StackPanel Spacing="10">
            <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                <arc:Button x:Name="OpenWebsiteButton" Variant="Secondary" Size="Small" Command="{Binding OpenWebsiteCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:LucideIcon Kind="Globe" Size="13" VerticalAlignment="Center" />
                        <TextBlock Text="{l:AppLangResource SettingsAboutWebsite}" VerticalAlignment="Center" />
                        <lucide:LucideIcon Kind="ArrowUpRight" Size="12" VerticalAlignment="Center" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    </StackPanel>
                </arc:Button>
                <arc:Button x:Name="OpenRepositoryButton" Variant="Secondary" Size="Small" Command="{Binding OpenRepositoryCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:LucideIcon Kind="Star" Size="13" VerticalAlignment="Center" Foreground="{arc:ArcDesignTokenResource Warning}" />
                        <TextBlock Text="{l:AppLangResource StarOnGitHub}" VerticalAlignment="Center" />
                        <lucide:LucideIcon Kind="ArrowUpRight" Size="12" VerticalAlignment="Center" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    </StackPanel>
                </arc:Button>
                <arc:Button x:Name="OpenChangelogButton" Variant="Secondary" Size="Small" Command="{Binding OpenChangelogCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:LucideIcon Kind="FileText" Size="13" VerticalAlignment="Center" />
                        <TextBlock Text="{l:AppLangResource SettingsAboutChangelog}" VerticalAlignment="Center" />
                        <lucide:LucideIcon Kind="ArrowUpRight" Size="12" VerticalAlignment="Center" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    </StackPanel>
                </arc:Button>
                <arc:Button x:Name="OpenIssuesButton" Variant="Secondary" Size="Small" Command="{Binding OpenIssuesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <lucide:LucideIcon Kind="Bug" Size="13" VerticalAlignment="Center" />
                        <TextBlock Text="{l:AppLangResource SettingsAboutFeedback}" VerticalAlignment="Center" />
                        <lucide:LucideIcon Kind="ArrowUpRight" Size="12" VerticalAlignment="Center" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    </StackPanel>
                </arc:Button>
            </WrapPanel>

            <arc:SettingsGroup Appearance="Plain">
                <arc:SettingsRow Header="{l:AppLangResource SettingsAboutDataDir}"
                                 Description="{Binding DataDirectory}">
                    <arc:Button x:Name="OpenDataDirButton" Variant="Secondary" Size="Small" Command="{Binding OpenDataDirectoryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:LucideIcon Kind="FolderOpen" Size="13" VerticalAlignment="Center" />
                            <TextBlock Text="{l:AppLangResource SettingsAboutOpenDir}" VerticalAlignment="Center" />
                        </StackPanel>
                    </arc:Button>
                </arc:SettingsRow>
                <arc:SettingsRow Header="{l:AppLangResource SettingsAboutCacheDir}"
                                 Description="{Binding CacheDirectory}">
                    <arc:Button x:Name="OpenCacheDirButton" Variant="Secondary" Size="Small" Command="{Binding OpenCacheDirectoryCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:LucideIcon Kind="FolderOpen" Size="13" VerticalAlignment="Center" />
                            <TextBlock Text="{l:AppLangResource SettingsAboutOpenDir}" VerticalAlignment="Center" />
                        </StackPanel>
                    </arc:Button>
                </arc:SettingsRow>
            </arc:SettingsGroup>
        </StackPanel>

        <!-- Runtime tech stack & diagnostics copy bar -->
        <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                Padding="14,10"
                Margin="0,4,0,0">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0"
                           x:Name="TechStackText"
                           Classes="mono"
                           Text="{Binding TechStackSummary}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center" />
                <arc:Button Grid.Column="1"
                            x:Name="CopyDiagnosticsButton"
                            Variant="Secondary"
                            Size="Small"
                            VerticalAlignment="Center"
                            Click="OnCopyDiagnostics">
                    <Panel>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !DiagnosticsCopied}">
                            <lucide:LucideIcon Kind="Copy" Size="13" VerticalAlignment="Center" />
                            <TextBlock Text="{l:AppLangResource SettingsAboutCopyDiagnostics}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding DiagnosticsCopied}">
                            <lucide:LucideIcon Kind="Check" Size="13" VerticalAlignment="Center" Foreground="{arc:ArcDesignTokenResource Success}" />
                            <TextBlock Text="{l:AppLangResource SettingsAboutCopied}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Panel>
                </arc:Button>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
