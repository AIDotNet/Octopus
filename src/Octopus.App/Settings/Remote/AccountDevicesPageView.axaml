<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:settings="using:Octopus.App.Settings"
             xmlns:remote="using:Octopus.App.Settings.Remote"
             x:Class="Octopus.App.Settings.Remote.AccountDevicesPageView"
             x:DataType="remote:AccountDevicesSettingsViewModel">
    <StackPanel Spacing="16">
        <StackPanel Orientation="Horizontal" Spacing="6">
            <TextBlock Classes="title" Text="{l:AppLangResource AccountDevicesTitle}" VerticalAlignment="Center" />
            <settings:SettingHelpTip Tip="{l:AppLangResource AccountDevicesSubtitle}" />
        </StackPanel>

        <!-- The account: everything below the password needs it. -->
        <arc:SettingsGroup Appearance="Plain">
            <arc:SettingsRow Header="{l:AppLangResource SettingsRemoteRelayAccount}"
                             settings:SettingHelp.Tip="{l:AppLangResource AccountDevicesAccountHint}">
                <TextBlock x:Name="AccountText" Classes="name" Text="{Binding AccountText}"
                           TextTrimming="CharacterEllipsis" MaxWidth="300" VerticalAlignment="Center" />
            </arc:SettingsRow>
            <arc:SettingsRow Header="{l:AppLangResource SettingsRemoteRelayHost}"
                             settings:SettingHelp.Tip="{l:AppLangResource AccountDevicesRelayHostHint}"
                             IsVisible="{Binding IsSignedIn}">
                <arc:Switch x:Name="RelayHostSwitch" IsChecked="{Binding RelayHostEnabled, Mode=TwoWay}" />
            </arc:SettingsRow>
        </arc:SettingsGroup>
        <arc:Alert Tone="Info" Content="{l:AppLangResource AccountDevicesSignInHint}" IsVisible="{Binding !IsSignedIn}" />
        <arc:Alert Tone="Warning" Content="{l:AppLangResource AccountDevicesRelayOff}" IsVisible="{Binding ShowRelayOffHint}" />

        <!-- This computer's access password. -->
        <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,8,0,0">
            <TextBlock Classes="group" Text="{l:AppLangResource AccountDevicesPasswordGroup}" VerticalAlignment="Center" />
            <settings:SettingHelpTip Tip="{l:AppLangResource AccountDevicesPasswordGroupHint}" />
        </StackPanel>
        <arc:SettingsGroup Appearance="Plain">
            <arc:SettingsRow Header="{l:AppLangResource AccountDevicesPasswordAccess}"
                             settings:SettingHelp.Tip="{l:AppLangResource AccountDevicesPasswordAccessHint}">
                <arc:Switch x:Name="PasswordAccessSwitch" IsChecked="{Binding PasswordAccessEnabled, Mode=TwoWay}" />
            </arc:SettingsRow>
            <arc:SettingsRow Header="{l:AppLangResource AccountDevicesPassword}"
                             Description="{Binding PasswordDevicesText}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <SelectableTextBlock x:Name="PasswordText" Text="{Binding PasswordText}"
                                         FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                         FontSize="18" FontWeight="SemiBold" MinWidth="110" VerticalAlignment="Center" />
                    <arc:Button x:Name="RevealButton" Variant="Ghost" Size="Small"
                                Content="{Binding RevealText}" Command="{Binding ToggleRevealCommand}" />
                    <arc:Button x:Name="CopyPasswordButton" Variant="Secondary" Size="Small" Click="OnCopyPassword">
                        <Panel>
                            <TextBlock Text="{l:AppLangResource SettingsRemoteCopy}" IsVisible="{Binding !Copied}" />
                            <TextBlock Text="{l:AppLangResource AccountDevicesCopied}" IsVisible="{Binding Copied}" />
                        </Panel>
                    </arc:Button>
                </StackPanel>
            </arc:SettingsRow>
            <arc:SettingsRow Header="{l:AppLangResource AccountDevicesChange}"
                             settings:SettingHelp.Tip="{l:AppLangResource AccountDevicesChangeHint}">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <arc:Button x:Name="RegenerateButton" Variant="Secondary" Size="Small"
                                Content="{l:AppLangResource AccountDevicesRegenerate}" Command="{Binding RegeneratePasswordCommand}" />
                    <arc:Button x:Name="EditPasswordButton" Variant="Secondary" Size="Small"
                                IsVisible="{Binding !IsEditingPassword}"
                                Content="{l:AppLangResource AccountDevicesEdit}" Command="{Binding BeginEditPasswordCommand}" />
                </StackPanel>
            </arc:SettingsRow>
        </arc:SettingsGroup>

        <!-- Choosing a password: eight letters and digits, checked before it is kept. -->
        <Border x:Name="EditPasswordPanel"
                IsVisible="{Binding IsEditingPassword}"
                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                Padding="14,12">
            <StackPanel Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <arc:Input x:Name="NewPasswordInput" Size="Small"
                               AutomationProperties.Name="{l:AppLangResource AccountDevicesNewPassword}"
                               PlaceholderText="{l:AppLangResource AccountDevicesNewPasswordPlaceholder}"
                               MaxLength="12"
                               Text="{Binding NewPassword, Mode=TwoWay}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <arc:Button x:Name="SavePasswordButton" Variant="Primary" Size="Small"
                                    Content="{l:AppLangResource AccountDevicesSave}" Command="{Binding SavePasswordCommand}" />
                        <arc:Button Variant="Ghost" Size="Small"
                                    Content="{l:AppLangResource SettingsRemoteRelayCancel}" Command="{Binding CancelEditPasswordCommand}" />
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="PasswordErrorText" Classes="hint" Foreground="{arc:ArcDesignTokenResource Danger}"
                           Text="{Binding PasswordErrorText}" IsVisible="{Binding HasPasswordError}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <arc:Checkbox x:Name="RevokeOnChangeCheckbox" IsChecked="{Binding RevokeOnChange, Mode=TwoWay}"
                      Content="{l:AppLangResource AccountDevicesRevokeOnChange}" />
        <arc:Alert Tone="Danger" IsVisible="{Binding IsSuspended}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <TextBlock Text="{l:AppLangResource AccountDevicesSuspended}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <arc:Button x:Name="ResumeButton" Grid.Column="1" Variant="Secondary" Size="Small"
                            Content="{l:AppLangResource AccountDevicesResume}" Command="{Binding ResumePasswordAccessCommand}" />
            </Grid>
        </arc:Alert>

        <!-- Every device of the account. -->
        <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                <TextBlock Classes="group" Text="{l:AppLangResource AccountDevicesList}" VerticalAlignment="Center" />
                <settings:SettingHelpTip Tip="{l:AppLangResource AccountDevicesListHint}" IsVisible="{Binding IsSignedIn}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsSignedIn}">
                <arc:ArcSpinner Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding IsLoadingDevices}" />
                <arc:Button x:Name="RefreshDevicesButton" Variant="Ghost" Size="Small"
                            Content="{l:AppLangResource AccountDevicesRefresh}" Command="{Binding RefreshDevicesCommand}" />
            </StackPanel>
        </Grid>
        <arc:Alert Tone="Danger" Content="{Binding DevicesErrorText}" IsVisible="{Binding HasDevicesError}" />
        <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                BorderThickness="1"
                CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                ClipToBounds="True"
                IsVisible="{Binding HasDevices}">
            <ItemsControl x:Name="AccountDeviceList" ItemsSource="{Binding Devices}" Margin="0,-1,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="remote:AccountDeviceRow">
                        <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="0,1,0,0" Padding="14,10">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" Opacity="{Binding RowOpacity}">
                                    <Panel VerticalAlignment="Center">
                                        <lucide:LucideIcon Kind="Monitor" Size="16" IsVisible="{Binding !IsPhone}"
                                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                        <lucide:LucideIcon Kind="Smartphone" Size="16" IsVisible="{Binding IsPhone}"
                                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                    </Panel>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                                            <arc:Badge Size="Small" Tone="Neutral" Content="{l:AppLangResource AccountDevicesThisComputer}" IsVisible="{Binding IsSelf}" VerticalAlignment="Center" />
                                            <arc:Badge Size="Small" Tone="Success" Content="{l:AppLangResource AccountDevicesOnline}" IsVisible="{Binding IsOnline}" VerticalAlignment="Center" />
                                            <arc:Badge Size="Small" Tone="Info" Content="{l:AppLangResource AccountDevicesAuthorized}" IsVisible="{Binding IsAuthorized}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Classes="hint" Text="{Binding Details}" IsVisible="{Binding HasDetails}" />
                                    </StackPanel>
                                    <Panel Grid.Column="2" VerticalAlignment="Center">
                                        <arc:Button Variant="Primary" Size="Small"
                                                    IsVisible="{Binding ShowEnterButton}"
                                                    Content="{l:AppLangResource AccountDevicesEnterPassword}"
                                                    Command="{Binding BeginEnteringCommand}" />
                                        <TextBlock Classes="hint" IsVisible="{Binding NeedsPairing}" MaxWidth="220" TextWrapping="Wrap"
                                                   Text="{l:AppLangResource AccountDevicesNeedsPairing}" />
                                    </Panel>
                                </Grid>

                                <!-- The password of that computer, typed once. -->
                                <Border IsVisible="{Binding IsEntering}"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                                        Padding="12,10">
                                    <StackPanel Spacing="6">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <arc:Input Size="Small" MaxLength="12"
                                                       AutomationProperties.Name="{l:AppLangResource AccountDevicesPassword}"
                                                       PlaceholderText="XXXX-XXXX"
                                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                       Text="{Binding Password, Mode=TwoWay}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                                <arc:ArcSpinner Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding IsConnecting}" />
                                                <arc:Button Variant="Primary" Size="Small" IsEnabled="{Binding CanSubmit}"
                                                            Content="{l:AppLangResource AccountDevicesConnect}" Command="{Binding SubmitCommand}" />
                                                <arc:Button Variant="Ghost" Size="Small"
                                                            Content="{l:AppLangResource SettingsRemoteRelayCancel}" Command="{Binding CancelEnteringCommand}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Classes="hint" Text="{l:AppLangResource AccountDevicesEnterHint}" TextWrapping="Wrap" IsVisible="{Binding !HasError}" />
                                        <TextBlock Classes="hint" Foreground="{arc:ArcDesignTokenResource Danger}"
                                                   Text="{Binding ErrorText}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </StackPanel>
</UserControl>
