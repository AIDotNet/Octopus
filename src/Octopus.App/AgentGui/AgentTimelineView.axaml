<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:common="using:Octopus.App.Common"
             xmlns:gui="using:Octopus.App.AgentGui"
             xmlns:ticker="using:Octopus.Ticker"
             x:Class="Octopus.App.AgentGui.AgentTimelineView"
             x:Name="RootControl">
    <UserControl.Styles>
        <Style Selector="Border.diffLine">
            <Setter Property="Padding" Value="6,1" />
        </Style>
        <Style Selector="Border.diffLine.add">
            <Setter Property="Background" Value="#1E22C55E" />
        </Style>
        <Style Selector="Border.diffLine.remove">
            <Setter Property="Background" Value="#1EEF4444" />
        </Style>
        <Style Selector="TextBlock.diffText">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="SelectableTextBlock.diffText">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <Style Selector="Border.diffLine.add TextBlock.diffText, Border.diffLine.add SelectableTextBlock.diffText">
            <Setter Property="Foreground" Value="#16A34A" />
        </Style>
        <Style Selector="Border.diffLine.remove TextBlock.diffText, Border.diffLine.remove SelectableTextBlock.diffText">
            <Setter Property="Foreground" Value="#DC2626" />
        </Style>

        <!-- Zero-card pure-text unified work area styles (Scheme C) -->
        <Style Selector="Button.workHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="Center" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.workHeader:pointerover TextBlock.workTitle">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="Button.workHeader:pointerover TextBlock.workCounts">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>

        <Style Selector="Button.workStep">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Padding="{TemplateBinding Padding}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="Center" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.workStep:pointerover TextBlock.stepTarget">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>

        <Style Selector="Button.textLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalContentAlignment="Center" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.textLink:pointerover">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="Button.textLink.accent">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>

        <Style Selector="TextBlock.tickerVerb">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.tickerVerb.failed">
            <Setter Property="Foreground" Value="#DC2626" />
        </Style>
        <Style Selector="ticker|TickerTargetText.tickerTarget">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="ticker|TickerTargetText.tickerTarget:not(.thought)">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="ticker|TickerTargetText.tickerTarget.failed">
            <Setter Property="Foreground" Value="#DC2626" />
        </Style>

        <Style Selector="TextBlock.stepMark">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.stepMark.failed">
            <Setter Property="Foreground" Value="#DC2626" />
        </Style>
        <Style Selector="TextBlock.stepVerb">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="TextBlock.stepVerb.failed">
            <Setter Property="Foreground" Value="#DC2626" />
        </Style>
        <Style Selector="TextBlock.stepTarget">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="MaxLines" Value="1" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.stepTarget:not(.thought)">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.stepTarget.failed">
            <Setter Property="Foreground" Value="#DC2626" />
        </Style>

        <!-- User turn hover-revealed quick actions (shown below the bubble) -->
        <Style Selector="StackPanel.userTurn StackPanel.turnActions">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.userTurn:pointerover StackPanel.turnActions, StackPanel.userTurn:focus-within StackPanel.turnActions">
            <Setter Property="Opacity" Value="0.88" />
        </Style>

        <!-- Smooth rotating chevron -->
        <Style Selector="lucide|LucideIcon.chevron">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="lucide|LucideIcon.chevron.open">
            <Setter Property="RenderTransform" Value="rotate(90deg)" />
        </Style>

        <!-- Permission card smooth resolve exit -->
        <Style Selector="Border.permCard">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.16" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.permCard.resolved">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="RenderTransform" Value="scale(0.97)" />
        </Style>

        <!-- Question card resolved tone transition -->
        <Style Selector="Border.questionCard">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource AccentStrong}" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.questionCard.resolved">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        </Style>

        <!-- Choice chips inside interactive questions -->
        <Style Selector="Button.chipChoice">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.97)" />
            </Style>
        </Style>
        <Style Selector="Button.chipChoice.selected">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
    </UserControl.Styles>

    <UserControl.DataTemplates>
        <!-- Scheme C: Single fixed slot inside the 5-line sliding live ticker (pure text, zero card) -->
        <DataTemplate DataType="gui:WorkTickerLineViewModel">
            <Grid IsVisible="{Binding IsVisible}"
                  ColumnDefinitions="14,Auto,*,Auto"
                  ColumnSpacing="6"
                  Margin="0,1">
                <Panel Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center">
                    <arc:ArcSpinner Width="10" Height="10" IsVisible="{Binding IsRunning}" VerticalAlignment="Center" />
                    <TextBlock Text="✓" FontSize="10.5" Foreground="{arc:ArcDesignTokenResource TextMuted}"
                               IsVisible="{Binding IsCompleted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBlock Text="✕" FontSize="10.5" Foreground="#DC2626"
                               IsVisible="{Binding IsFailed}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Panel>
                <TextBlock Grid.Column="1"
                           Classes="tickerVerb"
                           Classes.failed="{Binding IsFailed}"
                           Text="{Binding Verb}"
                           VerticalAlignment="Center" />
                <ticker:TickerTargetText Grid.Column="2"
                                         Classes="tickerTarget"
                                         Classes.thought="{Binding IsThought}"
                                         Classes.failed="{Binding IsFailed}"
                                         Text="{Binding Target}"
                                         StepKey="{Binding StepKey}"
                                         AnimateUpdates="{Binding IsActiveThought}"
                                         VerticalAlignment="Center" />
                <TextBlock Grid.Column="3"
                           IsVisible="{Binding HasStat}"
                           Text="{Binding StatText}"
                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                           FontSize="11"
                           Foreground="{arc:ArcDesignTokenResource TextMuted}"
                           VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>

        <!-- Scheme C: Fixed 5-slot sliding live ticker container (mounted ONLY while streaming & collapsed) -->
        <DataTemplate DataType="gui:WorkTickerViewModel">
            <ticker:WorkTickerViewport Margin="15,2,0,0" Spacing="1" />
        </DataTemplate>

        <!-- Lazy pure-text tool detail template (mounted ONLY when user clicks a tool step row; zero cards) -->
        <DataTemplate DataType="gui:ToolCallItemViewModel">
            <StackPanel Spacing="4">
                <!-- Inline pure-text action strip (script modal / diff / open file / copy) -->
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock IsVisible="{Binding HasExitCode}"
                               Text="{Binding ExitCodeText}"
                               FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                               FontSize="11"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                               VerticalAlignment="Center" />
                    <TextBlock IsVisible="{Binding ShowLinesBadge}"
                               Text="{Binding LinesCollapsedText}"
                               FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                               FontSize="11"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                               VerticalAlignment="Center" />
                    <Button Classes="textLink accent"
                            IsVisible="{Binding CanOpenScriptPreview}"
                            Command="{Binding OpenScriptPreviewCommand}"
                            Content="{l:AppLangResource AgentGuiBashViewFullScript}" />
                    <Button Classes="textLink"
                            IsVisible="{Binding CanOpenDiff}"
                            Command="{Binding OpenDiffCommand}"
                            Content="{l:AppLangResource AgentGuiOpenDiff}" />
                    <Button Classes="textLink"
                            IsVisible="{Binding CanOpenFile}"
                            Command="{Binding OpenFileCommand}"
                            Content="{l:AppLangResource AgentGuiOpenFile}" />
                    <arc:CopyButton IsIconOnly="True"
                                    IsVisible="{Binding HasDetails}"
                                    VerticalAlignment="Center"
                                    Value="{Binding CopyableOutput}"
                                    AutomationProperties.Name="{l:AppLangResource AgentGuiCopyOutput}"
                                    arc:Tooltip.Tip="{l:AppLangResource AgentGuiCopyOutput}" />
                </StackPanel>

                <!-- Pure-text command preview (1 line for large scripts, wrapped up to 76px for short commands) -->
                <TextBlock IsVisible="{Binding IsLargeCommand}"
                           Text="{Binding SingleLineCommandPreview, StringFormat='$ {0}'}"
                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                           FontSize="11.5"
                           MaxLines="1"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                <arc:ScrollArea IsVisible="{Binding IsCompactCommand}" MaxHeight="76" Orientation="Vertical" FadeLength="0">
                    <SelectableTextBlock Text="{Binding CommandText, StringFormat='$ {0}'}"
                                         FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                         FontSize="11.5"
                                         TextWrapping="Wrap"
                                         Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                </arc:ScrollArea>

                <arc:ScrollArea MaxHeight="220" Orientation="Vertical" FadeLength="0">
                    <StackPanel Spacing="3">
                        <SelectableTextBlock IsVisible="{Binding HasInputSummary}"
                                             Text="{Binding InputSummary}"
                                             FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                             FontSize="11.5"
                                             TextWrapping="Wrap"
                                             Foreground="{arc:ArcDesignTokenResource TextMuted}" />

                        <StackPanel IsVisible="{Binding IsRunningWithoutOutput}"
                                    Orientation="Horizontal" Spacing="6">
                            <arc:ArcSpinner Width="10" Height="10" VerticalAlignment="Center" />
                            <TextBlock Classes="hint" Text="{Binding StatusText}" VerticalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding DiffLines}" IsVisible="{Binding HasDiff}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="gui:DiffLineViewModel">
                                    <Border Classes="diffLine" Classes.add="{Binding IsAdd}" Classes.remove="{Binding IsRemove}">
                                        <Grid ColumnDefinitions="14,*">
                                            <TextBlock Classes="diffText" Text="{Binding Prefix}" Opacity="0.7" />
                                            <SelectableTextBlock Grid.Column="1" Classes="diffText" Text="{Binding Text}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <SelectableTextBlock IsVisible="{Binding HasStdout}"
                                             Text="{Binding Stdout}"
                                             FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                             FontSize="11.5"
                                             TextWrapping="Wrap"
                                             Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        <SelectableTextBlock IsVisible="{Binding HasStderr}"
                                             Text="{Binding Stderr}"
                                             FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                             FontSize="11.5"
                                             TextWrapping="Wrap"
                                             Foreground="#DC2626" />
                        <SelectableTextBlock IsVisible="{Binding HasOutputText}"
                                             Text="{Binding OutputText}"
                                             FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                             FontSize="11.5"
                                             TextWrapping="Wrap"
                                             Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                    </StackPanel>
                </arc:ScrollArea>
            </StackPanel>
        </DataTemplate>

        <!-- One pure-text step row inside the expanded unified work area (zero card; lazy-mounts details on click) -->
        <DataTemplate DataType="gui:WorkStepViewModel">
            <StackPanel Spacing="0">
                <Button Classes="workStep"
                        Command="{Binding ToggleExpandedCommand}"
                        IsHitTestVisible="{Binding CanExpand}">
                    <Grid ColumnDefinitions="14,*,Auto,Auto" ColumnSpacing="7">
                        <Panel Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center">
                            <arc:ArcSpinner Width="10" Height="10" IsVisible="{Binding IsRunning}" VerticalAlignment="Center" />
                            <TextBlock Classes="stepMark"
                                       Classes.failed="{Binding IsFailed}"
                                       IsVisible="{Binding !IsRunning}"
                                       Text="{Binding StatusMark}" />
                        </Panel>
                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0"
                                       Classes="stepVerb"
                                       Classes.failed="{Binding IsFailed}"
                                       IsVisible="{Binding HasVerb}"
                                       Margin="0,0,7,0"
                                       Text="{Binding Verb}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Classes="stepTarget"
                                       Classes.thought="{Binding IsProse}"
                                       Classes.failed="{Binding IsFailed}"
                                       Text="{Binding Target}"
                                       VerticalAlignment="Center" />
                        </Grid>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock IsVisible="{Binding HasAddedStats}"
                                       Text="{Binding AddedStatsText}"
                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                       FontSize="11" Foreground="#16A34A" />
                            <TextBlock IsVisible="{Binding HasRemovedStats}"
                                       Text="{Binding RemovedStatsText}"
                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                       FontSize="11" Foreground="#DC2626" />
                        </StackPanel>
                        <TextBlock Grid.Column="3"
                                   IsVisible="{Binding HasMeta}"
                                   Text="{Binding MetaText}"
                                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                   FontSize="11"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                   Opacity="0.78"
                                   VerticalAlignment="Center" />
                    </Grid>
                </Button>

                <!-- Lazy pure-text detail pane: null when collapsed so zero controls exist until clicked -->
                <ContentControl Content="{Binding ExpandedDetail}">
                    <ContentControl.ContentTemplate>
                        <DataTemplate x:DataType="gui:WorkStepViewModel">
                            <Border BorderBrush="{arc:ArcDesignTokenResource Border}"
                                    BorderThickness="1,0,0,0"
                                    Margin="16,2,0,6"
                                    Padding="10,2,0,2">
                                <StackPanel Spacing="4">
                                    <!-- Thought step pure-text prose -->
                                    <arc:ScrollArea Classes="thoughtScroll"
                                                    IsVisible="{Binding IsThought}"
                                                    MaxHeight="220"
                                                    Orientation="Vertical"
                                                    FadeLength="0">
                                        <SelectableTextBlock Text="{Binding ThoughtText}"
                                                             TextWrapping="Wrap"
                                                             FontSize="12"
                                                             LineHeight="18"
                                                             Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                    </arc:ScrollArea>

                                    <!-- Intermediate text step (folded into work area) -->
                                    <arc:ScrollArea IsVisible="{Binding IsText}"
                                                    MaxHeight="220"
                                                    Orientation="Vertical"
                                                    FadeLength="0">
                                        <arc:Markdown Text="{Binding NoteText}" />
                                    </arc:ScrollArea>

                                    <!-- Plan step pure-text checklist -->
                                    <StackPanel IsVisible="{Binding IsPlan}" Spacing="3">
                                        <ItemsControl ItemsSource="{Binding PlanEntries}" IsVisible="{Binding HasPlanEntries}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="gui:PlanEntryViewModel">
                                                    <Grid ColumnDefinitions="14,*" ColumnSpacing="6">
                                                        <TextBlock Text="{Binding StatusMark}" FontSize="11"
                                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Content}" FontSize="12"
                                                                   TextWrapping="Wrap" Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <arc:Markdown IsVisible="{Binding HasPlanMarkdown}" Text="{Binding PlanMarkdown}" />
                                    </StackPanel>

                                    <!-- Tool step pure-text detail (lazy-bound via ToolCallItemViewModel DataTemplate) -->
                                    <ContentControl IsVisible="{Binding IsTool}" Content="{Binding Tool}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ContentControl.ContentTemplate>
                </ContentControl>
            </StackPanel>
        </DataTemplate>

        <!-- Claude Code ExitPlanMode interactive Plan Approval strip (lightweight left-accent, no heavy card) -->
        <DataTemplate DataType="gui:PlanApprovalCardItem">
            <Border Classes="questionCard"
                    Classes.resolved="{Binding IsResolved}"
                    Margin="0,2,0,6"
                    BorderThickness="2,0,0,0"
                    Padding="10,4,0,4">
                <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold"
                                   FontSize="{arc:ArcDesignTokenResource TypeSM}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" FontSize="11.5" Foreground="#16A34A"
                                   Text="{Binding ResolvedSummary}" IsVisible="{Binding IsResolved}" VerticalAlignment="Center" />
                    </Grid>
                    <arc:ScrollArea IsVisible="{Binding HasPlanMarkdown}" MaxHeight="220" Orientation="Vertical" FadeLength="0">
                        <arc:Markdown Text="{Binding PlanMarkdown}" />
                    </arc:ScrollArea>
                    <common:SmoothCollapse IsExpanded="{Binding !IsResolved}" LazyData="{Binding}">
                        <common:SmoothCollapse.ContentTemplate>
                            <DataTemplate x:DataType="gui:PlanApprovalCardItem">
                                <StackPanel Spacing="6">
                                    <Grid IsVisible="{Binding IsFeedbackOpen}" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <arc:Input Size="Small" IsLabelVisible="False"
                                                   Placeholder="{l:AppLangResource AgentGuiPlanRevisePlaceholder}"
                                                   Text="{Binding FeedbackText, Mode=TwoWay}" />
                                        <arc:Button Grid.Column="1" Size="Small"
                                                    Content="{l:AppLangResource AgentGuiPlanReviseSend}"
                                                    Command="{Binding SubmitFeedbackCommand}" />
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <ItemsControl ItemsSource="{Binding Actions}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="gui:PermissionActionViewModel">
                                                    <arc:Button Margin="0,0,5,2" Size="Small"
                                                                Variant="{Binding Variant}"
                                                                Content="{Binding Label}"
                                                                Command="{Binding ChooseCommand}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <arc:Button Size="Small" Variant="Secondary"
                                                    Content="{l:AppLangResource AgentGuiPlanReviseToggle}"
                                                    Command="{Binding ToggleFeedbackCommand}" />
                                        <arc:Button Size="Small" Variant="Ghost"
                                                    Content="{l:AppLangResource AgentGuiPermissionCancel}"
                                                    Command="{Binding CancelCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </common:SmoothCollapse.ContentTemplate>
                    </common:SmoothCollapse>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- User turn: compact right-aligned quiet capsule with hover-revealed edit-resend & copy below -->
        <DataTemplate DataType="gui:UserTurnItem">
            <StackPanel Classes="userTurn"
                        Background="Transparent"
                        HorizontalAlignment="Right"
                        MaxWidth="640"
                        Margin="28,2,0,0"
                        Spacing="2">
                <Border Classes="userBubble"
                        HorizontalAlignment="Right"
                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="9"
                        Padding="10,6">
                    <StackPanel Spacing="4">
                        <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="gui:AttachmentChipViewModel">
                                    <Border Margin="0,0,4,2" Padding="5,1" CornerRadius="5"
                                            Background="{arc:ArcDesignTokenResource Surface}"
                                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <lucide:LucideIcon Kind="{Binding Icon}" Size="11" VerticalAlignment="Center" />
                                            <TextBlock Classes="hint" Text="{Binding Label}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Spacing="2">
                            <SelectableTextBlock Text="{Binding DisplayText}"
                                                 TextWrapping="Wrap"
                                                 FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                                 LineHeight="19"
                                                 Foreground="{arc:ArcDesignTokenResource Foreground}" />
                            <Button Classes="textLink accent"
                                    HorizontalAlignment="Left"
                                    IsVisible="{Binding IsCollapsible}"
                                    Command="{Binding ToggleExpandedCommand}"
                                    Content="{Binding ToggleExpandedText}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
                <StackPanel Classes="turnActions"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Spacing="2">
                    <arc:Button Classes="icon" Variant="Ghost"
                                VerticalAlignment="Center"
                                IsVisible="{Binding CanReuse}"
                                Command="{Binding ReuseCommand}"
                                AutomationProperties.Name="{l:AppLangResource AgentGuiReusePrompt}"
                                arc:Tooltip.Tip="{l:AppLangResource AgentGuiReusePrompt}">
                        <lucide:LucideIcon Kind="Pencil" Size="11" />
                    </arc:Button>
                    <arc:CopyButton IsIconOnly="True"
                                    VerticalAlignment="Center"
                                    Value="{Binding Text}"
                                    AutomationProperties.Name="{l:AppLangResource AgentGuiCopyPrompt}"
                                    arc:Tooltip.Tip="{l:AppLangResource AgentGuiCopyPrompt}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- Inline ACP image generation canvas rendered with TKCode.Arc ImageReveal -->
        <DataTemplate DataType="gui:ImageGenerationItemViewModel">
            <StackPanel Spacing="4" MaxWidth="420" HorizontalAlignment="Left">
                <arc:ImageReveal Source="{Binding Source}"
                                 Status="{Binding RevealStatus}"
                                 Progress="{Binding Progress}"
                                 AspectRatio="{Binding AspectRatio}"
                                 AltText="{Binding AltText}"
                                 ErrorMessage="{Binding ErrorMessage}"
                                 AllowsRetry="False"
                                 Seed="{Binding Seed}"
                                 Duration="0:0:12"
                                 Labels="{Binding Labels}"
                                 MaxWidth="420" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBlock Grid.Column="0"
                               IsVisible="{Binding HasPrompt}"
                               Text="{Binding Prompt}"
                               FontSize="11.5"
                               MaxLines="2"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                               arc:Tooltip.Tip="{Binding Prompt}"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="1"
                            Classes="textLink accent"
                            IsVisible="{Binding CanOpenImage}"
                            Command="{Binding OpenImageCommand}"
                            Content="{l:AppLangResource AgentGuiImageOpen}"
                            VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </DataTemplate>

        <!-- Single Markdown response block (frozen paragraphs + active streaming tail) -->
        <DataTemplate DataType="gui:MarkdownBlockViewModel">
            <StackPanel Spacing="6">
                <ItemsControl ItemsSource="{Binding FrozenChunks}" IsVisible="{Binding HasFrozenChunks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <arc:Markdown Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <arc:Markdown IsVisible="{Binding HasLiveText}" Text="{Binding LiveText}" />
            </StackPanel>
        </DataTemplate>

        <!-- Assistant turn (Scheme C): One unified zero-card pure-text Work Area + clean Markdown response -->
        <DataTemplate DataType="gui:AssistantTurnItem">
            <StackPanel Margin="0,2,0,8" Spacing="8">
                <!-- Single Unified Pure-Text Work Area (collapsed to 1 line on finish; fixed 5-line sliding ticker while running) -->
                <StackPanel IsVisible="{Binding HasWorkArea}" Spacing="2">
                    <Button Classes="workHeader"
                            Command="{Binding ToggleWorkExpandedCommand}"
                            IsHitTestVisible="{Binding CanExpandWork}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                            <lucide:LucideIcon Grid.Column="0"
                                               Classes="chevron"
                                               Classes.open="{Binding IsWorkExpanded}"
                                               Kind="ChevronRight"
                                               Size="11"
                                               IsVisible="{Binding CanExpandWork}"
                                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                               VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Classes="workTitle"
                                       Text="{Binding WorkHeaderTitle}"
                                       FontSize="12.5"
                                       FontWeight="Medium"
                                       Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2"
                                       Classes="workCounts"
                                       IsVisible="{Binding HasWorkHeaderCounts}"
                                       Text="{Binding WorkHeaderCounts}"
                                       FontSize="12"
                                       MaxLines="1"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3"
                                       IsVisible="{Binding HasWorkFailures}"
                                       Text="{Binding WorkHeaderFailedText}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="#DC2626"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="4"
                                       IsVisible="{Binding ShowWaitingBadge}"
                                       Text="{l:AppLangResource AgentGuiWorkWaiting}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{arc:ArcDesignTokenResource Warning}"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="5"
                                       IsVisible="{Binding HasWorkHeaderDuration}"
                                       Text="{Binding WorkHeaderDurationText}"
                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                       FontSize="11.5"
                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                       Opacity="0.78"
                                       VerticalAlignment="Center" />
                        </Grid>
                    </Button>

                    <!-- Scheme C fixed 5-line sliding pure-text ticker (null & unmounted once finished or expanded) -->
                    <ContentControl Content="{Binding LiveTicker}" />

                    <!-- Lazy-mounted full pure-text step log (null & unmounted when collapsed) -->
                    <Border IsVisible="{Binding IsWorkExpanded}"
                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                            BorderThickness="1.5,0,0,0"
                            Margin="5,2,0,2"
                            Padding="12,1,0,1">
                        <ItemsControl ItemsSource="{Binding ExpandedWorkSteps}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </StackPanel>

                <!-- Inline generated images rendered via TKCode.Arc ImageReveal -->
                <ItemsControl ItemsSource="{Binding GeneratedImages}" IsVisible="{Binding HasGeneratedImages}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="10" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <!-- Clean Final Markdown Response directly below the unified work area -->
                <ContentControl Content="{Binding ResponseMarkdown}" IsVisible="{Binding HasMarkdown}" />

                <!-- Unobtrusive copy action once response finishes -->
                <StackPanel IsVisible="{Binding CanCopyReply}"
                            Orientation="Horizontal"
                            Spacing="4"
                            Margin="0,-4,0,0"
                            Opacity="0.65">
                    <arc:CopyButton IsIconOnly="True"
                                    Value="{Binding CopyReplyValue}"
                                    AutomationProperties.Name="{l:AppLangResource AgentGuiCopyReply}"
                                    arc:Tooltip.Tip="{l:AppLangResource AgentGuiCopyReply}" />
                </StackPanel>

                <!-- Reassuring live loading status & rotating i18n whimsical phrases at the bottom while working -->
                <Border Classes="liveStatusBar"
                        IsVisible="{Binding ShowLiveStatus}"
                        HorizontalAlignment="Left"
                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                        CornerRadius="6"
                        Padding="8,4"
                        Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <arc:ArcSpinner Width="11" Height="11" VerticalAlignment="Center" />
                        <arc:TextShimmer FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                         Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                         Text="{Binding LiveStatusText}"
                                         IsActive="{Binding ShowLiveStatus}"
                                         VerticalAlignment="Center" />
                        <TextBlock IsVisible="{Binding HasLiveElapsed}"
                                   Classes="hint"
                                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                   Text="{Binding LiveElapsedText}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Lightweight compaction & non-normal stopReason notices -->
                <Border IsVisible="{Binding HasCompactionNotice}"
                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                        BorderThickness="2,0,0,0"
                        Padding="10,2,0,2">
                    <TextBlock Text="{Binding CompactionNotice}"
                               FontSize="11.5"
                               TextWrapping="Wrap"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                </Border>
                <Border IsVisible="{Binding HasStopReasonNotice}"
                        BorderBrush="{arc:ArcDesignTokenResource Warning}"
                        BorderThickness="2,0,0,0"
                        Padding="10,2,0,2">
                    <TextBlock Text="{Binding StopReasonNotice}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{arc:ArcDesignTokenResource Warning}" />
                </Border>

                <!-- Lightweight pure-text error notice -->
                <Border IsVisible="{Binding HasError}"
                        BorderBrush="#DC2626"
                        BorderThickness="2,0,0,0"
                        Padding="10,2,0,2">
                    <SelectableTextBlock Text="{Binding ErrorText}"
                                         FontSize="12.5"
                                         TextWrapping="Wrap"
                                         Foreground="#DC2626" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Interactive Permission Approval Strip (lightweight left-accent, glides away once resolved) -->
        <DataTemplate DataType="gui:PermissionCardItem">
            <common:SmoothCollapse IsExpanded="{Binding !IsResolved}">
                <Border Classes="permCard"
                        Classes.resolved="{Binding IsResolved}"
                        Margin="0,2,0,6"
                        BorderBrush="{arc:ArcDesignTokenResource Warning}"
                        BorderThickness="2,0,0,0"
                        Padding="10,3,0,3">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="{arc:ArcDesignTokenResource TypeSM}"
                                   MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                        <arc:ScrollArea IsVisible="{Binding HasActionDetail}" MaxHeight="84" Orientation="Vertical" FadeLength="0">
                            <SelectableTextBlock Text="{Binding ActionDetail}"
                                                 FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                 FontSize="11.5"
                                                 TextWrapping="Wrap"
                                                 Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                        </arc:ScrollArea>
                        <TextBlock IsVisible="{Binding HasWarning}"
                                   Text="{Binding WarningMessage}"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}" TextWrapping="Wrap"
                                   Foreground="{arc:ArcDesignTokenResource Warning}" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <ItemsControl ItemsSource="{Binding Actions}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="gui:PermissionActionViewModel">
                                        <arc:Button Margin="0,0,5,2" Size="Small"
                                                    Variant="{Binding Variant}"
                                                    Content="{Binding Label}"
                                                    Command="{Binding ChooseCommand}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <arc:Button Size="Small" Variant="Ghost"
                                        Content="{l:AppLangResource AgentGuiPermissionCancel}"
                                        Command="{Binding CancelCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </common:SmoothCollapse>
        </DataTemplate>

        <!-- Interactive Elicitation / Question Strip (lightweight left-accent, no heavy card) -->
        <DataTemplate DataType="gui:QuestionCardItem">
            <Border Classes="questionCard"
                    Classes.resolved="{Binding IsResolved}"
                    Margin="0,2,0,6"
                    BorderThickness="2,0,0,0"
                    Padding="10,3,0,3">
                <StackPanel Spacing="0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="{arc:ArcDesignTokenResource TypeSM}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" FontSize="11.5" Foreground="#16A34A"
                                   Text="{Binding ResolvedSummary}" IsVisible="{Binding IsResolved}" VerticalAlignment="Center" />
                    </Grid>
                    <common:SmoothCollapse IsExpanded="{Binding !IsResolved}" LazyData="{Binding}">
                        <common:SmoothCollapse.ContentTemplate>
                            <DataTemplate x:DataType="gui:QuestionCardItem">
                                <StackPanel Margin="0,6,0,0" Spacing="7">
                                    <ItemsControl ItemsSource="{Binding Fields}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="7" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="gui:QuestionFieldViewModel">
                                                <StackPanel Spacing="4">
                                                    <TextBlock Classes="body" Text="{Binding Prompt}" TextWrapping="Wrap" />
                                                    <ItemsControl ItemsSource="{Binding Choices}" IsVisible="{Binding HasChoices}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel Orientation="Horizontal" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="gui:QuestionChoiceViewModel">
                                                                <Button Classes="chipChoice" Classes.selected="{Binding IsSelected}"
                                                                        Margin="0,0,5,4" Command="{Binding ToggleCommand}">
                                                                    <StackPanel Spacing="1">
                                                                        <TextBlock Classes="body" FontSize="{arc:ArcDesignTokenResource TypeXS}" Text="{Binding Label}" FontWeight="Medium" />
                                                                        <TextBlock Classes="hint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" />
                                                                    </StackPanel>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <arc:Input IsVisible="{Binding AllowFreeText}"
                                                               Size="Small"
                                                               IsLabelVisible="False"
                                                               Label="{Binding Prompt}"
                                                               Placeholder="{Binding Prompt}"
                                                               Text="{Binding FreeText, Mode=TwoWay}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <arc:Button Size="Small"
                                                    Content="{l:AppLangResource AgentGuiQuestionSubmit}"
                                                    Command="{Binding SubmitCommand}" />
                                        <arc:Button Size="Small" Variant="Secondary"
                                                    Content="{l:AppLangResource AgentGuiQuestionDecline}"
                                                    Command="{Binding DeclineCommand}" />
                                        <arc:Button Size="Small" Variant="Ghost"
                                                    Content="{l:AppLangResource AgentGuiQuestionCancel}"
                                                    Command="{Binding CancelCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </common:SmoothCollapse.ContentTemplate>
                    </common:SmoothCollapse>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- Interactive Out-of-Band URL Elicitation Strip (ACP elicitation/create mode=url) -->
        <DataTemplate DataType="gui:UrlElicitationCardItem">
            <Border Classes="questionCard"
                    Classes.resolved="{Binding IsResolved}"
                    Margin="0,2,0,6"
                    BorderThickness="2,0,0,0"
                    Padding="10,3,0,3">
                <StackPanel Spacing="0">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" FontSize="{arc:ArcDesignTokenResource TypeSM}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" FontSize="11.5" Foreground="#16A34A"
                                   Text="{Binding ResolvedSummary}" IsVisible="{Binding IsResolved}" VerticalAlignment="Center" />
                    </Grid>
                    <common:SmoothCollapse IsExpanded="{Binding !IsResolved}" LazyData="{Binding}">
                        <common:SmoothCollapse.ContentTemplate>
                            <DataTemplate x:DataType="gui:UrlElicitationCardItem">
                                <StackPanel Margin="0,6,0,0" Spacing="6">
                                    <TextBlock Classes="body" Text="{Binding Message}" TextWrapping="Wrap" />
                                    <SelectableTextBlock Text="{Binding Url}"
                                                         FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                         FontSize="11.5"
                                                         TextWrapping="Wrap"
                                                         Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <arc:Button Size="Small" Variant="Primary"
                                                    Content="{l:AppLangResource AgentGuiUrlElicitationOpen}"
                                                    Command="{Binding OpenUrlCommand}" />
                                        <arc:Button Size="Small" Variant="Secondary"
                                                    Content="{l:AppLangResource AgentGuiUrlElicitationConfirm}"
                                                    Command="{Binding ConfirmCommand}" />
                                        <arc:Button Size="Small" Variant="Ghost"
                                                    Content="{l:AppLangResource AgentGuiUrlElicitationDecline}"
                                                    Command="{Binding DeclineCommand}" />
                                        <arc:Button Size="Small" Variant="Ghost"
                                                    Content="{l:AppLangResource AgentGuiPermissionCancel}"
                                                    Command="{Binding CancelCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </common:SmoothCollapse.ContentTemplate>
                    </common:SmoothCollapse>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.DataTemplates>

    <Grid>
        <!-- Non-virtualized StackPanel avoids Avalonia VirtualizingStackPanel's
             variable-height StartU invalidation and estimated-extent drift while streaming. -->
        <ItemsControl x:Name="TimelineList"
                      ItemsSource="{Binding ItemsSource, ElementName=RootControl}">
            <ItemsControl.Styles>
                <Style Selector="ItemsControl#TimelineList StackPanel.timelinePanel > ContentPresenter">
                    <Setter Property="MaxWidth" Value="{Binding MaxContentWidth, ElementName=RootControl}" />
                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                </Style>
            </ItemsControl.Styles>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Classes="timelinePanel"
                                Spacing="{DynamicResource OctopusAgentGuiTurnSpacing}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Template>
                <ControlTemplate>
                    <arc:ScrollArea Name="PART_ScrollViewer"
                                    Orientation="Vertical"
                                    FadeLength="0"
                                    HorizontalScrollBarVisibility="Disabled"
                                    BringIntoViewOnFocusChange="False"
                                    Padding="{Binding StreamPadding, ElementName=RootControl}">
                        <ItemsPresenter Name="PART_ItemsPresenter"
                                        ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </arc:ScrollArea>
                </ControlTemplate>
            </ItemsControl.Template>
        </ItemsControl>

        <!-- Smart auto-scroll paused indicator: Jump back to latest -->
        <arc:Button x:Name="JumpToBottomButton"
                    Variant="Secondary" Size="Small"
                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                    Margin="0,0,0,8"
                    IsVisible="{Binding ShowJumpToBottom, ElementName=RootControl}"
                    Command="{Binding JumpToBottomCommand, ElementName=RootControl}">
            <StackPanel Orientation="Horizontal" Spacing="4">
                <lucide:LucideIcon Kind="ArrowDown" Size="12" VerticalAlignment="Center" />
                <TextBlock FontSize="{arc:ArcDesignTokenResource TypeXS}" Text="{l:AppLangResource AgentGuiJumpToBottom}" VerticalAlignment="Center" />
            </StackPanel>
        </arc:Button>
    </Grid>
</UserControl>
