<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:common="using:Octopus.App.Common"
             xmlns:gui="using:Octopus.App.AgentGui"
             x:Class="Octopus.App.AgentGui.AgentGuiTabView"
             x:DataType="gui:AgentGuiTabViewModel">
    <UserControl.Styles>
        <Style Selector="Button.textLink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      Padding="{TemplateBinding Padding}"
                                      VerticalContentAlignment="Center" />
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.textLink:pointerover">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="Button.textLink.accent">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>

        <!-- Smooth rotating chevron for Activity Tray -->
        <Style Selector="lucide|LucideIcon.chevronPop">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.16" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="lucide|LucideIcon.chevronPop.open">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>

        <!-- Choice chips & quick starter prompts -->
        <Style Selector="Button.chipChoice">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.97)" />
            </Style>
        </Style>
        <Style Selector="Button.chipChoice.selected">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>

        <!-- Composer outer card with subtle focus ring -->
        <Style Selector="Border.composerCard">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.composerCard:focus-within">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>

        <!-- Single composer send/loading button hover-to-stop visual -->
        <Style Selector="arc|Button#SendButton lucide|LucideIcon.stopHoverIcon">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="arc|Button#SendButton.canStop:pointerover arc|ArcSpinner.loadingIcon">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="arc|Button#SendButton.canStop:pointerover lucide|LucideIcon.stopHoverIcon">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- Docked queued prompts tray above composer -->
        <Style Selector="Border.queueTray">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.queueTray.paused">
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Warning}" />
        </Style>
        <Style Selector="Border.queueItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="6,4" />
        </Style>
        <Style Selector="Border.queueItem:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        </Style>
        <Style Selector="Border.queueItem StackPanel.queueActions">
            <Setter Property="Opacity" Value="0.72" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.queueItem:pointerover StackPanel.queueActions, Border.queueItem:focus-within StackPanel.queueActions">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Border.queueIndex">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="Border.queueIndex.next">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        </Style>
        <Style Selector="Border.queueIndex TextBlock">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="Border.queueIndex.next TextBlock">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
        <Style Selector="Button.queueSendNowChip">
            <Setter Property="Height" Value="21" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource AccentStrong}" />
            </Style>
        </Style>

        <!-- Frameless multiline TextBox integrated cleanly inside ComposerCard (no double border) -->
        <Style Selector="TextBox.composerInput">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,2,2,4" />
            <Setter Property="MinHeight" Value="{DynamicResource OctopusAgentGuiComposerMinHeight}" />
            <Setter Property="MaxHeight" Value="180" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
            <Setter Property="LineHeight" Value="19" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="CaretBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="SelectionBrush" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
            <Setter Property="PlaceholderForeground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="Template">
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer Name="PART_ScrollViewer"
                                      Theme="{DynamicResource FieldScrollViewerTheme}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <Panel>
                                <TextBlock Name="PART_Placeholder"
                                           Margin="0,1,0,0"
                                           FontSize="{TemplateBinding FontSize}"
                                           LineHeight="{TemplateBinding LineHeight}"
                                           Foreground="{TemplateBinding PlaceholderForeground}"
                                           Text="{TemplateBinding PlaceholderText}"
                                           TextWrapping="Wrap">
                                    <TextBlock.IsVisible>
                                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                                            <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                            <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                        </MultiBinding>
                                    </TextBlock.IsVisible>
                                </TextBlock>
                                <TextPresenter Name="PART_TextPresenter"
                                               Margin="0,1,0,0"
                                               Text="{TemplateBinding Text, Mode=TwoWay}"
                                               CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                               CaretIndex="{TemplateBinding CaretIndex}"
                                               SelectionStart="{TemplateBinding SelectionStart}"
                                               SelectionEnd="{TemplateBinding SelectionEnd}"
                                               TextWrapping="{TemplateBinding TextWrapping}"
                                               LineHeight="{TemplateBinding LineHeight}"
                                               SelectionBrush="{TemplateBinding SelectionBrush}"
                                               SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                               CaretBrush="{TemplateBinding CaretBrush}" />
                            </Panel>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>

        <!-- Sleek compact ghost/pill triggers for composer popover pickers & toggles -->
        <Style Selector="Button.composerChip">
            <Setter Property="Height" Value="24" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.10" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="PART_Chip"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
                <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
                <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            </Style>
            <Style Selector="^:pressed">
                <Setter Property="RenderTransform" Value="scale(0.97)" />
            </Style>
            <Style Selector="^.open">
                <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
                <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
                <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            </Style>
            <Style Selector="^.active">
                <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
                <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource AccentStrong}" />
                <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
            </Style>
            <Style Selector="^.danger">
                <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Warning}" />
            </Style>
        </Style>

        <!-- Subtle picker row icon coloring -->
        <Style Selector="lucide|LucideIcon.permIcon">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="lucide|LucideIcon.permIcon.danger">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Warning}" />
        </Style>

        <!-- Docked Live Activity Tray (Scheme A: unified SubAgents, Background Bash & Tasks above composer) -->
        <Style Selector="Border.activityTray">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <Style Selector="Border.activityRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.activityRow:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="Button.activityChip">
            <Setter Property="Height" Value="21" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusAdorner" Value="{x:Null}" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          VerticalContentAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover">
                <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
                <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Border}" />
                <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            </Style>
            <Style Selector="^.accent">
                <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
            </Style>
            <Style Selector="^.accent:pointerover">
                <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource AccentStrong}" />
            </Style>
            <Style Selector="^.danger">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="#F87171" />
            </Style>
            <Style Selector="^.danger:pointerover">
                <Setter Property="Background" Value="#22EF4444" />
                <Setter Property="BorderBrush" Value="#55EF4444" />
            </Style>
        </Style>
        <Style Selector="SelectableTextBlock.bgLogLine">
            <Setter Property="Foreground" Value="#D8DCE6" />
        </Style>
        <Style Selector="SelectableTextBlock.bgLogLine.err">
            <Setter Property="Foreground" Value="#F87171" />
        </Style>
        <Style Selector="SelectableTextBlock.bgLogLine.ok">
            <Setter Property="Foreground" Value="#4ADE80" />
        </Style>
        <Style Selector="SelectableTextBlock.bgLogLine.info">
            <Setter Property="Foreground" Value="#7DD3FC" />
        </Style>

        <!-- Refined Task List rows & progress bar -->
        <Style Selector="Border.taskRow">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="7" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style Selector="Border.taskRow:pointerover">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource SurfaceMuted}" />
        </Style>
        <Style Selector="Border.taskRow.active">
            <Setter Property="Background" Value="#148B8BF5" />
            <Setter Property="BorderBrush" Value="#3D8B8BF5" />
        </Style>
        <Style Selector="Border.taskRow.failed">
            <Setter Property="Background" Value="#16EF4444" />
            <Setter Property="BorderBrush" Value="#44EF4444" />
        </Style>
        <Style Selector="Border.taskRail">
            <Setter Property="Width" Value="2.5" />
            <Setter Property="Height" Value="14" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.taskRail.active">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
        <Style Selector="Border.taskRail.done">
            <Setter Property="Background" Value="#4422C55E" />
        </Style>
        <Style Selector="Border.taskRail.failed">
            <Setter Property="Background" Value="#EF4444" />
        </Style>
        <Style Selector="TextBlock.taskIndex">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="Opacity" Value="0.72" />
        </Style>
        <Style Selector="TextBlock.taskIndex.active">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="TextBlock.taskIndex.done">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
        <Style Selector="TextBlock.taskTitle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.taskTitle.active">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.taskTitle.done">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
            <Setter Property="Opacity" Value="0.78" />
        </Style>
        <Style Selector="TextBlock.taskTitle.failed">
            <Setter Property="Foreground" Value="#FCA5A5" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="ProgressBar.taskProgress">
            <Setter Property="Height" Value="4" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Width" Value="54" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Border}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ProgressBar.taskProgress.done">
            <Setter Property="Foreground" Value="#22C55E" />
        </Style>
        <Style Selector="ProgressBar.trayHairlineProgress">
            <Setter Property="Height" Value="2" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ProgressBar.trayHairlineProgress.done">
            <Setter Property="Foreground" Value="#22C55E" />
        </Style>
        <Style Selector="Border.taskRatioBadge">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.taskRatioBadge.done">
            <Setter Property="Background" Value="#1F22C55E" />
        </Style>
        <Style Selector="Border.taskRatioBadge TextBlock">
            <Setter Property="FontFamily" Value="{arc:ArcDesignTokenResource MonoFontFamily}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
        <Style Selector="Border.taskRatioBadge.done TextBlock">
            <Setter Property="Foreground" Value="#22C55E" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Background="{arc:ArcDesignTokenResource Background}">
        <!-- Slim Compact IDE Header Bar -->
        <Border Grid.Row="0"
                Height="{DynamicResource OctopusAgentGuiHeaderHeight}"
                Padding="10,0,6,0"
                Background="{arc:ArcDesignTokenResource Background}"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <common:AgentIcon AgentId="{Binding AgentId}" AgentName="{Binding AgentName}" Size="15" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AgentName}" FontSize="{arc:ArcDesignTokenResource TypeSM}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Padding="5,0" CornerRadius="4" Background="{arc:ArcDesignTokenResource SurfaceMuted}" VerticalAlignment="Center"
                            arc:Tooltip.Tip="{Binding SourceLabel}">
                        <TextBlock Text="ACP" FontSize="10" FontWeight="SemiBold" Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                    </Border>
                    <TextBlock Classes="hint" Text="·" VerticalAlignment="Center" />
                    <TextBlock Classes="hint" Text="{Binding WorkingDirectoryName}" VerticalAlignment="Center"
                               arc:Tooltip.Tip="{Binding WorkingDirectory}" />
                    <TextBlock Classes="hint" Text="·" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <arc:ArcSpinner Width="10" Height="10" IsVisible="{Binding IsBusy}" VerticalAlignment="Center" />
                        <TextBlock Classes="hint" Text="{Binding StatusText}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                    <Border IsVisible="{Binding HasContextUsage}"
                            Padding="6,1"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                            Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <lucide:LucideIcon Kind="Gauge" Size="11" Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                            <TextBlock Classes="hint"
                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                       Text="{Binding ContextUsageText}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <arc:Popover x:Name="SessionHistoryPopover"
                                 Placement="Bottom" Alignment="End" Offset="6"
                                 IsVisible="{Binding CanListSessions}"
                                 IsOpen="{Binding IsSessionHistoryOpen, Mode=TwoWay}">
                        <arc:Popover.Trigger>
                            <arc:Button Classes="icon" Variant="Ghost"
                                        AutomationProperties.Name="{l:AppLangResource AgentGuiSessionHistory}"
                                        arc:Tooltip.Tip="{l:AppLangResource AgentGuiSessionHistory}">
                                <lucide:LucideIcon Kind="History" Size="13" />
                            </arc:Button>
                        </arc:Popover.Trigger>
                        <StackPanel Width="300" Spacing="4">
                            <Grid ColumnDefinitions="*,Auto" Margin="6,2,4,2">
                                <TextBlock Classes="hint" Text="{l:AppLangResource AgentGuiSessionHistory}" VerticalAlignment="Center" />
                                <arc:Button Grid.Column="1" Classes="icon" Variant="Ghost" Command="{Binding RefreshSessionHistoryCommand}">
                                    <lucide:LucideIcon Kind="RefreshCw" Size="11" />
                                </arc:Button>
                            </Grid>
                            <arc:ArcSpinner Width="14" Height="14" HorizontalAlignment="Center" Margin="0,8"
                                            IsVisible="{Binding IsLoadingSessionHistory}" />
                            <TextBlock Classes="hint" Margin="8,8" HorizontalAlignment="Center"
                                       IsVisible="{Binding ShowEmptyRemoteSessions}"
                                       Text="{l:AppLangResource AgentGuiSessionHistoryEmpty}" TextWrapping="Wrap" />
                            <arc:ScrollArea MaxHeight="260" Orientation="Vertical" FadeLength="0" IsVisible="{Binding HasRemoteSessions}">
                                <ItemsControl ItemsSource="{Binding RemoteSessions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="gui:AcpSessionListEntryViewModel">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4" Margin="2,1">
                                                <Button Classes="row" Classes.selected="{Binding IsCurrent}" Padding="7,5"
                                                        Command="{Binding LoadCommand}">
                                                    <StackPanel Spacing="1">
                                                        <TextBlock Classes="body" FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                   Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Classes="hint" Text="{Binding UpdatedAtText}" IsVisible="{Binding HasUpdatedAt}" />
                                                    </StackPanel>
                                                </Button>
                                                <arc:Button Grid.Column="1" Classes="icon" Variant="Ghost"
                                                            IsVisible="{Binding CanDelete}"
                                                            Command="{Binding DeleteCommand}"
                                                            AutomationProperties.Name="{l:AppLangResource AgentGuiSessionDelete}"
                                                            arc:Tooltip.Tip="{l:AppLangResource AgentGuiSessionDelete}">
                                                    <lucide:LucideIcon Kind="Trash2" Size="12" />
                                                </arc:Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </arc:ScrollArea>
                        </StackPanel>
                    </arc:Popover>
                    <arc:Button x:Name="ForkSessionButton"
                                Classes="icon" Variant="Ghost"
                                IsVisible="{Binding CanForkSession}"
                                Command="{Binding ForkSessionCommand}"
                                AutomationProperties.Name="{l:AppLangResource AgentGuiForkSession}"
                                arc:Tooltip.Tip="{l:AppLangResource AgentGuiForkSession}">
                        <lucide:LucideIcon Kind="GitFork" Size="13" />
                    </arc:Button>
                    <arc:Button Classes="icon" Variant="Ghost"
                                IsVisible="{Binding CanLogout}"
                                Command="{Binding LogoutCommand}"
                                AutomationProperties.Name="{l:AppLangResource AgentGuiAuthLogout}"
                                arc:Tooltip.Tip="{l:AppLangResource AgentGuiAuthLogout}">
                        <lucide:LucideIcon Kind="LogOut" Size="13" />
                    </arc:Button>
                    <arc:Button Classes="icon" Variant="Ghost"
                                IsVisible="{Binding HasDiagnostics}"
                                Command="{Binding ToggleDiagnosticsCommand}"
                                AutomationProperties.Name="{l:AppLangResource AgentGuiStderrToggle}"
                                arc:Tooltip.Tip="{l:AppLangResource AgentGuiStderrToggle}">
                        <lucide:LucideIcon Kind="Terminal" Size="13" />
                    </arc:Button>
                    <arc:Button Classes="icon" Variant="Ghost"
                                IsVisible="{Binding HasTimeline}"
                                Command="{Binding ClearTimelineCommand}"
                                AutomationProperties.Name="{l:AppLangResource AgentGuiClearSession}"
                                arc:Tooltip.Tip="{l:AppLangResource AgentGuiClearSession}">
                        <lucide:LucideIcon Kind="Eraser" Size="13" />
                    </arc:Button>
                    <arc:Button Classes="icon" Variant="Ghost"
                                Command="{Binding NewSessionCommand}"
                                AutomationProperties.Name="{l:AppLangResource AgentGuiNewSession}"
                                arc:Tooltip.Tip="{l:AppLangResource AgentGuiNewSession}">
                        <lucide:LucideIcon Kind="SquarePen" Size="13" />
                    </arc:Button>
                    <arc:Button Variant="Secondary" Size="Small"
                                IsVisible="{Binding ShowReconnect}"
                                Command="{Binding ReconnectCommand}"
                                Content="{l:AppLangResource AgentGuiReconnect}" />
                    <arc:Button Variant="Ghost" Size="Small"
                                Command="{Binding ContinueInTerminalCommand}"
                                AutomationProperties.Name="{l:AppLangResource AgentGuiContinueInTerminal}"
                                arc:Tooltip.Tip="{l:AppLangResource AgentGuiContinueInTerminal}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <lucide:LucideIcon Kind="SquareTerminal" Size="12" VerticalAlignment="Center" />
                            <TextBlock FontSize="{arc:ArcDesignTokenResource TypeXS}" Text="{l:AppLangResource AgentGuiContinueInTerminal}" VerticalAlignment="Center" />
                        </StackPanel>
                    </arc:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scheme C: Compact Docked Collab Topology Ribbon, Bubbled Child Approvals & Inline Negotiation Thread -->
        <StackPanel Grid.Row="1" Spacing="0">
            <Border IsVisible="{Binding HasCollabTopology}"
                    Padding="10,4"
                    Background="{arc:ArcDesignTokenResource Surface}"
                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                    BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <TextBlock Text="{l:AppLangResource CollabRibbonTitle}"
                               FontSize="10.5" FontWeight="SemiBold"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                               VerticalAlignment="Center" />
                    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding CollabRibbonNodes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="gui:CollabRibbonNodeViewModel">
                                    <Button Classes="chipChoice"
                                            Classes.selected="{Binding IsCurrent}"
                                            Padding="7,2"
                                            Command="{Binding ActivateCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding PrefixGlyph}" IsVisible="{Binding HasPrefixGlyph}"
                                                       FontSize="11" Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                                       VerticalAlignment="Center" />
                                            <common:AgentIcon AgentId="{Binding AgentId}" AgentName="{Binding Label}" Size="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Label}" FontSize="11.5" MaxWidth="145"
                                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <Border IsVisible="{Binding HasMeta}" Padding="4,0" CornerRadius="4"
                                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Meta}" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                           FontSize="9.5" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                            </Border>
                                            <arc:ArcSpinner Width="10" Height="10" IsVisible="{Binding IsWorking}" VerticalAlignment="Center" />
                                            <Ellipse Width="6" Height="6" IsVisible="{Binding IsWaiting}" VerticalAlignment="Center"
                                                     Fill="{arc:ArcDesignTokenResource Warning}" />
                                            <Ellipse Width="6" Height="6" IsVisible="{Binding IsDone}" VerticalAlignment="Center"
                                                     Fill="{arc:ArcDesignTokenResource Success}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Bubbled Permission Approvals from direct spawned child agents -->
            <ItemsControl ItemsSource="{Binding BubbledApprovals}" IsVisible="{Binding HasBubbledApprovals}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="gui:CollabBubbledApprovalViewModel">
                        <Border Padding="10,6"
                                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                BorderBrush="{arc:ArcDesignTokenResource Warning}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <lucide:LucideIcon Kind="ShieldAlert" Size="13" Foreground="{arc:ArcDesignTokenResource Warning}" VerticalAlignment="Center" />
                                    <common:AgentIcon AgentId="{Binding ChildAgentId}" AgentName="{Binding ChildTitle}" Size="13" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ChildTitle}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Detail}"
                                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                           FontSize="11" Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <arc:Button Variant="Primary" Size="Small" Content="{l:AppLangResource CollabBubbleAllow}" Command="{Binding AllowOnceCommand}" />
                                    <arc:Button Variant="Secondary" Size="Small" Content="{l:AppLangResource CollabBubbleDeny}" Command="{Binding DenyCommand}" />
                                    <arc:Button Variant="Ghost" Size="Small" Content="{l:AppLangResource CollabBubbleInspect}" Command="{Binding InspectChildCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Compact Inline Negotiation Thread Panel (opens when clicking a peer pill in the ribbon) -->
            <ContentControl Content="{Binding ActiveCollabThread}" IsVisible="{Binding HasActiveCollabThread}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="gui:CollabThreadPanelViewModel">
                        <Border Padding="10,7"
                                Background="{arc:ArcDesignTokenResource Surface}"
                                BorderBrush="{arc:ArcDesignTokenResource Border}"
                                BorderThickness="0,0,0,1">
                            <StackPanel Spacing="6">
                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <TextBlock Text="⇄" FontSize="12" Foreground="{arc:ArcDesignTokenResource AccentStrong}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Border Padding="5,0" CornerRadius="999" Background="{arc:ArcDesignTokenResource SurfaceMuted}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding HopsText}" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" FontSize="10" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                        </Border>
                                    </StackPanel>
                                    <arc:Button Grid.Column="1" Variant="Secondary" Size="Small" IsVisible="{Binding IsBudgetPaused}"
                                                Content="{l:AppLangResource CollabThreadExtendBudget}" Command="{Binding ExtendBudgetCommand}" />
                                    <arc:Button Grid.Column="2" Classes="icon" Variant="Ghost" Command="{Binding CloseCommand}">
                                        <lucide:LucideIcon Kind="X" Size="12" />
                                    </arc:Button>
                                </Grid>
                                <arc:ScrollArea MaxHeight="140" Orientation="Vertical" FadeLength="0">
                                    <ItemsControl ItemsSource="{Binding Messages}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Spacing="4" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="gui:CollabThreadMessageViewModel">
                                                <Border Padding="7,4" CornerRadius="6"
                                                        Background="{arc:ArcDesignTokenResource Background}"
                                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="1">
                                                    <StackPanel Spacing="2">
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="5">
                                                            <common:AgentIcon IsVisible="{Binding HasAgentIcon}" AgentId="{Binding FromAgentId}" AgentName="{Binding FromLabel}" Size="11" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Text="{Binding FromLabel}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5">
                                                                <TextBlock Text="{Binding RoundBadge}" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" FontSize="10" Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                                                                <TextBlock Text="{Binding TimeText}" Classes="hint" FontSize="10" />
                                                            </StackPanel>
                                                        </Grid>
                                                        <TextBlock Text="{Binding Text}" FontSize="11.5" TextWrapping="Wrap"
                                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </arc:ScrollArea>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                    <arc:Input Text="{Binding InterjectText, Mode=TwoWay}"
                                               Placeholder="{l:AppLangResource CollabThreadInterjectPlaceholder}"
                                               Label="{l:AppLangResource CollabThreadInterjectPlaceholder}"
                                               IsLabelVisible="False"
                                               Size="Small" />
                                    <arc:Button Grid.Column="1" Variant="Primary" Size="Small"
                                                Content="{l:AppLangResource CollabThreadBroadcast}"
                                                Command="{Binding SendInterjectCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </StackPanel>

        <!-- Centered Editorial Document Stream + SubAgent Slide-Over Drawer -->
        <Grid Grid.Row="2">
            <Grid RowDefinitions="Auto,*">
                <!-- Status banners & collapsible diagnostics stay compact at top -->
                <StackPanel Grid.Row="0" MaxWidth="860" HorizontalAlignment="Stretch" Margin="14,6,14,0" Spacing="6">
                    <!-- Auth required banner -->
                    <arc:Alert IsVisible="{Binding IsAuthRequired}"
                               Tone="Warning"
                               Title="{l:AppLangResource AgentGuiAuthRequiredTitle}">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="body" Text="{l:AppLangResource AgentGuiAuthRequiredHint}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding AuthMethods}" IsVisible="{Binding HasAuthMethods}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="gui:AuthMethodActionViewModel">
                                        <arc:Button Margin="0,0,6,2" Size="Small" Variant="Primary"
                                                    Content="{Binding Label}"
                                                    arc:Tooltip.Tip="{Binding Description}"
                                                    Command="{Binding RunCommand}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <arc:Button Size="Small" Variant="Secondary"
                                            Content="{l:AppLangResource AgentGuiContinueInTerminal}"
                                            Command="{Binding ContinueInTerminalCommand}" />
                                <arc:Button Size="Small" Variant="Ghost"
                                            Content="{l:AppLangResource AgentGuiReconnect}"
                                            Command="{Binding ReconnectCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </arc:Alert>

                    <!-- Connection / process error banner -->
                    <arc:Alert IsVisible="{Binding HasErrorBanner}"
                               Tone="Danger"
                               Title="{l:AppLangResource AgentGuiStatusError}">
                        <StackPanel Spacing="6">
                            <SelectableTextBlock Classes="body" Text="{Binding ErrorBanner}" TextWrapping="Wrap" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <arc:Button Size="Small" Variant="Secondary"
                                            Content="{l:AppLangResource AgentGuiReconnect}"
                                            Command="{Binding ReconnectCommand}" />
                                <arc:Button Size="Small" Variant="Ghost"
                                            Content="{l:AppLangResource AgentGuiContinueInTerminal}"
                                            Command="{Binding ContinueInTerminalCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </arc:Alert>

                    <!-- Smooth collapsible stderr diagnostics drawer (lazy-mounted) -->
                    <common:SmoothCollapse IsExpanded="{Binding ShowDiagnostics}" LazyData="{Binding}">
                        <common:SmoothCollapse.ContentTemplate>
                            <DataTemplate x:DataType="gui:AgentGuiTabViewModel">
                                <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8">
                                    <arc:ScrollArea MaxHeight="200" Orientation="Vertical" FadeLength="0">
                                        <SelectableTextBlock Text="{Binding DiagnosticsText}"
                                                             FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                             FontSize="11"
                                                             TextWrapping="Wrap"
                                                             Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                                    </arc:ScrollArea>
                                </Border>
                            </DataTemplate>
                        </common:SmoothCollapse.ContentTemplate>
                    </common:SmoothCollapse>
                </StackPanel>

                <!-- Compact empty state with quick starter prompts -->
                <arc:ScrollArea Grid.Row="1" IsVisible="{Binding ShowEmptyState}" Orientation="Vertical" FadeLength="0">
                    <StackPanel MaxWidth="860"
                                Margin="14,28,14,12"
                                Spacing="7"
                                HorizontalAlignment="Center">
                        <common:AgentIcon AgentId="{Binding AgentId}" AgentName="{Binding AgentName}" Size="32" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding EmptyTitle}" FontSize="{arc:ArcDesignTokenResource TypeLG}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Classes="hint" Text="{l:AppLangResource AgentGuiEmptyHint}" TextWrapping="Wrap"
                                   MaxWidth="440" TextAlignment="Center" HorizontalAlignment="Center" />
                        <ItemsControl ItemsSource="{Binding Composer.CapabilityBadges}" HorizontalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Margin="2" Padding="6,1" CornerRadius="8"
                                            Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                                        <TextBlock Classes="hint" Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding QuickPrompts}" HorizontalAlignment="Center" Margin="0,4,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Classes="chipChoice" Margin="3"
                                            Command="{Binding $parent[gui:AgentGuiTabView].((gui:AgentGuiTabViewModel)DataContext).UseQuickPromptCommand}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Classes="hint" Foreground="{arc:ArcDesignTokenResource TextSecondary}" Text="{Binding}" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </arc:ScrollArea>

                <!-- Shared Main Timeline (reused 1:1 by the right-panel Subagent inspector) -->
                <gui:AgentTimelineView x:Name="TimelineView"
                                       Grid.Row="1"
                                       IsVisible="{Binding HasTimeline}"
                                       ItemsSource="{Binding Timeline}"
                                       StreamPadding="{DynamicResource OctopusAgentGuiStreamMargin}"
                                       IsPinnedToBottom="{Binding IsPinnedToBottom, Mode=TwoWay}"
                                       ShowJumpToBottom="{Binding ShowJumpToBottom}"
                                       JumpToBottomCommand="{Binding JumpToBottomCommand}"
                                       WorkingDirectory="{Binding WorkingDirectory}" />
            </Grid>
        </Grid>

        <!-- Compact Floating Dynamic Agent-Driven Composer -->
        <Border Grid.Row="3" Padding="{DynamicResource OctopusAgentGuiComposerMargin}" Background="{arc:ArcDesignTokenResource Background}">
            <StackPanel MaxWidth="860" HorizontalAlignment="Stretch" Spacing="5">
                <!-- Scheme A: Docked Live Activity Tray above composer (SubAgents, Background Bash & Workflow Tasks) -->
                <common:SmoothCollapse IsExpanded="{Binding HasActivityTray}">
                    <Border x:Name="ActivityTray" Classes="activityTray">
                        <StackPanel Spacing="0">
                            <!-- Tray Header -->
                            <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                    Padding="8,5">
                                <Panel>
                                    <!-- Single Background Bash compact single-line header -->
                                    <Grid IsVisible="{Binding IsSingleBackgroundShell}"
                                          ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                        <Button Grid.Column="0" Classes="row" Padding="2,1"
                                                Command="{Binding ToggleActivityTrayCommand}"
                                                arc:Tooltip.Tip="{Binding SingleBackgroundShell.DisplayCommand, FallbackValue=''}">
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                                                <Panel Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center">
                                                    <Ellipse Width="7" Height="7" Fill="#16A34A"
                                                             IsVisible="{Binding SingleBackgroundShell.IsRunning, FallbackValue=False}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Ellipse Width="7" Height="7" Fill="#DC2626"
                                                             IsVisible="{Binding SingleBackgroundShell.IsFailed, FallbackValue=False}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Ellipse Width="7" Height="7" Fill="{arc:ArcDesignTokenResource TextMuted}"
                                                             IsVisible="{Binding SingleBackgroundShell.IsCompleted, FallbackValue=False}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Panel>
                                                <Border Grid.Column="1" Padding="5,1" CornerRadius="4" Background="#1A14B8A6" VerticalAlignment="Center">
                                                    <TextBlock Text="{l:AppLangResource AgentGuiBgBashBadge}"
                                                               FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                               FontSize="10" FontWeight="SemiBold" Foreground="#0D9488" />
                                                </Border>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding SingleBackgroundShell.CompactCommand, FallbackValue=''}"
                                                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                           FontSize="11.5"
                                                           Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                           MaxLines="1" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <Border Grid.Column="3"
                                                        IsVisible="{Binding SingleBackgroundShell.HasPort, FallbackValue=False}"
                                                        Padding="5,0" CornerRadius="4"
                                                        Background="{arc:ArcDesignTokenResource AccentSubtle}"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SingleBackgroundShell.DetectedPort, FallbackValue=''}"
                                                               FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                               FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                                                </Border>
                                                <Border Grid.Column="4"
                                                        IsVisible="{Binding SingleBackgroundShell.HasUnread, FallbackValue=False}"
                                                        Padding="5,0" CornerRadius="4"
                                                        Background="#1F16A34A"
                                                        VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SingleBackgroundShell.UnreadBadgeText, FallbackValue=''}"
                                                               FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                               FontSize="10" FontWeight="SemiBold" Foreground="#16A34A" />
                                                </Border>
                                                <TextBlock Grid.Column="5" Classes="hint"
                                                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                           Text="{Binding SingleBackgroundShell.StatusElapsedText, FallbackValue=''}"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <Button Classes="activityChip accent"
                                                    IsVisible="{Binding ShowCollapsedSingleShellActions}"
                                                    Command="{Binding OpenSingleShellLogsCommand}">
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Text="{l:AppLangResource AgentGuiBgBashViewLogs}" />
                                            </Button>
                                            <Button Classes="activityChip danger"
                                                    IsVisible="{Binding ShowCollapsedSingleShellStop}"
                                                    Command="{Binding SingleBackgroundShell.StopCommand, FallbackValue={x:Null}}">
                                                <TextBlock FontSize="11" FontWeight="SemiBold"
                                                           Text="{l:AppLangResource AgentGuiBgBashStop}" />
                                            </Button>
                                            <Button Classes="composerChip" Width="22" Height="22" Padding="0"
                                                    Command="{Binding ToggleActivityTrayCommand}"
                                                    AutomationProperties.Name="{l:AppLangResource AgentGuiActivityTrayToggle}"
                                                    arc:Tooltip.Tip="{l:AppLangResource AgentGuiActivityTrayToggle}">
                                                <lucide:LucideIcon Classes="chevronPop" Classes.open="{Binding IsActivityTrayExpanded}"
                                                                   Kind="ChevronDown" Size="12"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Multi-item (Task List / SubAgents / multiple Bash) header -->
                                    <Grid IsVisible="{Binding IsMultiActivityTray}"
                                          ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Button Grid.Column="0" Classes="row" Padding="2,1"
                                                Command="{Binding ToggleActivityTrayCommand}"
                                                AutomationProperties.Name="{l:AppLangResource AgentGuiActivityTrayToggle}"
                                                arc:Tooltip.Tip="{l:AppLangResource AgentGuiActivityTrayToggle}">
                                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="7">
                                                <Panel Grid.Column="0" Width="13" Height="13" VerticalAlignment="Center">
                                                    <arc:ArcSpinner Width="11" Height="11"
                                                                    Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                                                    IsVisible="{Binding ShowSpinnerInActivityHeader}" />
                                                    <Ellipse Width="7" Height="7" Fill="#22C55E"
                                                             IsVisible="{Binding ShowRunningBashDotOnly}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <lucide:LucideIcon Kind="CircleAlert" Size="12" Foreground="#EF4444"
                                                                       IsVisible="{Binding HasFailedActivity}" />
                                                    <lucide:LucideIcon Kind="CircleCheck" Size="12" Foreground="#22C55E"
                                                                       IsVisible="{Binding HasCompletedActivity}" />
                                                </Panel>
                                                <TextBlock Grid.Column="1"
                                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                           Text="{Binding ActivityTrayTitle}"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Classes="hint"
                                                           IsVisible="{Binding ShowMultiHeaderSummary}"
                                                           Text="{Binding ActivityTraySummary}"
                                                           MaxLines="1" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           IsVisible="{Binding ShowCollapsedActiveTaskPreview}"
                                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                           Text="{Binding ActiveWorkflowTaskTitle}"
                                                           MaxLines="1" TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <ProgressBar Classes="taskProgress"
                                                         Classes.done="{Binding IsAllWorkflowTasksCompleted}"
                                                         IsVisible="{Binding IsOnlyWorkflowTasks}"
                                                         Minimum="0" Maximum="100"
                                                         Value="{Binding WorkflowProgressPercent}" />
                                            <Border Classes="taskRatioBadge"
                                                    Classes.done="{Binding IsAllWorkflowTasksCompleted}"
                                                    IsVisible="{Binding IsOnlyWorkflowTasks}">
                                                <TextBlock Text="{Binding WorkflowProgressRatioText}" />
                                            </Border>
                                            <Button Classes="composerChip" Width="22" Height="22" Padding="0"
                                                    Command="{Binding ToggleActivityTrayCommand}"
                                                    AutomationProperties.Name="{l:AppLangResource AgentGuiActivityTrayToggle}"
                                                    arc:Tooltip.Tip="{l:AppLangResource AgentGuiActivityTrayToggle}">
                                                <lucide:LucideIcon Classes="chevronPop" Classes.open="{Binding IsActivityTrayExpanded}"
                                                                   Kind="ChevronDown" Size="12"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Panel>
                            </Border>
                            <ProgressBar Classes="trayHairlineProgress"
                                         Classes.done="{Binding IsAllWorkflowTasksCompleted}"
                                         IsVisible="{Binding HasWorkflowTasks}"
                                         Minimum="0" Maximum="100"
                                         Value="{Binding WorkflowProgressPercent}" />

                            <!-- Collapsible Scrollable Activity List -->
                            <common:SmoothCollapse IsExpanded="{Binding IsActivityTrayExpanded}">
                                <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="0,1,0,0">
                                    <arc:ScrollArea MaxHeight="310" Orientation="Vertical" FadeLength="0">
                                        <StackPanel Spacing="0">
                                            <!-- SubAgents -->
                                            <ItemsControl ItemsSource="{Binding Subagents}" IsVisible="{Binding HasSubagents}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Spacing="0" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="gui:SubagentRunViewModel">
                                                        <Border Classes="activityRow" Padding="8,6">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <Button Grid.Column="0" Classes="row" Padding="0" Command="{Binding SelectCommand}">
                                                                    <Grid ColumnDefinitions="14,Auto,*,Auto" ColumnSpacing="7">
                                                                        <Panel Grid.Column="0" Width="12" Height="12" VerticalAlignment="Center">
                                                                            <arc:ArcSpinner Width="10" Height="10" IsVisible="{Binding IsRunning}" />
                                                                            <lucide:LucideIcon Kind="Check" Size="11" Foreground="#16A34A" IsVisible="{Binding IsDone}" />
                                                                            <lucide:LucideIcon Kind="X" Size="11" Foreground="#DC2626" IsVisible="{Binding IsFailed}" />
                                                                            <lucide:LucideIcon Kind="Minus" Size="11" Foreground="{arc:ArcDesignTokenResource TextMuted}" IsVisible="{Binding IsInterrupted}" />
                                                                        </Panel>
                                                                        <Border Grid.Column="1" Padding="5,1" CornerRadius="4"
                                                                                Background="{arc:ArcDesignTokenResource AccentSubtle}"
                                                                                VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding AgentType}"
                                                                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                                       FontSize="10" FontWeight="SemiBold"
                                                                                       Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                                                                        </Border>
                                                                        <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding DisplayTitle}"
                                                                                       FontSize="12" FontWeight="Medium"
                                                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Classes="hint"
                                                                                       IsVisible="{Binding HasSubtitle}"
                                                                                       Text="{Binding SubtitleText}"
                                                                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                                       FontSize="10.5"
                                                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="3" Classes="hint"
                                                                                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                                   Text="{Binding MetaText}"
                                                                                   VerticalAlignment="Center" />
                                                                    </Grid>
                                                                </Button>
                                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                    <Button Classes="activityChip accent" Command="{Binding SelectCommand}">
                                                                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="{l:AppLangResource AgentGuiActivityTrayDetails}" />
                                                                    </Button>
                                                                    <Button Classes="activityChip danger"
                                                                            IsVisible="{Binding IsRunning}"
                                                                            Command="{Binding StopCommand}">
                                                                        <TextBlock FontSize="11" FontWeight="SemiBold" Text="{l:AppLangResource AgentGuiSubagentStop}" />
                                                                    </Button>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Background Bash Shells (with inline expandable dark live terminal) -->
                                            <ItemsControl ItemsSource="{Binding BackgroundShells}" IsVisible="{Binding HasBackgroundShells}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Spacing="0" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="gui:BackgroundBashViewModel">
                                                        <Border Classes="activityRow">
                                                            <StackPanel Spacing="0">
                                                                <Grid Margin="8,6" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                    <Button Grid.Column="0" Classes="row" Padding="0"
                                                                            Command="{Binding ToggleLogsCommand}"
                                                                            arc:Tooltip.Tip="{Binding DisplayCommand}">
                                                                        <Grid ColumnDefinitions="12,Auto,*,Auto" ColumnSpacing="7">
                                                                            <Panel Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center">
                                                                                <Ellipse Width="7" Height="7" Fill="#16A34A" IsVisible="{Binding IsRunning}"
                                                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                <Ellipse Width="7" Height="7" Fill="#DC2626" IsVisible="{Binding IsFailed}"
                                                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                                <Ellipse Width="7" Height="7" Fill="{arc:ArcDesignTokenResource TextMuted}" IsVisible="{Binding IsCompleted}"
                                                                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                            </Panel>
                                                                            <Border Grid.Column="1" Padding="5,1" CornerRadius="4"
                                                                                    Background="#1A14B8A6" VerticalAlignment="Center">
                                                                                <TextBlock Text="Bash"
                                                                                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                                           FontSize="10" FontWeight="SemiBold" Foreground="#0D9488" />
                                                                            </Border>
                                                                            <StackPanel Grid.Column="2" Spacing="1" VerticalAlignment="Center">
                                                                                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="5">
                                                                                    <TextBlock Grid.Column="0"
                                                                                               Text="{Binding CompactCommand}"
                                                                                               FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                                               FontSize="11.5"
                                                                                               Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                                               MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                                                    <Border Grid.Column="1" IsVisible="{Binding HasPort}"
                                                                                            Padding="4,0" CornerRadius="4"
                                                                                            Background="{arc:ArcDesignTokenResource AccentSubtle}"
                                                                                            VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding DetectedPort}"
                                                                                                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                                                   FontSize="10" FontWeight="SemiBold"
                                                                                                   Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                                                                                    </Border>
                                                                                    <Border Grid.Column="2" IsVisible="{Binding HasUnread}"
                                                                                            Padding="4,0" CornerRadius="4"
                                                                                            Background="#1F16A34A"
                                                                                            VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding UnreadBadgeText}"
                                                                                                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                                                   FontSize="10" FontWeight="SemiBold" Foreground="#16A34A" />
                                                                                    </Border>
                                                                                </Grid>
                                                                                <TextBlock Classes="hint"
                                                                                           IsVisible="{Binding HasLastLogLine}"
                                                                                           Text="{Binding LastLogLine}"
                                                                                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                                           FontSize="10.5"
                                                                                           MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                                            </StackPanel>
                                                                            <TextBlock Grid.Column="3" Classes="hint"
                                                                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                                       Text="{Binding StatusElapsedText}"
                                                                                       VerticalAlignment="Center" />
                                                                        </Grid>
                                                                    </Button>
                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                        <Button Classes="activityChip"
                                                                                Classes.accent="{Binding IsLogsExpanded}"
                                                                                Command="{Binding ToggleLogsCommand}">
                                                                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding LogsToggleLabel}" />
                                                                        </Button>
                                                                        <Button Classes="activityChip danger"
                                                                                IsVisible="{Binding IsRunning}"
                                                                                Command="{Binding StopCommand}">
                                                                            <TextBlock FontSize="11" FontWeight="SemiBold" Text="{l:AppLangResource AgentGuiBgBashStop}" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>

                                                                <!-- Inline Live Terminal Output -->
                                                                <common:SmoothCollapse IsExpanded="{Binding IsLogsExpanded}">
                                                                    <Border Background="#0E1015"
                                                                            BorderBrush="#22FFFFFF"
                                                                            BorderThickness="0,1,0,0">
                                                                        <Grid RowDefinitions="Auto,*">
                                                                            <Border Grid.Row="0" Padding="9,5"
                                                                                    BorderBrush="#1AFFFFFF" BorderThickness="0,0,0,1">
                                                                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="5">
                                                                                    <TextBlock Grid.Column="0"
                                                                                               Text="{Binding DisplayCommand}"
                                                                                               arc:Tooltip.Tip="{Binding DisplayCommand}"
                                                                                               FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                                               FontSize="11" Foreground="#7DD3FC"
                                                                                               MaxLines="1" TextTrimming="CharacterEllipsis"
                                                                                               VerticalAlignment="Center" />
                                                                                    <arc:CopyButton Grid.Column="1" IsIconOnly="True"
                                                                                                    Value="{Binding CombinedLogText}" />
                                                                                    <arc:Button Grid.Column="2" Size="Small" Variant="Ghost"
                                                                                                Command="{Binding OpenInTerminalCommand}">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                                                                            <lucide:LucideIcon Kind="ExternalLink" Size="11" />
                                                                                            <TextBlock FontSize="10.5" Text="{l:AppLangResource AgentGuiBgBashOpenTerminal}" />
                                                                                        </StackPanel>
                                                                                    </arc:Button>
                                                                                    <arc:Button Grid.Column="3" Size="Small" Variant="Ghost"
                                                                                                IsVisible="{Binding IsRunning}"
                                                                                                Command="{Binding StopCommand}">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                                                                            <lucide:LucideIcon Kind="Square" Size="10" Foreground="#F87171" />
                                                                                            <TextBlock FontSize="10.5" Foreground="#FCA5A5" Text="{l:AppLangResource AgentGuiBgBashStop}" />
                                                                                        </StackPanel>
                                                                                    </arc:Button>
                                                                                </Grid>
                                                                            </Border>
                                                                            <arc:ScrollArea Grid.Row="1" MaxHeight="160" Orientation="Vertical" FadeLength="0" Padding="9,6">
                                                                                <ItemsControl ItemsSource="{Binding Logs}">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="gui:BackgroundBashLogLine">
                                                                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7">
                                                                                                <TextBlock Text="{Binding Timestamp}"
                                                                                                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                                                           FontSize="10.5" Foreground="#6C7384" />
                                                                                                <SelectableTextBlock Grid.Column="1"
                                                                                                                     Classes="bgLogLine"
                                                                                                                     Classes.err="{Binding IsError}"
                                                                                                                     Classes.ok="{Binding IsSuccess}"
                                                                                                                     Classes.info="{Binding IsInfo}"
                                                                                                                     Text="{Binding Text}"
                                                                                                                     FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                                                                     FontSize="11" TextWrapping="Wrap" />
                                                                                            </Grid>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </arc:ScrollArea>
                                                                        </Grid>
                                                                    </Border>
                                                                </common:SmoothCollapse>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Task List (refined cardless rows with live spinner, accent rail & progress) -->
                                            <StackPanel IsVisible="{Binding HasWorkflowTasks}" Spacing="0">
                                                <Button Classes="row" Padding="9,6"
                                                        IsVisible="{Binding ShowWorkflowTasksSectionHeader}"
                                                        Command="{Binding ToggleWorkflowTasksExpandedCommand}">
                                                    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnSpacing="6">
                                                        <lucide:LucideIcon Grid.Column="0" Kind="ListChecks" Size="12"
                                                                           Foreground="{arc:ArcDesignTokenResource AccentStrong}" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" FontSize="11.5" FontWeight="SemiBold"
                                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                   Text="{l:AppLangResource AgentGuiTaskDagTitle}" VerticalAlignment="Center" />
                                                        <ProgressBar Grid.Column="3" Classes="taskProgress"
                                                                     Classes.done="{Binding IsAllWorkflowTasksCompleted}"
                                                                     Minimum="0" Maximum="100"
                                                                     Value="{Binding WorkflowProgressPercent}" />
                                                        <Border Grid.Column="4" Classes="taskRatioBadge"
                                                                Classes.done="{Binding IsAllWorkflowTasksCompleted}">
                                                            <TextBlock Text="{Binding WorkflowProgressRatioText}" />
                                                        </Border>
                                                        <lucide:LucideIcon Grid.Column="5" Classes="chevronPop" Classes.open="{Binding IsWorkflowTasksExpanded}"
                                                                           Kind="ChevronDown" Size="11" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                                <common:SmoothCollapse IsExpanded="{Binding IsWorkflowTasksListVisible}">
                                                    <ItemsControl ItemsSource="{Binding WorkflowTasks}" Margin="6,5,6,6">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate><StackPanel Spacing="2" /></ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="gui:WorkflowTaskViewModel">
                                                                <Border Classes="taskRow"
                                                                        Classes.active="{Binding IsInProgress}"
                                                                        Classes.done="{Binding IsCompleted}"
                                                                        Classes.failed="{Binding IsFailed}">
                                                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" ColumnSpacing="7">
                                                                        <Border Grid.Column="0" Classes="taskRail"
                                                                                Classes.active="{Binding IsInProgress}"
                                                                                Classes.done="{Binding IsCompleted}"
                                                                                Classes.failed="{Binding IsFailed}" />
                                                                        <Panel Grid.Column="1" Width="14" Height="14" VerticalAlignment="Center">
                                                                            <arc:ArcSpinner Width="12" Height="12"
                                                                                            Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                                                                            IsVisible="{Binding IsInProgress}" />
                                                                            <lucide:LucideIcon Kind="CircleCheck" Size="13"
                                                                                               Foreground="#22C55E"
                                                                                               IsVisible="{Binding IsCompleted}" />
                                                                            <lucide:LucideIcon Kind="CircleAlert" Size="13"
                                                                                               Foreground="#EF4444"
                                                                                               IsVisible="{Binding IsFailed}" />
                                                                            <lucide:LucideIcon Kind="Circle" Size="12"
                                                                                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                                               Opacity="0.55"
                                                                                               IsVisible="{Binding IsPending}" />
                                                                        </Panel>
                                                                        <TextBlock Grid.Column="2" Classes="taskIndex"
                                                                                   Classes.active="{Binding IsInProgress}"
                                                                                   Classes.done="{Binding IsCompleted}"
                                                                                   Text="{Binding DisplayId}"
                                                                                   VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Column="3" Spacing="1" VerticalAlignment="Center">
                                                                            <TextBlock Classes="taskTitle"
                                                                                       Classes.active="{Binding IsInProgress}"
                                                                                       Classes.done="{Binding IsCompleted}"
                                                                                       Classes.failed="{Binding IsFailed}"
                                                                                       Text="{Binding Title}"
                                                                                       MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                                            <TextBlock Classes="hint"
                                                                                       IsVisible="{Binding HasActiveForm}"
                                                                                       Text="{Binding ActiveForm}"
                                                                                       FontSize="10.5"
                                                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                            <Border IsVisible="{Binding IsInProgress}"
                                                                                    Padding="6,1" CornerRadius="999"
                                                                                    Background="{arc:ArcDesignTokenResource AccentSubtle}">
                                                                                <TextBlock FontSize="10" FontWeight="SemiBold"
                                                                                           Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                                                                           Text="{l:AppLangResource AgentGuiTaskInProgress}" />
                                                                            </Border>
                                                                            <Button Classes="composerChip" Height="18" Padding="5,0"
                                                                                    IsVisible="{Binding HasOwner}" Command="{Binding FocusOwnerCommand}">
                                                                                <TextBlock FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}" FontSize="10" Text="{Binding Owner}" />
                                                                            </Button>
                                                                            <Border IsVisible="{Binding HasBlockedBy}" Padding="5,0" CornerRadius="4" Background="#22E4B445">
                                                                                <TextBlock FontSize="10" Foreground="{arc:ArcDesignTokenResource Warning}" Text="{Binding BlockedByText}" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </common:SmoothCollapse>
                                            </StackPanel>
                                        </StackPanel>
                                    </arc:ScrollArea>
                                </Border>
                            </common:SmoothCollapse>
                        </StackPanel>
                    </Border>
                </common:SmoothCollapse>

                <!-- Docked queued prompts tray above composer -->
                <common:SmoothCollapse IsExpanded="{Binding HasQueuedPrompts}">
                    <Border x:Name="QueuedPromptsTray"
                            Classes="queueTray"
                            Classes.paused="{Binding IsQueuePaused}">
                        <StackPanel Spacing="0">
                            <!-- Queue Tray Header -->
                            <Border Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                    Padding="8,4">
                                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4">
                                    <Button Grid.Column="0" Classes="row" Padding="2,1"
                                            Command="{Binding ToggleQueueExpandedCommand}"
                                            AutomationProperties.Name="{l:AppLangResource AgentGuiQueueToggle}"
                                            arc:Tooltip.Tip="{l:AppLangResource AgentGuiQueueToggle}">
                                        <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6">
                                            <lucide:LucideIcon Grid.Column="0"
                                                               Kind="Clock" Size="12"
                                                               IsVisible="{Binding !IsQueuePaused}"
                                                               Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                                               VerticalAlignment="Center" />
                                            <lucide:LucideIcon Grid.Column="0"
                                                               Kind="Pause" Size="12"
                                                               IsVisible="{Binding IsQueuePaused}"
                                                               Foreground="{arc:ArcDesignTokenResource Warning}"
                                                               VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                       Text="{Binding QueuedBadgeText}"
                                                       VerticalAlignment="Center" />
                                            <Border Grid.Column="2"
                                                    IsVisible="{Binding IsQueuePaused}"
                                                    Padding="5,0"
                                                    CornerRadius="4"
                                                    Background="{arc:ArcDesignTokenResource Surface}"
                                                    BorderBrush="{arc:ArcDesignTokenResource Warning}"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <TextBlock FontSize="10" FontWeight="SemiBold"
                                                           Foreground="{arc:ArcDesignTokenResource Warning}"
                                                           Text="{l:AppLangResource AgentGuiQueuePaused}" />
                                            </Border>
                                            <TextBlock Grid.Column="3"
                                                       IsVisible="{Binding ShowCollapsedQueuePreview}"
                                                       Classes="hint"
                                                       MaxLines="1"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding FirstQueuedPreview}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>

                                    <arc:Button Grid.Column="1"
                                                x:Name="ResumeQueueButton"
                                                Size="Small" Variant="Secondary"
                                                IsVisible="{Binding ShowResumeQueueButton}"
                                                Command="{Binding ResumeQueueCommand}">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <lucide:LucideIcon Kind="Play" Size="10" Foreground="{arc:ArcDesignTokenResource AccentStrong}" VerticalAlignment="Center" />
                                            <TextBlock FontSize="11" Text="{l:AppLangResource AgentGuiQueueResume}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </arc:Button>

                                    <Button Grid.Column="2"
                                            x:Name="ClearQueueButton"
                                            Classes="composerChip" Height="22" Padding="6,0"
                                            Command="{Binding ClearQueuedPromptsCommand}"
                                            AutomationProperties.Name="{l:AppLangResource AgentGuiQueueClear}"
                                            arc:Tooltip.Tip="{l:AppLangResource AgentGuiQueueClear}">
                                        <StackPanel Orientation="Horizontal" Spacing="3">
                                            <lucide:LucideIcon Kind="Trash2" Size="11" VerticalAlignment="Center" />
                                            <TextBlock FontSize="11" Text="{l:AppLangResource AgentGuiQueueClear}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Grid.Column="3"
                                            x:Name="ToggleQueueExpandButton"
                                            Classes="composerChip" Width="22" Height="22" Padding="0"
                                            Command="{Binding ToggleQueueExpandedCommand}"
                                            AutomationProperties.Name="{l:AppLangResource AgentGuiQueueToggle}"
                                            arc:Tooltip.Tip="{l:AppLangResource AgentGuiQueueToggle}">
                                        <lucide:LucideIcon Classes="chevronPop" Classes.open="{Binding IsQueueExpanded}"
                                                           Kind="ChevronDown" Size="12"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>
                            </Border>

                            <!-- Collapsible Scrollable Queue List -->
                            <common:SmoothCollapse IsExpanded="{Binding IsQueueExpanded}">
                                <Border BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                        BorderThickness="0,1,0,0">
                                    <arc:ScrollArea MaxHeight="168" Orientation="Vertical" FadeLength="0" Padding="5,4">
                                        <ItemsControl x:Name="QueuedPromptsList" ItemsSource="{Binding QueuedPrompts}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="2" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="gui:QueuedPrompt">
                                                    <Border Classes="queueItem">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                                            <!-- 1-based queue order badge -->
                                                            <Border Grid.Column="0"
                                                                    Classes="queueIndex"
                                                                    Classes.next="{Binding IsNext}"
                                                                    Width="18" Height="18"
                                                                    CornerRadius="4"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding PositionText}"
                                                                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                           FontSize="10.5"
                                                                           FontWeight="SemiBold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>

                                                            <!-- Prompt preview with full-text tooltip -->
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding PreviewText}"
                                                                       arc:Tooltip.Tip="{Binding FullTooltip}"
                                                                       FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                       Foreground="{arc:ArcDesignTokenResource Foreground}"
                                                                       MaxLines="1"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center" />

                                                            <!-- Attachment count badge -->
                                                            <Border Grid.Column="2"
                                                                    IsVisible="{Binding HasAttachments}"
                                                                    Padding="5,1" CornerRadius="4"
                                                                    Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                                                    BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                                                                    BorderThickness="1"
                                                                    VerticalAlignment="Center"
                                                                    arc:Tooltip.Tip="{Binding AttachmentTooltip}">
                                                                <StackPanel Orientation="Horizontal" Spacing="3">
                                                                    <lucide:LucideIcon Kind="{Binding AttachmentIcon}" Size="10"
                                                                                       Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                                                                       VerticalAlignment="Center" />
                                                                    <TextBlock Text="{Binding AttachmentCount}"
                                                                               FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                               FontSize="10"
                                                                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                                               VerticalAlignment="Center" />
                                                                </StackPanel>
                                                            </Border>

                                                            <!-- Per-item quick actions -->
                                                            <StackPanel Grid.Column="3" Classes="queueActions" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                                                <Button Classes="queueSendNowChip"
                                                                        Command="{Binding SendNowCommand}"
                                                                        AutomationProperties.Name="{l:AppLangResource AgentGuiSendNow}"
                                                                        arc:Tooltip.Tip="{l:AppLangResource AgentGuiQueueSendNowItemTip}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                                        <lucide:LucideIcon Kind="Zap" Size="10.5" VerticalAlignment="Center" />
                                                                        <TextBlock FontSize="10.5" FontWeight="Medium"
                                                                                   Text="{l:AppLangResource AgentGuiSendNow}"
                                                                                   VerticalAlignment="Center" />
                                                                    </StackPanel>
                                                                </Button>
                                                                <arc:Button Classes="icon" Variant="Ghost"
                                                                            IsVisible="{Binding CanMoveUp}"
                                                                            Command="{Binding MoveUpCommand}"
                                                                            AutomationProperties.Name="{l:AppLangResource AgentGuiQueueMoveUpTip}"
                                                                            arc:Tooltip.Tip="{l:AppLangResource AgentGuiQueueMoveUpTip}">
                                                                    <lucide:LucideIcon Kind="ArrowUp" Size="11" />
                                                                </arc:Button>
                                                                <arc:Button Classes="icon" Variant="Ghost"
                                                                            IsVisible="{Binding CanMoveDown}"
                                                                            Command="{Binding MoveDownCommand}"
                                                                            AutomationProperties.Name="{l:AppLangResource AgentGuiQueueMoveDownTip}"
                                                                            arc:Tooltip.Tip="{l:AppLangResource AgentGuiQueueMoveDownTip}">
                                                                    <lucide:LucideIcon Kind="ArrowDown" Size="11" />
                                                                </arc:Button>
                                                                <arc:Button Classes="icon" Variant="Ghost"
                                                                            Command="{Binding EditCommand}"
                                                                            AutomationProperties.Name="{l:AppLangResource AgentGuiQueueEditItemTip}"
                                                                            arc:Tooltip.Tip="{l:AppLangResource AgentGuiQueueEditItemTip}">
                                                                    <lucide:LucideIcon Kind="Pencil" Size="11" />
                                                                </arc:Button>
                                                                <arc:Button Classes="icon" Variant="Ghost"
                                                                            Command="{Binding RemoveCommand}"
                                                                            AutomationProperties.Name="{l:AppLangResource AgentGuiQueueRemoveItemTip}"
                                                                            arc:Tooltip.Tip="{l:AppLangResource AgentGuiQueueRemoveItemTip}">
                                                                    <lucide:LucideIcon Kind="X" Size="11" />
                                                                </arc:Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </arc:ScrollArea>
                                </Border>
                            </common:SmoothCollapse>
                        </StackPanel>
                    </Border>
                </common:SmoothCollapse>

                <!-- Inline '/' Slash Commands Picker (lazy-mounted, supports Up/Down/Enter/Tab) -->
                <common:SmoothCollapse IsExpanded="{Binding IsCommandPopupOpen}" LazyData="{Binding}">
                    <common:SmoothCollapse.ContentTemplate>
                        <DataTemplate x:DataType="gui:AgentGuiTabViewModel">
                            <Border Background="{arc:ArcDesignTokenResource Surface}"
                                    BorderBrush="{arc:ArcDesignTokenResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4"
                                    MaxHeight="170">
                                <arc:ScrollArea Orientation="Vertical" FadeLength="0">
                                    <ItemsControl ItemsSource="{Binding FilteredCommands}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="gui:SlashCommandSuggestion">
                                                <Button Classes="row" Classes.selected="{Binding IsSelected}" Padding="7,4"
                                                        Command="{Binding $parent[gui:AgentGuiTabView].((gui:AgentGuiTabViewModel)DataContext).InsertSlashCommandCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                        <TextBlock Text="{Binding DisplayName}"
                                                                   FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                   FontSize="12" FontWeight="SemiBold"
                                                                   Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                                                        <TextBlock Grid.Column="1" Classes="hint" Text="{Binding Description}"
                                                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </arc:ScrollArea>
                            </Border>
                        </DataTemplate>
                    </common:SmoothCollapse.ContentTemplate>
                </common:SmoothCollapse>

                <!-- Inline '@' Unified Mention Picker (active sessions, agents to delegate, and workspace files) -->
                <common:SmoothCollapse IsExpanded="{Binding IsFilePopupOpen}" LazyData="{Binding}">
                    <common:SmoothCollapse.ContentTemplate>
                        <DataTemplate x:DataType="gui:AgentGuiTabViewModel">
                            <Border Background="{arc:ArcDesignTokenResource Surface}"
                                    BorderBrush="{arc:ArcDesignTokenResource Border}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="4"
                                    MaxHeight="210">
                                <arc:ScrollArea Orientation="Vertical" FadeLength="0">
                                    <ItemsControl ItemsSource="{Binding FilteredFiles}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="gui:FileMentionSuggestion">
                                                <Button Classes="row" Classes.selected="{Binding IsSelected}" Padding="7,4"
                                                        Command="{Binding $parent[gui:AgentGuiTabView].((gui:AgentGuiTabViewModel)DataContext).InsertFileMentionCommand}"
                                                        CommandParameter="{Binding}">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="6">
                                                        <Panel VerticalAlignment="Center">
                                                            <common:AgentIcon IsVisible="{Binding HasAgentIcon}" AgentId="{Binding AgentId}" AgentName="{Binding RelativePath}" Size="13" VerticalAlignment="Center" />
                                                            <lucide:LucideIcon IsVisible="{Binding IsFile}" Kind="FileCode" Size="12" Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                                                        </Panel>
                                                        <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                                   FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Classes="hint" IsVisible="{Binding HasSubtitle}"
                                                                   Text="{Binding Subtitle}" FontSize="10.5" VerticalAlignment="Center" />
                                                        <Border Grid.Column="3" IsVisible="{Binding HasKindBadge}"
                                                                Padding="5,0" CornerRadius="4"
                                                                Background="{arc:ArcDesignTokenResource AccentSubtle}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding KindBadge}" FontSize="10" FontWeight="SemiBold"
                                                                       Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                                                        </Border>
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </arc:ScrollArea>
                            </Border>
                        </DataTemplate>
                    </common:SmoothCollapse.ContentTemplate>
                </common:SmoothCollapse>

                <!-- Sleek Unified Floating Composer Card (frameless input + dynamic popover pills) -->
                <Border x:Name="ComposerCard"
                        Classes="composerCard"
                        Padding="{DynamicResource OctopusAgentGuiComposerPadding}">
                    <StackPanel Spacing="6">
                        <!-- Attached file / image chips -->
                        <ItemsControl ItemsSource="{Binding Attachments}" IsVisible="{Binding HasAttachments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="gui:AttachmentChipViewModel">
                                    <Border Margin="0,0,4,2" Padding="5,2" CornerRadius="5"
                                            Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <lucide:LucideIcon Kind="{Binding Icon}" Size="11" VerticalAlignment="Center" />
                                            <TextBlock Classes="hint" Text="{Binding Label}" VerticalAlignment="Center" />
                                            <Button Classes="row" Width="14" Height="14" Command="{Binding RemoveChipCommand}">
                                                <lucide:LucideIcon Kind="X" Size="10" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Frameless prompt input -->
                        <TextBox x:Name="ComposerInput"
                                 Classes="composerInput"
                                 Text="{Binding InputText, Mode=TwoWay}"
                                 PlaceholderText="{Binding ComposerPlaceholder}"
                                 AutomationProperties.Name="{Binding ComposerPlaceholder}" />

                        <!-- Compact Dynamic Agent-Driven Toolbar -->
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <arc:Button x:Name="SlashCommandsButton"
                                            Classes="icon" Variant="Ghost" Margin="0,0,2,0"
                                            IsVisible="{Binding Composer.SupportsSlashCommands}"
                                            Command="{Binding ToggleCommandPopupCommand}"
                                            AutomationProperties.Name="{l:AppLangResource AgentGuiSlashCommands}"
                                            arc:Tooltip.Tip="{l:AppLangResource AgentGuiSlashCommands}">
                                    <lucide:LucideIcon Kind="Slash" Size="13" />
                                </arc:Button>

                                <arc:Button x:Name="FileMentionButton"
                                            Classes="icon" Variant="Ghost" Margin="0,0,2,0"
                                            IsVisible="{Binding Composer.SupportsFileMentions}"
                                            Command="{Binding ToggleFilePopupCommand}"
                                            AutomationProperties.Name="{l:AppLangResource AgentGuiMentionFile}"
                                            arc:Tooltip.Tip="{l:AppLangResource AgentGuiMentionFile}">
                                    <lucide:LucideIcon Kind="AtSign" Size="13" />
                                </arc:Button>

                                <Button x:Name="CollabRouteModeButton"
                                        Classes="composerChip"
                                        Classes.active="{Binding IsDirectRelayMode}"
                                        Margin="0,0,3,0"
                                        IsVisible="{Binding HasSessionMention}"
                                        Command="{Binding ToggleRouteModeCommand}"
                                        arc:Tooltip.Tip="{l:AppLangResource CollabRouteToggleTip}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <lucide:LucideIcon Kind="Send" Size="11" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RouteModeLabel}" FontSize="{arc:ArcDesignTokenResource TypeXS}" FontWeight="Medium" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <arc:Button x:Name="ImageAttachButton"
                                            Classes="icon" Variant="Ghost" Margin="0,0,4,0"
                                            IsVisible="{Binding Composer.SupportsImageAttachments}"
                                            Command="{Binding PickImageCommand}"
                                            AutomationProperties.Name="{l:AppLangResource AgentGuiAttachImage}"
                                            arc:Tooltip.Tip="{l:AppLangResource AgentGuiAttachImage}">
                                    <lucide:LucideIcon Kind="ImagePlus" Size="13" />
                                </arc:Button>

                                <!-- Dynamic Mode Selector (upward popover) -->
                                <arc:Popover x:Name="ModePickerPopover"
                                             Margin="0,0,3,0"
                                             Placement="Top" Alignment="Start" Offset="6"
                                             IsVisible="{Binding Composer.ShowModeSelector}"
                                             IsOpen="{Binding Composer.IsModePickerOpen, Mode=TwoWay}">
                                    <arc:Popover.Trigger>
                                        <Button x:Name="ModeSelector"
                                                Classes="composerChip"
                                                Classes.open="{Binding Composer.IsModePickerOpen}"
                                                AutomationProperties.Name="{l:AppLangResource AgentGuiModeLabel}"
                                                arc:Tooltip.Tip="{l:AppLangResource AgentGuiModeLabel}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <lucide:LucideIcon Kind="Layers" Size="12" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Composer.SelectedModeLabel}"
                                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                           FontWeight="Medium"
                                                           MaxWidth="120"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <lucide:LucideIcon Classes="chevronPop" Classes.open="{Binding Composer.IsModePickerOpen}"
                                                                   Kind="ChevronDown" Size="11" Opacity="0.7" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </arc:Popover.Trigger>
                                    <StackPanel MinWidth="200" MaxWidth="280" Spacing="1">
                                        <TextBlock Classes="hint" Margin="8,4,8,4" Text="{l:AppLangResource AgentGuiModeLabel}" />
                                        <arc:ScrollArea MaxHeight="240" Orientation="Vertical" FadeLength="0">
                                            <ItemsControl ItemsSource="{Binding Composer.ModeChoices}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="gui:ComposerChoiceItem">
                                                        <Button Classes="row" Classes.selected="{Binding IsSelected}" Padding="8,5"
                                                                Command="{Binding SelectCommand}">
                                                            <Grid ColumnDefinitions="*,18" ColumnSpacing="8">
                                                                <StackPanel Spacing="1">
                                                                    <TextBlock Classes="body" FontSize="{arc:ArcDesignTokenResource TypeXS}" FontWeight="Medium" Text="{Binding Label}" />
                                                                    <TextBlock Classes="hint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                                <lucide:LucideIcon Grid.Column="1" Kind="Check" Size="13"
                                                                                   Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                                                                   IsVisible="{Binding IsSelected}"
                                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </arc:ScrollArea>
                                    </StackPanel>
                                </arc:Popover>

                                <!-- Dynamic Permission Selector (upward popover with semantic shield icon) -->
                                <arc:Popover x:Name="PermissionPickerPopover"
                                             Margin="0,0,3,0"
                                             Placement="Top" Alignment="Start" Offset="6"
                                             IsVisible="{Binding Composer.ShowPermissionSelector}"
                                             IsOpen="{Binding Composer.IsPermissionPickerOpen, Mode=TwoWay}">
                                    <arc:Popover.Trigger>
                                        <Button x:Name="PermissionSelector"
                                                Classes="composerChip"
                                                Classes.open="{Binding Composer.IsPermissionPickerOpen}"
                                                Classes.danger="{Binding Composer.IsPermissionDanger}"
                                                AutomationProperties.Name="{l:AppLangResource AgentGuiPermissionLabel}"
                                                arc:Tooltip.Tip="{l:AppLangResource AgentGuiPermissionLabel}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <lucide:LucideIcon Kind="{Binding Composer.PermissionIcon}" Size="12" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Composer.SelectedPermissionLabel}"
                                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                           FontWeight="Medium"
                                                           MaxWidth="130"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <lucide:LucideIcon Classes="chevronPop" Classes.open="{Binding Composer.IsPermissionPickerOpen}"
                                                                   Kind="ChevronDown" Size="11" Opacity="0.7" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </arc:Popover.Trigger>
                                    <StackPanel Width="220" Spacing="1">
                                        <TextBlock Classes="hint" Margin="8,4,8,4" Text="{l:AppLangResource AgentGuiPermissionLabel}" />
                                        <ItemsControl ItemsSource="{Binding Composer.PermissionChoices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="gui:ComposerChoiceItem">
                                                    <Button Classes="row" Classes.selected="{Binding IsSelected}" Padding="8,5"
                                                            Command="{Binding SelectCommand}">
                                                        <Grid ColumnDefinitions="Auto,*,18" ColumnSpacing="7">
                                                            <lucide:LucideIcon Classes="permIcon" Classes.danger="{Binding IsDanger}"
                                                                               Kind="{Binding DisplayIcon}" Size="13" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1" Classes="body" FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                       Text="{Binding Label}" VerticalAlignment="Center" />
                                                            <lucide:LucideIcon Grid.Column="2" Kind="Check" Size="13"
                                                                               Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                                                               IsVisible="{Binding IsSelected}"
                                                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </arc:Popover>

                                <!-- Dynamic Model Selector (wide searchable upward popover — zero model-name truncation) -->
                                <arc:Popover x:Name="ModelPickerPopover"
                                             Margin="0,0,3,0"
                                             Placement="Top" Alignment="Start" Offset="6"
                                             IsVisible="{Binding Composer.ShowModelSelector}"
                                             IsOpen="{Binding Composer.IsModelPickerOpen, Mode=TwoWay}">
                                    <arc:Popover.Trigger>
                                        <Button x:Name="ModelSelector"
                                                Classes="composerChip"
                                                Classes.open="{Binding Composer.IsModelPickerOpen}"
                                                AutomationProperties.Name="{l:AppLangResource AgentGuiModelLabel}"
                                                arc:Tooltip.Tip="{Binding Composer.SelectedModelLabel}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <common:ModelIconView IconKey="{Binding Composer.SelectedModelIconKey}" Size="13" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Composer.SelectedModelLabel}"
                                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                           FontWeight="Medium"
                                                           MaxWidth="210"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <lucide:LucideIcon Classes="chevronPop" Classes.open="{Binding Composer.IsModelPickerOpen}"
                                                                   Kind="ChevronDown" Size="11" Opacity="0.7" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </arc:Popover.Trigger>
                                    <StackPanel Width="320" Spacing="4">
                                        <arc:SearchField x:Name="ModelSearchBox"
                                                         Margin="2,2,2,0"
                                                         Size="Small"
                                                         IsLabelVisible="False"
                                                         IsVisible="{Binding Composer.ShowModelSearch}"
                                                         Label="{l:AppLangResource SearchModels}"
                                                         Placeholder="{l:AppLangResource SearchModels}"
                                                         Text="{Binding Composer.ModelSearchQuery, Mode=TwoWay}" />
                                        <TextBlock Classes="hint" Margin="8,4,8,2"
                                                   IsVisible="{Binding !Composer.ShowModelSearch}"
                                                   Text="{l:AppLangResource AgentGuiModelLabel}" />
                                        <arc:ScrollArea MaxHeight="280" Orientation="Vertical" FadeLength="0">
                                            <StackPanel Spacing="1">
                                                <TextBlock Classes="hint"
                                                           Margin="10,12"
                                                           HorizontalAlignment="Center"
                                                           IsVisible="{Binding Composer.ShowNoModelMatches}"
                                                           Text="{l:AppLangResource ExplorerNoMatches}" />
                                                <ItemsControl ItemsSource="{Binding Composer.FilteredModelChoices}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Spacing="1" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="gui:ComposerChoiceItem">
                                                            <Button Classes="row" Classes.selected="{Binding IsSelected}" Padding="8,5"
                                                                    Command="{Binding SelectCommand}"
                                                                    AutomationProperties.Name="{Binding Label}">
                                                                <Grid ColumnDefinitions="Auto,*,Auto,18" ColumnSpacing="8">
                                                                    <common:ModelIconView Grid.Column="0" IconKey="{Binding ModelIconKey}" Size="15" VerticalAlignment="Center" />
                                                                    <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                                        <TextBlock Classes="body" FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                                   Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                                        <TextBlock Classes="hint" Text="{Binding Description}"
                                                                                   IsVisible="{Binding HasDescription}" TextTrimming="CharacterEllipsis" />
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="2" Classes="hint"
                                                                               FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                               Text="{Binding Meta}"
                                                                               IsVisible="{Binding HasMeta}"
                                                                               MaxWidth="96"
                                                                               TextTrimming="CharacterEllipsis"
                                                                               VerticalAlignment="Center" />
                                                                    <lucide:LucideIcon Grid.Column="3" Kind="Check" Size="13"
                                                                                       Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                                                                       IsVisible="{Binding IsSelected}"
                                                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button x:Name="UseCustomModelButton"
                                                        Classes="row" Padding="8,5"
                                                        IsVisible="{Binding Composer.CanUseCustomModelQuery}"
                                                        Command="{Binding Composer.UseCustomModelQueryCommand}"
                                                        AutomationProperties.Name="{Binding Composer.CustomModelOptionLabel}">
                                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                        <lucide:LucideIcon Kind="Plus" Size="12"
                                                                           Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                                                           VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Classes="body"
                                                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                                   Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                                                   Text="{Binding Composer.CustomModelOptionLabel}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </arc:ScrollArea>
                                    </StackPanel>
                                </arc:Popover>

                                <!-- Dynamic Effort / Thought-Level Selector (shown ONLY when active ACP session supports it) -->
                                <arc:Popover x:Name="EffortPickerPopover"
                                             Margin="0,0,3,0"
                                             Placement="Top" Alignment="Start" Offset="6"
                                             IsVisible="{Binding Composer.ShowEffortSelector}"
                                             IsOpen="{Binding Composer.IsEffortPickerOpen, Mode=TwoWay}">
                                    <arc:Popover.Trigger>
                                        <Button x:Name="EffortSelector"
                                                Classes="composerChip"
                                                Classes.open="{Binding Composer.IsEffortPickerOpen}"
                                                AutomationProperties.Name="{l:AppLangResource AgentGuiEffortLabel}"
                                                arc:Tooltip.Tip="{l:AppLangResource AgentGuiEffortLabel}">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <lucide:LucideIcon Kind="Gauge" Size="12" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding Composer.SelectedEffortLabel}"
                                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                                           FontWeight="Medium"
                                                           MaxWidth="110"
                                                           TextTrimming="CharacterEllipsis"
                                                           VerticalAlignment="Center" />
                                                <lucide:LucideIcon Classes="chevronPop" Classes.open="{Binding Composer.IsEffortPickerOpen}"
                                                                   Kind="ChevronDown" Size="11" Opacity="0.7" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </arc:Popover.Trigger>
                                    <StackPanel MinWidth="180" MaxWidth="240" Spacing="1">
                                        <TextBlock Classes="hint" Margin="8,4,8,4" Text="{l:AppLangResource AgentGuiEffortLabel}" />
                                        <ItemsControl ItemsSource="{Binding Composer.EffortChoices}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="gui:ComposerChoiceItem">
                                                    <Button Classes="row" Classes.selected="{Binding IsSelected}" Padding="8,5"
                                                            Command="{Binding SelectCommand}">
                                                        <Grid ColumnDefinitions="*,18" ColumnSpacing="8">
                                                            <StackPanel Spacing="1">
                                                                <TextBlock Classes="body" FontSize="{arc:ArcDesignTokenResource TypeXS}" Text="{Binding Label}" />
                                                                <TextBlock Classes="hint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                            <lucide:LucideIcon Grid.Column="1" Kind="Check" Size="13"
                                                                               Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                                                               IsVisible="{Binding IsSelected}"
                                                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </arc:Popover>

                                <!-- Dynamic Fast Toggle Pill (ONLY when active ACP session supports it) -->
                                <Button x:Name="FastToggleGroup"
                                        Classes="composerChip"
                                        Classes.active="{Binding Composer.FastMode}"
                                        Margin="0,0,3,0"
                                        IsVisible="{Binding Composer.ShowFastToggle}"
                                        Command="{Binding Composer.ToggleFastCommand}"
                                        AutomationProperties.Name="{l:AppLangResource AgentGuiFastLabel}"
                                        arc:Tooltip.Tip="{l:AppLangResource AgentGuiFastLabel}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <lucide:LucideIcon Kind="Zap" Size="12" VerticalAlignment="Center" />
                                        <TextBlock FontSize="{arc:ArcDesignTokenResource TypeXS}" FontWeight="Medium"
                                                   Text="{l:AppLangResource AgentGuiFastLabel}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Dynamic Thinking Toggle Pill (ONLY when active ACP session supports it) -->
                                <Button x:Name="ThinkingToggleGroup"
                                        Classes="composerChip"
                                        Classes.active="{Binding Composer.ThinkingEnabled}"
                                        Margin="0,0,3,0"
                                        IsVisible="{Binding Composer.ShowThinkingToggle}"
                                        Command="{Binding Composer.ToggleThinkingCommand}"
                                        AutomationProperties.Name="{l:AppLangResource AgentGuiThinkingLabel}"
                                        arc:Tooltip.Tip="{l:AppLangResource AgentGuiThinkingLabel}">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <lucide:LucideIcon Kind="Brain" Size="12" VerticalAlignment="Center" />
                                        <TextBlock FontSize="{arc:ArcDesignTokenResource TypeXS}" FontWeight="Medium"
                                                   Text="{l:AppLangResource AgentGuiThinkingLabel}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Generic Custom ACP ConfigOptions Popover (ONLY when unmapped options exist) -->
                                <arc:Popover x:Name="CustomOptionsPickerPopover"
                                             Margin="0,0,3,0"
                                             Placement="Top" Alignment="Start" Offset="6"
                                             IsVisible="{Binding Composer.ShowCustomOptionsButton}"
                                             IsOpen="{Binding Composer.IsCustomOptionsPickerOpen, Mode=TwoWay}">
                                    <arc:Popover.Trigger>
                                        <Button x:Name="CustomOptionsSelector"
                                                Classes="composerChip"
                                                Classes.open="{Binding Composer.IsCustomOptionsPickerOpen}"
                                                AutomationProperties.Name="{l:AppLangResource AgentGuiCustomOptionsLabel}"
                                                arc:Tooltip.Tip="{l:AppLangResource AgentGuiCustomOptionsLabel}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <lucide:LucideIcon Kind="SlidersHorizontal" Size="12" VerticalAlignment="Center" />
                                                <TextBlock FontSize="{arc:ArcDesignTokenResource TypeXS}" FontWeight="Medium"
                                                           Text="{l:AppLangResource AgentGuiCustomOptionsLabel}" VerticalAlignment="Center" />
                                                <lucide:LucideIcon Classes="chevronPop" Classes.open="{Binding Composer.IsCustomOptionsPickerOpen}"
                                                                   Kind="ChevronDown" Size="11" Opacity="0.7" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </arc:Popover.Trigger>
                                    <StackPanel Width="260" Spacing="6">
                                        <TextBlock Classes="hint" Margin="6,2,6,0" Text="{l:AppLangResource AgentGuiCustomOptionsLabel}" />
                                        <arc:ScrollArea MaxHeight="280" Orientation="Vertical" FadeLength="0">
                                            <ItemsControl ItemsSource="{Binding Composer.CustomConfigOptions}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="gui:CustomConfigOptionViewModel">
                                                        <Border Padding="6,5" BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="0,0,0,1">
                                                            <StackPanel Spacing="4">
                                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                                                        <TextBlock Classes="body" FontSize="{arc:ArcDesignTokenResource TypeXS}" FontWeight="Medium" Text="{Binding Name}" />
                                                                        <TextBlock Classes="hint" Text="{Binding Description}" IsVisible="{Binding HasDescription}" TextWrapping="Wrap" />
                                                                    </StackPanel>
                                                                    <arc:Switch Grid.Column="1" VerticalAlignment="Center"
                                                                                IsVisible="{Binding IsBoolean}"
                                                                                IsChecked="{Binding BoolValue, Mode=TwoWay}" />
                                                                </Grid>
                                                                <ItemsControl ItemsSource="{Binding Choices}" IsVisible="{Binding IsSelect}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel Orientation="Horizontal" />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="gui:ComposerChoiceItem">
                                                                            <Button Classes="chipChoice" Classes.selected="{Binding IsSelected}"
                                                                                    Margin="0,0,4,4" Padding="6,2"
                                                                                    Command="{Binding SelectCommand}">
                                                                                <TextBlock Classes="body" FontSize="11" Text="{Binding Label}" />
                                                                            </Button>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </arc:ScrollArea>
                                    </StackPanel>
                                </arc:Popover>
                            </WrapPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Classes="hint" Opacity="0.6" VerticalAlignment="Center"
                                           IsVisible="{Binding !IsTurnActive}"
                                           Text="{l:AppLangResource AgentGuiComposerHint}" />
                                <arc:Button x:Name="SendButton"
                                            Size="Small"
                                            Classes.loading="{Binding ShowComposerLoading}"
                                            Classes.canStop="{Binding CanStopFromComposerButton}"
                                            Command="{Binding ComposerActionCommand}"
                                            AutomationProperties.Name="{Binding SendButtonTooltip}"
                                            arc:Tooltip.Tip="{Binding SendButtonTooltip}">
                                    <Panel Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Panel x:Name="SendButtonLoadingVisual"
                                               IsVisible="{Binding ShowComposerLoading}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <arc:ArcSpinner x:Name="SendButtonSpinner"
                                                            Classes="loadingIcon"
                                                            Width="13" Height="13"
                                                            Foreground="{Binding $parent[arc:Button].Foreground}"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <lucide:LucideIcon x:Name="SendButtonStopIcon"
                                                               Classes="stopHoverIcon"
                                                               Kind="Square" Size="11"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Panel>
                                        <lucide:LucideIcon x:Name="SendButtonSendIcon"
                                                           Kind="ArrowUp" Size="13"
                                                           IsVisible="{Binding !ShowComposerLoading}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Panel>
                                </arc:Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Bash Style 2: Full Script Viewer Modal Overlay (lazy-mounted only while open) -->
        <Border x:Name="ScriptPreviewModal"
                Grid.RowSpan="3"
                IsVisible="{Binding ScriptPreview.IsOpen}"
                Background="#88000000"
                Padding="24">
            <ContentControl Content="{Binding ActiveScriptPreview}">
                <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="gui:ScriptPreviewViewModel">
                        <Border MaxWidth="760" MaxHeight="560"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{arc:ArcDesignTokenResource Background}"
                                BorderBrush="{arc:ArcDesignTokenResource Border}"
                                BorderThickness="1"
                                CornerRadius="12"
                                BoxShadow="0 20 56 0 #66000000"
                                ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*">
                                <Border Grid.Row="0" Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="0,0,0,1"
                                        Padding="12,8">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                                        <Border Grid.Column="0" IsVisible="{Binding HasLanguage}"
                                                Padding="6,1" CornerRadius="4" Background="{arc:ArcDesignTokenResource AccentSubtle}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Language}"
                                                       FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                       FontSize="10.5" FontWeight="SemiBold"
                                                       Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                   FontWeight="SemiBold" FontSize="12.5" MaxLines="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Classes="hint" Text="{Binding LineCountText}" VerticalAlignment="Center" />
                                        <arc:CopyButton Grid.Column="3" IsIconOnly="True" Value="{Binding FullScript}" />
                                        <arc:Button Grid.Column="4" Classes="icon" Variant="Ghost" Command="{Binding CloseCommand}">
                                            <lucide:LucideIcon Kind="X" Size="13" />
                                        </arc:Button>
                                    </Grid>
                                </Border>
                                <arc:ScrollArea Grid.Row="1" Orientation="Both" FadeLength="0" Padding="8,8">
                                    <ItemsControl ItemsSource="{Binding Lines}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Spacing="1" /></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="gui:ScriptLineViewModel">
                                                <Grid ColumnDefinitions="34,*" ColumnSpacing="10">
                                                    <TextBlock Grid.Column="0" Text="{Binding LineNumber}"
                                                               FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                               FontSize="11" HorizontalAlignment="Right" Opacity="0.45" />
                                                    <SelectableTextBlock Grid.Column="1" Text="{Binding Text}"
                                                                         FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                                                         FontSize="11.5"
                                                                         Foreground="{arc:ArcDesignTokenResource Foreground}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </arc:ScrollArea>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Border>
    </Grid>
</UserControl>
