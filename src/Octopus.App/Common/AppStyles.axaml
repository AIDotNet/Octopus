<Styles xmlns="https://github.com/avaloniaui"
        x:Class="Octopus.App.Common.AppStyles"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc">
    <!-- A whole-row button: quiet until hovered, tinted when selected. Used by the sidebar, the launcher and the tabs. -->
    <Style Selector="Button.row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Row"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Row">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        </Style>
        <Style Selector="^.selected /template/ Border#PART_Row">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Border}" />
        </Style>
    </Style>

    <!-- A project square: the project's color fills it; a picture is clipped to its rounded corners. -->
    <Style Selector="Button.chip">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" ClipToBounds="True"
                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- A small square icon button (the sidebar toggle, the "+" of the toolbar). -->
    <Style Selector="arc|Button.icon">
        <Setter Property="Width" Value="{DynamicResource OctopusIconButtonSize}" />
        <Setter Property="Height" Value="{DynamicResource OctopusIconButtonSize}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsPressScaleEnabled" Value="False" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
    </Style>
    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
    </Style>

    <!-- The info bar of a file: quiet icon buttons that are tinted while the thing they switch is on (wrap, fit). -->
    <Style Selector="arc|Button.icon.header">
        <Setter Property="Variant" Value="Ghost" />
    </Style>
    <Style Selector="arc|Button.icon.header.active">
        <Setter Property="Variant" Value="Secondary" />
    </Style>
    <Style Selector="TextBlock.headerMeta">
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Project panel title: clean text at rest, subtle pill & pencil on hover, matching the inline editor's exact frame. -->
    <Style Selector="Button.project-name">
        <Setter Property="Height" Value="{DynamicResource OctopusPanelNameHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="{DynamicResource OctopusPanelNamePadding}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Frame"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Frame">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        </Style>
        <Style Selector="^:focus-visible /template/ Border#PART_Frame">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
            <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>
    </Style>
    <Style Selector="Button.project-name :is(Control).project-name-pencil">
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Button.project-name:pointerover :is(Control).project-name-pencil">
        <Setter Property="Opacity" Value="0.85" />
    </Style>
    <Style Selector="Button.project-name:focus-visible :is(Control).project-name-pencil">
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- Active inline project-name shell: aligned with SearchField, crisp 1px accent border, no overflowing halo. -->
    <Style Selector="Border.project-name-editor">
        <Setter Property="Height" Value="{DynamicResource OctopusPanelNameHeight}" />
        <Setter Property="Padding" Value="{DynamicResource OctopusPanelNamePadding}" />
        <Setter Property="Background" Value="{arc:ArcDesignTokenResource Surface}" />
        <Setter Property="BorderBrush" Value="{arc:ArcDesignTokenResource Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
    </Style>

    <!-- Frameless single-line TextBox hosted inside Border.project-name-editor. -->
    <Style Selector="TextBox.inline-name">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{arc:ArcDesignTokenResource Foreground}" />
        <Setter Property="SelectionBrush" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
        <Setter Property="PlaceholderForeground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="Template">
            <ControlTemplate TargetType="TextBox">
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ScrollViewer Name="PART_ScrollViewer"
                                  Theme="{DynamicResource FieldScrollViewerTheme}"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled"
                                  VerticalAlignment="Center">
                        <Panel VerticalAlignment="Center">
                            <TextBlock Name="PART_Placeholder"
                                       VerticalAlignment="Center"
                                       FontWeight="Normal"
                                       Foreground="{TemplateBinding PlaceholderForeground}"
                                       Text="{TemplateBinding PlaceholderText}"
                                       TextWrapping="{TemplateBinding TextWrapping}">
                                <TextBlock.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <Binding ElementName="PART_TextPresenter" Path="PreeditText" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                        <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Text" Converter="{x:Static StringConverters.IsNullOrEmpty}" />
                                    </MultiBinding>
                                </TextBlock.IsVisible>
                            </TextBlock>
                            <TextPresenter Name="PART_TextPresenter"
                                           VerticalAlignment="Center"
                                           Text="{TemplateBinding Text, Mode=TwoWay}"
                                           CaretBlinkInterval="{TemplateBinding CaretBlinkInterval}"
                                           CaretIndex="{TemplateBinding CaretIndex}"
                                           SelectionStart="{TemplateBinding SelectionStart}"
                                           SelectionEnd="{TemplateBinding SelectionEnd}"
                                           TextWrapping="{TemplateBinding TextWrapping}"
                                           LineHeight="{TemplateBinding LineHeight}"
                                           SelectionBrush="{TemplateBinding SelectionBrush}"
                                           SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                           CaretBrush="{TemplateBinding CaretBrush}" />
                        </Panel>
                    </ScrollViewer>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Compact confirm / cancel action buttons nested inside Border.project-name-editor. -->
    <Style Selector="Button.inline-action">
        <Setter Property="Width" Value="{DynamicResource OctopusPanelNameActionSize}" />
        <Setter Property="Height" Value="{DynamicResource OctopusPanelNameActionSize}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="{arc:ArcDesignTokenResource RadiusControl}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Bg"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="Center"
                                      VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#PART_Bg">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        </Style>
        <Style Selector="^.primary">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource AccentSubtle}" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentStrong}" />
        </Style>
        <Style Selector="^.primary:pointerover">
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource AccentForeground}" />
        </Style>
        <Style Selector="^.primary:pointerover /template/ Border#PART_Bg">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Accent}" />
        </Style>
        <Style Selector="^.primary:disabled">
            <Setter Property="Opacity" Value="0.35" />
            <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        </Style>
        <Style Selector="^.primary:disabled /template/ Border#PART_Bg">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Style>
</Styles>
