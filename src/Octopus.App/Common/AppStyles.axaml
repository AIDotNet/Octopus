<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:arc="https://github.com/AIDotNet/TKCode.Arc">
    <!-- A whole-row button: quiet until hovered, tinted when selected. Used by the sidebar, the launcher and the tabs. -->
    <Style Selector="Button.row">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="PART_Row"
                        Background="{TemplateBinding Background}"
                        CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                        Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#PART_Row">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource BorderSubtle}" />
        </Style>
        <Style Selector="^.selected /template/ Border#PART_Row">
            <Setter Property="Background" Value="{arc:ArcDesignTokenResource Border}" />
        </Style>
    </Style>

    <!-- A project square: the project's color fills it; a picture is clipped to its rounded corners. -->
    <Style Selector="Button.chip">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" ClipToBounds="True"
                        CornerRadius="{arc:ArcDesignTokenResource RadiusPanel}">
                    <ContentPresenter Content="{TemplateBinding Content}"
                                      HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- A small square icon button (the sidebar toggle, the "+" of the toolbar). -->
    <Style Selector="arc|Button.icon">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="IsPressScaleEnabled" Value="False" />
    </Style>

    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.body">
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeSM}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource Foreground}" />
    </Style>
    <Style Selector="TextBlock.hint">
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
    </Style>

    <!-- The info bar of a file: quiet icon buttons that are tinted while the thing they switch is on (wrap, fit). -->
    <Style Selector="arc|Button.icon.header">
        <Setter Property="Variant" Value="Ghost" />
    </Style>
    <Style Selector="arc|Button.icon.header.active">
        <Setter Property="Variant" Value="Secondary" />
    </Style>
    <Style Selector="TextBlock.headerMeta">
        <Setter Property="FontSize" Value="{arc:ArcDesignTokenResource TypeXS}" />
        <Setter Property="Foreground" Value="{arc:ArcDesignTokenResource TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
</Styles>
