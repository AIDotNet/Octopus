<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:common="using:Octopus.App.Common"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="using:Octopus.App.Launcher"
             x:Class="Octopus.App.Launcher.AgentLaunchPanel"
             x:DataType="vm:AgentLaunchViewModel">
    <StackPanel Spacing="0">
        <!-- Scheme C: unified Source selector (Accounts / Managed Providers / Local Tunnel) sits at the TOP -->
        <StackPanel Margin="8,8,8,2" Spacing="4" IsVisible="{Binding HasBackends}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="hint" VerticalAlignment="Center" Text="{l:AppLangResource BackendSourceLabel}" />
                <arc:Button Grid.Column="1"
                            Variant="Ghost"
                            Size="Small"
                            IsVisible="{Binding CanManageProviders}"
                            Command="{Binding OpenProvidersCommand}"
                            Content="{l:AppLangResource ProvidersManageMenu}" />
            </Grid>
            <arc:Select AutoScrollToSelectedItem="False"
                        Size="Small"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{l:AppLangResource BackendSourceLabel}"
                        ItemsSource="{Binding BackendOptions}"
                        SelectedValue="{Binding SelectedBackendRef, Mode=TwoWay}" />
            <Border Padding="6,3"
                    CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                    Background="{arc:ArcDesignTokenResource AccentSubtle}"
                    IsVisible="{Binding IsTunnelSelected}">
                <TextBlock FontSize="11"
                           Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                           TextWrapping="Wrap"
                           Text="{l:AppLangResource BackendRemoteTunnelGroup}" />
            </Border>
        </StackPanel>

        <!-- model -->
        <StackPanel IsVisible="{Binding HasModel}">
            <arc:SearchField Margin="6,6,6,4" Size="Small" IsLabelVisible="False"
                             Label="{l:AppLangResource SearchModels}"
                             Placeholder="{l:AppLangResource SearchModels}"
                             Text="{Binding ModelQuery, Mode=TwoWay}" x:Name="ModelSearch" />
            <arc:ScrollArea MaxHeight="176" Margin="4,0,4,4">
                <ItemsControl ItemsSource="{Binding Models}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Spacing="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModelOptionViewModel">
                            <Button Classes="row" Height="{DynamicResource OctopusLauncherModelRowHeight}" Command="{Binding SelectCommand}"
                                    AutomationProperties.Name="{Binding Label}">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,20" ColumnSpacing="6" Margin="8,0,4,0">
                                    <common:ModelIconView Grid.Column="0" IconKey="{Binding IconKey}" Size="14" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="body" VerticalAlignment="Center" Text="{Binding Label}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="2"
                                            IsVisible="{Binding HasSourceBadge}"
                                            VerticalAlignment="Center"
                                            Padding="5,1"
                                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                            Background="{arc:ArcDesignTokenResource SurfaceMuted}">
                                        <TextBlock FontSize="10"
                                                   Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                                                   Text="{Binding SourceBadge}" />
                                    </Border>
                                    <TextBlock Grid.Column="3" Classes="hint" VerticalAlignment="Center"
                                               Text="{Binding Note}" TextTrimming="CharacterEllipsis" MaxWidth="96" />
                                    <lucide:LucideIcon Grid.Column="4" Kind="Check" Size="14" HorizontalAlignment="Right"
                                                       IsVisible="{Binding IsSelected}" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </arc:ScrollArea>
        </StackPanel>

        <StackPanel Margin="{DynamicResource OctopusLauncherSectionMargin}" Spacing="{DynamicResource OctopusLauncherSectionSpacing}">
            <!-- effort -->
            <StackPanel Spacing="4" IsVisible="{Binding HasEffort}">
                <TextBlock Classes="hint" Text="{Binding EffortCaption}" />
                <ContentControl x:Name="EffortHost" />
            </StackPanel>
            <!-- fast -->
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasFast}">
                <TextBlock Classes="body" VerticalAlignment="Center" Text="{l:AppLangResource FastMode}" />
                <arc:Switch Grid.Column="1" IsChecked="{Binding Fast, Mode=TwoWay}"
                            AutomationProperties.Name="{l:AppLangResource FastMode}" />
            </Grid>
            <!-- prompt -->
            <arc:Textarea x:Name="PromptBox" IsVisible="{Binding HasPrompt}" IsLabelVisible="False"
                          Label="{l:AppLangResource AddPrompt}" Placeholder="{l:AppLangResource AddPrompt}"
                          FrameMinHeight="56" IsResizable="False" Size="Small"
                          Text="{Binding Prompt, Mode=TwoWay}" />
        </StackPanel>

        <StackPanel Spacing="6" Margin="{DynamicResource OctopusLauncherFooterMargin}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBlock Classes="hint" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="{l:AppLangResource PermissionPrefix}" /><Run Text=" " /><Run Text="{Binding PermissionName}" />
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <arc:Button Variant="Ghost"
                                Size="Small"
                                IsVisible="{Binding CanPin}"
                                Command="{Binding PinCurrentCommand}"
                                arc:Tooltip.Tip="{l:AppLangResource ProvidersPinPreset}"
                                AutomationProperties.Name="{l:AppLangResource ProvidersPinPreset}">
                        <lucide:LucideIcon Kind="Pin" Size="13" />
                    </arc:Button>
                    <arc:Button x:Name="SecondaryLaunchButton"
                                Variant="Secondary"
                                Size="Small"
                                IsVisible="{Binding ShowDualLaunchButtons}"
                                Content="{Binding SecondaryLaunchLabel}"
                                Command="{Binding LaunchSecondaryCommand}" />
                    <arc:Button x:Name="PrimaryLaunchButton"
                                Size="Small"
                                Content="{Binding PrimaryLaunchLabel}"
                                Command="{Binding LaunchCommand}" />
                </StackPanel>
            </Grid>
            <TextBlock Classes="hint"
                       IsVisible="{Binding ShowTerminalOnlyHint}"
                       Text="{l:AppLangResource LaunchTerminalOnlyHint}" />
        </StackPanel>
    </StackPanel>
</UserControl>
