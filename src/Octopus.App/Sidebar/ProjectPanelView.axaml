<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="using:Octopus.App.Sidebar"
             x:Class="Octopus.App.Sidebar.ProjectPanelView"
             x:DataType="vm:ProjectPanelViewModel">
    <Grid x:Name="PanelRoot" Background="{arc:ArcDesignTokenResource SurfaceMuted}">
        <!-- No project yet -->
        <StackPanel IsVisible="{Binding HasNoProject}" Margin="16,24" Spacing="10" VerticalAlignment="Top">
            <TextBlock Classes="body" FontWeight="Medium" Text="{l:AppLangResource NoProjectTitle}" TextWrapping="Wrap" />
            <TextBlock Classes="hint" Text="{l:AppLangResource NoProjectHint}" TextWrapping="Wrap" />
            <arc:Button Size="Small" HorizontalAlignment="Left" Content="{l:AppLangResource NewProject}"
                        Command="{Binding NewProjectCommand}" />
        </StackPanel>

        <Grid IsVisible="{Binding HasProject}" RowDefinitions="Auto,Auto,Auto,Auto,*">
            <!-- The group the project is in: the rail shows a group's name only in its tooltip. -->
            <TextBlock Classes="caption" Margin="16,10,14,-8" IsVisible="{Binding HasGroup}"
                       Text="{Binding GroupName}" TextTrimming="CharacterEllipsis" />
            <arc:InlineEdit x:Name="NameEdit" Grid.Row="1" Margin="8,10,8,0" HeadingLevel="2" Variant="Body" FontWeight="SemiBold"
                            Label="{l:AppLangResource ProjectName}"
                            Value="{Binding ProjectName, Mode=TwoWay}" />
            <TextBlock Grid.Row="2" Margin="16,0,14,8" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                       FontSize="{arc:ArcDesignTokenResource TypeXS}" Foreground="{arc:ArcDesignTokenResource TextMuted}"
                       Text="{Binding ProjectPath}" TextTrimming="PathSegmentEllipsis"
                       arc:Tooltip.Tip="{Binding ProjectPath}" />
            <arc:SearchField Grid.Row="3" Margin="10,0,10,6" Size="Small" IsLabelVisible="False"
                             Label="{l:AppLangResource SearchInProject}"
                             Placeholder="{l:AppLangResource SearchInProject}"
                             Text="{Binding Filter, Mode=TwoWay}" />
            <arc:ScrollArea Grid.Row="4">
                <StackPanel Margin="6,0,6,8" Spacing="2">
                    <!-- Terminals and agents, one list the user arranges by dragging. -->
                    <Grid ColumnDefinitions="*,Auto" Margin="8,6,0,0">
                        <TextBlock Classes="caption" VerticalAlignment="Center" Text="{l:AppLangResource ItemList}" />
                        <arc:Button x:Name="AddItemButton" Grid.Column="1" Classes="icon" Variant="Ghost"
                                    Click="OnAddItemClick"
                                    AutomationProperties.Name="{l:AppLangResource NewItem}"
                                    arc:Tooltip.Tip="{l:AppLangResource NewItem}">
                            <lucide:LucideIcon Kind="Plus" Size="14" />
                        </arc:Button>
                    </Grid>
                    <arc:ReorderableList x:Name="ItemList" ItemsSource="{Binding Items}"
                                         Label="{l:AppLangResource ItemList}" Reordered="OnItemsReordered">
                        <arc:ReorderableList.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="1" ClipToBounds="False" />
                            </ItemsPanelTemplate>
                        </arc:ReorderableList.ItemsPanel>
                        <arc:ReorderableList.ItemTemplate>
                            <DataTemplate x:DataType="vm:ItemRowViewModel"><vm:ItemRowView /></DataTemplate>
                        </arc:ReorderableList.ItemTemplate>
                    </arc:ReorderableList>
                    <TextBlock Classes="hint" Margin="10,2" Text="{l:AppLangResource GroupEmpty}" IsVisible="{Binding NoItems}" />
                </StackPanel>
            </arc:ScrollArea>
        </Grid>
    </Grid>
</UserControl>
