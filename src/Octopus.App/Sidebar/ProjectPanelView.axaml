<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="using:Octopus.App.Sidebar"
             x:Class="Octopus.App.Sidebar.ProjectPanelView"
             x:DataType="vm:ProjectPanelViewModel">
    <Grid x:Name="PanelRoot" RowDefinitions="Auto,Auto,*" Background="{arc:ArcDesignTokenResource SurfaceMuted}">
        <!-- Option B device echo pill: complements the circular rail badge with the full device name & status. -->
        <StackPanel Grid.Row="0" IsVisible="{Binding ShowDeviceHeader}" Margin="10,8,10,0">
            <Button x:Name="DeviceEchoButton" Classes="row" HorizontalAlignment="Left" Padding="6,3"
                    Click="OnDeviceEchoClick"
                    AutomationProperties.Name="{l:AppLangResource DeviceSwitchHeader}"
                    arc:Tooltip.Tip="{l:AppLangResource DeviceSwitchHeader}" arc:Tooltip.Side="Bottom">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Panel Width="7" Height="7" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" IsVisible="{Binding Devices.CurrentDevice.IsOnlineStatus}"
                                 Fill="{arc:ArcDesignTokenResource Success}" />
                        <Ellipse Width="7" Height="7" IsVisible="{Binding Devices.CurrentDevice.IsConnecting}"
                                 Fill="{arc:ArcDesignTokenResource Warning}" />
                        <Ellipse Width="7" Height="7" IsVisible="{Binding Devices.CurrentDevice.IsOffline}"
                                 Fill="{arc:ArcDesignTokenResource TextMuted}" Opacity="0.55" />
                        <Ellipse Width="7" Height="7" IsVisible="{Binding Devices.CurrentDevice.IsSshStatus}"
                                 Fill="{arc:ArcDesignTokenResource Accent}" />
                    </Panel>
                    <TextBlock Classes="caption" FontWeight="SemiBold"
                               Foreground="{arc:ArcDesignTokenResource Foreground}"
                               Text="{Binding Devices.CurrentDevice.Name}" TextTrimming="CharacterEllipsis" MaxWidth="130" />
                    <TextBlock Classes="hint" Text="{Binding Devices.CurrentDevice.StatusText}" />
                    <lucide:LucideIcon Kind="ChevronDown" Size="11" Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
        </StackPanel>

        <!-- Offline remote host banner with quick reconnect -->
        <Border Grid.Row="1" IsVisible="{Binding ShowOfflineBanner}" Margin="10,6,10,0" Padding="8,7"
                CornerRadius="{arc:ArcDesignTokenResource RadiusControl}"
                Background="{arc:ArcDesignTokenResource Surface}"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="1">
            <StackPanel Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <arc:ArcSpinner IsVisible="{Binding Devices.CurrentDevice.IsConnecting}" Width="12" Height="12"
                                    Foreground="{arc:ArcDesignTokenResource Accent}" VerticalAlignment="Center" />
                    <lucide:LucideIcon IsVisible="{Binding Devices.CurrentDevice.IsOffline}" Kind="WifiOff" Size="13"
                                       Foreground="{arc:ArcDesignTokenResource Danger}" VerticalAlignment="Center" />
                    <TextBlock Classes="caption" FontWeight="SemiBold" Foreground="{arc:ArcDesignTokenResource Foreground}"
                               Text="{Binding Devices.OfflineBannerTitle}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Classes="hint" TextWrapping="Wrap" Text="{l:AppLangResource DeviceOfflineHint}" />
                <arc:Button Size="Small" Variant="Secondary" HorizontalAlignment="Left"
                            IsVisible="{Binding Devices.CurrentDevice.CanReconnect}"
                            Command="{Binding Devices.ReconnectCurrentCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <lucide:LucideIcon Kind="RefreshCw" Size="12" />
                        <TextBlock Text="{l:AppLangResource DeviceReconnect}" VerticalAlignment="Center" />
                    </StackPanel>
                </arc:Button>
            </StackPanel>
        </Border>

        <!-- No project yet (on this device) -->
        <StackPanel Grid.Row="2" IsVisible="{Binding HasNoProject}" Margin="16,24" Spacing="10" VerticalAlignment="Top">
            <TextBlock Classes="body" FontWeight="Medium" Text="{Binding EmptyTitle}" TextWrapping="Wrap" />
            <TextBlock Classes="hint" Text="{Binding EmptyHint}" TextWrapping="Wrap" />
            <arc:Button Size="Small" HorizontalAlignment="Left" Content="{l:AppLangResource NewProject}"
                        Command="{Binding NewProjectCommand}" />
        </StackPanel>

        <Grid Grid.Row="2" IsVisible="{Binding HasProject}" RowDefinitions="Auto,Auto,Auto,Auto,*">
            <!-- The group the project is in: the rail shows a group's name only in its tooltip. -->
            <StackPanel Orientation="Horizontal" Spacing="5" Margin="{DynamicResource OctopusPanelGroupMargin}" IsVisible="{Binding HasGroup}">
                <TextBlock Classes="caption" Text="{Binding GroupName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <lucide:LucideIcon Kind="Link" Size="11" IsVisible="{Binding IsGroupMerged}" VerticalAlignment="Center"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                   arc:Tooltip.Tip="{l:AppLangResource GroupMergedWorkspacesTag}" />
            </StackPanel>
            <Panel Grid.Row="1" Margin="{DynamicResource OctopusPanelNameMargin}">
                <Button x:Name="NameDisplayButton" Classes="project-name"
                        Click="OnNameDisplayClick"
                        AutomationProperties.Name="{l:AppLangResource ProjectName}"
                        AutomationProperties.HeadingLevel="2"
                        arc:Tooltip.Tip="{l:AppLangResource RenameProject}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                        <TextBlock x:Name="NameDisplayText"
                                   VerticalAlignment="Center"
                                   FontSize="{arc:ArcDesignTokenResource TypeBase}"
                                   FontWeight="SemiBold"
                                   Foreground="{arc:ArcDesignTokenResource Foreground}"
                                   Text="{Binding ProjectName}"
                                   TextTrimming="CharacterEllipsis" />
                        <lucide:LucideIcon x:Name="NameEditIcon" Grid.Column="1"
                                           Classes="project-name-pencil"
                                           Kind="Pencil" Size="12"
                                           Margin="0,0,2,0"
                                           VerticalAlignment="Center"
                                           Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                    </Grid>
                </Button>
                <Border x:Name="NameEditFrame" Classes="project-name-editor" IsVisible="False">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                        <TextBox x:Name="NameInput" Classes="inline-name"
                                 FontSize="{arc:ArcDesignTokenResource TypeBase}"
                                 FontWeight="SemiBold"
                                 Foreground="{arc:ArcDesignTokenResource Foreground}"
                                 PlaceholderText="{l:AppLangResource ProjectName}"
                                 AutomationProperties.Name="{l:AppLangResource ProjectName}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button x:Name="NameSaveButton" Classes="inline-action primary"
                                    Click="OnNameSaveClick"
                                    AutomationProperties.Name="{l:AppLangResource Save}"
                                    arc:Tooltip.Tip="{l:AppLangResource Save}">
                                <lucide:LucideIcon Kind="Check" Size="12" />
                            </Button>
                            <Button x:Name="NameCancelButton" Classes="inline-action"
                                    Click="OnNameCancelClick"
                                    AutomationProperties.Name="{l:AppLangResource Cancel}"
                                    arc:Tooltip.Tip="{l:AppLangResource Cancel}">
                                <lucide:LucideIcon Kind="X" Size="12" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Panel>
            <TextBlock Grid.Row="2" Margin="{DynamicResource OctopusPanelPathMargin}" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                       FontSize="{arc:ArcDesignTokenResource TypeXS}" Foreground="{arc:ArcDesignTokenResource TextMuted}"
                       Text="{Binding ProjectPath}" TextTrimming="PathSegmentEllipsis"
                       arc:Tooltip.Tip="{Binding ProjectPath}" />
            <arc:SearchField Grid.Row="3" Margin="{DynamicResource OctopusPanelSearchMargin}" Size="Small" IsLabelVisible="False"
                             Label="{l:AppLangResource SearchInProject}"
                             Placeholder="{l:AppLangResource SearchInProject}"
                             Text="{Binding Filter, Mode=TwoWay}" />
            <arc:ScrollArea Grid.Row="4">
                <StackPanel Margin="{DynamicResource OctopusPanelListMargin}" Spacing="1">
                    <!-- Header: single list when no worktrees exist; workspace tree with "+ New branch" (Scheme C) once a git project has worktrees. -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="2" Margin="{DynamicResource OctopusPanelHeaderMargin}">
                        <TextBlock Classes="caption" VerticalAlignment="Center" Text="{Binding SectionHeaderText}" TextTrimming="CharacterEllipsis" />
                        <arc:Button x:Name="NewBranchButton" Grid.Column="1" Variant="Ghost" Size="Small"
                                    IsVisible="{Binding CanCreateWorkspace}"
                                    Padding="6,0" Height="22" MinHeight="0"
                                    Command="{Binding NewBranchWorkspaceCommand}"
                                    AutomationProperties.Name="{l:AppLangResource WorkspaceNewBranch}"
                                    arc:Tooltip.Tip="{l:AppLangResource WorkspaceNewBranchTip}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <lucide:LucideIcon Kind="GitBranch" Size="12" Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                                <TextBlock FontSize="{arc:ArcDesignTokenResource TypeXS}" FontWeight="SemiBold"
                                           Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                           Text="{l:AppLangResource WorkspaceNewBranch}" VerticalAlignment="Center" />
                            </StackPanel>
                        </arc:Button>
                        <arc:Button x:Name="AddItemButton" Grid.Column="2" Classes="icon" Variant="Ghost"
                                    IsVisible="{Binding ShowFlatList}"
                                    Click="OnAddItemClick"
                                    AutomationProperties.Name="{l:AppLangResource NewItem}"
                                    arc:Tooltip.Tip="{l:AppLangResource NewItem}">
                            <lucide:LucideIcon Kind="Plus" Size="14" />
                        </arc:Button>
                        <arc:Button x:Name="WorkspaceCleanupButton" Grid.Column="2" Classes="icon" Variant="Ghost"
                                    IsVisible="{Binding HasWorkspaces}"
                                    Command="{Binding OpenWorkspaceCleanupCommand}"
                                    AutomationProperties.Name="{l:AppLangResource WorkspaceCleanupOpenSettingsTip}"
                                    arc:Tooltip.Tip="{l:AppLangResource WorkspaceCleanupOpenSettingsTip}">
                            <lucide:LucideIcon Kind="BrushCleaning" Size="13" />
                        </arc:Button>
                    </Grid>
                    <!-- No branch workspaces yet: flat reorderable list -->
                    <arc:ReorderableList x:Name="ItemList" ItemsSource="{Binding Items}"
                                         IsVisible="{Binding ShowFlatList}"
                                         Label="{l:AppLangResource ItemList}" Reordered="OnItemsReordered">
                        <arc:ReorderableList.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="1" ClipToBounds="False" />
                            </ItemsPanelTemplate>
                        </arc:ReorderableList.ItemsPanel>
                        <arc:ReorderableList.ItemTemplate>
                            <DataTemplate x:DataType="vm:ItemRowViewModel"><vm:ItemRowView /></DataTemplate>
                        </arc:ReorderableList.ItemTemplate>
                    </arc:ReorderableList>
                    <!-- Has branch workspaces: grouping tree (Default + each worktree, each with its own "+") -->
                    <ItemsControl x:Name="WorkspaceTree" ItemsSource="{Binding WorkspaceGroups}"
                                  IsVisible="{Binding HasWorkspaces}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorkspaceGroupViewModel"><vm:WorkspaceGroupView /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="hint" Margin="10,2" Text="{l:AppLangResource GroupEmpty}" IsVisible="{Binding NoItems}" />
                </StackPanel>
            </arc:ScrollArea>
        </Grid>
    </Grid>
</UserControl>
