<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:common="using:Octopus.App.Common"
             xmlns:vm="using:Octopus.App.Sidebar"
             x:Class="Octopus.App.Sidebar.DeviceSwitcherView"
             x:DataType="vm:DeviceSwitcherViewModel"
             Width="276">
    <UserControl.Resources>
        <DataTemplate x:Key="DeviceRowTemplate" x:DataType="vm:DeviceEntryViewModel">
            <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                <Button Classes="row" Classes.selected="{Binding IsCurrent}"
                        Padding="6,5"
                        Command="{Binding SelectCommand}"
                        AutomationProperties.Name="{Binding Name}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <!-- Circular device avatar (supports color + initial / Lucide icon / pixel icon / custom picture). -->
                        <Grid Width="30" Height="30" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="14" ClipToBounds="True"
                                    Background="{Binding Background}" Opacity="{Binding BadgeOpacity}">
                                <Panel>
                                    <TextBlock IsVisible="{Binding ShowInitial}" Text="{Binding Initial}"
                                               Foreground="White" FontWeight="Bold"
                                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <lucide:LucideIcon IsVisible="{Binding ShowIcon}" Kind="{Binding EffectiveIconKind}"
                                                       Size="14" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <common:PixelIconView IsVisible="{Binding ShowPixel}" Icon="{Binding Pixel}"
                                                          Width="18" Height="18" Foreground="White"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Image IsVisible="{Binding HasImage}" Source="{Binding Image}"
                                           Width="28" Height="28" Stretch="UniformToFill"
                                           RenderOptions.BitmapInterpolationMode="HighQuality" />
                                </Panel>
                            </Border>
                            <!-- Live connection status dot -->
                            <Border Width="10" Height="10" CornerRadius="5"
                                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Background="{arc:ArcDesignTokenResource Surface}"
                                    IsHitTestVisible="False">
                                <Panel>
                                    <Ellipse Width="6" Height="6" IsVisible="{Binding IsOnlineStatus}"
                                             Fill="{arc:ArcDesignTokenResource Success}" />
                                    <Ellipse Width="6" Height="6" IsVisible="{Binding IsConnecting}"
                                             Fill="{arc:ArcDesignTokenResource Warning}" />
                                    <Ellipse Width="6" Height="6" IsVisible="{Binding IsOffline}"
                                             Fill="{arc:ArcDesignTokenResource TextMuted}" Opacity="0.55" />
                                    <Ellipse Width="6" Height="6" IsVisible="{Binding IsSshStatus}"
                                             Fill="{arc:ArcDesignTokenResource Accent}" />
                                </Panel>
                            </Border>
                        </Grid>

                        <!-- Name & subtitle -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                <TextBlock Classes="body" FontWeight="SemiBold"
                                           Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <Border Grid.Column="1" Padding="4,1" CornerRadius="4"
                                        Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                                        VerticalAlignment="Center">
                                    <TextBlock FontSize="10" Foreground="{arc:ArcDesignTokenResource TextMuted}"
                                               Text="{Binding StatusText}" />
                                </Border>
                            </Grid>
                            <TextBlock Classes="hint" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!-- Cross-device activity + project count + check -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <Border IsVisible="{Binding HasWaiting}" MinWidth="16" Height="16" Padding="4,0"
                                    CornerRadius="8" Background="{arc:ArcDesignTokenResource Warning}">
                                <TextBlock FontSize="10" FontWeight="Bold" Foreground="#1C1405"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Text="{Binding WaitingBadgeText}" />
                            </Border>
                            <arc:ArcSpinner IsVisible="{Binding ShowWorkingIndicator}" Width="11" Height="11"
                                            Foreground="{arc:ArcDesignTokenResource Accent}" />
                            <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding ProjectCount}" />
                            <lucide:LucideIcon IsVisible="{Binding IsCurrent}" Kind="Check" Size="13"
                                               Foreground="{arc:ArcDesignTokenResource Accent}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Quick customize icon button right beside each device row -->
                <arc:Button Grid.Column="1" Classes="icon" Variant="Ghost"
                            Width="24" Height="24" Margin="2,0,0,0" VerticalAlignment="Center"
                            Command="{Binding ChangeIconCommand}"
                            AutomationProperties.Name="{l:AppLangResource DeviceChangeIcon}"
                            arc:Tooltip.Tip="{l:AppLangResource DeviceChangeIcon}" arc:Tooltip.Side="Right">
                    <lucide:LucideIcon Kind="Palette" Size="12" Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                </arc:Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="4">
        <arc:ScrollArea MaxHeight="380" OverlayScrollbarMode="Auto" FadeLength="0">
            <StackPanel Spacing="6">
                <!-- Local computer -->
                <StackPanel Spacing="2">
                    <TextBlock Classes="caption" Margin="6,2,6,0" Text="{l:AppLangResource DeviceSectionLocal}" />
                    <ItemsControl ItemsSource="{Binding LocalDevices}" ItemTemplate="{StaticResource DeviceRowTemplate}" />
                </StackPanel>

                <!-- Paired remote Octopus hosts -->
                <StackPanel Spacing="2" IsVisible="{Binding HasRemoteDevices}">
                    <Border Height="1" Background="{arc:ArcDesignTokenResource BorderSubtle}" Margin="4,0,4,2" />
                    <TextBlock Classes="caption" Margin="6,2,6,0" Text="{l:AppLangResource DeviceSectionRemote}" />
                    <ItemsControl ItemsSource="{Binding RemoteDevices}" ItemTemplate="{StaticResource DeviceRowTemplate}" />
                </StackPanel>

                <!-- SSH hosts -->
                <StackPanel Spacing="2" IsVisible="{Binding HasSshDevices}">
                    <Border Height="1" Background="{arc:ArcDesignTokenResource BorderSubtle}" Margin="4,0,4,2" />
                    <TextBlock Classes="caption" Margin="6,2,6,0" Text="{l:AppLangResource DeviceSectionSsh}" />
                    <ItemsControl ItemsSource="{Binding SshDevices}" ItemTemplate="{StaticResource DeviceRowTemplate}" />
                </StackPanel>
            </StackPanel>
        </arc:ScrollArea>

        <Border Height="1" Background="{arc:ArcDesignTokenResource BorderSubtle}" Margin="4,2" />
        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
            <arc:Button Variant="Ghost" Size="Small" HorizontalAlignment="Stretch"
                        Command="{Binding OpenRemoteHostsSettingsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <lucide:LucideIcon Kind="Monitor" Size="12" />
                    <TextBlock Text="{l:AppLangResource DeviceManageRemoteHosts}" VerticalAlignment="Center" />
                </StackPanel>
            </arc:Button>
            <arc:Button Grid.Column="1" Variant="Ghost" Size="Small" HorizontalAlignment="Stretch"
                        Command="{Binding OpenSshSettingsCommand}">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <lucide:LucideIcon Kind="Server" Size="12" />
                    <TextBlock Text="{l:AppLangResource DeviceManageSshHosts}" VerticalAlignment="Center" />
                </StackPanel>
            </arc:Button>
        </Grid>
    </StackPanel>
</UserControl>
