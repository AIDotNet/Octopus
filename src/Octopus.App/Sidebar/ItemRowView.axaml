<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:common="using:Octopus.App.Common"
             xmlns:vm="using:Octopus.App.Sidebar"
             x:Class="Octopus.App.Sidebar.ItemRowView"
             x:DataType="vm:ItemRowViewModel">
    <StackPanel>
    <Grid>
        <Button x:Name="RowButton" Classes="row" Classes.selected="{Binding IsActive}" Height="{DynamicResource OctopusItemRowHeight}"
                Command="{Binding ActivateCommand}" DoubleTapped="OnDoubleTapped"
                AutomationProperties.Name="{Binding Title}"
                IsVisible="{Binding !IsRenaming}">
            <Grid ColumnDefinitions="Auto,*,Auto" Margin="{DynamicResource OctopusItemRowMargin}">
                <common:AgentIcon IsVisible="{Binding IsAgent}" AgentId="{Binding AgentId}" AgentName="{Binding Title}"
                                  Size="{DynamicResource OctopusItemAgentIconSize}" Margin="{DynamicResource OctopusItemAgentIconMargin}" />
                <lucide:LucideIcon IsVisible="{Binding IsTerminal}" Kind="SquareTerminal" Size="{DynamicResource OctopusItemIconSize}" Margin="{DynamicResource OctopusItemIconMargin}" />
                <lucide:LucideIcon IsVisible="{Binding IsFile}" Kind="FileText" Size="{DynamicResource OctopusItemIconSize}" Margin="{DynamicResource OctopusItemIconMargin}" />
                <lucide:LucideIcon IsVisible="{Binding IsPlugin}" Kind="LayoutGrid" Size="{DynamicResource OctopusItemIconSize}" Margin="{DynamicResource OctopusItemIconMargin}" />
                <TextBlock Grid.Column="1" Classes="body" VerticalAlignment="Center" Text="{Binding Title}"
                           TextTrimming="CharacterEllipsis" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" Margin="4,0,0,0" VerticalAlignment="Center">
                    <!-- Direct spawned child agents pill (Scheme C): compact count toggle with warning tint if any child awaits approval. -->
                    <Button Classes="row" Height="18" VerticalAlignment="Center"
                            IsVisible="{Binding HasSpawnedChildren}"
                            Command="{Binding ToggleChildrenExpandedCommand}">
                        <Border Background="{arc:ArcDesignTokenResource Surface}"
                                BorderBrush="{arc:ArcDesignTokenResource Border}"
                                BorderThickness="1"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                Padding="5,0">
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="↳" FontSize="10" Foreground="{arc:ArcDesignTokenResource AccentStrong}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding SpawnedChildrenCount}" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" VerticalAlignment="Center" />
                                <Ellipse Width="5" Height="5" VerticalAlignment="Center" IsVisible="{Binding HasWaitingChild}"
                                         Fill="{arc:ArcDesignTokenResource Warning}" />
                                <lucide:LucideIcon Kind="ChevronDown" Size="10" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsChildrenExpanded}"
                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                <lucide:LucideIcon Kind="ChevronRight" Size="10" VerticalAlignment="Center"
                                                   IsVisible="{Binding !IsChildrenExpanded}"
                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <!-- Active peer negotiation badge for sibling sessions collaborating via @-mentions. -->
                    <Border IsVisible="{Binding HasPeerThreads}" VerticalAlignment="Center"
                            Background="{arc:ArcDesignTokenResource AccentSubtle}"
                            CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                            Padding="4,0">
                        <TextBlock Text="⇄" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{arc:ArcDesignTokenResource AccentStrong}" VerticalAlignment="Center" />
                    </Border>
                    <!-- Isolation micro-badge on spawned child rows (wt = worktree, ro = read-only). -->
                    <Border IsVisible="{Binding HasIsolationBadge}" VerticalAlignment="Center"
                            Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="3,0">
                        <TextBlock Text="{Binding IsolationBadge}" FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                   FontSize="9.5" Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                    </Border>
                    <!-- A delegate running on another computer, nested under the session here that started it. -->
                    <Border IsVisible="{Binding HasHostBadge}" VerticalAlignment="Center"
                            Background="{arc:ArcDesignTokenResource AccentSubtle}"
                            CornerRadius="4"
                            Padding="3,0"
                            arc:Tooltip.Tip="{Binding HostBadgeTip}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <lucide:LucideIcon Kind="Monitor" Size="9" VerticalAlignment="Center"
                                               Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                            <TextBlock Text="{Binding HostBadge}" MaxWidth="90" TextTrimming="CharacterEllipsis"
                                       FontSize="9.5" Foreground="{arc:ArcDesignTokenResource AccentStrong}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!-- Work another session delegated here, often from another computer. -->
                    <Border IsVisible="{Binding HasOrigin}" VerticalAlignment="Center"
                            Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="3,0"
                            arc:Tooltip.Tip="{Binding OriginTip}">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <lucide:LucideIcon Kind="ArrowDownLeft" Size="9" VerticalAlignment="Center"
                                               Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                            <TextBlock Text="{Binding OriginText}" MaxWidth="110" TextTrimming="CharacterEllipsis"
                                       FontSize="9.5" Foreground="{arc:ArcDesignTokenResource TextMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <!-- Subagents: collapsed by default as one bot icon per subagent (up to 4, then ...); click to expand/collapse cards below. -->
                    <Button Classes="row" Height="18" VerticalAlignment="Center"
                            IsVisible="{Binding Subagents.HasAny, FallbackValue=False}"
                            Command="{Binding Subagents.ToggleExpandedCommand, FallbackValue={x:Null}}"
                            AutomationProperties.Name="{l:AppLangResource SubagentsToggle}"
                            arc:Tooltip.Tip="{Binding Subagents.ToggleTip, FallbackValue={x:Null}}">
                        <Border Background="{arc:ArcDesignTokenResource Surface}"
                                BorderBrush="{arc:ArcDesignTokenResource Border}"
                                BorderThickness="1"
                                CornerRadius="{arc:ArcDesignTokenResource RadiusPill}"
                                Padding="5,0">
                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <ItemsControl ItemsSource="{Binding Subagents.PillIcons, FallbackValue={x:Null}}"
                                              VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SubagentCardViewModel">
                                            <Panel VerticalAlignment="Center">
                                                <lucide:LucideIcon Kind="Bot" Size="11"
                                                                   IsVisible="{Binding IsRunning}"
                                                                   Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                                                <lucide:LucideIcon Kind="Bot" Size="11"
                                                                   IsVisible="{Binding IsDone}"
                                                                   Foreground="{arc:ArcDesignTokenResource Success}" />
                                                <lucide:LucideIcon Kind="Bot" Size="11"
                                                                   IsVisible="{Binding IsFailed}"
                                                                   Foreground="{arc:ArcDesignTokenResource Danger}" />
                                                <lucide:LucideIcon Kind="Bot" Size="11"
                                                                   IsVisible="{Binding IsInterrupted}"
                                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                            </Panel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <lucide:LucideIcon Kind="Ellipsis" Size="11" VerticalAlignment="Center"
                                                   IsVisible="{Binding Subagents.HasPillOverflow, FallbackValue=False}"
                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                <lucide:LucideIcon Kind="ChevronDown" Size="10" VerticalAlignment="Center" Margin="1,0,0,0"
                                                   IsVisible="{Binding Subagents.IsExpanded, FallbackValue=False}"
                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                            </StackPanel>
                        </Border>
                    </Button>
                    <TextBlock Classes="hint" VerticalAlignment="Center"
                               IsVisible="{Binding HasModel}" Text="{Binding ModelName}" MaxWidth="80"
                               TextTrimming="CharacterEllipsis" />
                    <!-- Working: Arc's loading ring. Waiting for the user: a yellow dot. The turn failed: a red dot. -->
                    <arc:ArcSpinner Width="12" Height="12" VerticalAlignment="Center" IsVisible="{Binding IsWorking}"
                                    Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" IsVisible="{Binding IsWaiting}"
                             Fill="{arc:ArcDesignTokenResource Warning}"
                             arc:Tooltip.Tip="{l:AppLangResource ItemWaitingTip}" />
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" IsVisible="{Binding HasError}"
                             Fill="{arc:ArcDesignTokenResource Danger}" />
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" IsVisible="{Binding IsDone}"
                             Fill="{arc:ArcDesignTokenResource Success}"
                             arc:Tooltip.Tip="{l:AppLangResource ItemDoneTip}" />
                </StackPanel>
            </Grid>
        </Button>
        <arc:InlineEdit x:Name="Editor" Variant="Body" Margin="26,0,0,0" VerticalAlignment="Center"
                        IsVisible="{Binding IsRenaming}" Value="{Binding Title, Mode=OneWay}"
                        Label="{Binding Title}" TextCommitted="OnTextCommitted" EditCanceled="OnEditCanceled" />
    </Grid>
    <!-- Directly spawned child agents nested underneath this parent agent (Scheme C compact sub-rows). -->
    <Border IsVisible="{Binding ShowSpawnedChildren}"
            Margin="15,1,0,3"
            Padding="7,0,0,0"
            BorderThickness="1,0,0,0"
            BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
        <ItemsControl ItemsSource="{Binding SpawnedChildren}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Spacing="1" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ItemRowViewModel">
                    <Grid ColumnDefinitions="Auto,*">
                        <TextBlock Text="↳" FontSize="11" Margin="0,0,2,0" VerticalAlignment="Top" Padding="0,5,0,0"
                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                        <vm:ItemRowView Grid.Column="1" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Border>
    <!-- Null for an item that never started a subagent: then nothing is built here. -->
    <ContentControl Content="{Binding Subagents}">
        <ContentControl.ContentTemplate>
            <DataTemplate x:DataType="vm:SubagentListViewModel"><vm:SubagentListView /></DataTemplate>
        </ContentControl.ContentTemplate>
    </ContentControl>
    </StackPanel>
</UserControl>
