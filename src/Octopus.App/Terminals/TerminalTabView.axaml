<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:term="using:Octopus.Terminal.Avalonia"
             xmlns:vm="using:Octopus.App.Terminals"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             x:Class="Octopus.App.Terminals.TerminalTabView"
             x:DataType="vm:TerminalTabViewModel">
    <Grid RowDefinitions="Auto,*">
        <!-- Shown only for worktree workspace tabs: branch, directory path, and optional linked Issue/PR context. -->
        <Border Grid.Row="0" IsVisible="{Binding HasWorkspaceContext}"
                Padding="10,4"
                Background="{arc:ArcDesignTokenResource SurfaceMuted}"
                BorderThickness="0,0,0,1"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="8">
                <Border CornerRadius="{arc:ArcDesignTokenResource RadiusPill}" Padding="7,1"
                        Background="{arc:ArcDesignTokenResource AccentSubtle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <lucide:LucideIcon Kind="GitBranch" Size="12" VerticalAlignment="Center"
                                           Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                        <TextBlock FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   FontWeight="SemiBold"
                                   Foreground="{arc:ArcDesignTokenResource AccentStrong}"
                                   Text="{Binding WorkspaceBranch}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button Grid.Column="1" Classes="row" Padding="4,1" VerticalAlignment="Center"
                        Command="{Binding RevealWorkspaceCommand}"
                        arc:Tooltip.Tip="{Binding WorkspaceShortPath}">
                    <TextBlock FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                               FontSize="{arc:ArcDesignTokenResource TypeXS}"
                               Foreground="{arc:ArcDesignTokenResource TextMuted}"
                               Text="{Binding WorkspaceShortPath}" MaxWidth="260"
                               TextTrimming="CharacterEllipsis" />
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                            IsVisible="{Binding HasTask}">
                    <Border CornerRadius="{arc:ArcDesignTokenResource RadiusPill}" Padding="6,1"
                            Background="{arc:ArcDesignTokenResource Surface}"
                            BorderThickness="1" BorderBrush="{arc:ArcDesignTokenResource Border}">
                        <TextBlock FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                   FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                   FontWeight="SemiBold"
                                   Text="{Binding TaskKey}" />
                    </Border>
                    <TextBlock Classes="hint" VerticalAlignment="Center"
                               Foreground="{arc:ArcDesignTokenResource TextSecondary}"
                               Text="{Binding TaskTitle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <arc:Button Grid.Column="3" Classes="icon" Variant="Ghost" VerticalAlignment="Center"
                            IsVisible="{Binding HasTaskUrl}"
                            Command="{Binding OpenTaskUrlCommand}"
                            arc:Tooltip.Tip="{Binding TaskUrl}">
                    <lucide:LucideIcon Kind="ExternalLink" Size="13" />
                </arc:Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
        <term:TerminalControl x:Name="Terminal"
                              FontSize="{Binding TerminalFontSize}"
                              ScrollbackLines="{Binding ScrollbackLines}"
                              ConfirmMultilinePaste="{Binding ConfirmMultilinePaste}" />
        <!-- The connection of a terminal on an SSH host: its steps and the protocol lines, while it is made or when it failed. -->
        <!-- With no connection (a terminal on this computer) the binding has no source: FallbackValue keeps the card hidden. -->
        <Border x:Name="ConnectCard" DataContext="{Binding Connect}" x:DataType="vm:SshConnectProgress"
                IsVisible="{Binding IsVisible, FallbackValue=False}"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="24"
                Width="520" Padding="18,14"
                Background="{arc:ArcDesignTokenResource Background}"
                BorderBrush="{arc:ArcDesignTokenResource BorderSubtle}" BorderThickness="1"
                CornerRadius="{arc:ArcDesignTokenResource RadiusControl}">
            <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <arc:ArcSpinner Width="14" Height="14" VerticalAlignment="Center"
                                    IsVisible="{Binding IsConnecting}"
                                    Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                    <lucide:LucideIcon Kind="CircleAlert" Size="16" VerticalAlignment="Center"
                                       IsVisible="{Binding !IsConnecting}"
                                       Foreground="{arc:ArcDesignTokenResource Warning}" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Steps}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SshConnectStep">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="2,2">
                                <lucide:LucideIcon Kind="Check" Size="14" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsDone}"
                                                   Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                                <arc:ArcSpinner Width="12" Height="12" VerticalAlignment="Center"
                                                IsVisible="{Binding IsCurrent}"
                                                Foreground="{arc:ArcDesignTokenResource AccentStrong}" />
                                <lucide:LucideIcon Kind="Circle" Size="8" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsPending}"
                                                   Foreground="{arc:ArcDesignTokenResource TextMuted}" />
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding ProtocolTitle}" FontSize="{arc:ArcDesignTokenResource TypeXS}"
                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                <ScrollViewer MaxHeight="220">
                    <ItemsControl ItemsSource="{Binding RecentLines}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap"
                                           FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                                           FontSize="{arc:ArcDesignTokenResource TypeXS}"
                                           Foreground="{arc:ArcDesignTokenResource TextSecondary}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <arc:Alert Tone="Danger"
                   Margin="16"
                   VerticalAlignment="Top"
                   IsOpen="{Binding Error, Mode=OneWay, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Title="{Binding Error}" />
        </Grid>
    </Grid>
</UserControl>
