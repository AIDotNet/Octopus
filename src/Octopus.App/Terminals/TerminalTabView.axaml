<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:term="using:Octopus.Terminal.Avalonia"
             xmlns:vm="using:Octopus.App.Terminals"
             x:Class="Octopus.App.Terminals.TerminalTabView"
             x:DataType="vm:TerminalTabViewModel">
    <Grid>
        <term:TerminalControl x:Name="Terminal"
                              FontSize="{Binding TerminalFontSize}"
                              ScrollbackLines="{Binding ScrollbackLines}"
                              ConfirmMultilinePaste="{Binding ConfirmMultilinePaste}" />
        <arc:Alert Tone="Danger"
                   Margin="16"
                   VerticalAlignment="Top"
                   IsOpen="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                   Title="{Binding Error}" />
    </Grid>
</UserControl>
