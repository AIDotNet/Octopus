<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:vm="using:Octopus.App.Files"
             x:Class="Octopus.App.Files.DiffTabView"
             x:DataType="vm:DiffTabViewModel">
    <Grid Background="{arc:ArcDesignTokenResource Background}" RowDefinitions="Auto,Auto,*">
        <vm:FileHeaderBar Folder="{Binding FolderText}" FileName="{Binding FileLabel}"
                          CopyText="{Binding Request.Path}" RevealPath="{Binding Request.FullPath}">
            <vm:FileHeaderBar.Trailing>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding HasChangeCounts}">
                        <arc:Badge Tone="Success" Size="Small" Content="{Binding AddedText}" />
                        <arc:Badge Tone="Danger" Size="Small" Content="{Binding RemovedText}" />
                    </StackPanel>
                    <arc:Badge Tone="Warning" Size="Small" Content="{l:AppLangResource MdUnsaved}" IsVisible="{Binding ShowUnsaved}" />
                    <arc:Button x:Name="SaveButton" Classes="icon header" IsVisible="{Binding ShowSave}" Command="{Binding SaveDocumentCommand}"
                                AutomationProperties.Name="{l:AppLangResource MdSave}"
                                arc:Tooltip.Tip="{l:AppLangResource MdSave}">
                        <lucide:LucideIcon Kind="Save" Size="14" />
                    </arc:Button>
                    <arc:Button Classes="icon header" Classes.active="{Binding RenderSideBySide}" IsVisible="{Binding ShowDiffEditor}"
                                Command="{Binding ToggleSideBySideCommand}"
                                AutomationProperties.Name="{l:AppLangResource DiffSideBySide}"
                                arc:Tooltip.Tip="{l:AppLangResource DiffSideBySide}">
                        <lucide:LucideIcon Kind="Columns2" Size="14" />
                    </arc:Button>
                    <arc:Button Classes="icon header" Classes.active="{Binding HideUnchangedRegions}" IsVisible="{Binding ShowDiffEditor}"
                                Command="{Binding ToggleHideUnchangedCommand}"
                                AutomationProperties.Name="{l:AppLangResource DiffHideUnchanged}"
                                arc:Tooltip.Tip="{l:AppLangResource DiffHideUnchanged}">
                        <lucide:LucideIcon Kind="FoldVertical" Size="14" />
                    </arc:Button>
                    <arc:Button Classes="icon header" Classes.active="{Binding WrapLines}" IsVisible="{Binding ShowUnifiedFallback}"
                                Command="{Binding ToggleWrapCommand}"
                                AutomationProperties.Name="{l:AppLangResource FileWrapLines}"
                                arc:Tooltip.Tip="{l:AppLangResource FileWrapLines}">
                        <lucide:LucideIcon Kind="WrapText" Size="14" />
                    </arc:Button>
                </StackPanel>
            </vm:FileHeaderBar.Trailing>
        </vm:FileHeaderBar>

        <Grid Grid.Row="1">
            <arc:Alert Margin="12,8,12,4" Tone="Warning" Title="{Binding TruncatedNotice}"
                       IsVisible="{Binding HasTruncatedNotice}" />
            <arc:Alert Margin="12,8,12,4" Tone="Danger" Title="{l:AppLangResource MdSaveFailedTitle}"
                       Content="{Binding SaveError}" IsVisible="{Binding HasSaveError}" />
        </Grid>

        <!-- Monaco DiffEditor when both sides are available; unified CodeView fallback for truncated / remote diffs. -->
        <Grid Grid.Row="2">
            <arc:DiffEditor x:Name="Diff"
                            IsVisible="{Binding ShowDiffEditor}"
                            LanguageId="{Binding EditorLanguageId}"
                            RenderSideBySide="{Binding RenderSideBySide}"
                            HideUnchangedRegions="{Binding HideUnchangedRegions}"
                            IsReadOnly="{Binding IsDiffReadOnly}"
                            FontSize="{Binding FontSize}"
                            BorderThickness="0"
                            CornerRadius="0"
                            AutomationProperties.Name="{Binding Title}" />

            <arc:ScrollArea x:Name="Scroller" Orientation="Both" FadeLength="0" IsVisible="{Binding ShowUnifiedFallback}">
                <vm:CodeView x:Name="Lines" Text="{Binding CodeText}" Marks="{Binding Marks}" Language="{Binding Language}"
                             WrapLines="{Binding WrapLines}" FontSize="{Binding FontSize}"
                             FontFamily="{arc:ArcDesignTokenResource MonoFontFamily}"
                             Background="{arc:ArcDesignTokenResource Background}"
                             Foreground="{arc:ArcDesignTokenResource Foreground}"
                             MutedForeground="{arc:ArcDesignTokenResource TextSecondary}"
                             GutterForeground="{arc:ArcDesignTokenResource TextMuted}"
                             HoverBrush="{arc:ArcDesignTokenResource SurfaceMuted}"
                             SelectionBrush="{arc:ArcDesignTokenResource AccentSubtle}"
                             DividerBrush="{arc:ArcDesignTokenResource BorderSubtle}"
                             AddedBrush="{arc:ArcDesignTokenResource Success}"
                             RemovedBrush="{arc:ArcDesignTokenResource Danger}"
                             HunkBrush="{arc:ArcDesignTokenResource Accent}" />
            </arc:ScrollArea>

            <arc:EmptyState IsVisible="{Binding HasNotice}" Description="{Binding Notice}"
                            Icon="{x:Static arc:ArcIcons.FileText}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</UserControl>
