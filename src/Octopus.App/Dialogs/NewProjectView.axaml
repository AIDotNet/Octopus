<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:arc="https://github.com/AIDotNet/TKCode.Arc"
             xmlns:l="using:Octopus.App.Localization"
             xmlns:lucide="https://github.com/AIDotNet/TKCode.Arc/lucide"
             xmlns:dialogs="using:Octopus.App.Dialogs"
             x:Class="Octopus.App.Dialogs.NewProjectView">
    <Panel>
        <StackPanel x:Name="FormPanel" Spacing="14">
            <!-- Shown only when there is an SSH or paired Octopus host: the folder then is a path on that host. -->
            <arc:Select x:Name="LocationSelect" Size="Small"
                        Label="{l:AppLangResource NewProjectLocation}"
                        AutoScrollToSelectedItem="False"
                        IsVisible="False" />
            <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <!-- Label and placeholder are set in code (OnLocationChanged): a markup binding would put back the local text. -->
                    <arc:Input x:Name="PathInput" Size="Small" />
                    <arc:Button x:Name="BrowseButton" Grid.Column="1" Variant="Secondary" Size="Small" VerticalAlignment="Top" Margin="0,24,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <lucide:LucideIcon Kind="FolderOpen" Size="14" />
                            <TextBlock Text="{l:AppLangResource NewProjectBrowse}" VerticalAlignment="Center" />
                        </StackPanel>
                    </arc:Button>
                </Grid>
                <TextBlock x:Name="PathHint" Classes="hint" TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>
            <arc:Input x:Name="NameInput" Size="Small"
                       Label="{l:AppLangResource NewProjectName}"
                       Description="{l:AppLangResource NewProjectNameHint}" />
        </StackPanel>

        <dialogs:FolderBrowserView x:Name="BrowserView" IsVisible="False" />
    </Panel>
</UserControl>
