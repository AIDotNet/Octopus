<Project Sdk="Microsoft.NET.Sdk">
    <!-- The phone app on iOS: starts the shared MobileApp (src/Octopus.Mobile) on the system's keychain
         (design/12-远程操作.md §9.1). Needs the .NET ios workload and Xcode, so it is only in Octopus.Mobile.slnx.
         Simulator:  dotnet build -t:Run src/Octopus.Mobile.iOS -p:RuntimeIdentifier=iossimulator-arm64
         A device needs a signing identity and provisioning profile (CodesignKey, CodesignProvision). -->
    <PropertyGroup>
        <TargetFramework>net10.0-ios</TargetFramework>
        <OutputType>Exe</OutputType>
        <SupportedOSPlatformVersion>15.0</SupportedOSPlatformVersion>
        <RootNamespace>Octopus.Mobile.iOS</RootNamespace>
        <AssemblyName>Octopus.Mobile.iOS</AssemblyName>
        <ApplicationId>com.aidotnet.octopus.mobile</ApplicationId>
        <ApplicationTitle>Octopus</ApplicationTitle>
        <ApplicationVersion>5</ApplicationVersion>
        <ApplicationDisplayVersion>1.0.1</ApplicationDisplayVersion>
        <AppleAppManifest>Info.plist</AppleAppManifest>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- On a device, iOS allows no JIT: the release build is NativeAOT, as every head of the phone app is (§9.2, item 6). -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <PublishAot>true</PublishAot>
        <OptimizationPreference>Size</OptimizationPreference>
        <IlcFoldIdenticalMethodBodies>true</IlcFoldIdenticalMethodBodies>
        <StripSymbols>true</StripSymbols>
        <HybridGlobalization>true</HybridGlobalization>
        <EventSourceSupport>false</EventSourceSupport>
        <DebuggerSupport>false</DebuggerSupport>
        <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
        <MetricsSupport>false</MetricsSupport>
        <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
        <EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
        <UseSystemResourceKeys>true</UseSystemResourceKeys>
    </PropertyGroup>

    <ItemGroup>
        <ImageAsset Include="Assets.xcassets/**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.iOS" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Octopus.Mobile/Octopus.Mobile.csproj" />
    </ItemGroup>
</Project>
