<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Hosts are reached over the network: on the same network directly, elsewhere through the relay. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Optional camera permission for scanning desktop pairing / relay QR codes inside the app. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Voice input in the conversation composer: only while "hold to talk" is held. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <!-- Android 11+ package visibility: without this SpeechRecognizer cannot see the system's recognition service. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <!-- In-app updates (design/10-自动更新.md §15): the verified APK is handed to the system installer, which asks first. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- A host on the same network is ws://address:port. That is not plain text: everything in it is the app's own
         end-to-end channel (design/remote/安全通道.md), so Android's block on cleartext traffic is lifted. -->
    <application android:label="Octopus" android:icon="@mipmap/octopus" android:usesCleartextTraffic="true" android:networkSecurityConfig="@xml/network_security_config">
        <!-- Shows the downloaded update to the installer. The authority is the application id + ".updates"
             (AndroidUpdatePlatform.Authority). -->
        <provider android:name="androidx.core.content.FileProvider"
                  android:authorities="com.aidotnet.octopus.mobile.updates"
                  android:exported="false"
                  android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/update_paths" />
        </provider>
    </application>
</manifest>
