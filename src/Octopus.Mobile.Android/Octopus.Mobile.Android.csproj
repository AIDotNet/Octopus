<Project Sdk="Microsoft.NET.Sdk">
    <!-- The phone app on Android: starts the shared MobileApp (src/Octopus.Mobile) on the system's keystore
         (design/12-远程操作.md §9.1). Needs the .NET android workload, so it is only in Octopus.Mobile.slnx.
         Emulator or device attached:  dotnet build -t:Run src/Octopus.Mobile.Android
         An APK to install by hand:    dotnet publish src/Octopus.Mobile.Android -c Release -->
    <PropertyGroup>
        <TargetFramework>net10.0-android</TargetFramework>
        <OutputType>Exe</OutputType>
        <SupportedOSPlatformVersion>24</SupportedOSPlatformVersion>
        <RootNamespace>Octopus.Mobile.Android</RootNamespace>
        <AssemblyName>Octopus.Mobile.Android</AssemblyName>
        <ApplicationId>com.aidotnet.octopus.mobile</ApplicationId>
        <ApplicationTitle>Octopus</ApplicationTitle>
        <ApplicationVersion>1</ApplicationVersion>
        <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>
        <AndroidManifest>AndroidManifest.xml</AndroidManifest>
        <AndroidPackageFormat>apk</AndroidPackageFormat>
        <UseNativeHttpHandler>true</UseNativeHttpHandler>
        <UseSystemResourceKeys>false</UseSystemResourceKeys>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <!-- Release APKs target arm64-v8a by default instead of bundling x86_64 (~16 MB saved); override with -p:RuntimeIdentifiers=... if needed. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <RuntimeIdentifiers Condition="'$(RuntimeIdentifiers)' == ''">android-arm64</RuntimeIdentifiers>
        <AndroidLinkTool>r8</AndroidLinkTool>
        <HybridGlobalization>true</HybridGlobalization>
        <EventSourceSupport>false</EventSourceSupport>
        <DebuggerSupport>false</DebuggerSupport>
        <HttpActivityPropagationSupport>false</HttpActivityPropagationSupport>
        <MetricsSupport>false</MetricsSupport>
        <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
        <DebugSymbols>false</DebugSymbols>
        <DebugType>none</DebugType>
    </PropertyGroup>

    <ItemGroup>
        <AndroidResource Include="Resources/**" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia.Android" />
        <PackageReference Include="ZXing.Net" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Octopus.Mobile/Octopus.Mobile.csproj" />
    </ItemGroup>
</Project>
