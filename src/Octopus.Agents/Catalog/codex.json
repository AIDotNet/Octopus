{
  "schema": 1,
  "id": "codex",
  "name": "Codex CLI",
  "icon": "openai",
  "homepage": "https://github.com/openai/codex",
  "verified": true,
  "detect": {
    "executables": ["codex"],
    "versionArgs": ["--version"],
    "versionRegex": "codex-cli (\\d+\\.\\d+\\.\\d+)",
    "fingerprint": "codex-cli",
    "installHints": [
      { "kind": "npm", "command": "npm i -g @openai/codex" },
      { "kind": "brew", "command": "brew install codex" }
    ]
  },
  "capabilities": {
    "model": {
      "args": ["-m", "{value}"],
      "allowCustom": true,
      "options": [
        { "id": "gpt-6-luna", "label": "GPT-6 Luna" },
        { "id": "gpt-5.6-terra", "label": "GPT-5.6 Terra" },
        { "id": "gpt-5.6-luna", "label": "GPT-5.6 Luna" }
      ]
    },
    "effort": {
      "label": "Reasoning effort",
      "args": ["-c", "model_reasoning_effort=\"{value}\""],
      "options": [
        { "id": "low", "label": "Low" },
        { "id": "medium", "label": "Medium" },
        { "id": "high", "label": "High" },
        { "id": "xhigh", "label": "Extra high" },
        { "id": "max", "label": "Max" }
      ]
    },
    "permission": {
      "default": "default",
      "modes": {
        "default": { "args": [] },
        "acceptEdits": { "args": ["-a", "on-request", "-s", "workspace-write"] },
        "plan": { "args": ["-s", "read-only"] },
        "auto": { "args": ["--approve-for-me"] },
        "dontAsk": { "args": ["-a", "never", "-s", "workspace-write"] },
        "full": { "args": ["--dangerously-bypass-approvals-and-sandbox"], "danger": true }
      }
    },
    "prompt": { "mode": "positional" },
    "resume": { "continueLatest": ["resume", "--last"], "byId": ["resume", "{id}"] },
    "extraArgs": true,
    "env": {
      "known": [
        { "name": "CODEX_HOME", "label": "Config directory", "localized": { "zh-CN": { "label": "配置目录" } } },
        { "name": "OPENAI_API_KEY", "label": "API key", "secret": true, "localized": { "zh-CN": { "label": "API 密钥" } } }
      ],
      "allowCustom": true
    },
    "features": [
      { "id": "codexHome", "type": "directory", "label": "Codex home", "placeholder": "~/.codex", "env": "CODEX_HOME", "localized": { "zh-CN": { "label": "Codex 主目录" } } },
      { "id": "search", "type": "bool", "label": "Live web search", "args": ["--search"], "localized": { "zh-CN": { "label": "联网搜索" } } },
      { "id": "profile", "type": "string", "label": "Profile", "args": ["--profile", "{value}"], "localized": { "zh-CN": { "label": "配置档" } } }
    ]
  },
  // Codex has no status line. notify is a single slot (the user's own program is chained); whether hooks can be
  // added per session with -c is unknown (research/智能体用量来源调研.md §1.3), so only turn completion is heard.
  "signals": {
    "minVersion": "0.167.0",
    "account": { "env": "CODEX_HOME", "default": "~/.codex" },
    "attach": [
      { "args": ["-c", "notify={signalNotify}"], "note": "-c overrides any config key; notify passing its JSON as the last argument is from memory of the Codex docs, not yet run (13-P0 §4)" }
    ],
    "channels": {
      "turn-complete": { "via": "notify", "chainUserCommand": true }
    },
    "status": {
      "done": ["turn-complete"]
    },
    "credentialFiles": ["auth.json"]
  },
  // Read-only account query through the official app-server protocol (13-P0 §3: 1.3–2.9 s, found a 43200-minute window).
  "probes": {
    "rateLimits": {
      "kind": "jsonRpcStdio",
      "args": ["app-server"],
      "requests": [
        { "method": "initialize", "params": { "clientInfo": { "name": "octopus", "version": "{appVersion}" } } },
        { "method": "account/rateLimits/read", "result": true }
      ],
      "select": ["rateLimits", "rateLimitsByLimitId"],
      "timeoutMs": 30000,
      "minIntervalSec": 120,
      "exclusivePer": "account"
    }
  }
}
