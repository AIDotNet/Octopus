{
  "schema": 1,
  "id": "codebuff",
  "name": "Codebuff",
  "icon": "codebuff",
  "homepage": "https://codebuff.com",
  "verified": false,
  "detect": {
    "executables": ["codebuff", "cb"],
    "versionArgs": ["--version"],
    "versionRegex": "(\\d+\\.\\d+\\.\\d+)",
    "installHints": [{ "kind": "npm", "command": "npm i -g codebuff" }]
  },
  "capabilities": {
    "resume": {
      "continueLatest": ["--continue"]
    },
    "extraArgs": true
  }
}
