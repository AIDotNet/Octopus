{
  "schema": 1,
  "id": "glm",
  "name": "GLM Agent",
  "icon": "glm",
  "homepage": "https://github.com/stefandevo/glm-acp-agent",
  "verified": false,
  "detect": {
    "executables": ["glm-acp-agent"],
    "versionArgs": ["--version"],
    "versionRegex": "(\\d+\\.\\d+\\.\\d+)",
    "installHints": [
      { "kind": "npm", "command": "npm i -g glm-acp-agent" }
    ]
  },
  "capabilities": {
    "extraArgs": true,
    "env": {
      "known": [
        { "name": "Z_AI_API_KEY", "label": "Z.AI API key", "secret": true, "localized": { "zh-CN": { "label": "Z.AI / 智谱 API 密钥" } } }
      ],
      "allowCustom": true
    }
  },
  "acp": {
    "mode": "adapter",
    "dialect": "generic",
    "adapter": {
      "registryId": "glm-acp-agent",
      "executables": ["glm-acp-agent"],
      "npxPackage": "glm-acp-agent"
    }
  }
}
