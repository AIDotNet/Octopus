{
  "schema": 1,
  "id": "crow",
  "name": "crow-cli",
  "icon": "crow",
  "homepage": "https://crow-ai.dev",
  "verified": false,
  "detect": {
    "executables": ["crow-cli"],
    "versionArgs": ["--version"],
    "versionRegex": "(\\d+\\.\\d+\\.\\d+)",
    "installHints": [
      { "kind": "native", "command": "https://github.com/crow-cli/crow-cli/releases" }
    ]
  },
  "capabilities": {
    "extraArgs": true,
    "env": { "allowCustom": true }
  },
  "acp": {
    "mode": "adapter",
    "dialect": "generic",
    "adapter": {
      "registryId": "crow-cli",
      "executables": ["crow-cli"],
      "args": ["acp"]
    }
  }
}
