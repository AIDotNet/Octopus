{
  "schema": 1,
  "id": "agy",
  "name": "Antigravity CLI",
  "icon": "agy",
  "homepage": "https://antigravity.google/docs/getting-started",
  "verified": false,
  "detect": {
    "executables": ["agy"],
    "versionArgs": ["--version"],
    "versionRegex": "(\\d+\\.\\d+\\.\\d+)",
    "installHints": [
      { "kind": "script", "command": "curl -fsSL https://antigravity.google/cli/install.sh | bash" },
      { "kind": "script", "command": "irm https://antigravity.google/cli/install.ps1 | iex" }
    ]
  },
  "capabilities": {
    "model": {
      "args": ["--model", "{value}"],
      "allowCustom": true,
      "options": [
        { "id": "gemini-4-neon-high", "label": "Gemini 4 Neon (High)" },
        { "id": "gemini-4-neon-xhigh", "label": "Gemini 4 Neon (XHigh)" },
        { "id": "gemini-4-neon-medium", "label": "Gemini 4 Neon (Medium)" },
        { "id": "gemini-4-neon-low", "label": "Gemini 4 Neon (Low)" },
        { "id": "gemini-4-argon-high", "label": "Gemini 4 Argon (High)" },
        { "id": "gemini-4-argon-medium", "label": "Gemini 4 Argon (Medium)" },
        { "id": "gemini-4-argon-low", "label": "Gemini 4 Argon (Low)" },
        { "id": "gemini-4-hydrogen-high", "label": "Gemini 4 Hydrogen (High)" },
        { "id": "gemini-4-hydrogen-xhigh", "label": "Gemini 4 Hydrogen (XHigh)" },
        { "id": "gemini-4-hydrogen-medium", "label": "Gemini 4 Hydrogen (Medium)" },
        { "id": "gemini-4-hydrogen-low", "label": "Gemini 4 Hydrogen (Low)" },
        { "id": "gemini-pro-orchestrator-neon", "label": "Orchestrator (Neon)" },
        { "id": "gemini-pro-orchestrator-g1-pro", "label": "Orchestrator (Argon)" },
        { "id": "gemini-3.8-flash-high", "label": "Gemini 3.8 Flash (High)" },
        { "id": "gemini-3.8-flash-medium", "label": "Gemini 3.8 Flash (Medium)" },
        { "id": "gemini-3.8-flash-low", "label": "Gemini 3.8 Flash (Low)" },
        { "id": "claude-opus-5-5-high", "label": "Claude Opus 5.5 (High)" },
        { "id": "claude-opus-5-5-medium", "label": "Claude Opus 5.5 (Medium)" },
        { "id": "claude-opus-5-5-low", "label": "Claude Opus 5.5 (Low)" },
        { "id": "claude-sonnet-5-5-high", "label": "Claude Sonnet 5.5 (High)" },
        { "id": "claude-sonnet-5-5-medium", "label": "Claude Sonnet 5.5 (Medium)" },
        { "id": "claude-sonnet-5-5-low", "label": "Claude Sonnet 5.5 (Low)" },
        { "id": "gpt-oss-120b-medium", "label": "GPT-OSS 120B (Medium)" }
      ],
      "discover": { "args": ["models"], "parser": "idTabLabel" }
    },
    "effort": {
      "label": "Effort",
      "args": ["--effort", "{value}"],
      "options": [
        { "id": "low", "label": "Low" },
        { "id": "medium", "label": "Medium" },
        { "id": "high", "label": "High" },
        { "id": "xhigh", "label": "Extra high" },
        { "id": "max", "label": "Max" }
      ]
    },
    "permission": {
      "default": "default",
      "modes": {
        "default": { "args": [] },
        "acceptEdits": { "args": ["--mode", "accept-edits"] },
        "plan": { "args": ["--mode", "plan"] },
        "auto": { "args": ["--mode", "auto"] },
        "full": { "args": ["--dangerously-skip-permissions"], "danger": true }
      }
    },
    "prompt": { "mode": "flag", "args": ["-i", "{value}"] },
    "resume": { "continueLatest": ["--continue"], "byId": ["--conversation", "{id}"] },
    "additionalDirs": { "mode": "repeat", "args": ["--add-dir", "{value}"] },
    "extraArgs": true,
    "env": { "allowCustom": true }
  },
  // agy has no per-session way to pass hooks (--settings rejects "hooks", there is no --plugin-dir), and reads them from
  // hooks.json files only. Octopus keeps one entry named "octopus" in ~/.gemini/config/hooks.json; it runs the forwarder
  // named by OCTOPUS_SIGNAL_FORWARDER, which only sessions started by Octopus have (anywhere else it just prints "{}").
  // Checked against agy 1.5.12 with a plain hooks.json: SessionStart, PreInvocation and Stop all ran (a 429 included).
  "signals": {
    "minVersion": "1.5.12",
    "account": { "default": "~/.gemini/antigravity-cli" },
    "attach": [
      {
        "env": { "OCTOPUS_SIGNAL_FORWARDER": "{forwarder}", "OCTOPUS_SIGNAL_HOOKS": "{signalHooks}" },
        "verified": false,
        "note": "hooks.json entry installed by Octopus; the session's environment tells it where the forwarder is. The three events fire from a hooks.json (agy 1.5.12); the forwarder end to end is still to be run"
      }
    ],
    "channels": {
      "session-start": { "via": "hook", "event": "SessionStart" },
      "invocation": { "via": "hook", "event": "PreInvocation" },
      "stop": { "via": "hook", "event": "Stop" }
    },
    "status": {
      "working": ["invocation"],
      "done": ["stop"]
    }
  },
  // Verified against agy 1.5.15: `--print /usage --output-format json` queries quota without creating a conversation
  // or spending tokens (conversation_id is empty, num_turns is 0).
  "probes": {
    "usage": {
      "kind": "command",
      "args": ["--print", "/usage", "--output-format", "json"],
      "parse": "json",
      "select": ["status", "command.data.groups"],
      "timeoutMs": 30000,
      "minIntervalSec": 120
    }
  },
  "accounts": {
    "mode": "globalKeyring",
    "loginArgs": [],
    "unsetEnv": ["GEMINI_API_KEY", "AGY_ADC_AUTH"],
    "keyring": {
      "service": "gemini",
      "account": "antigravity",
      "windowsTarget": "gemini:antigravity",
      "linuxUserAttribute": "username"
    }
  },
  "providerSupport": {
    "protocols": ["geminiOfficialKey"],
    "strategy": "env",
    "apiKeyEnv": "GEMINI_API_KEY"
  },
  "acp": {
    "mode": "native",
    "args": [
      "acp"
    ],
    "fullAccessArgs": [
      "--dangerously-skip-permissions"
    ],
    "dialect": "antigravity",
    "permissionStrategy": "agentMode",
    "permissionModes": {
      "default": "default",
      "acceptEdits": "accept-edits",
      "auto": "auto",
      "plan": "plan",
      "full": "auto"
    }
  }
}
