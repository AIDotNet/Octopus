{
  "schema": 1,
  "id": "opencode",
  "name": "OpenCode",
  "icon": "opencode",
  "homepage": "https://opencode.ai",
  "verified": true,
  "detect": {
    "executables": ["opencode"],
    "versionArgs": ["--version"],
    "versionRegex": "^(\\d+\\.\\d+\\.\\d+)",
    "extraDirs": ["~/.opencode/bin"],
    "installHints": [
      { "kind": "script", "command": "curl -fsSL https://opencode.ai/install | bash" },
      { "kind": "npm", "command": "npm i -g opencode-ai" }
    ]
  },
  "capabilities": {
    "model": {
      "args": ["-m", "{value}"],
      "allowCustom": true,
      "options": [],
      "discover": { "args": ["models"], "parser": "lines" }
    },
    "permission": {
      "default": "default",
      "modes": {
        "default": { "args": [] },
        "plan": { "args": ["--agent", "plan"] },
        "auto": { "args": ["--auto"], "danger": true }
      }
    },
    "prompt": { "mode": "flag", "args": ["--prompt", "{value}"] },
    "resume": { "continueLatest": ["--continue"] },
    "extraArgs": true,
    "env": {
      "known": [
        { "name": "OPENCODE_CONFIG", "label": "Config file", "localized": { "zh-CN": { "label": "配置文件" } } },
        { "name": "OPENCODE_CONFIG_DIR", "label": "Config directory", "localized": { "zh-CN": { "label": "配置目录" } } }
      ],
      "allowCustom": true
    },
    "features": [
      { "id": "agent", "type": "string", "label": "Primary agent", "args": ["--agent", "{value}"], "localized": { "zh-CN": { "label": "主智能体" } } }
    ]
  },
  // OpenCode's extensions are in-process JS plugins, so Octopus generates a small one (it writes the forwarder's
  // envelope to the socket itself). 1.19.3 merges OPENCODE_CONFIG_CONTENT over the user's config and appends its
  // plugins (read from the binary). An event is matched by its type, and session.status also as "type:status".
  "signals": {
    "minVersion": "1.19.3",
    "attach": [
      { "env": { "OPENCODE_CONFIG_CONTENT": "{signalConfig}" }, "note": "merge and file:// plugin loading read from the 1.19.3 binary; Bun connecting to the socket or pipe not yet run (research §7)" }
    ],
    "channels": {
      "session-usage": { "via": "plugin", "event": "session.usage.updated" },
      "session-busy": { "via": "plugin", "event": "session.status:busy" },
      "session-idle": { "via": "plugin", "event": "session.idle" },
      "session-error": { "via": "plugin", "event": "session.error" }
    },
    "status": {
      "working": ["session-busy"],
      "done": ["session-idle"],
      "error": ["session-error"]
    },
    "credentialFiles": ["auth.json"]
  }
}
