{
  "schema": 1,
  "id": "kimchi",
  "name": "Kimchi",
  "icon": "kimchi",
  "homepage": "https://kimchi.dev",
  "verified": false,
  "detect": {
    "executables": ["kimchi"],
    "versionArgs": ["--version"],
    "versionRegex": "(\\d+\\.\\d+\\.\\d+)",
    "installHints": [
      { "kind": "native", "command": "https://github.com/getkimchi/kimchi/releases" }
    ]
  },
  "capabilities": {
    "extraArgs": true,
    "env": { "allowCustom": true }
  },
  "acp": {
    "mode": "adapter",
    "dialect": "generic",
    "adapter": {
      "registryId": "kimchi",
      "executables": ["kimchi"],
      "args": ["--mode", "acp"]
    }
  }
}
