{
  "schema": 1,
  "id": "harn",
  "name": "Harn",
  "icon": "harn",
  "homepage": "https://harnlang.com",
  "verified": false,
  "detect": {
    "executables": ["harn"],
    "versionArgs": ["--version"],
    "versionRegex": "(\\d+\\.\\d+\\.\\d+)",
    "installHints": [
      { "kind": "native", "command": "https://github.com/burin-labs/harn/releases" }
    ]
  },
  "capabilities": {
    "extraArgs": true,
    "env": { "allowCustom": true }
  },
  "acp": {
    "mode": "adapter",
    "dialect": "generic",
    "adapter": {
      "registryId": "harn",
      "executables": ["harn"],
      "args": ["serve", "acp"]
    }
  }
}
