{
  "schema": 1,
  "id": "copilot",
  "name": "GitHub Copilot CLI",
  "icon": "copilot",
  "homepage": "https://github.com/features/copilot/cli",
  "verified": false,
  "detect": {
    "executables": ["copilot"],
    "versionArgs": ["--version"],
    "versionRegex": "(\\d+\\.\\d+\\.\\d+)",
    "installHints": [
      { "kind": "npm", "command": "npm i -g @github/copilot" },
      { "kind": "brew", "command": "brew install copilot-cli" }
    ]
  },
  "capabilities": {
    "model": {
      "args": ["--model", "{value}"],
      "allowCustom": true,
      "options": []
    },
    "permission": {
      "default": "default",
      "modes": {
        "default": { "args": [] },
        "dontAsk": { "args": ["--allow-all-tools"] },
        "full": { "args": ["--yolo"], "danger": true }
      }
    },
    "prompt": { "mode": "flag", "args": ["-i", "{value}"] },
    "resume": { "continueLatest": ["--continue"] },
    "additionalDirs": { "mode": "repeat", "args": ["--add-dir", "{value}"] },
    "extraArgs": true,
    "env": {
      "known": [
        { "name": "COPILOT_HOME", "label": "Config directory", "localized": { "zh-CN": { "label": "配置目录" } } },
        { "name": "COPILOT_GITHUB_TOKEN", "label": "GitHub token", "secret": true, "localized": { "zh-CN": { "label": "GitHub 令牌" } } }
      ],
      "allowCustom": true
    }
  },
  // Read-only quota query through Copilot CLI's headless JSON-RPC server (Content-Length framing, same protocol as @github/copilot-sdk).
  "probes": {
    "quota": {
      "kind": "jsonRpcStdio",
      "framing": "contentLength",
      "args": ["--headless", "--stdio", "--no-auto-update"],
      "requests": [
        { "method": "account.getQuota", "params": {}, "result": true }
      ],
      "select": ["quotaSnapshots"],
      "timeoutMs": 20000,
      "minIntervalSec": 120,
      "exclusivePer": "account"
    }
  },
  "accounts": {
    "mode": "envDir",
    "env": "COPILOT_HOME",
    "defaultDir": "~/.copilot",
    "loginArgs": ["login"],
    "unsetEnv": ["COPILOT_GITHUB_TOKEN", "GH_TOKEN", "GITHUB_TOKEN"],
    "identityFile": {
      "path": "config.json",
      "kind": "jsonPaths",
      "jsonPaths": ["last_logged_in_user.login", "user.login"]
    }
  },
  "acp": {
    "mode": "native",
    "args": [
      "--acp"
    ],
    "dialect": "copilot",
    "minVersion": "1.0.88"
  }
}
