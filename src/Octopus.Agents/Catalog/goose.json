{
  "schema": 1,
  "id": "goose",
  "name": "Goose",
  "icon": "goose",
  "homepage": "https://block.github.io/goose",
  "verified": false,
  "detect": {
    "executables": ["goose"],
    "versionArgs": ["--version"],
    "versionRegex": "(\\d+\\.\\d+\\.\\d+)",
    "installHints": [
      { "kind": "brew", "command": "brew install block-goose-cli" },
      { "kind": "script", "command": "curl -fsSL https://github.com/block/goose/releases/download/stable/download_cli.sh | bash" }
    ]
  },
  "capabilities": {
    "baseArgs": ["session"],
    "permission": {
      "default": "default",
      "modes": {
        "default": { "args": [] },
        "full": { "args": [], "env": { "GOOSE_MODE": "auto" }, "danger": true }
      }
    },
    "resume": { "continueLatest": ["--resume"] },
    "extraArgs": true,
    "features": [
      { "id": "provider", "type": "string", "label": "Provider", "env": "GOOSE_PROVIDER", "localized": { "zh-CN": { "label": "提供商" } } },
      { "id": "model", "type": "string", "label": "Model", "env": "GOOSE_MODEL", "localized": { "zh-CN": { "label": "模型" } } }
    ]
  },
  "providerSupport": {
    "protocols": ["openaiChat", "anthropic"],
    "strategy": "env",
    "modelEnv": "GOOSE_MODEL",
    "protocolBaseUrlEnvs": {
      "openaiChat": "OPENAI_HOST",
      "anthropic": "ANTHROPIC_HOST"
    },
    "protocolApiKeyEnvs": {
      "openaiChat": "OPENAI_API_KEY",
      "anthropic": "ANTHROPIC_API_KEY"
    },
    "protocolExtraEnv": {
      "openaiChat": { "GOOSE_PROVIDER": "openai" },
      "anthropic": { "GOOSE_PROVIDER": "anthropic" }
    }
  },
  "acp": {
    "mode": "native",
    "args": [
      "acp"
    ],
    "dialect": "goose",
    "minVersion": "1.42.0",
    "permissionStrategy": "agentMode",
    "permissionModes": {
      "default": "approve",
      "auto": "smart_approve",
      "full": "auto"
    }
  }
}
