{
  "schema": 1,
  "id": "kiro",
  "name": "Kiro",
  "icon": "kiro",
  "homepage": "https://kiro.dev/cli",
  "verified": false,
  "detect": {
    "executables": ["kiro-cli"],
    "versionArgs": ["--version"],
    "versionRegex": "(\\d+\\.\\d+\\.\\d+)",
    "installHints": [
      { "kind": "script", "command": "curl -fsSL https://cli.kiro.dev/install | bash" }
    ]
  },
  "capabilities": {
    "baseArgs": ["chat"],
    "model": {
      "args": ["--model", "{value}"],
      "allowCustom": true,
      "options": []
    },
    "permission": {
      "default": "default",
      "modes": {
        "default": { "args": [] },
        "full": { "args": ["--trust-all-tools"], "danger": true }
      }
    },
    "prompt": { "mode": "positional" },
    "resume": { "continueLatest": ["--resume"] },
    "extraArgs": true
  }
}
