<Project>
    <PropertyGroup>
        <TargetFramework>net11.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <!-- The address of the official Octopus service (https://…), compiled into the desktop and phone apps:
             sign-in, default relay, and update checks go here. Override with -p:OctopusServiceUrl=… -->
        <OctopusServiceUrl Condition="'$(OctopusServiceUrl)' == ''">https://octoterm.si</OctopusServiceUrl>
    </PropertyGroup>
</Project>
