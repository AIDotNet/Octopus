<Project>
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <!-- The address of the official Octopus service (https://…), compiled into the desktop and phone apps:
             sign-in, default relay, and update checks go here. Override with -p:OctopusServiceUrl=… -->
        <OctopusServiceUrl Condition="'$(OctopusServiceUrl)' == ''">https://octoterm.si</OctopusServiceUrl>
    </PropertyGroup>
    <ItemGroup Condition="'$(MSBuildProjectName)' != 'Octopus.SignalForwarder'">
        <!-- Many projects use these types; .NET 11 carries the abstractions in its shared framework, net10.0 does not. -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    </ItemGroup>
</Project>
