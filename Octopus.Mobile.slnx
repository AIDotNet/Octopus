<Solution>
  <!-- The phone app alone: its shared part, the iOS and Android heads, the desktop preview and the tests. The heads are
       here and only here: they need workloads the desktop build must not depend on (design/12-远程操作.md §9.1). -->
  <Folder Name="/src/">
    <Project Path="src/Octopus.Mobile.Android/Octopus.Mobile.Android.csproj" />
    <Project Path="src/Octopus.Mobile.Desktop/Octopus.Mobile.Desktop.csproj" />
    <Project Path="src/Octopus.Mobile.iOS/Octopus.Mobile.iOS.csproj" />
    <Project Path="src/Octopus.Mobile/Octopus.Mobile.csproj" />
  </Folder>
  <Folder Name="/tests/">
    <Project Path="tests/Octopus.Mobile.Tests/Octopus.Mobile.Tests.csproj" />
  </Folder>
</Solution>
